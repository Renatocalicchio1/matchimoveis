            <span style="display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;background:<%= jaEnviado ? '#9ca3af' : '#25D366' %>;color:#fff;font-size:11px;flex-shrink:0"><%= jaEnviado ? '✓' : '💬' %></span>
            <%= c.celular %>
