  <script>
  // Clique no botão de WhatsApp já marca visualmente na hora (sem esperar
  // recarregar a página) e manda a linha pro final da lista — pra quem ainda
  // não foi chamado ficar sempre no topo e não correr o risco de clicar 2x
  // na mesma pessoa (pedido explícito do Renato, ago/2026). A marcação real
  // (wa_manual_enviado_em) já acontece no servidor, em /app/afiliados/
  // contato/:id/whatsapp — isso aqui só antecipa o resultado na tela.
  function afMarcarConviteEnviado(id){
    var row = document.getElementById('af-camp-row-' + id);
    if(!row) return;
    var link = row.querySelector('td:nth-child(4) a');
    if(link){
      link.style.color = '#374151';
      link.style.background = '#f3f4f6';
      link.style.border = '1px solid #e5e7eb';
      link.title = 'Você já chamou essa lead — clique pra reenviar';
      var dot = link.querySelector('span');
      if(dot){ dot.style.background = '#9ca3af'; dot.textContent = '✓'; }
    }
    var statusCell = document.getElementById('af-camp-status-' + id);
    if(statusCell) statusCell.innerHTML = '<span style="color:#2563eb;font-weight:700">💬 Você já chamou</span>';
    if(row.parentElement) row.parentElement.appendChild(row);
  }
  </script>
  <% } %>
