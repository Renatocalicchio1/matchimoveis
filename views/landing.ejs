        <% if(typeof ref !== 'undefined' && ref){ %>
        <div style="background:#f0fdf4;border:1px solid #86efac;color:#15803d;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:12px">🎉 Você foi indicado por um parceiro MatchImóveis! Cadastre-se e ganhe <strong>500 créditos de bônus</strong>, além dos 1.000 iniciais.</div>
        <% } %>
        <% if(typeof plano !== 'undefined' && plano){ %>
        <div style="background:#FFF1E9;border:1px solid #FDDCC4;color:#B4551A;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:12px">⚡ Cria a conta e você já vai direto pro pagamento do plano escolhido.</div>
        <% } %>
        <div class="m-field"><label>Nome completo</label><input name="nome" placeholder="Seu nome" required></div>
        <div class="m-field"><label>E-mail</label><input name="email" type="email" placeholder="seu@email.com" required></div>
        <div class="m-field"><label>Celular</label><input name="telefone" placeholder="47999999999" required></div>
        <div class="m-field"><label>Tipo de conta</label>
          <select name="tipoConta">
            <option value="corretor">Corretor</option>
            <option value="imobiliaria">Imobiliária</option>
            <option value="construtor">Construtor</option>
            <option value="agencia_marketing">Agência de Marketing</option>
          </select>
        </div>
        <div class="m-field">
          <label>Estado de atuação</label>
          <select id="areaEstadoInput"><option value="">Selecione...</option></select>
        </div>
        <div class="m-field">
          <label>Cidades de atuação (escolha quantas quiser)</label>
          <div style="position:relative">
            <input type="text" id="areaCidadeInput" placeholder="Selecione o estado primeiro..." autocomplete="off" disabled style="width:100%">
            <div id="areaCidadeSugestoes" class="sugestoes-dropdown" style="display:none"></div>
          </div>
          <div id="areaCidadesChips" class="chips"></div>
        </div>
        <div class="m-field">
          <label>Bairros onde atua (escolha quantos quiser)</label>
          <div style="position:relative">
            <input type="text" id="areaBairroInput" placeholder="Selecione uma cidade primeiro..." autocomplete="off" disabled style="width:100%">
            <div id="areaBairroSugestoes" class="sugestoes-dropdown" style="display:none"></div>
          </div>
          <div id="areaBairrosChips" class="chips"></div>
          <input type="hidden" name="areaAtuacaoEstado" id="areaAtuacaoEstadoHidden" value="">
          <input type="hidden" name="areaAtuacaoCidades" id="areaAtuacaoCidadesHidden" value="[]">
          <input type="hidden" name="areaAtuacaoBairros" id="areaAtuacaoBairrosHidden" value="[]">
        </div>
        <div class="m-field"><label>Senha</label><input name="senha" type="password" placeholder="Mínimo 4 caracteres" required minlength="4"></div>
        <button type="submit" class="m-btn">Criar conta grátis →</button>
        <p class="m-note">1.000 créditos grátis para começar</p>
      </form>
    </div>
  </div>
</div>

<script src="/area-atuacao-widget.js"></script>
<script>
// Botão flutuante de CTA — aparece só depois que o visitante rola a página
// (sinal de que já leu algo e pode precisar de um lembrete de conversão).
(function(){
  const heroEl = document.querySelector('.hero-wrap');
  const flutuante = document.getElementById('cta-flutuante');
  if(!heroEl || !flutuante) return;
  window.addEventListener('scroll', function(){
    const passouHero = window.scrollY > heroEl.offsetHeight;
    flutuante.classList.toggle('visivel', passouHero);
  }, { passive: true });
})();

// Fluxo animado do hero — acende 1 nó por vez, em loop (decorativo, respeita
// prefers-reduced-motion via *{animation-duration:.001ms} no CSS).
(function(){
  const nos = document.querySelectorAll('#hvFlow .hv-node');
  if(!nos.length) return;
  let i = 0;
  setInterval(function(){
    nos.forEach(function(n){ n.classList.remove('on'); });
    nos[i].classList.add('on');
    i = (i + 1) % nos.length;
  }, 1400);
  nos[0].classList.add('on');
})();

function openModal(aba){
  document.getElementById('modal-login').style.display='flex';
  if(aba) setTab(aba);
}
function closeModal(){
  document.getElementById('modal-login').style.display='none';
}
function setTab(t){
  document.getElementById('form-entrar').style.display=t==='entrar'?'block':'none';
  document.getElementById('form-cadastro').style.display=t==='cadastro'?'block':'none';
  document.getElementById('form-esqueci').style.display=t==='esqueci'?'block':'none';
  document.getElementById('tab-e').className='modal-tab'+(t==='entrar'||t==='esqueci'?' on':'');
  document.getElementById('tab-c').className='modal-tab'+(t==='cadastro'?' on':'');
}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();});

// Cidades + bairros de atuação (cadastro) — estado -> múltiplas cidades
// (digita, aparece sugestão, clica, vira chip) -> bairros das cidades
// escolhidas (mesmo padrão, chip). Guardado estruturado (não texto livre)
// porque a ideia é depois usar isso pra rotear lead automaticamente batendo
// a cidade/bairro. ago/2026: trocado de "1 cidade + checkbox rolável de
// bairro" pro widget de chips único (public/area-atuacao-widget.js),
// reaproveitado também no modal de /demanda e em app-perfil.ejs.
const UFS_BR = ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'];
(function(){
  const selEstado = document.getElementById('areaEstadoInput');
  if(!selEstado) return;
  UFS_BR.forEach(uf => { const o = document.createElement('option'); o.value = uf; o.textContent = uf; selEstado.appendChild(o); });
  criarSeletorAreaAtuacao('area');
})();

// Reabrir modal na aba correta se tiver erro
(function(){
  const _p = new URLSearchParams(window.location.search);
  const _e = _p.get('erro');
  if(_e === 'celular_existente' || _e === 'email_existente' || _e === 'nome_invalido' || _e === 'telefone_invalido') {
    openModal('cadastro');
  } else if(_e === 'telefone_nao_encontrado' || _e === 'senha_incorreta' || _e === 'nao_cadastrado') {
    openModal('entrar');
  } else if(_e) {
    openModal();
  } else if(_p.get('msg') === 'senha_email_enviado') {
    openModal('entrar');
  } else if(_p.get('ref')) {
    openModal('cadastro');
  } else if(_p.get('cadastro') === '1') {
    // Usado pelas páginas de conteúdo (/crm-para-corretores etc) e por
    // qualquer link que precise abrir direto no cadastro sem se misturar
    // com a atribuição de sub-admin do ?ref= — esse param não seta indicador.
    openModal('cadastro');
  }
})();
let _mdTarget=null;
document.getElementById('modal-login').addEventListener('mousedown',e=>{_mdTarget=e.target;});
document.getElementById('modal-login').addEventListener('mouseup',e=>{if(_mdTarget===e.target&&e.target===document.getElementById('modal-login'))closeModal();_mdTarget=null;});
document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener('click',e=>{
    e.preventDefault();
    const el=document.querySelector(a.getAttribute('href'));
    if(el)el.scrollIntoView({behavior:'smooth'});
  });
});

</script>

</body>
</html>
