<script>
function openModal(aba){
  document.getElementById('modal-login').style.display='flex';
  if(aba) setTab(aba);
}
function closeModal(){
  document.getElementById('modal-login').style.display='none';
}
function setTab(t){
  document.getElementById('form-entrar').style.display=t==='entrar'?'block':'none';
  document.getElementById('form-cadastro').style.display=t==='cadastro'?'block':'none';
  document.getElementById('form-esqueci').style.display=t==='esqueci'?'block':'none';
  document.getElementById('tab-e').className='modal-tab'+(t==='entrar'||t==='esqueci'?' on':'');
  document.getElementById('tab-c').className='modal-tab'+(t==='cadastro'?' on':'');
}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();});

// Cidade + bairros de atuação (cadastro) — estado -> cidade (autocomplete
// contra /api/localidades/cidades) -> bairros dessa cidade (checkbox, contra
// /api/localidades/bairros). Guardado estruturado (não texto livre) porque a
// ideia é depois usar isso pra rotear lead automaticamente batendo o bairro.
const UFS_BR = ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'];
(function(){
  const selEstado = document.getElementById('areaEstadoInput');
  if(!selEstado) return;
  UFS_BR.forEach(uf => { const o = document.createElement('option'); o.value = uf; o.textContent = uf; selEstado.appendChild(o); });
})();
let _bairrosEscolhidos = [];
let _debounceCidade;
async function _buscarCidades(){
  const estado = document.getElementById('areaEstadoInput').value;
  const q = document.getElementById('areaCidadeInput').value.trim();
  if(!estado || q.length < 2) return;
  try {
    const r = await fetch('/api/localidades/cidades?estado='+encodeURIComponent(estado)+'&q='+encodeURIComponent(q));
    const d = await r.json();
    const dl = document.getElementById('areaCidadeLista');
    dl.innerHTML = (d.cidades||[]).map(c => '<option value="'+c.replace(/"/g,'')+'">').join('');
  } catch(e){}
}
async function _selecionarCidade(){
  const estado = document.getElementById('areaEstadoInput').value;
  const cidade = document.getElementById('areaCidadeInput').value.trim();
  _bairrosEscolhidos = [];
  document.getElementById('areaAtuacaoEstadoHidden').value = estado;
  document.getElementById('areaAtuacaoCidadeHidden').value = cidade;
  document.getElementById('areaAtuacaoBairrosHidden').value = '[]';
  const wrap = document.getElementById('areaBairrosWrap');
  const lista = document.getElementById('areaBairrosLista');
  if(!estado || !cidade){ wrap.style.display='none'; return; }
  lista.innerHTML = '<span style="color:#9ca3af;font-size:12px">Carregando bairros...</span>';
  wrap.style.display = 'block';
  try {
    const r = await fetch('/api/localidades/bairros?estado='+encodeURIComponent(estado)+'&cidade='+encodeURIComponent(cidade));
    const d = await r.json();
    if(!d.bairros || !d.bairros.length){ lista.innerHTML = '<span style="color:#9ca3af;font-size:12px">Nenhum bairro encontrado pra essa cidade.</span>'; return; }
    lista.innerHTML = d.bairros.map(b => {
      const id = 'bairro-'+b.replace(/[^a-zA-Z0-9]/g,'');
      return '<label style="display:block;margin-bottom:4px;cursor:pointer"><input type="checkbox" value="'+b.replace(/"/g,'')+'" onchange="_toggleBairro(this)"> '+b+'</label>';
    }).join('');
  } catch(e){ lista.innerHTML = '<span style="color:#dc2626;font-size:12px">Erro ao buscar bairros.</span>'; }
}
function _toggleBairro(chk){
  if(chk.checked){ if(!_bairrosEscolhidos.includes(chk.value)) _bairrosEscolhidos.push(chk.value); }
  else { _bairrosEscolhidos = _bairrosEscolhidos.filter(b => b !== chk.value); }
  document.getElementById('areaAtuacaoBairrosHidden').value = JSON.stringify(_bairrosEscolhidos);
}
(function(){
  const selEstado = document.getElementById('areaEstadoInput');
  const inputCidade = document.getElementById('areaCidadeInput');
  if(!selEstado || !inputCidade) return;
  selEstado.addEventListener('change', () => {
    inputCidade.disabled = !selEstado.value;
    inputCidade.value = '';
    document.getElementById('areaBairrosWrap').style.display = 'none';
  });
  inputCidade.addEventListener('input', () => { clearTimeout(_debounceCidade); _debounceCidade = setTimeout(_buscarCidades, 300); });
  inputCidade.addEventListener('change', _selecionarCidade);
})();

// Reabrir modal na aba correta se tiver erro
(function(){
  const _p = new URLSearchParams(window.location.search);
  const _e = _p.get('erro');
  if(_e === 'celular_existente' || _e === 'email_existente' || _e === 'nome_invalido' || _e === 'telefone_invalido') {
    openModal('cadastro');
  } else if(_e === 'telefone_nao_encontrado' || _e === 'senha_incorreta' || _e === 'nao_cadastrado') {
    openModal('entrar');
  } else if(_e) {
    openModal();
  } else if(_p.get('msg') === 'senha_email_enviado') {
    openModal('entrar');
  } else if(_p.get('ref')) {
    openModal('cadastro');
  }
})();
let _mdTarget=null;
document.getElementById('modal-login').addEventListener('mousedown',e=>{_mdTarget=e.target;});
document.getElementById('modal-login').addEventListener('mouseup',e=>{if(_mdTarget===e.target&&e.target===document.getElementById('modal-login'))closeModal();_mdTarget=null;});
document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener('click',e=>{
    e.preventDefault();
    const el=document.querySelector(a.getAttribute('href'));
    if(el)el.scrollIntoView({behavior:'smooth'});
  });
});

// Grade de 4 cards com atividade REAL da plataforma (mesma fonte de dados
// do modal "pensando" em /demanda: leads que já receberam vitrine + foto
// real do imóvel enviado). Cada card gira independente, offset diferente,
// pra visitante ver rotatividade de cidades diferentes de cara — prova de
// que tem negócio de verdade acontecendo, antes de pedir cadastro.
function escHtmlAtividade(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function _montarCardAtividadeLanding(a){
  const valorTxt = a.Valor ? 'R$ '+Number(a.Valor).toLocaleString('pt-BR') : '';
  const fotoHtml = a.Foto ? '<img class="atividade-card-foto" src="'+escHtmlAtividade(a.Foto)+'" loading="lazy" onerror="this.remove()">' : '';
  const contatoPartes = [];
  if(a.Telefone) contatoPartes.push('📱 '+escHtmlAtividade(a.Telefone));
  if(a.Email) contatoPartes.push('✉️ '+escHtmlAtividade(a.Email));
  const contatoHtml = contatoPartes.length ? '<div class="atividade-card-contato">'+contatoPartes.join(' · ')+'</div>' : '';
  const diasHtml = a.ProcurandoTexto ? '<div class="atividade-card-dias">⏱️ '+escHtmlAtividade(a.ProcurandoTexto)+'</div>' : '';
  return fotoHtml
    + '<div class="atividade-card-corpo">'
    + '<div class="atividade-card-topo"><span>👤 '+escHtmlAtividade(a.Nome)+'</span>'+(valorTxt ? '<span class="atividade-card-valor">'+valorTxt+'</span>' : '')+'</div>'
    + contatoHtml
    + '<div class="atividade-card-tags">'+(a.Tipo ? '<span>🏠 '+escHtmlAtividade(a.Tipo)+'</span>' : '')+'<span>'+(a.Transacao === 'aluguel' ? '🔑 Aluguel' : '🛒 Venda')+'</span>'+(a.Quartos ? '<span>🛏️ '+escHtmlAtividade(a.Quartos)+' qts</span>' : '')+'</div>'
    + '<div class="atividade-card-loc">📍 '+escHtmlAtividade(a.Bairro)+(a.Cidade ? ', '+escHtmlAtividade(a.Cidade) : '')+'</div>'
    + diasHtml
    + '</div>';
}
(function(){
  const NUM_CARDS = window.innerWidth <= 768 ? 1 : 4;
  const wrap = document.getElementById('atividade-wrap');
  const grid = document.getElementById('atividade-grid');
  const els = [];
  for(let i=0;i<NUM_CARDS;i++){
    const el = document.createElement('div');
    el.className = 'atividade-card';
    grid.appendChild(el);
    els.push(el);
  }

  let atividade = [];
  let indices = [];

  // Sorteia NUM_CARDS índices diferentes entre si (sem repetir na mesma
  // tela) — se o pool tiver menos que NUM_CARDS itens, repete só o
  // necessário pra preencher.
  function sortearIndices(){
    const pool = atividade.map((_, i) => i);
    for(let i=pool.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [pool[i],pool[j]]=[pool[j],pool[i]]; }
    return els.map((_, i) => pool[i % pool.length]);
  }

  function renderCard(i){
    els[i].innerHTML = _montarCardAtividadeLanding(atividade[indices[i]]);
    els[i].classList.add('mostrar');
  }

  function renderTudo(){
    els.forEach((el, i) => {
      el.classList.remove('mostrar');
      setTimeout(() => renderCard(i), 150);
    });
  }

  // Escolhe o próximo item pra ESSE card sem repetir o que os outros
  // cards estão mostrando agora (se o pool for grande o bastante).
  function proximoIndice(cardIdx){
    const usadosPorOutros = indices.filter((_, i) => i !== cardIdx);
    const livres = atividade.map((_, i) => i).filter(i => !usadosPorOutros.includes(i) && i !== indices[cardIdx]);
    if(livres.length) return livres[Math.floor(Math.random()*livres.length)];
    const alternativas = atividade.map((_, i) => i).filter(i => i !== indices[cardIdx]);
    return alternativas.length ? alternativas[Math.floor(Math.random()*alternativas.length)] : indices[cardIdx];
  }

  // Cada card tem seu próprio ciclo (some, troca, aparece) — não troca tudo
  // junto de uma vez, um card some e outro aparece no lugar, continuamente.
  function iniciarCicloCard(i){
    setInterval(() => {
      if(!atividade.length) return;
      els[i].classList.remove('mostrar');
      setTimeout(() => {
        indices[i] = proximoIndice(i);
        renderCard(i);
      }, 300);
    }, 4500);
  }

  // Puxa um lote novo do servidor (pool de até 24 itens, aleatório a cada
  // chamada) — evita ficar preso sempre nos mesmos poucos exemplos.
  async function carregarAtividade(){
    try {
      const r = await fetch('/demanda/atividade', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({}) });
      const d = await r.json();
      const nova = (d && d.ok && d.atividade) ? d.atividade : [];
      if(!nova.length){ wrap.style.display = 'none'; return; }
      atividade = nova;
      indices = sortearIndices();
      wrap.style.display = 'block';
      renderTudo();
    } catch(e) {}
  }

  carregarAtividade().then(() => {
    // Ciclos independentes, com largada escalonada — cada card começa a
    // trocar num instante diferente, dando a sensação de "um por vez".
    els.forEach((_, i) => setTimeout(() => iniciarCicloCard(i), i * 1100));
  });
  // Busca um lote novo do servidor de tempos em tempos, pra variar de
  // verdade ao longo de uma visita mais longa (não só o mesmo lote sempre).
  setInterval(carregarAtividade, 45000);
})();
</script>

</body>
</html>
