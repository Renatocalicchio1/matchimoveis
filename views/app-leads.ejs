// Polling de importação se tiver jobId na URL
(function(){
  const params = new URLSearchParams(window.location.search);
  const jobId = params.get('jobId');
  if(!jobId) return;
  const bar = document.createElement('div');
  bar.style = 'position:fixed;top:0;left:0;right:0;background:#fff;border-bottom:1px solid #e5e7eb;padding:12px 20px;z-index:9999;display:flex;align-items:center;gap:12px;font-size:14px';
  bar.innerHTML = '<span id="job-status">⏳ Importando planilha de leads...</span>';
  document.body.appendChild(bar);
  const timer = setInterval(async()=>{
    try{
      const r = await fetch('/api/import/status/'+jobId);
      const d = await r.json();
      if(!d.ok) return;
      const job = d.job;
      const el = document.getElementById('job-status');
      if(job.status==='concluido'){
        clearInterval(timer);
        if(el) el.innerHTML = '✅ Importação concluída! <a href="/app/leads" style="color:#FF385C;font-weight:600">Atualizar →</a>';
        setTimeout(()=>{ window.history.replaceState({},'',' /app/leads'); bar.remove(); location.reload(); }, 3000);
      } else if(job.status==='erro'){
        clearInterval(timer);
        if(el) el.innerHTML = '❌ Erro na importação: '+(job.erro||'');
      } else if(job.status==='processando'){
        if(el) el.textContent = '⏳ Processando leads... '+job.progresso+'%';
      }
    }catch(e){}
  }, 2000);
})();

function abrirModalKanban(colKey, colLabel) {
  const col = document.querySelector('[data-col="' + colKey + '"]');
  if (!col) return;
  const cards = col.querySelectorAll('.lead-card');
  document.getElementById('modal-kanban-title').textContent = colLabel + ' (' + cards.length + ')';
  const body = document.getElementById('modal-kanban-body');
  body.innerHTML = '';

  const header = document.createElement('div');
  header.style.cssText = 'display:grid;grid-template-columns:150px 110px 80px 55px 70px 1fr 110px;gap:8px;padding:6px 10px;border-bottom:1px solid #f0f0f0;margin-bottom:4px';
  header.innerHTML = '<span style="font-size:10px;font-weight:600;color:#9ca3af">NOME</span><span style="font-size:10px;font-weight:600;color:#9ca3af">TELEFONE</span><span style="font-size:10px;font-weight:600;color:#9ca3af">TEMP</span><span style="font-size:10px;font-weight:600;color:#9ca3af">SCORE</span><span style="font-size:10px;font-weight:600;color:#9ca3af">MATCHES</span><span style="font-size:10px;font-weight:600;color:#9ca3af">PERFIL</span><span style="font-size:10px;font-weight:600;color:#9ca3af">AÇÕES</span>';
  body.appendChild(header);

  cards.forEach(function(card) {
    var nome = card.querySelector('.lead-nome') ? card.querySelector('.lead-nome').textContent.trim() : '—';
    var tel = card.dataset.tel || '—';
    var id = card.dataset.id || '#';
    var score = card.dataset.score || '0';
    var temp = card.querySelector('.temp-pill') ? card.querySelector('.temp-pill').textContent.trim() : '—';
    var matches = card.querySelector('.match-pill') ? card.querySelector('.match-pill').textContent.trim() : '—';
    var perfil = Array.from(card.querySelectorAll('.perfil-tag')).map(function(t){return t.textContent.trim();}).join(' · ') || '—';

    var scoreNum = parseInt(score);
    var scoreCor = scoreNum>=70?'#16a34a':scoreNum>=40?'#d97706':'#9ca3af';

    var row = document.createElement('div');
    row.style.cssText = 'display:grid;grid-template-columns:150px 110px 80px 55px 70px 1fr 110px;gap:8px;padding:8px 10px;border-radius:8px;align-items:center;border:0.5px solid rgba(0,0,0,.06);background:#fff;margin-bottom:4px';
    row.onmouseenter = function(){ this.style.background='#f9fafb'; };
    row.onmouseleave = function(){ this.style.background='#fff'; };

    // colunas de texto
    var cols = [
      '<span style="font-size:12px;font-weight:500;color:#111;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+nome+'</span>',
      '<span style="font-size:11px;color:#6b7280">'+tel+'</span>',
      '<span style="font-size:11px">'+temp+'</span>',
      '<span style="font-size:11px;font-weight:600;color:'+scoreCor+'">'+score+'</span>',
      '<span style="font-size:11px;color:#FC642D">'+matches+'</span>',
      '<span style="font-size:11px;color:#374151;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+perfil+'</span>'
    ];
    row.innerHTML = cols.join('');

    // coluna ações via createElement
    var acoes = document.createElement('div');
    acoes.style.cssText = 'display:flex;gap:4px;align-items:center';

    if (tel && tel !== '—') {
      var wa = document.createElement('a');
      wa.href = 'https://wa.me/' + tel.replace(/\D/g,'');
      wa.target = '_blank';
      wa.textContent = 'WA';
      wa.style.cssText = 'font-size:10px;font-weight:600;padding:3px 7px;border-radius:6px;background:#dcfce7;color:#166534;text-decoration:none;border:0.5px solid #86efac';
      acoes.appendChild(wa);
    }

    var ver = document.createElement('a');
    ver.href = '/app/lead/' + id;
    ver.textContent = 'Ver';
    ver.style.cssText = 'font-size:10px;font-weight:600;padding:3px 7px;border-radius:6px;background:#f3f4f6;color:#374151;text-decoration:none;border:0.5px solid #e5e7eb';
    acoes.appendChild(ver);

    var flag = document.createElement('button');
    flag.textContent = '🚩';
    flag.style.cssText = 'font-size:10px;font-weight:600;padding:3px 7px;border-radius:6px;background:#fef3c7;color:#92400e;border:0.5px solid #fcd34d;cursor:pointer';
    flag.addEventListener('click', function(){ abrirMiniModalClassificar(id, nome); });
    acoes.appendChild(flag);

    var del = document.createElement('button');
    del.textContent = '×';
    del.style.cssText = 'font-size:10px;font-weight:600;padding:3px 7px;border-radius:6px;background:#fee2e2;color:#991b1b;border:0.5px solid #fca5a5;cursor:pointer';
    del.addEventListener('click', function(){ abrirMiniModalExcluir(id, nome); });
    acoes.appendChild(del);

    row.appendChild(acoes);
    body.appendChild(row);
  });

  document.getElementById('modal-kanban').style.display = 'flex';
}
function fecharModalKanban() {
  document.getElementById('modal-kanban').style.display = 'none';
}

document.addEventListener('DOMContentLoaded', function() {
  const mk = document.getElementById('modal-kanban');
  if (mk) mk.addEventListener('click', function(e) {
    if (e.target === this) fecharModalKanban();
  });
});


