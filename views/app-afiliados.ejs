<script>
function afTab(nome, btn){
  document.querySelectorAll('.af-tab-pane').forEach(function(p){ p.classList.remove('active'); });
  document.querySelectorAll('.af-tab-btn').forEach(function(b){ b.classList.remove('active'); });
  document.getElementById('af-pane-' + nome).classList.add('active');
  btn.classList.add('active');
  if (nome === 'inbox' && !_afInboxCarregado) afInboxCarregar();
}

// ── INBOX (campanha de disparo oficial vinculada a este afiliado) ──────
let _afInboxCarregado = false;
let _afInboxTelefoneAtivo = null;
let _afInboxNomeAtivo = '';
let _afInboxUltimaData = null;
let _afInboxPollTimer = null;
let _afInboxConversas = [];
let _afInboxAguardando = [];
function _afEscHtml(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function _afLinkify(s){ return s.replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" style="color:inherit;text-decoration:underline">$1</a>'); }
// Respostas rápidas — clicar já manda na hora (pedido explícito do Renato:
// "quero que quando Bruno responde já vai a msg clicando"). Textos pensados
// pro momento certo da campanha "Dia do Corretor" (link já mandado, dúvida
// mais comum é "como acesso"/"funcionou?").
const AF_INBOX_RESPOSTAS_RAPIDAS = [
  'Oi! Tudo bem? 😊',
  'É só clicar no botão "Quero meu presente" na mensagem que você recebeu, que já libera o acesso.',
  'Qualquer dúvida, pode me chamar aqui a qualquer hora!',
  'Perfeito, fico à disposição 🙌'
];
function afInboxBadgeStatus(statusContato){
  if (statusContato === 'comprou') return { texto: '💰 Comprou', cor: '#FC642D' };
  if (statusContato === 'cadastrou') return { texto: '✅ Cadastrou', cor: '#00A699' };
  if (statusContato === 'excluido') return { texto: '🚫 Bloqueado', cor: '#9ca3af' };
  return null;
}
async function afInboxCarregar(){
  _afInboxCarregado = true;
  const carregando = document.getElementById('af-inbox-carregando');
  const corpo = document.getElementById('af-inbox-corpo');
  const vazio = document.getElementById('af-inbox-vazio');
  try {
    const r = await fetch('/api/afiliados/inbox/lista');
    const d = await r.json();
    carregando.style.display = 'none';
    _afInboxConversas = (d && d.conversas) || [];
    _afInboxAguardando = (d && d.aguardando) || [];
    if (!_afInboxConversas.length && !_afInboxAguardando.length) { vazio.style.display = 'block'; return; }
    corpo.style.display = 'flex';
    afInboxFiltrar();
  } catch(e) {
    carregando.textContent = 'Erro ao carregar.';
  }
}
// Filtra client-side (busca por nome/telefone + status) — não recarrega do
// servidor, só re-renderiza a partir do que já veio (_afInboxConversas/
// _afInboxAguardando), pra ficar instantâneo digitando.
function afInboxFiltrar(){
  const termo = (document.getElementById('af-inbox-busca').value || '').trim().toLowerCase();
  const filtroStatus = document.getElementById('af-inbox-filtro-status').value;
  const lista = document.getElementById('af-inbox-lista');
  const vaziaMsg = document.getElementById('af-inbox-lista-vazia');
  lista.innerHTML = '';
  const _bate = c => {
    if (termo) {
      const alvo = ((c.contato_nome || '') + ' ' + (c.contato_telefone || '')).toLowerCase();
      if (alvo.indexOf(termo) === -1) return false;
    }
    if (filtroStatus === 'aguardando') return !!c.aguardando;
    if (filtroStatus) return c.statusContato === filtroStatus;
    return true;
  };
  const conversasF = _afInboxConversas.filter(_bate);
  const aguardandoF = _afInboxAguardando.filter(_bate);
  conversasF.forEach(function(c){
    const item = document.createElement('div');
    item.style.cssText = 'padding:12px 14px;border-bottom:1px solid #f3f4f6;cursor:pointer' + (c.contato_telefone === _afInboxTelefoneAtivo ? ';background:#f9fafb' : '');
    item.onclick = function(){ afInboxAbrirConversa(c.contato_telefone, c.contato_nome); };
    const nome = document.createElement('div');
    nome.style.cssText = 'font-size:13px;font-weight:600;color:#111827';
    nome.textContent = c.contato_nome || c.contato_telefone;
    if (c.naoLidas) {
      const badge = document.createElement('span');
      badge.style.cssText = 'background:#FF385C;color:#fff;font-size:10px;font-weight:700;padding:1px 6px;border-radius:10px;margin-left:6px';
      badge.textContent = c.naoLidas;
      nome.appendChild(badge);
    }
    const statusBadge = afInboxBadgeStatus(c.statusContato);
    if (statusBadge) {
      const badge = document.createElement('span');
      badge.style.cssText = 'font-size:10px;font-weight:700;margin-left:6px;color:' + statusBadge.cor;
      badge.textContent = statusBadge.texto;
      nome.appendChild(badge);
    }
    const preview = document.createElement('div');
    preview.style.cssText = 'font-size:11.5px;color:#6b7280;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis';
    preview.textContent = (c.direcao === 'saida' ? 'Você: ' : '') + (c.texto || '');
    item.appendChild(nome);
    item.appendChild(preview);
    lista.appendChild(item);
  });
  aguardandoF.forEach(function(c){
    const item = document.createElement('div');
    item.style.cssText = 'padding:12px 14px;border-bottom:1px solid #f3f4f6;opacity:.6';
    const nome = document.createElement('div');
    nome.style.cssText = 'font-size:13px;font-weight:600;color:#111827';
    nome.textContent = c.contato_nome || c.contato_telefone;
    const statusBadge = afInboxBadgeStatus(c.statusContato);
    if (statusBadge) {
      const badge = document.createElement('span');
      badge.style.cssText = 'font-size:10px;font-weight:700;margin-left:6px;color:' + statusBadge.cor;
      badge.textContent = statusBadge.texto;
      nome.appendChild(badge);
    }
    const preview = document.createElement('div');
    preview.style.cssText = 'font-size:11.5px;color:#b45309;margin-top:2px';
    preview.textContent = statusBadge ? '' : '⏳ Aguardando resposta';
    item.appendChild(nome);
    if (!statusBadge) item.appendChild(preview);
    lista.appendChild(item);
  });
  vaziaMsg.style.display = (!conversasF.length && !aguardandoF.length) ? 'block' : 'none';
}
function _afInboxMontarBolha(m){
  const minha = m.direcao === 'saida';
  let corpo;
  if (m.tipo === 'audio' && m.midia_url) {
    corpo = '<audio controls preload="none" src="' + m.midia_url + '" style="max-width:220px"></audio>';
  } else if ((m.tipo === 'image' || m.tipo === 'sticker') && m.midia_url) {
    corpo = '<img src="' + m.midia_url + '" style="max-width:200px;border-radius:8px;display:block">';
  } else if (m.tipo === 'video' && m.midia_url) {
    corpo = '<video controls preload="metadata" src="' + m.midia_url + '" style="max-width:200px;border-radius:8px;display:block"></video>';
  } else if (m.tipo === 'botao') {
    corpo = '<span style="opacity:.8;font-size:11px">🔘 clicou:</span><br>' + _afLinkify(_afEscHtml(m.texto || ''));
  } else {
    corpo = _afLinkify(_afEscHtml(m.texto || ''));
  }
  const bolha = document.createElement('div');
  bolha.setAttribute('data-id', m.id);
  bolha.style.cssText = 'max-width:75%;padding:8px 12px;border-radius:12px;font-size:13px;line-height:1.4;' + (minha ? 'align-self:flex-end;background:#111827;color:#fff' : 'align-self:flex-start;background:#f3f4f6;color:#111827');
  bolha.innerHTML = corpo + '<div style="font-size:10px;opacity:.65;margin-top:4px">' + (m.criado_em ? new Date(m.criado_em).toLocaleString('pt-BR') : '') + '</div>';
  return bolha;
}
function _afInboxPararPoll(){
  if (_afInboxPollTimer) { clearInterval(_afInboxPollTimer); _afInboxPollTimer = null; }
}
async function _afInboxChecarNovas(){
  if (!_afInboxTelefoneAtivo) return;
  try {
    const r = await fetch('/api/afiliados/inbox/' + encodeURIComponent(_afInboxTelefoneAtivo) + '/novas?apos=' + encodeURIComponent(_afInboxUltimaData || new Date(0).toISOString()));
    const novas = await r.json();
    if (!novas || !novas.length) return;
    const thread = document.getElementById('af-inbox-thread');
    const pertoDoFim = thread.scrollTop + thread.clientHeight >= thread.scrollHeight - 60;
    let temEntrada = false;
    novas.forEach(function(m){
      if (!thread.querySelector('[data-id="' + m.id + '"]')) thread.appendChild(_afInboxMontarBolha(m));
      _afInboxUltimaData = m.criado_em;
      if (m.direcao === 'entrada') temEntrada = true;
    });
    if (pertoDoFim) thread.scrollTop = thread.scrollHeight;
    if (temEntrada) {
      document.getElementById('af-inbox-reply-box').style.display = 'block';
      document.getElementById('af-inbox-reply-bloqueado').style.display = 'none';
    }
  } catch(e) {}
}
function _afInboxRenderRapidas(){
  const wrap = document.getElementById('af-inbox-rapidas');
  wrap.innerHTML = '';
  AF_INBOX_RESPOSTAS_RAPIDAS.forEach(function(texto){
    const chip = document.createElement('button');
    chip.type = 'button';
    chip.textContent = texto.length > 32 ? texto.slice(0, 32) + '…' : texto;
    chip.title = texto;
    chip.style.cssText = 'background:#f3f4f6;border:1px solid #e5e7eb;color:#374151;font-size:11.5px;padding:5px 10px;border-radius:14px;cursor:pointer';
    chip.onclick = function(){ afInboxResponder(texto); };
    wrap.appendChild(chip);
  });
}
async function afInboxAbrirConversa(telefone, nomeContato){
  _afInboxTelefoneAtivo = telefone;
  _afInboxNomeAtivo = nomeContato || telefone;
  _afInboxUltimaData = null;
  _afInboxPararPoll();
  const titulo = document.getElementById('af-inbox-thread-titulo');
  const acoes = document.getElementById('af-inbox-thread-acoes');
  const thread = document.getElementById('af-inbox-thread');
  const replyBox = document.getElementById('af-inbox-reply-box');
  const replyBloqueado = document.getElementById('af-inbox-reply-bloqueado');
  titulo.textContent = _afInboxNomeAtivo + (nomeContato ? ' · ' + telefone : '');
  acoes.style.display = 'flex';
  thread.innerHTML = '<p style="color:#9ca3af;font-size:12px">Carregando...</p>';
  _afInboxRenderRapidas();
  try {
    const r = await fetch('/api/afiliados/inbox/' + encodeURIComponent(telefone) + '/mensagens');
    const d = await r.json();
    const mensagens = (d && d.mensagens) || [];
    thread.innerHTML = '';
    mensagens.forEach(function(m){
      thread.appendChild(_afInboxMontarBolha(m));
      _afInboxUltimaData = m.criado_em;
    });
    thread.scrollTop = thread.scrollHeight;
    // Janela de 24h (regra da Meta): não basta "ela já respondeu alguma
    // vez" — se a ÚLTIMA mensagem dela foi há mais de 24h, texto/áudio
    // livre não funciona mais (só reabre se ela escrever de novo, ou com
    // template novo — que conta como conversa nova, com cobrança de novo).
    const recebidas = mensagens.filter(function(m){ return m.direcao === 'entrada'; });
    const ultimaRecebida = recebidas[recebidas.length - 1];
    const _horasDesdeUltima = ultimaRecebida ? (Date.now() - new Date(ultimaRecebida.criado_em).getTime()) / 3600000 : Infinity;
    const janelaAberta = ultimaRecebida && _horasDesdeUltima < 24;
    replyBox.style.display = janelaAberta ? 'block' : 'none';
    replyBloqueado.style.display = janelaAberta ? 'none' : 'block';
    replyBloqueado.textContent = !ultimaRecebida
      ? '⏳ Aguardando essa pessoa responder — sem isso não dá pra mandar texto livre (regra do WhatsApp oficial).'
      : '🔒 A janela de 24h desde a última mensagem dela fechou — só reabre se ela escrever de novo, ou com um template novo (conta como conversa nova, com cobrança de novo).';
    // Fica de olho em mensagem nova enquanto essa conversa está aberta (sem
    // precisar recarregar a página) — mesmo padrão do inbox admin.
    _afInboxPollTimer = setInterval(_afInboxChecarNovas, 5000);
  } catch(e) {
    thread.innerHTML = '<p style="color:#dc2626;font-size:12px">Erro ao carregar mensagens.</p>';
  }
}
// Servidor detectou que a janela de 24h fechou no meio do caminho (ex: você
// abriu a conversa a tempo, mas demorou pra digitar) — em vez de só um
// alert genérico, já esconde a caixa de resposta e mostra o aviso certo.
function _afInboxTratarJanelaFechada(d){
  if (!d || !d.janelaFechada) return false;
  document.getElementById('af-inbox-reply-box').style.display = 'none';
  const bloqueado = document.getElementById('af-inbox-reply-bloqueado');
  bloqueado.textContent = '🔒 ' + d.erro;
  bloqueado.style.display = 'block';
  return true;
}
async function afInboxResponder(textoFixo){
  const input = document.getElementById('af-inbox-reply-texto');
  const texto = (typeof textoFixo === 'string' ? textoFixo : input.value).trim();
  if (!texto || !_afInboxTelefoneAtivo) return;
  input.disabled = true;
  try {
    const r = await fetch('/api/afiliados/inbox/' + encodeURIComponent(_afInboxTelefoneAtivo) + '/responder', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ texto }) });
    const d = await r.json();
    if (d && d.ok) {
      input.value = '';
      const thread = document.getElementById('af-inbox-thread');
      thread.appendChild(_afInboxMontarBolha({ id: 'local-' + Date.now(), direcao: 'saida', tipo: 'texto', texto, criado_em: new Date().toISOString() }));
      thread.scrollTop = thread.scrollHeight;
    } else if (!_afInboxTratarJanelaFechada(d)) {
      alert((d && d.erro) || 'Erro ao enviar.');
    }
  } catch(e) {
    alert('Erro ao enviar.');
  } finally {
    input.disabled = false;
  }
}
async function afInboxEnviarBlobAudio(blob, nomeArquivo){
  if (!_afInboxTelefoneAtivo) return;
  const status = document.getElementById('af-inbox-status-audio');
  status.textContent = 'Enviando áudio...';
  try {
    const fd = new FormData();
    fd.append('audio', blob, nomeArquivo || 'audio.webm');
    const r = await fetch('/api/afiliados/inbox/' + encodeURIComponent(_afInboxTelefoneAtivo) + '/responder-audio', { method:'POST', body: fd });
    const d = await r.json();
    status.textContent = '';
    if (d && d.ok) { _afInboxChecarNovas(); } else if (!_afInboxTratarJanelaFechada(d)) { alert((d && d.erro) || 'Erro ao enviar áudio'); }
  } catch(e) {
    status.textContent = '';
    alert('Erro ao enviar áudio');
  }
}
function afInboxEnviarArquivoAudio(file){
  if (!file) return;
  afInboxEnviarBlobAudio(file, file.name);
}
let _afInboxGravador = null, _afInboxChunks = [];
async function afInboxAlternarGravacao(){
  const btn = document.getElementById('af-inbox-btn-gravar');
  if (_afInboxGravador && _afInboxGravador.state === 'recording') { _afInboxGravador.stop(); return; }
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    const mime = MediaRecorder.isTypeSupported('audio/ogg;codecs=opus') ? 'audio/ogg;codecs=opus'
      : MediaRecorder.isTypeSupported('audio/webm;codecs=opus') ? 'audio/webm;codecs=opus' : '';
    _afInboxGravador = mime ? new MediaRecorder(stream, { mimeType: mime }) : new MediaRecorder(stream);
    _afInboxChunks = [];
    _afInboxGravador.ondataavailable = function(e){ if (e.data.size > 0) _afInboxChunks.push(e.data); };
    _afInboxGravador.onstop = function(){
      stream.getTracks().forEach(function(t){ t.stop(); });
      btn.textContent = '🎤'; btn.style.background = '#fff'; btn.style.color = '#374151';
      const blob = new Blob(_afInboxChunks, { type: _afInboxGravador.mimeType || 'audio/webm' });
      if (blob.size > 500) afInboxEnviarBlobAudio(blob, 'gravacao.' + (blob.type.includes('ogg') ? 'ogg' : 'webm'));
    };
    _afInboxGravador.start();
    btn.textContent = '⏹'; btn.style.background = '#FF385C'; btn.style.color = '#fff';
  } catch(e) {
    alert('Não consegui acessar o microfone: ' + e.message);
  }
}
async function afInboxBloquear(){
  if (!_afInboxTelefoneAtivo) return;
  if (!confirm('Bloquear ' + _afInboxNomeAtivo + '? Ele não vai mais receber disparo nenhum da plataforma (mas a conversa continua aqui).')) return;
  try {
    const r = await fetch('/api/afiliados/inbox/' + encodeURIComponent(_afInboxTelefoneAtivo) + '/bloquear', { method:'POST' });
    const d = await r.json();
    if (d && d.ok) { afInboxCarregar(); } else { alert((d && d.erro) || 'Erro ao bloquear.'); }
  } catch(e) { alert('Erro ao bloquear.'); }
}
async function afInboxExcluir(){
  if (!_afInboxTelefoneAtivo) return;
  if (!confirm('Excluir ' + _afInboxNomeAtivo + ' da sua inbox? Some da lista (o histórico de mensagens continua salvo no sistema).')) return;
  try {
    const r = await fetch('/api/afiliados/inbox/' + encodeURIComponent(_afInboxTelefoneAtivo) + '/excluir', { method:'POST' });
    const d = await r.json();
    if (d && d.ok) {
      _afInboxPararPoll();
      _afInboxTelefoneAtivo = null;
      document.getElementById('af-inbox-thread-titulo').textContent = 'Selecione uma conversa';
      document.getElementById('af-inbox-thread-acoes').style.display = 'none';
      document.getElementById('af-inbox-thread').innerHTML = '';
      document.getElementById('af-inbox-reply-box').style.display = 'none';
      document.getElementById('af-inbox-reply-bloqueado').style.display = 'none';
      afInboxCarregar();
    } else { alert((d && d.erro) || 'Erro ao excluir.'); }
  } catch(e) { alert('Erro ao excluir.'); }
}
async function afResgatar(){
  const ids = Array.from(document.querySelectorAll('.af-check-linha:checked')).map(function(c){ return c.value; });
  const status = document.getElementById('af-resgate-status');
  if (!ids.length) { status.textContent = 'Selecione ao menos uma comissão'; return; }
  const modo = document.querySelector('input[name="af-modo"]:checked').value;
  status.textContent = 'Enviando...';
  try{
    const r = await fetch('/app/afiliados/resgate', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ ids, modo }) });
    const j = await r.json();
    if (j.ok) { status.textContent = 'Ok! ' + j.totalCoins + ' coins ' + (modo==='credito' ? 'creditados na sua conta.' : 'em processo de saque.'); setTimeout(function(){ location.reload(); }, 1500); }
    else status.textContent = 'Erro: ' + (j.erro||'tente novamente');
  }catch(e){ status.textContent = 'Erro de conexão'; }
}
</script>

