<%
  // ── cálculos do painel ──────────────────────────────────────
  const _agora = new Date();
  const _hoje = _agora.toISOString().split('T')[0];
  const _inicioSemana = new Date(_agora); _inicioSemana.setDate(_agora.getDate() - _agora.getDay());
  const _inicioMes = new Date(_agora.getFullYear(), _agora.getMonth(), 1);

  const _debitos = (historicoCompleto || historico || []).filter(t => t.quantidade < 0);
  const _recargas = (historicoCompleto || historico || []).filter(t => t.quantidade > 0);

  const _somaHoje    = _debitos.filter(t => t.data.startsWith(_hoje)).reduce((s,t) => s + Math.abs(t.quantidade), 0);
  const _somaSemana  = _debitos.filter(t => new Date(t.data) >= _inicioSemana).reduce((s,t) => s + Math.abs(t.quantidade), 0);
  const _somaMes     = _debitos.filter(t => new Date(t.data) >= _inicioMes).reduce((s,t) => s + Math.abs(t.quantidade), 0);

  const _categorias = {
    'Leads':    ['importar_lead','nova_lead','match_encontrado','ia_qualifica_lead','lead_ativo_dia'],
    'IA':       ['ia_responde_whatsapp','followup_auto','visita_agendada_ia'],
    'WhatsApp': ['vitrine_whatsapp','confirmacao_auto','notificacao_prop'],
    'E-mail':   ['email_lead'],
    'Imóveis':  ['cadastrar_imovel','importar_xml','gerar_xml_portal','sync_xml_24h','imovel_divulgado'],
    'Divulgação': ['postar_instagram'],
  };
  const _gastoCat = {};
  Object.keys(_categorias).forEach(cat => {
    _gastoCat[cat] = _debitos.reduce((s,t) => _categorias[cat].includes(t.motivo) ? s + Math.abs(t.quantidade) : s, 0);
  });
  const _maxCat = Math.max(...Object.values(_gastoCat), 1);
  const _topCat = Object.entries(_gastoCat).sort((a,b) => b[1]-a[1])[0];

  const _topAcao = Object.entries(
    _debitos.reduce((acc,t) => { acc[t.motivo] = (acc[t.motivo]||0) + Math.abs(t.quantidade); return acc; }, {})
  ).sort((a,b) => b[1]-a[1])[0];

  const _labels = {
    cadastrar_imovel: '🏠 Cadastro de imóvel',
    importar_xml: '📥 Importação XML',
    importar_lead: '👤 Importação de lead',
    nova_lead: '👤 Nova lead manual',
    match_encontrado: '🎯 Match encontrado',
    vitrine_whatsapp: '📲 Vitrine enviada',
    followup_auto: '🔄 Follow-up automático',
    confirmacao_auto: '✅ Confirmação automática',
    notificacao_prop: '🔔 Notif. proprietário',
    ia_qualifica_lead: '🤖 IA qualificou lead',
    ia_responde_whatsapp: '🤖 IA respondeu WA',
    gerar_xml_portal: '📤 XML para portal',
    lead_ativo_dia: '📊 Lead ativo (dia)',
    visita_agendada_ia: '📅 Visita agendada IA',
    sync_xml_24h: '🔁 Sync XML 24h',
    imovel_divulgado: '📢 Imóvel divulgado na vitrine',
    email_lead: '✉️ E-mail enviado pro lead',
    postar_instagram: '📸 Publicação no Instagram',
    recarga: '💳 Recarga',
    'recarga manual': '💳 Recarga manual',
    'debito manual': '⚙️ Ajuste manual (suporte)',
  };

  const _corCat = { 'Leads':'#FC642D', 'IA':'#f59e0b', 'WhatsApp':'#22c55e', 'E-mail':'#2563eb', 'Imóveis':'#FF385C', 'Divulgação':'#00A699' };
  let _filtro = 'todos';
%>

