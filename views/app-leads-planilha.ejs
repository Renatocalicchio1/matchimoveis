<%- include('partials/app-shell',{active:'leads-planilha',title:'📊 Planilha de Leads',subtitle:'Todas as leads em formato de tabela — data, dados, perfil de busca, vitrine e imóvel de referência.',user:user}) %>

<style>
.pl-toolbar{display:flex;justify-content:flex-end;margin-bottom:14px}
.pl-filtros{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.pl-filtros select,.pl-filtros input{width:auto;min-width:140px}
.pl-filtros input[type="search"]{flex:1;min-width:200px}
.pl-tablewrap{background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);overflow-x:auto}
/* table-layout:fixed + width:100% força as colunas a espremer pra caber na
   tela mesmo quando não cabe (texto quebrando letra por letra no mobile) —
   min-width garante um tamanho mínimo legível; abaixo dele quem rola é o
   wrapper (overflow-x acima), não o texto de dentro da célula. */
.pl-tablewrap table{width:100%;min-width:880px;border-collapse:collapse;font-size:12px;table-layout:fixed}
.pl-tablewrap th{text-align:left;padding:10px 10px;font-size:10px;font-weight:600;color:var(--text-ter);text-transform:uppercase;letter-spacing:.3px;border-bottom:1px solid var(--border-light);background:var(--bg);position:sticky;top:0;overflow-wrap:break-word}
.pl-tablewrap td{padding:10px 10px;border-bottom:1px solid var(--border-light);color:var(--text);vertical-align:middle;overflow-wrap:break-word;word-break:break-word}
.pl-tablewrap tr:last-child td{border-bottom:none}
.pl-tablewrap tr:hover td{background:var(--bg)}
.pl-tablewrap tr.pl-atendida td{background:#fef2f2}
.pl-col-data{width:8%}
.pl-col-lead{width:15%}
.pl-col-origem{width:10%}
.pl-col-perfil{width:20%}
.pl-col-vitrine{width:16%}
.pl-col-imovel{width:17%}
.pl-col-acoes{width:14%}
.pl-data{color:var(--text-sec);font-variant-numeric:tabular-nums}
.pl-data b{display:block;color:var(--text);font-weight:600;font-size:12px}
.pl-nome{font-weight:600;color:var(--text);text-decoration:none}
.pl-nome:hover{color:var(--brand)}
.pl-tel{color:var(--text-sec);font-size:11px;font-variant-numeric:tabular-nums}
.pl-chip{display:inline-flex;align-items:center;padding:3px 8px;border-radius:20px;font-size:10px;font-weight:500;max-width:100%;overflow-wrap:break-word;background:var(--border-light);color:var(--text-sec)}
.pl-perfil{display:flex;flex-direction:column;gap:2px}
.pl-perfil-tipo{font-weight:500;color:var(--text)}
.pl-perfil-loc{color:var(--text-sec);font-size:11px}
.pl-perfil-meta{color:var(--text-ter);font-size:10.5px;font-variant-numeric:tabular-nums}
.pl-perfil-valor{color:#00847a;font-weight:600;font-variant-numeric:tabular-nums}
.pl-ver{padding:0;font-size:11px;font-weight:600;background:none;color:var(--brand);border:none;cursor:pointer;text-decoration:none;display:inline-block}
.pl-ver:hover{text-decoration:underline}
.pl-excluir{padding:0;font-size:11px;font-weight:600;background:none;color:#dc2626;border:none;cursor:pointer;text-decoration:none;display:block;margin-top:6px}
.pl-excluir:hover{text-decoration:underline}
.pl-acoes{display:flex;flex-direction:column;align-items:flex-start}
.pl-foot{display:flex;justify-content:space-between;align-items:center;margin-top:12px;color:var(--text-ter);font-size:11.5px}
.pct-badge{padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap;display:inline-block}
.pct-low{background:#fef2f2;color:#dc2626}
.pct-mid{background:#fffbeb;color:#92400e}
.pct-high{background:#f0fdf4;color:#16a34a}
@media(max-width:700px){ .pl-filtros input,.pl-filtros select{min-width:0;flex:1} }
</style>

<div class="pl-toolbar">
  <a href="/app/leads/planilha/exportar-excel<%= filtrosQS ? ('?'+filtrosQS) : '' %>" class="btn btn-outline btn-sm">⬇ Exportar Excel</a>
</div>

<form method="GET" action="/app/leads/planilha" class="pl-filtros">
  <input type="search" name="busca" placeholder="Buscar por nome, telefone ou bairro..." value="<%= filtros.busca %>">
  <select name="origem" onchange="this.form.submit()">
    <option value="">Todos os canais</option>
    <% canaisDisponiveis.forEach(function(c){ %>
      <option value="<%= c %>" <%= filtros.origem===c?'selected':'' %>><%= c %></option>
    <% }); %>
  </select>
  <select name="status" onchange="this.form.submit()">
    <option value="">Todos os status</option>
    <option value="novo" <%= filtros.status==='novo'?'selected':'' %>>Novo</option>
    <option value="qualificando" <%= filtros.status==='qualificando'?'selected':'' %>>Qualificando</option>
    <option value="captacao" <%= filtros.status==='captacao'?'selected':'' %>>Captação</option>
  </select>
  <input type="date" name="de" value="<%= filtros.de %>" title="De">
  <input type="date" name="ate" value="<%= filtros.ate %>" title="Até">
  <button type="submit" class="btn btn-dark btn-sm">Filtrar</button>
  <% if(filtros.origem||filtros.status||filtros.busca||filtros.de||filtros.ate){ %>
    <a href="/app/leads/planilha" class="btn btn-outline btn-sm">Limpar</a>
  <% } %>
</form>

<div class="pl-tablewrap">
  <table>
    <thead>
      <tr>
        <th class="pl-col-data">Data</th>
        <th class="pl-col-lead">Lead</th>
        <th class="pl-col-origem">Origem</th>
        <th class="pl-col-perfil">Perfil do imóvel</th>
        <th class="pl-col-vitrine">Vitrine</th>
        <th class="pl-col-imovel">Imóvel de referência</th>
        <th class="pl-col-acoes"></th>
      </tr>
    </thead>
    <tbody>
      <% if(!leads.length){ %>
        <tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text-ter)">Nenhuma lead encontrada com esses filtros.</td></tr>
      <% } %>
      <% leads.forEach(function(l){ %>
        <% const p = l.perfilIA || {}; %>
        <% const d = new Date(l.criadoEm || l.data_cadastro || Date.now()); %>
        <% const transacaoLabel = p.intencao==='comprar'?'Comprar':p.intencao==='alugar'?'Alugar':p.intencao||''; %>
        <% const _matPl = (l.matchesAuto||l.matches||[]).length; %>
        <% const _vitrineLinkPl = _matPl>0 ? (l.vitrineLink || ('/cliente/oferta/'+(l.leadId||l.id)+'?userId='+encodeURIComponent(l.userId||l.usuarioId||l.corretorId||''))) : ''; %>
        <tr class="<%= l.emAtendimento?'pl-atendida':'' %>" title="<%= l.emAtendimento?'Lead em atendimento (já viu detalhes)':'Clique em ver detalhes' %>">
          <td class="pl-data"><b><%= d.toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo'}) %></b><%= d.toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'}) %></td>
          <td>
            <a href="/app/lead/<%= l.id %>" class="pl-nome"><%= l.nome || 'Sem nome' %></a><br>
            <span class="pl-tel"><%= l.telefone || l.whatsapp || l.contato || '-' %></span>
          </td>
          <td><span class="pl-chip"><%= l.origem || l.origemEntrada || '-' %></span></td>
          <td class="pl-perfil">
            <% if(p.tipo || transacaoLabel){ %>
              <span class="pl-perfil-tipo"><%= [p.tipo, transacaoLabel].filter(Boolean).join(' · ') %></span>
            <% } %>
            <% if(p.bairro || p.cidade){ %>
              <span class="pl-perfil-loc"><%= [p.bairro, [p.cidade,p.estado].filter(Boolean).join('/')].filter(Boolean).join(', ') %></span>
            <% } %>
            <% if(p.quartos || p.valorMax){ %>
              <span class="pl-perfil-meta"><%= p.quartos ? (p.quartos+' qtos') : '' %><%= (p.quartos && p.valorMax) ? ' · ' : '' %><% if(p.valorMax){ %><span class="pl-perfil-valor">R$ <%= Number(p.valorMax).toLocaleString('pt-BR') %></span><% } %></span>
            <% } %>
            <% if(!p.tipo && !p.bairro && !p.valorMax){ %><span style="color:var(--text-ter)">Perfil incompleto</span><% } %>
          </td>
          <td>
            <% if(_vitrineLinkPl){ %><a href="<%= _vitrineLinkPl %>" target="_blank" class="pl-ver">Ver vitrine</a>
              <% const _telDigitsPl = (l.telefone||l.whatsapp||l.contato||'').replace(/\D/g,''); %>
              <% const _telPl = _telDigitsPl ? '55'+_telDigitsPl.replace(/^55/,'') : ''; %>
              <% if(_telPl){ %>
                <% const _linkVitrinePl = _vitrineLinkPl.startsWith('http') ? _vitrineLinkPl : ('https://www.matchimoveis.ia.br'+_vitrineLinkPl); %>
                <% const _msgVitrinePl = encodeURIComponent('Olá ' + (l.nome||'') + '! Segue sua seleção personalizada de imóveis: ' + _linkVitrinePl); %>
                <br><a href="https://wa.me/<%= _telPl %>?text=<%= _msgVitrinePl %>" target="_blank" class="pl-ver" style="color:#25D366">🏠 Enviar vitrine manual</a>
              <% } %>
            <% } else { %><span style="color:var(--text-ter)">—</span><% } %>
          </td>
          <td>
            <% function pctClassePl(p){ return p>=67 ? 'pct-high' : p>=34 ? 'pct-mid' : 'pct-low'; } %>
            <% if(l.idAnuncio){ %><a href="/app/imovel/<%= l.idAnuncio %>" target="_blank" class="pl-ver">Ver detalhes do imóvel</a>
            <% } else if(l.imovelParcial){ %>
              <span class="pct-badge <%= pctClassePl(l.imovelParcial.percentual) %>"><%= l.imovelParcial.percentual %>%</span>
              <a href="/app/imovel/<%= l.imovelParcial.id_interno||l.imovelParcial.id %>/editar" target="_blank" class="pl-ver" style="margin-left:6px">✏️ Editar para completar</a>
            <% } else if((l.origem||l.origemEntrada)==='captacao_link'){ %><a href="/app/cadastro" class="pl-ver">+ Cadastrar imóvel</a>
            <% } else { %><span style="color:var(--text-ter)">—</span><% } %>
          </td>
          <td class="pl-acoes">
            <a href="/app/lead/<%= l.id %>" class="pl-ver">Ver detalhes</a><button type="button" class="pl-excluir" onclick="plExcluirLead('<%= l.id %>')">Excluir</button>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="pl-foot">
  <span>Mostrando <%= leads.length %> lead<%= leads.length===1?'':'s' %></span>
</div>

<script>
async function plExcluirLead(id){
  if(!confirm('Excluir esta lead? Essa ação não pode ser desfeita.')) return;
  try{
    const r = await fetch('/app/lead/'+id, { method:'DELETE' });
    const d = await r.json();
    if(d.ok) location.reload();
    else alert('Erro: '+(d.erro||'não foi possível excluir'));
  }catch(e){ alert('Erro ao excluir a lead.'); }
}
</script>

<%- include('partials/app-end') %>
