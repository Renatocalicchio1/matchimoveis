            <div class="mc-field" style="<%= c.objetivo==='lead_form' ? '' : 'margin-bottom:0' %>">
              <div class="mc-campo-label"><span class="mc-selo mc-selo-3">3</span><label class="mc-label" style="margin-bottom:0">Título secundário</label></div>
              <input type="text" class="mc-input" id="mc-editar-secundario-<%= c.id %>" maxlength="30" value="<%= c.tituloSecundario %>" style="margin-top:6px" oninput="atualizarContador('mc-editar-secundario-<%= c.id %>','mc-editar-secundario-count-<%= c.id %>');atualizarPreviewEdicao(<%= c.id %>)">
              <div class="mc-char-count" id="mc-editar-secundario-count-<%= c.id %>"><%= (c.tituloSecundario||'').length %>/30</div>
              <button type="button" class="mc-btn-ia" onclick="gerarTextoIAEdicao(<%= c.id %>,'secundario', this)">🤖 Gerar com IA</button>
            </div>
            <% if(c.objetivo === 'lead_form'){ %>
