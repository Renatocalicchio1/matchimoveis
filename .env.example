PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Disparos WhatsApp (/admin/disparos) — WhatsApp Cloud API oficial da Meta
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=

# Domínio próprio por usuário (/app/meu-site) — Cloudflare for SaaS (Custom Hostnames)
# Requer: zona matchimoveis.ia.br sob proxy Cloudflare + produto "Cloudflare for SaaS"
# habilitado na zona + um "Fallback Origin" cadastrado (hostname fixo nosso que os
# clientes vão apontar via CNAME, ex: sites.matchimoveis.ia.br -> serviço no Render).
# Isso é configuração manual única no painel Cloudflare, não por usuário.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_FALLBACK_ORIGIN=
