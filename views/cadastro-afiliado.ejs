<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Seja afiliado · MatchImóveis</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{--rosa:#FF385C;--dark:#0f0f0f;--muted:#6b7280;--light:#f5f5f4;--border:#e8e8e6}
  body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;background:var(--light);color:var(--dark);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
  .box{background:#fff;border:1px solid var(--border);border-radius:14px;padding:32px;max-width:400px;width:100%;box-shadow:0 4px 24px rgba(0,0,0,.06)}
  .logo{font-size:16px;font-weight:700;margin-bottom:4px}
  .logo span{color:var(--rosa)}
  h1{font-size:19px;font-weight:800;margin:14px 0 6px;line-height:1.3}
  .sub{font-size:13px;color:var(--muted);margin-bottom:20px;line-height:1.5}
  .m-field{margin-bottom:12px}
  .m-field label{display:block;font-size:11px;font-weight:500;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px}
  .m-field input,.m-field select{width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:7px;font-size:13.5px;color:var(--dark);outline:none;background:#fff}
  .m-field input:focus,.m-field select:focus{border-color:var(--dark)}
  .m-btn{width:100%;background:var(--rosa);color:#fff;padding:11px;border:none;border-radius:7px;font-size:13.5px;font-weight:600;cursor:pointer;margin-top:6px}
  .m-note{font-size:11px;color:var(--muted);text-align:center;margin-top:12px}
  .voltar{display:block;text-align:center;font-size:12px;color:var(--muted);text-decoration:none;margin-top:16px}
  .erro{background:#fef2f2;border:1px solid #fca5a5;color:#b91c1c;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:14px}
</style>
</head>
<body>
  <div class="box">
    <div class="logo">Match<span>Imóveis</span></div>
    <h1>💰 Programa de afiliados</h1>
    <p class="sub">Não precisa ser corretor pra ganhar aqui. Cadastre-se e ganhe comissão recorrente indicando corretores e imobiliárias pra plataforma.</p>
    <% if (typeof erro !== 'undefined' && erro) { %>
      <div class="erro"><%= erro %></div>
    <% } %>
    <!--
      Posta direto em /login (mesma rota de cadastro de todo mundo,
      services/salvarUsuario.js/bcrypt/etc — ver bloco "CADASTRO" em
      server.js) — só com menos campos e a flag afiliadoRestrito=1, que faz
      o menu (app-shell.ejs, _menuRestrito) mostrar só Afiliados+Perfil.
    -->
    <form method="POST" action="/login" onsubmit="this.querySelector('button[type=submit]').disabled=true;this.querySelector('button[type=submit]').textContent='Criando conta...'">
      <input type="hidden" name="afiliadoRestrito" value="1">
      <div class="m-field"><label>Nome completo</label><input name="nome" placeholder="Seu nome" required></div>
      <div class="m-field"><label>E-mail</label><input name="email" type="email" placeholder="seu@email.com" required></div>
      <div class="m-field"><label>Celular</label><input name="telefone" placeholder="47999999999" required></div>
      <div class="m-field">
        <label>Você é</label>
        <select name="tipoConta">
          <option value="afiliado">Afiliado</option>
          <option value="agencia_marketing">Agência de Marketing</option>
        </select>
      </div>
      <div class="m-field"><label>Senha</label><input name="senha" type="password" placeholder="Mínimo 4 caracteres" required minlength="4"></div>
      <button type="submit" class="m-btn">Criar conta de afiliado →</button>
      <p class="m-note">Grátis — sem mensalidade</p>
    </form>
    <a class="voltar" href="/">← Voltar</a>
  </div>
</body>
</html>
