<%- include("partials/app-shell",{active:"coins",user:user,title:"Créditos"}) %>

<%
  const saldo = user.matchCoins || 0;
  const total = Math.max(user.matchCoinsTotal || 200, saldo, 1);
  const pct   = Math.min(100, Math.round((saldo / total) * 100));
  const cor   = pct > 40 ? '#22c55e' : pct > 15 ? '#f59e0b' : '#ef4444';
  const msg   = pct > 40 ? null : pct > 15 ? 'Seus créditos estão acabando. Considere recarregar.' : saldo === 0 ? 'Sua conta está pausada. Adicione créditos para continuar.' : 'Créditos baixos. Recarregue para não pausar sua conta.';
%>

<script src="https://sdk.mercadopago.com/js/v2"></script>

<!-- MODAL PAGAMENTO -->
<div id="mpModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:3000;align-items:center;justify-content:center;padding:20px">
  <div style="background:#fff;border-radius:16px;padding:24px;width:100%;max-width:480px;max-height:90vh;overflow-y:auto;position:relative">
    <button onclick="fecharMP()" style="position:absolute;top:12px;right:12px;background:none;border:none;font-size:22px;cursor:pointer;color:#888">✕</button>
    <h3 style="font-size:16px;font-weight:700;margin-bottom:16px">Adicionar créditos</h3>
    <div id="mpBrick"></div>
  </div>
</div>

<!-- ADICIONAR CRÉDITOS -->
<div class="card" style="margin-bottom:16px">
  <h2 style="font-size:15px;font-weight:700;margin-bottom:4px">Adicionar créditos</h2>
  <p style="color:#888;font-size:13px;margin-bottom:20px">Mínimo R$50 · R$1 = 50 créditos</p>
  <div style="margin-bottom:16px">
    <div style="display:flex;align-items:center;gap:12px">
      <div style="position:relative;flex:1">
        <input type="number" id="valorInput" min="50" step="1" placeholder="50" oninput="atualizarPreview(this.value)" style="width:100%;padding:14px 16px;border:2px solid #e5e7eb;border-radius:10px;font-size:20px;font-weight:700;outline:none">
      </div>
      <div style="text-align:right;min-width:110px">
        <div style="font-size:11px;color:#888">você recebe</div>
        <div id="creditosPreview" style="font-size:22px;font-weight:800;color:#111">0 créditos</div>
      </div>
    </div>
  </div>
  <button id="btnPagar" onclick="iniciarCompra()" style="width:100%;background:#FF385C;color:#fff;border:none;padding:16px;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer">
    Adicionar créditos
  </button>
</div>

<!-- SALDO -->
<div class="card" style="margin-bottom:16px;text-align:center;padding:32px 24px">
  <div style="font-size:12px;color:#888;margin-bottom:6px;text-transform:uppercase;letter-spacing:.08em">Seus créditos</div>
  <div style="font-size:52px;font-weight:800;color:#111;margin-bottom:4px"><%= saldo %></div>
  <div style="font-size:13px;color:#888;margin-bottom:20px">créditos disponíveis</div>

  <div style="background:#f3f4f6;border-radius:99px;height:12px;overflow:hidden;margin-bottom:8px">
    <div style="height:100%;width:<%= pct %>%;background:<%= cor %>;border-radius:99px;transition:width .6s"></div>
  </div>

  <% if(msg) { %>
    <div style="font-size:13px;color:<%= cor %>;font-weight:600;margin-top:10px"><%= msg %></div>
  <% } %>
</div>

<!-- ONDE OS CRÉDITOS SÃO USADOS -->
<div class="card" style="margin-bottom:16px">
  <h2 style="font-size:15px;font-weight:700;margin-bottom:4px">Como seus créditos são usados</h2>
  <p style="color:#888;font-size:13px;margin-bottom:20px">Toda atividade da plataforma consome créditos automaticamente.</p>

  <div style="display:flex;flex-direction:column;gap:12px">
    <div style="display:flex;align-items:center;gap:14px;padding:12px;background:#f9fafb;border-radius:12px">
      <div style="font-size:22px">🏠</div>
      <div>
        <div style="font-size:14px;font-weight:600;color:#111">Imóveis</div>
        <div style="font-size:12px;color:#888">Cadastro, edição, geração de XML e envio para portais</div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:14px;padding:12px;background:#f9fafb;border-radius:12px">
      <div style="font-size:22px">👤</div>
      <div>
        <div style="font-size:14px;font-weight:600;color:#111">Leads</div>
        <div style="font-size:12px;color:#888">Leads ativos, qualificação automática e matches encontrados</div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:14px;padding:12px;background:#f9fafb;border-radius:12px">
      <div style="font-size:22px">🤖</div>
      <div>
        <div style="font-size:14px;font-weight:600;color:#111">Inteligência Artificial</div>
        <div style="font-size:12px;color:#888">Respostas automáticas, follow-ups e sugestões pelo WhatsApp</div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:14px;padding:12px;background:#f9fafb;border-radius:12px">
      <div style="font-size:22px">📅</div>
      <div>
        <div style="font-size:14px;font-weight:600;color:#111">Visitas</div>
        <div style="font-size:12px;color:#888">Agendamento, confirmações automáticas e notificações</div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:14px;padding:12px;background:#f9fafb;border-radius:12px">
      <div style="font-size:22px">📲</div>
      <div>
        <div style="font-size:14px;font-weight:600;color:#111">WhatsApp</div>
        <div style="font-size:12px;color:#888">Mensagens enviadas, vitrines e confirmações via WhatsApp</div>
      </div>
    </div>
  </div>
</div>


<!-- HISTÓRICO DE CONSUMO -->
<div class="card" style="margin-bottom:16px">
  <h2 style="font-size:15px;font-weight:700;margin-bottom:4px">Histórico de uso</h2>
  <p style="color:#888;font-size:13px;margin-bottom:16px">Últimas 50 movimentações da sua conta.</p>

  <% if (!historico || historico.length === 0) { %>
    <div style="text-align:center;padding:32px;color:#aaa;font-size:14px">Nenhuma movimentação ainda.</div>
  <% } else { %>
    <div style="display:flex;flex-direction:column;gap:8px">
      <% historico.forEach(function(t){ %>
        <%
          const _eh_credito = t.quantidade > 0;
          const _valor = Math.abs(t.quantidade);
          const _cor = _eh_credito ? '#22c55e' : '#ef4444';
          const _sinal = _eh_credito ? '+' : '-';
          const _data = new Date(t.data).toLocaleString('pt-BR', {timeZone:'America/Sao_Paulo', day:'2-digit', month:'2-digit', year:'2-digit', hour:'2-digit', minute:'2-digit'});
          const _labels = {
            cadastrar_imovel: '🏠 Cadastro de imóvel',
            importar_xml: '📥 Importação XML',
            importar_lead: '👤 Importação de lead',
            nova_lead: '👤 Nova lead manual',
            match_encontrado: '🎯 Match encontrado',
            vitrine_whatsapp: '📲 Vitrine enviada',
            followup_auto: '🔄 Follow-up automático',
            confirmacao_auto: '✅ Confirmação automática',
            notificacao_prop: '🔔 Notificação proprietário',
            ia_qualifica_lead: '🤖 IA qualificou lead',
            ia_responde_whatsapp: '🤖 IA respondeu WhatsApp',
            gerar_xml_portal: '📤 XML para portal',
            lead_ativo_dia: '📊 Lead ativo (dia)',
            visita_agendada_ia: '📅 Visita agendada pela IA',
            sync_xml_24h: '🔁 Sync XML 24h',
            recarga: '💳 Recarga',
            'recarga manual': '💳 Recarga manual',
          };
          const _label = _labels[t.motivo] || t.motivo;
        %>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:#f9fafb;border-radius:10px">
          <div style="flex:1;min-width:0">
            <div style="font-size:13px;font-weight:600;color:#111;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= _label %></div>
            <div style="font-size:11px;color:#aaa;margin-top:2px"><%= _data %> · saldo: <%= t.saldoApos %></div>
          </div>
          <div style="font-size:15px;font-weight:800;color:<%= _cor %>;margin-left:12px;white-space:nowrap"><%= _sinal %><%= _valor %></div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<script>
let valorSelecionado = 0;
function atualizarPreview(v){
  valorSelecionado = parseFloat(v)||0;
  document.getElementById("creditosPreview").innerText = Math.floor(valorSelecionado*50).toLocaleString("pt-BR")+" créditos";
}
async function iniciarCompra(){
  if(!valorSelecionado || valorSelecionado < 50){ alert("Valor mínimo é R$50."); return; }
  const btn = document.getElementById("btnPagar");
  btn.disabled = true; btn.textContent = "Aguarde...";
  try{
    const r = await fetch("/pagamento/criar",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({valor:valorSelecionado})});
    const d = await r.json();
    if(d.ok && d.url){ window.open(d.url, '_blank'); btn.disabled=false; btn.textContent='Adicionar créditos'; }
    else{ alert(d.erro||"Erro ao criar pagamento"); btn.disabled=false; btn.textContent="Adicionar créditos"; }
  } catch(e){
    alert("Erro de conexão"); btn.disabled=false; btn.textContent="Adicionar créditos";
  }
}
</script>

<%- include('partials/app-end') %>
