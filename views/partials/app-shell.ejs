  <meta name="apple-mobile-web-app-title" content="MatchImóveis">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <script>
    if(false && 'serviceWorker' in navigator){
      navigator.serviceWorker.register('/sw.js').catch(()=>{});
    }
  </script>
</head>
