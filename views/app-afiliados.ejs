<%- include("partials/app-shell",{active:"afiliados",user:user,title:"Afiliados"}) %>

<style>
.af-nivel-badge{display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;padding:4px 12px;border-radius:20px;color:#fff}
.af-nivel-1{background:#FF385C}
.af-nivel-2{background:#00A699}
.af-nivel-3{background:#FC642D}
.af-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px}
@media(max-width:800px){.af-grid{grid-template-columns:1fr}}
.af-stat-num{font-size:26px;font-weight:800;color:#111827}
.af-stat-label{font-size:12px;color:#6b7280;margin-top:2px}
.af-link-box{display:flex;gap:8px;align-items:center;background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;padding:10px 14px;font-size:13px;font-family:monospace;overflow-x:auto}
/* A URL não tem espaço nenhum (é 1 "palavra" só) — sem white-space:nowrap
   aqui, o word-break:break-word global de app-shell.ejs (trava geral de
   overflow de todo /app/*) quebra ela caractere por caractere, 1 por linha,
   e a altura da caixa explode (bug real reportado no mobile, ago/2026). O
   scroll horizontal do próprio .af-link-box (overflow-x:auto acima) já
   resolve telas estreitas — não precisa quebrar linha. */
.af-link-box span{white-space:nowrap;flex-shrink:0}
.af-link-box button, .af-link-box a{flex-shrink:0}
.af-table{width:100%;border-collapse:collapse;font-size:13px}
.af-table th{text-align:left;color:#6b7280;font-weight:600;padding:8px;border-bottom:1px solid #e5e7eb;font-size:12px}
.af-table td{padding:8px;border-bottom:1px solid #f3f4f6}
/* Organograma — padrão clássico de árvore em CSS puro (conectores via borda
   em ::before/::after), estilo genealogia de rede multinível. */
.af-orgchart-wrap{overflow-x:auto;overflow-y:hidden;padding:8px 0}
.af-orgchart, .af-orgchart ul{display:flex;justify-content:safe center;padding-top:13px;position:relative;list-style:none;margin:0}
.af-orgchart{padding-top:0}
.af-orgchart li{display:flex;flex-direction:column;align-items:center;position:relative;padding:13px 3px 0}
.af-orgchart li::before, .af-orgchart li::after{content:'';position:absolute;top:0;right:50%;border-top:2px solid #e5e7eb;width:50%;height:13px}
.af-orgchart li::after{right:auto;left:50%;border-left:2px solid #e5e7eb}
.af-orgchart li:only-child{padding-top:0}
.af-orgchart li:only-child::before, .af-orgchart li:only-child::after{display:none}
.af-orgchart > li{padding-top:0}
.af-orgchart > li::before, .af-orgchart > li::after{display:none}
.af-orgchart li:first-child::before, .af-orgchart li:last-child::after{border:0 none}
.af-orgchart li:last-child::before{border-right:2px solid #e5e7eb;border-radius:0 6px 0 0}
.af-orgchart li:first-child::after{border-radius:6px 0 0 0}
.af-orgchart ul::before{content:'';position:absolute;top:0;left:50%;border-left:2px solid #e5e7eb;width:0;height:13px}
.af-no{border:2px solid;border-radius:7px;padding:3px 5px;background:#fff;min-width:0;width:66px;box-shadow:0 1px 3px rgba(0,0,0,.06);position:relative}
.af-no-badge{display:inline-block;color:#fff;font-size:8px;font-weight:700;padding:1px 5px;border-radius:7px;margin-bottom:1px}
.af-no-nome{font-size:9.5px;font-weight:700;color:#111827;white-space:normal;line-height:1.2;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.af-no-dot{position:absolute;top:-3px;right:-3px;width:9px;height:9px;border-radius:50%;border:1.5px solid #fff;z-index:5}
.af-no-dot-on{background:#16a34a}
.af-no-dot-off{background:#9ca3af}
.af-no-wa-btn{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;background:#25D366;color:#fff;font-size:10px;text-decoration:none;margin-top:3px}
.af-tabs{display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap}
.af-tab-btn{padding:8px 16px;border-radius:10px;border:1px solid #e5e7eb;background:#fff;font-size:13px;font-weight:600;cursor:pointer;color:#374151}
.af-tab-btn.active{background:#111827;color:#fff;border-color:#111827}
.af-tab-pane{display:none}
.af-tab-pane.active{display:block}
.af-contrato-box{max-height:420px;overflow-y:auto;background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;padding:16px;font-size:13px;line-height:1.6;color:#374151}
.af-contrato-box h3{font-size:14px;margin:14px 0 6px}
.af-contrato-box h3:first-child{margin-top:0}

/* Cabeçalho (nível + links de convite) e Inbox — min-width:0 nos filhos de
   flex é obrigatório aqui: sem isso o item nunca encolhe abaixo do próprio
   conteúdo, estourando a largura da tela em mobile (mesmo bug de overflow
   já corrigido em outras telas do app, ago/2026). */
.af-top-card{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
.af-top-card > div{min-width:0}
.af-inbox-corpo{gap:16px;align-items:flex-start;min-width:0}
.af-inbox-list-col{flex:1;min-width:0}
.af-inbox-lista-scroll{max-height:480px;overflow-y:auto;border:1px solid #e5e7eb;border-radius:10px}
.af-inbox-thread-col{flex:2;min-width:0;border:1px solid #e5e7eb;border-radius:10px;display:flex;flex-direction:column;height:520px}
@media(max-width:720px){
  .af-inbox-corpo{flex-direction:column}
  .af-inbox-list-col, .af-inbox-thread-col{width:100%}
  .af-inbox-lista-scroll{max-height:220px}
  .af-inbox-thread-col{height:420px}
}
</style>

<% if (!aceitouContrato) { %>
<div class="card">
  <h2 style="margin:0 0 4px">🤝 Programa de Afiliados MatchImóveis</h2>
  <p style="margin:0 0 16px;color:#6b7280;font-size:13px">Antes de acessar sua área de afiliado, leia e aceite o termo de adesão abaixo.</p>
  <div style="background:#FFF6F0;border:1px solid #FDE0CC;border-radius:10px;padding:14px 16px;margin-bottom:16px;font-size:13px;color:#374151;line-height:1.6">
    💰 <strong>Como funciona, em resumo:</strong> você ganha comissão recorrente toda vez que alguém que você indicou <strong>compra créditos pra usar a plataforma MatchImóveis</strong> — não importa se essa pessoa vendeu ou alugou algum imóvel. A comissão é sobre o uso da plataforma (usuário pagante), <strong>nunca sobre venda de imóvel</strong>.
  </div>
  <div class="af-contrato-box">
    <h3>1. Natureza da relação</h3>
    <p>Ao aderir ao Programa de Afiliados, você passa a atuar como <strong>afiliado/representante comercial autônomo</strong> da MatchImóveis, exclusivamente para fins de indicação e divulgação da plataforma a terceiros. Esta adesão <strong>não cria vínculo empregatício, societário, de parceria, consórcio ou associação</strong> com a MatchImóveis. Você não é sócio, não tem participação no capital, gestão ou resultados da empresa — sua remuneração se limita às comissões previstas neste termo. Não há subordinação, horário, meta obrigatória ou exclusividade impostos pela MatchImóveis.</p>
    <h3>2. Objeto</h3>
    <p>Divulgação da plataforma por meio de link de indicação próprio e material fornecido pela empresa, buscando novos usuários (corretores/imobiliárias).</p>
    <h3>3. Estrutura de níveis e comissionamento</h3>
    <p>Você é enquadrado em um dos níveis do programa (1, 2 ou 3), conforme critérios de volume definidos pela MatchImóveis. A comissão incide sobre o valor pago pelo indicado, conforme tabela de percentuais vigente. A MatchImóveis pode alterar, a qualquer tempo, os percentuais e critérios de nível, mediante comunicação prévia na plataforma.</p>
    <h3>4. Pagamento</h3>
    <p>As comissões ficam disponíveis na sua área de afiliado. Você pode solicitar <strong>saque em dinheiro</strong> (fechamento no dia 25 de cada mês, pagamento em até 3 dias úteis) ou <strong>converter o saldo em créditos</strong> na sua própria conta de corretor/imobiliária. <strong>É vedada a revenda, cessão ou transferência dos créditos/comissões a terceiros ou a outra conta.</strong> Tributos incidentes sobre a comissão são de responsabilidade exclusiva do afiliado.</p>
    <h3>5. Rede de indicados</h3>
    <p>A rede de indicados gerada é um dado operacional da plataforma, não constituindo ativo cedível, vendável ou transferível.</p>
    <h3>6. Uso de marca e conduta</h3>
    <p>Uso da marca/materiais só na forma disponibilizada pela empresa. Indicações fraudulentas autorizam suspensão imediata e cancelamento de comissões pendentes relacionadas.</p>
    <h3>7. Vigência e rescisão</h3>
    <p>Prazo indeterminado, rescindível a qualquer momento por qualquer das partes, sem aviso prévio e sem multa. Encerrada a relação, cessa o direito a comissões futuras, preservadas as já geradas e não pagas até a data.</p>
    <h3>8. Disposições gerais</h3>
    <p>Sem exclusividade em favor do afiliado. Foro da comarca da sede da MatchImóveis.</p>
  </div>
  <label style="display:flex;align-items:center;gap:8px;margin:16px 0;font-size:13px;color:#374151;cursor:pointer">
    <input type="checkbox" id="af-check-li"> Li e concordo com o Termo de Adesão ao Programa de Afiliados
  </label>
  <button id="af-btn-aceitar" disabled style="opacity:.5;background:#111827;color:#fff;border:none;padding:12px 24px;border-radius:10px;font-weight:700;cursor:not-allowed" onclick="afAceitarContrato()">Aceitar e entrar</button>
  <span id="af-aceitar-status" style="margin-left:10px;font-size:13px;color:#6b7280"></span>
</div>
<script>
document.getElementById('af-check-li').addEventListener('change', function(){
  const btn = document.getElementById('af-btn-aceitar');
  btn.disabled = !this.checked;
  btn.style.opacity = this.checked ? '1' : '.5';
  btn.style.cursor = this.checked ? 'pointer' : 'not-allowed';
});
async function afAceitarContrato(){
  const status = document.getElementById('af-aceitar-status');
  status.textContent = 'Salvando...';
  try{
    const r = await fetch('/app/afiliados/aceitar-contrato', { method:'POST' });
    const j = await r.json();
    if(j.ok) location.reload(); else status.textContent = 'Erro: ' + (j.erro||'tente novamente');
  }catch(e){ status.textContent = 'Erro de conexão'; }
}
</script>

<% } else { %>

<div style="background:#FFF6F0;border:1px solid #FDE0CC;border-radius:10px;padding:10px 14px;margin-bottom:16px;font-size:12.5px;color:#7c4a2d;line-height:1.5">
  🎉 <strong><%= dados.bonusIndicacao %> coins na hora</strong> assim que quem você indicou se cadastra — e depois, comissão recorrente toda vez que essa pessoa <strong>compra créditos pra usar a plataforma</strong> (nunca comissão de venda de imóvel).
</div>

<div class="card af-top-card" style="margin-bottom:16px">
  <div>
    <span class="af-nivel-badge af-nivel-<%= nivel %>">Nível <%= nivel %></span>
    <% if (dados.faltaProximoNivel > 0) { %>
      <span style="margin-left:10px;font-size:12px;color:#6b7280">Faltam <strong>R$ <%= dados.faltaProximoNivel.toLocaleString('pt-BR') %></strong> em vendas próprias pra subir de nível</span>
    <% } else if (nivel === 1) { %>
      <span style="margin-left:10px;font-size:12px;color:#6b7280">Nível máximo do programa</span>
    <% } %>
  </div>
  <div>
    <p style="margin:0 0 6px;font-size:13px;font-weight:700;color:#111827">Convide seus amigos corretores</p>
    <div class="af-link-box">
    <span id="af-link"><%= dados.linkIndicacao %></span>
    <button onclick="navigator.clipboard.writeText('<%= dados.linkIndicacao %>');this.textContent='✓ copiado'" style="border:none;background:#111827;color:#fff;padding:6px 12px;border-radius:8px;font-size:12px;cursor:pointer;white-space:nowrap">Copiar link</button>
    <%
      // wa.me SEM número — abre o WhatsApp deixando o próprio usuário
      // escolher o contato da agenda dele, com a legenda já pronta (pedido
      // do Renato, ago/2026). Texto neutro de propósito: não presume que
      // quem vai receber já é corretor, só convida a conhecer a plataforma
      // — o link de cadastro é o mesmo pra qualquer pessoa de qualquer jeito.
      const _afMsgCompartilhar = `Oi! Conheça a MatchImóveis — plataforma que cruza automaticamente leads com os imóveis certos pra corretores e imobiliárias, sem mensalidade. Cadastro é grátis e já vem com créditos de bônus. Ah, e eu ganho ${dados.bonusIndicacao} coins assim que você se cadastrar por esse link, então já ajuda de graça 🙂: ` + dados.linkIndicacao;
    %>
    <a href="https://wa.me/?text=<%= encodeURIComponent(_afMsgCompartilhar) %>" target="_blank" style="display:inline-flex;align-items:center;gap:6px;border:none;background:#25D366;color:#fff;padding:6px 12px;border-radius:8px;font-size:12px;font-weight:600;text-decoration:none;white-space:nowrap">💬 Compartilhar no WhatsApp</a>
    </div>

    <p style="margin:14px 0 6px;font-size:13px;font-weight:700;color:#111827">Ou divulgue a página de vendas (preços e recursos, tom mais direto)</p>
    <div class="af-link-box">
    <span id="af-link-planos"><%= dados.linkPlanos %></span>
    <button onclick="navigator.clipboard.writeText('<%= dados.linkPlanos %>');this.textContent='✓ copiado'" style="border:none;background:#111827;color:#fff;padding:6px 12px;border-radius:8px;font-size:12px;cursor:pointer;white-space:nowrap">Copiar link</button>
    <%
      const _afMsgPlanos = `Oi! Passando o link dos planos da MatchImóveis — a IA responde lead no WhatsApp, faz o match e manda vitrine sozinha, sem mensalidade (você só paga se recarregar). Cadastro é grátis com 1.000 créditos de bônus: ` + dados.linkPlanos;
    %>
    <a href="https://wa.me/?text=<%= encodeURIComponent(_afMsgPlanos) %>" target="_blank" style="display:inline-flex;align-items:center;gap:6px;border:none;background:#25D366;color:#fff;padding:6px 12px;border-radius:8px;font-size:12px;font-weight:600;text-decoration:none;white-space:nowrap">💬 Compartilhar no WhatsApp</a>
    </div>
  </div>
</div>

<div class="af-grid">
  <div class="card"><div class="af-stat-num"><%= dados.disponivelCoins.toLocaleString('pt-BR') %></div><div class="af-stat-label">coins disponíveis pra resgate (R$ <%= dados.disponivelReais %>)</div></div>
  <div class="card"><div class="af-stat-num"><%= dados.indicados.length %></div><div class="af-stat-label">afiliados indicados por você</div></div>
  <div class="card"><div class="af-stat-num">R$ <%= dados.volumeAtual.toLocaleString('pt-BR') %></div><div class="af-stat-label">volume de vendas próprias acumulado</div></div>
</div>

<div class="af-tabs">
  <button class="af-tab-btn active" onclick="afTab('comissoes',this)">💰 Minhas comissões</button>
  <button class="af-tab-btn" onclick="afTab('indicados',this)">👥 Meus afiliados</button>
  <button class="af-tab-btn" onclick="afTab('campanha',this)">📧 Convidar novos</button>
  <% if (user && ['BRU-8MPC','REN-G9K6','LUI-VCNE'].includes(user.codigoUsuario||user.id)) { %>
  <button class="af-tab-btn" onclick="afTab('inbox',this)">📥 Inbox</button>
  <% } %>
  <button class="af-tab-btn" onclick="afTab('arvore',this)">🌳 Árvore</button>
  <button class="af-tab-btn" onclick="afTab('niveis',this)">📖 Como funciona</button>
</div>

<div id="af-pane-comissoes" class="af-tab-pane active card">
  <h3 style="margin-top:0">Histórico de comissões</h3>
  <% if (!dados.historico.length) { %>
    <p style="color:#6b7280;font-size:13px">Nenhuma comissão registrada ainda.</p>
  <% } else { %>
  <form id="af-resgate-form">
    <div style="overflow-x:auto">
    <table class="af-table">
      <thead><tr><th></th><th>Data</th><th>Comprador</th><th>Origem</th><th>Papel</th><th>Coins</th><th>Status</th></tr></thead>
      <tbody>
        <% dados.historico.forEach(function(h){ %>
        <tr>
          <td><% if (h.status === 'disponivel') { %><input type="checkbox" class="af-check-linha" value="<%= h.id %>"><% } %></td>
          <td><%= new Date(h.criado_em).toLocaleDateString('pt-BR') %></td>
          <td><%= h.compradorNome %></td>
          <td>
            <% if (h.origem === 'admin') { %><span title="Crédito adicionado manualmente pelo admin" style="color:#6b7280">🎁 Crédito admin</span>
            <% } else { %><span title="Pagamento real via app" style="color:#00A699">🛒 Compra no app</span><% } %>
          </td>
          <td><%= h.papel === 'propria' ? 'Própria venda' : h.papel === 'override_n2' ? 'Override N2' : h.papel === 'override_n1' ? 'Override N1' : '-' %></td>
          <td><%= h.bonus_coins %></td>
          <td>
            <% if (h.status === 'disponivel') { %><span style="color:#00A699;font-weight:600">Disponível</span>
            <% } else if (h.status === 'solicitado') { %><span style="color:#FC642D;font-weight:600">Solicitado</span>
            <% } else { %><span style="color:#6b7280">Pago</span><% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
    <div style="margin-top:16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
      <% if (!(user && user.afiliadoRestrito === true)) { %>
      <label style="font-size:13px"><input type="radio" name="af-modo" value="credito" checked> Creditar na minha conta</label>
      <% } %>
      <label style="font-size:13px"><input type="radio" name="af-modo" value="dinheiro" <%= (user && user.afiliadoRestrito === true) ? 'checked' : '' %>> Sacar em dinheiro (fecha dia 25, paga em até 3 dias)</label>
      <button type="button" onclick="afResgatar()" style="background:#111827;color:#fff;border:none;padding:10px 20px;border-radius:10px;font-weight:700;cursor:pointer">Resgatar selecionadas</button>
      <span id="af-resgate-status" style="font-size:13px;color:#6b7280"></span>
    </div>
  </form>
  <% } %>
</div>

<div id="af-pane-indicados" class="af-tab-pane card">
  <h3 style="margin-top:0">Meus afiliados — indicados</h3>
  <% if (!dados.indicados.length) { %>
    <p style="color:#6b7280;font-size:13px">Você ainda não indicou ninguém. Compartilhe seu link acima.</p>
  <% } else { %>
  <div style="overflow-x:auto">
  <table class="af-table">
    <thead><tr><th>Nome</th><th>Nível</th><th>Cadastro</th><th>WhatsApp</th></tr></thead>
    <tbody>
      <% dados.indicados.forEach(function(i){ %>
      <tr>
        <td><%= i.nome %></td>
        <td><span class="af-nivel-badge af-nivel-<%= i.nivel %>" style="font-size:11px;padding:2px 8px"><%= i.nivel %></span></td>
        <td><%= i.criadoEm ? new Date(i.criadoEm).toLocaleDateString('pt-BR') : '-' %></td>
        <td><%= i.online ? '🟢 conectado' : '⚪ desconectado' %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <% } %>
</div>

<div id="af-pane-campanha" class="af-tab-pane card">
  <h3 style="margin-top:0">Convidar novos usuários</h3>
  <p style="color:#6b7280;font-size:13px;margin-bottom:16px">Contatos que já abriram o e-mail de divulgação da MatchImóveis e foram distribuídos pra você — o convite por WhatsApp já sai automático com o <strong>seu link de indicação</strong>, então quem se cadastrar entra na sua rede. <strong>Clique no número verde 💬 na coluna WhatsApp pra chamar a lead direto</strong> — a mensagem já vem pronta com seu link, é só mandar. Assim que você clica, o botão fica cinza ✓ e a linha desce pro final da lista, pra você sempre ver primeiro quem ainda não foi chamado.</p>
  <% if (!dados.contatosCampanha.length) { %>
    <p style="color:#6b7280;font-size:13px">Nenhum contato distribuído pra você ainda.</p>
  <% } else { %>
  <div style="overflow-x:auto">
  <table class="af-table">
    <thead><tr><th>Data</th><th>Nome</th><th>Email</th><th>WhatsApp</th><th>Status</th></tr></thead>
    <tbody>
      <%
        // Mesma normalização usada no servidor (_celularWA em server.js) — célula
        // importada pode ter mais de 1 número junto ("fixo, celular") e vir com ou
        // sem "55" na frente; sempre devolve com "55" (sem "+") ou '' se inválido.
        // Corrige convite saindo sem DDI pra parte dos contatos (ago/2026).
        function _afCelularWA(raw){
          const candidatos = String(raw||'').split(/[,/;]+/).map(p=>p.replace(/\D/g,'').replace(/^55/,'')).filter(Boolean);
          const movel = candidatos.find(d=>d.length===11);
          if(movel) return '55'+movel;
          const fixo = candidatos.find(d=>d.length===10);
          if(fixo) return '55'+fixo;
          return '';
        }
      %>
      <% dados.contatosCampanha.forEach(function(c){
        const tel = _afCelularWA(c.celular);
        const jaEnviado = !!c.wa_manual_enviado_em;
      %>
      <tr id="af-camp-row-<%= c.id %>">
        <td><%= c.aberto_em ? new Date(c.aberto_em).toLocaleDateString('pt-BR') : '-' %></td>
        <td><%= c.nome || '(sem nome)' %></td>
        <td><%= c.email || '-' %></td>
        <td>
          <% if (tel) { %>
