<%- include('partials/app-shell',{active:'academia',title:'Academia MatchImóveis',subtitle:'Conquistas de negócio e trilhas de estudo.',perfil:(user && user.tipo)||'corretor',user:user}) %>

<style>
.ac-card{margin-bottom:16px}
.ac-track-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:6px}
.ac-track-head h4{font-size:14.5px;font-weight:700;display:flex;align-items:center;gap:8px}
.ac-track-head .ac-count{font-size:12px;color:var(--text-sec);font-variant-numeric:tabular-nums}
.ac-track-head .ac-count b{color:var(--text)}

.ac-ladder{display:flex;align-items:flex-start}
.ac-node{display:flex;flex-direction:column;align-items:center;gap:9px;flex:1;position:relative;min-width:0}
.ac-line{position:absolute;top:25px;left:-50%;width:100%;height:3px;background:var(--border);z-index:0}
.ac-node:first-child .ac-line{display:none}
.ac-node.earned .ac-line{background:#F5A623}

.ac-medal{width:50px;height:50px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px;position:relative;z-index:1;border:1.5px solid var(--border);background:#fff;color:var(--text-ter)}
.ac-node.earned.bronze .ac-medal{background:linear-gradient(155deg,#E3A46E,#B4652C);border-color:transparent;color:#fff;box-shadow:0 6px 14px rgba(180,101,44,.35)}
.ac-node.earned.prata .ac-medal{background:linear-gradient(155deg,#F1F3F5,#AEB4BC);border-color:transparent;color:#4B5563;box-shadow:0 6px 14px rgba(107,114,128,.3)}
.ac-node.earned.ouro .ac-medal{background:linear-gradient(155deg,#FFE1A8,#F5A623);border-color:transparent;color:#7A4E00;box-shadow:0 6px 14px rgba(245,166,35,.35)}
.ac-node.earned.diamante .ac-medal{background:linear-gradient(155deg,#D6E8FF,#4C8DFF);border-color:transparent;color:#fff;box-shadow:0 6px 16px rgba(76,141,255,.4)}
.ac-node.locked .ac-medal{opacity:.55}

.ac-node .ac-tier{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--text-ter)}
.ac-node.earned .ac-tier{color:var(--text)}
.ac-node .ac-goal{font-size:11px;color:var(--text-sec);text-align:center;white-space:nowrap}

.ac-em-breve{display:flex;align-items:center;gap:16px;padding:8px 4px;margin-bottom:18px}
.ac-em-breve .ic{width:52px;height:52px;border-radius:14px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;color:var(--text-ter)}
.ac-em-breve .tx{min-width:0}
.ac-em-breve .tx b{display:block;font-size:14px;color:var(--text);margin-bottom:3px}
.ac-em-breve .tx span{font-size:12.5px;color:var(--text-sec);line-height:1.5}

.ac-topico{border-top:1px solid var(--border);padding:16px 2px}
.ac-topico:first-of-type{border-top:none}
.ac-topico summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:12px;font-size:14px;font-weight:600;color:var(--text)}
.ac-topico summary::-webkit-details-marker{display:none}
.ac-topico summary .ac-topico-ic{width:34px;height:34px;border-radius:9px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.ac-topico summary .ac-topico-plus{margin-left:auto;font-size:18px;color:var(--text-ter);flex-shrink:0}
.ac-topico[open] summary .ac-topico-plus{content:'–'}
.ac-topico-body{padding:14px 2px 4px 46px}
.ac-topico-body h6{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--text-ter);margin-bottom:4px}
.ac-topico-body p{font-size:13px;color:var(--text-sec);line-height:1.6;margin-bottom:14px}
.ac-topico-body p:last-child{margin-bottom:0}
.ac-topico-body p.ac-ia b{color:var(--brand)}

/* Trilhas de leitura (ago/2026) — 3 artigos por função, com trava de tempo
   mínimo de leitura antes de liberar o próximo (pedido do Renato: "só muda
   de tópico quando completar de ler", tipo capítulo de livro). */
.ac-trilha{border:1px solid var(--border);border-radius:12px;margin-bottom:10px;overflow:hidden}
.ac-trilha-head{display:flex;align-items:center;gap:12px;padding:14px 16px;cursor:pointer;min-width:0}
.ac-trilha-head .ic{width:38px;height:38px;border-radius:10px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
.ac-trilha-head .tx{flex:1;min-width:0}
.ac-trilha-head .tx b{font-size:14px;color:var(--text);display:block}
.ac-trilha-head .tx span{font-size:11.5px;color:var(--text-sec)}
.ac-trilha-head .tx span.done{color:#00847A;font-weight:600}
.ac-trilha-head .seta{font-size:16px;color:var(--text-ter);flex-shrink:0}
.ac-trilha-dots{display:flex;gap:4px;flex-shrink:0}
.ac-trilha-dots i{width:7px;height:7px;border-radius:50%;background:var(--border)}
.ac-trilha-dots i.lido{background:#00A699}

.ac-leitor{display:none;border-top:1px solid var(--border);padding:18px 16px 20px;background:var(--bg)}
.ac-leitor.on{display:block}
.ac-leitor-cap{font-size:10.5px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px}
.ac-leitor-titulo{font-size:15px;font-weight:700;color:var(--text);margin-bottom:12px;text-wrap:balance}
.ac-leitor-corpo p{font-size:13.5px;color:var(--text-sec);line-height:1.7;margin-bottom:12px}
.ac-leitor-corpo p:last-child{margin-bottom:0}
.ac-leitor-nav{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:18px;flex-wrap:wrap}
.ac-leitor-voltar{font-size:12px;color:var(--text-sec);cursor:pointer;background:none;border:none;padding:8px 0}
.ac-btn-prox{padding:10px 20px;border-radius:9px;border:none;background:var(--brand);color:#fff;font-weight:700;font-size:13px;cursor:pointer}
.ac-btn-prox:disabled{background:var(--border);color:var(--text-ter);cursor:default}
.ac-btn-prox .cd{font-variant-numeric:tabular-nums}
</style>

<%
  // Conquistas de negócio (ago/2026, pedido do Bruno) — tiers calculados
  // direto de dado real, nada decorativo: venda fechada = visita com
  // pipelineStatus='FECHADO' (mesmo estado gravado por
  // POST /app/visitas/fechado/:id); indicação = usuario com
  // dados.indicadoPor apontando pra esse código (mesmo mecanismo do
  // programa de afiliados). Trilhas de estudo com vídeo ficam "em breve"
  // até o material existir (projeto separado, ainda em planejamento) —
  // sem botão fingindo funcionar sem conteúdo atrás.
  const _vTiers = [
    { min: 1, tier: 'bronze', medal: '🥉', label: 'Bronze', goal: '1ª venda fechada' },
    { min: 3, tier: 'ouro',   medal: '🥇', label: 'Ouro',   goal: '3 vendas fechadas' },
    { min: 5, tier: 'diamante', medal: '💎', label: 'Diamante', goal: '5 vendas fechadas' },
  ];
  const _iTiers = [
    { min: 1, tier: 'bronze', medal: '🥉', label: 'Bronze', goal: '1º cadastro pelo link' },
    { min: 5, tier: 'prata',  medal: '🥈', label: 'Prata',  goal: '5 cadastros pelo link' },
  ];
%>

<div class="card ac-card">
  <p style="font-size:15px;font-weight:600;margin-bottom:4px">🏅 Conquistas de negócio</p>
  <p style="font-size:13px;color:var(--text-sec);margin-bottom:20px">Medalhas por resultado real — calculadas sozinhas a partir do que você já faz na plataforma.</p>

  <div class="ac-track-head">
    <h4>💰 Vendas fechadas</h4>
    <div class="ac-count">Você já fechou <b><%= vendasFechadas %></b> visita<%= vendasFechadas === 1 ? '' : 's' %></div>
  </div>
  <div class="ac-ladder">
    <% _vTiers.forEach(function(t){ const earned = vendasFechadas >= t.min; %>
    <div class="ac-node <%= earned ? 'earned' : 'locked' %> <%= t.tier %>">
      <div class="ac-line"></div>
      <div class="ac-medal"><%= t.medal %></div>
      <div class="ac-tier"><%= t.label %></div>
      <div class="ac-goal"><%= t.goal %></div>
    </div>
    <% }); %>
  </div>
</div>

<div class="card ac-card">
  <div class="ac-track-head">
    <h4>🔗 Indicações (afiliados)</h4>
    <div class="ac-count"><b><%= indicacoes %></b> corretor<%= indicacoes === 1 ? '' : 'es' %> cadastrado<%= indicacoes === 1 ? '' : 's' %> pelo seu link</div>
  </div>
  <div class="ac-ladder">
    <% _iTiers.forEach(function(t){ const earned = indicacoes >= t.min; %>
    <div class="ac-node <%= earned ? 'earned' : 'locked' %> <%= t.tier %>">
      <div class="ac-line"></div>
      <div class="ac-medal"><%= t.medal %></div>
      <div class="ac-tier"><%= t.label %></div>
      <div class="ac-goal"><%= t.goal %></div>
    </div>
    <% }); %>
  </div>
  <% if (!indicacoes) { %>
  <p style="font-size:12px;color:var(--text-ter);margin-top:14px">Ainda não indicou ninguém? <a href="/app/afiliados" style="color:var(--brand);font-weight:600">Pegue seu link em Afiliados →</a></p>
  <% } %>
</div>

<div class="card ac-card">
  <p style="font-size:15px;font-weight:600;margin-bottom:4px">🎓 Trilhas de estudo</p>
  <p style="font-size:13px;color:var(--text-sec);margin-bottom:16px">3 artigos por função da plataforma. Cada artigo tem um tempo mínimo de leitura — só libera o próximo depois que você realmente ficou na tela.</p>
  <div class="ac-em-breve">
    <div class="ic">🎬</div>
    <div class="tx">
      <b>Vídeo em produção</b>
      <span>As aulas em vídeo de cada tela ainda estão sendo gravadas — enquanto isso, essas trilhas em texto já ensinam a fundo cada área.</span>
    </div>
  </div>

  <%
    // Trilhas de leitura (ago/2026, pedido do Renato) — 3 artigos reais por
    // função, mapeados no que a plataforma faz de verdade (mesma fonte de
    // conhecimento que cerebro.js usa pro assistente, escrito aqui em texto
    // corrido em vez de resposta de chat). Tempo mínimo de leitura por
    // artigo é controlado no JS (_AC_SEGUNDOS_MIN), não aqui.
    const _trilhas = [
      { id:'leads', ic:'🎯', titulo:'Leads', artigos: [
        { titulo:'De onde vêm as leads', corpo: [
          'Uma lead pode chegar por seis caminhos diferentes, e a plataforma trata cada um de um jeito: portal imobiliário (ZAP, OLX, VivaReal, ImovelWeb, 123i, Chaves na Mão) manda a lead via webhook direto pro corretor dono do anúncio; WhatsApp é quando alguém manda mensagem pro seu número conectado e a IA já começa a conversa; captação de proprietário é quando alguém preenche o formulário público pra anunciar o próprio imóvel (essa vira um tipo especial de lead, "cliente vendedor"); indicação é quando outra pessoa se cadastra pelo seu link de afiliado; planilha é importação manual de uma lista que você já tinha; e Meta Ads é quando alguém clica num anúncio seu do Instagram/Facebook.',
          'Cada uma dessas origens fica registrada no campo "origem" da lead — é por isso que no Kanban (/app/leads) você consegue filtrar e ver exatamente de onde veio cada uma. Isso importa na prática: uma lead de portal já chega sabendo qual imóvel ela clicou (o sistema já sabe o que ela quer), enquanto uma lead de WhatsApp direto chega "em branco" e precisa que a IA descubra o perfil dela conversando.',
        ]},
        { titulo:'Como a lead é tratada dentro da plataforma', corpo: [
          'Toda lead entra classificada em duas dimensões: fase do funil (novo, interesse, qualificado) e temperatura (fria, morna, quente). A temperatura não é escolhida por você — é calculada sozinha a partir do comportamento real: quantas vezes ela interagiu, quão rápido respondeu, se já teve match. Isso significa que uma lead pode esfriar ou esquentar sozinha conforme o tempo passa, sem ninguém precisar mexer manualmente.',
          'Tem um detalhe importante só do fluxo de WhatsApp: quando uma lead chega escrevendo sem ainda ter um perfil mínimo de busca definido, ela fica "oculta" — não aparece no Kanban, não conta nos números do dashboard, não gera notificação de sino. Ela só "nasce de verdade" pro sistema quando gera o primeiro match. Isso evita que sua tela de leads fique poluída com gente que ainda nem disse o que procura.',
          'Por trás de cada lead existe um "mapa de intenção" — uma estrutura que guarda, campo por campo (tipo de imóvel, cidade, bairro, valor, quartos), o que já foi descoberto sobre o que ela quer, com um nível de confiança pra cada dado. Quanto mais completo esse mapa, mais preciso fica o match.',
        ]},
        { titulo:'Pra que serve e como aproveitar', corpo: [
          'O objetivo de toda essa estrutura é uma coisa só: encontrar o imóvel certo pra cada lead o mais rápido possível. Assim que o mapa de intenção tem informação suficiente, o motor de match roda sozinho e a lead já ganha um "imóvel ideal" — o melhor candidato da sua carteira (ou da rede de parceiros), calculado com base em preço, localização, características e até em quão recente o imóvel foi atualizado.',
          'Se a lead não responde, a plataforma não deixa ela esfriar sozinha — dispara follow-up automático seguindo regras por temperatura e fase (uma lead quente é cutucada com mais frequência que uma morna). Na prática, seu trabalho como corretor vira: acompanhar o Kanban, entrar na conversa quando a IA sinaliza que a lead está pronta pra negociar, e usar as recomendações que já vêm prontas em vez de vasculhar a carteira manualmente.',
        ]},
      ]},
      { id:'imoveis', ic:'🏠', titulo:'Imóveis', artigos: [
        { titulo:'Como cadastrar e importar sua carteira', corpo: [
          'Tem dois jeitos de colocar imóvel na plataforma: cadastro manual (formulário completo, foto por foto) ou importação via XML — você conecta o feed que sua imobiliária já usa pra outros portais, e o sistema importa a carteira inteira de uma vez. Dá pra ter mais de um feed XML na mesma conta (por exemplo um feed de venda e outro de locação, ou de fontes diferentes), e cada um sincroniza sozinho a cada 24 horas, sem você precisar reimportar manualmente.',
          'No cadastro manual, o endereço é geocodificado automaticamente a partir do CEP — isso é o que permite o imóvel aparecer certo no mapa da carteira e ser comparado por distância/região na hora do match.',
        ]},
        { titulo:'Como um imóvel entra e sai do match e da vitrine pública', corpo: [
          'Nem todo imóvel cadastrado aparece pro público ou entra na disputa de match: existe uma regra de "visibilidade pública" que exige, no mínimo, ter foto e valor acima de um piso mínimo. Um imóvel sem foto, por exemplo, continua existindo no seu painel interno, mas fica de fora da vitrine que vai pro WhatsApp da lead — a plataforma não quer mandar pra um cliente algo que pareça abandonado ou incompleto.',
          'Quando você reimporta um XML, a plataforma marca como inativo qualquer imóvel que sumiu daquele feed específico — mas protege automaticamente qualquer imóvel cadastrado manualmente ou vindo de outro feed diferente, pra uma importação nunca desligar por engano um imóvel que não tem nada a ver com aquele XML.',
        ]},
        { titulo:'Divulgação automática — o imóvel trabalhando sozinho', corpo: [
          'Depois de cadastrado, o mesmo imóvel se espalha sozinho por vários canais sem retrabalho seu: a plataforma gera o XML no formato certo pra cada portal ativado, publica no Instagram (feed ou stories, com carrossel de até 10 fotos), aparece no feed estilo reels dentro do app, e entra na vitrine automática enviada pra qualquer lead compatível — seja pelo WhatsApp, seja pelo seu Meu Site.',
          'A descrição de texto de cada imóvel também pode ser gerada por IA a partir dos dados cadastrados (tipo, quartos, bairro, diferenciais) — você não precisa escrever um texto de anúncio do zero pra cada imóvel novo.',
        ]},
      ]},
      { id:'whatsapp', ic:'💬', titulo:'WhatsApp & Assistente', artigos: [
        { titulo:'Conectando seu número', corpo: [
          'A conexão do WhatsApp funciona via Evolution API — você escaneia um QR code (igual conectar o WhatsApp Web) e a plataforma passa a enviar e receber mensagens por esse número. A recomendação forte é usar um número exclusivo, de preferência um chip profissional dedicado só pra isso: um número pessoal misturado com uso comercial automatizado tem muito mais risco de ser bloqueado pelo WhatsApp, e isso derrubaria o atendimento de todas as suas leads de uma vez.',
        ]},
        { titulo:'Como a IA atende sozinha, sem você online', corpo: [
          'Toda mensagem nova passa por até três camadas antes de virar resposta: primeiro uma checagem rápida de saudação/resumo; depois, se configurado, a IA de verdade (Groq) entra com um contexto rico sobre a sua carteira e as leads recentes; e por último existe um fallback fixo, caso a IA não esteja disponível no momento. Isso garante que a lead nunca fica sem nenhuma resposta, mesmo em uma falha de sistema.',
          'A IA não só responde — ela extrai o perfil de busca da conversa (tipo de imóvel, bairro, valor, quartos) frase por frase, alimenta o mapa de intenção da lead, roda o match automaticamente assim que tem dado suficiente, e já manda a vitrine com os imóveis compatíveis, tudo isso em segundos e sem nenhuma ação manual sua.',
        ]},
        { titulo:'Central Operacional e Assistente — as duas formas de "conversar" com o sistema', corpo: [
          'Além do atendimento automático da lead, você também tem duas ferramentas pra interagir com a própria plataforma em linguagem natural: o Assistente (chat completo, com contexto da sua carteira, pra tirar dúvida ou pedir sugestão) e a Central Operacional (comandos mais diretos e rápidos, tipo "quais leads quentes eu tenho hoje" ou "resumo do dia"). São dois motores diferentes — a Central usa reconhecimento de comando mais simples e direto, o Assistente usa a IA completa com mais contexto.',
        ]},
      ]},
      { id:'portais', ic:'📡', titulo:'Portais & XML', artigos: [
        { titulo:'O que é o feed XML e pra que ele serve', corpo: [
          'Todo portal imobiliário grande (ZAP, VivaReal, OLX, ImovelWeb) espera receber a carteira de imóveis num arquivo XML com um formato específico — é assim que eles sabem quais imóveis existem, com qual preço, foto e descrição. Em vez de você cadastrar o mesmo imóvel manualmente em cada portal, a plataforma gera esse XML automaticamente a partir da sua carteira já cadastrada aqui dentro.',
        ]},
        { titulo:'Como ativar e manter sincronizado', corpo: [
          'Em Portais (/app/portais) você ativa qual portal quer alimentar — a plataforma passa a gerar (e manter atualizado) o XML no formato daquele portal específico. A sincronização roda sozinha a cada 24 horas: se você mudar o preço de um imóvel ou tirar ele do ar, o portal reflete essa mudança no ciclo seguinte, sem você precisar reenviar nada manualmente.',
        ]},
        { titulo:'Webhooks — como o lead do portal chega até você', corpo: [
          'Quando alguém clica em "tenho interesse" num anúncio seu dentro de um portal, o portal manda essa informação de volta pra plataforma através de um webhook (uma notificação automática entre sistemas). A plataforma usa o identificador do anúncio pra descobrir exatamente qual imóvel da sua carteira gerou aquele interesse, e já monta a lead com esse imóvel marcado como o "âncora" — ela chega no seu Kanban já sabendo o que a pessoa clicou, sem você ter que perguntar de novo.',
        ]},
      ]},
      { id:'redes', ic:'📸', titulo:'Redes Sociais', artigos: [
        { titulo:'Instagram conectado à sua conta', corpo: [
          'A conexão usa o login profissional do próprio Instagram (Instagram Business Login) — não precisa ter uma Página do Facebook vinculada, que era uma exigência mais antiga e mais complicada. A conta do Instagram precisa ser Profissional (Empresa ou Criador de conteúdo); conta pessoal comum não consegue conectar.',
        ]},
        { titulo:'Publicando um imóvel automaticamente', corpo: [
          'Com a conta conectada, você publica um imóvel direto da plataforma — feed normal (com carrossel de até 10 fotos) ou stories. A legenda/descrição do post pode ser gerada por IA a partir dos dados já cadastrados do imóvel, então você não precisa escrever um texto de divulgação do zero toda vez.',
        ]},
        { titulo:'Meta Ads — campanha de tráfego direto da plataforma', corpo: [
          'Além de publicar orgânico, dá pra criar campanha paga (Meta Ads) sem sair da plataforma — inclusive campanha de "clique para WhatsApp", que já manda quem clicou direto pra conversa com a IA. Um lead vindo de uma campanha dessas chega marcado com uma origem própria, então dá pra medir separadamente quanto cada campanha está trazendo de gente de verdade.',
        ]},
      ]},
      { id:'site', ic:'🌐', titulo:'Meu Site', artigos: [
        { titulo:'Sua página pública própria', corpo: [
          'Cada corretor tem uma página pública própria com a carteira inteira de imóveis, sem precisar contratar ou manter um site separado. Dá pra usar esse link na bio do Instagram, mandar direto no WhatsApp ou colocar num cartão de visita — é uma vitrine profissional pronta, gerada automaticamente a partir do que você já cadastrou.',
        ]},
        { titulo:'Como um visitante do site vira lead de verdade', corpo: [
          'Quando alguém visitando o Meu Site demonstra interesse (clica num imóvel, preenche um formulário de contato), essa pessoa entra no mesmo motor de match que trata qualquer outra lead — não existe um fluxo "diferente" ou mais fraco pra quem chega pelo site. O imóvel que ela clicou vira a âncora do match dela, do mesmo jeito que aconteceria vindo de um portal.',
        ]},
        { titulo:'Domínio próprio', corpo: [
          'Se você já tem (ou quer ter) um domínio próprio (tipo www.seunome.com.br) em vez do link padrão da plataforma, dá pra apontar esse domínio pro Meu Site via configuração de CNAME. Depois que a verificação do domínio é confirmada, sua página passa a responder nesse endereço próprio, mantendo a mesma vitrine por trás.',
        ]},
      ]},
      { id:'parceiros', ic:'🤝', titulo:'Parceiros & Indicações', artigos: [
        { titulo:'Rede de parceiros — o match não para na sua carteira', corpo: [
          'Quando uma lead não encontra o imóvel ideal só na sua carteira, o sistema pode sugerir um imóvel de outro corretor parceiro — ampliando a chance de fechar negócio mesmo sem você ter o imóvel exato. Se preferir não usar imóveis de rede (por exemplo, se você quer garantir que a lead só veja imóveis que são realmente seus), existe uma preferência de perfil pra restringir a vitrine só à sua própria carteira.',
        ]},
        { titulo:'Como funciona quando o match usa imóvel de um parceiro', corpo: [
          'Mesmo com a rede ativada, seus próprios imóveis sempre são priorizados primeiro no ranking de match — um imóvel de parceiro só entra na frente se não existir opção equivalente sua. Quando uma visita ou negócio nasce de um imóvel de parceiro, existe uma comissão de parceria configurável entre as duas partes envolvidas.',
        ]},
        { titulo:'Programa de afiliados — indicar outro corretor', corpo: [
          'É um programa separado da rede de parceiros de imóveis: aqui você indica outro corretor ou imobiliária pra usar a plataforma, usando um link de indicação próprio. Existem níveis (1, 2 e 3) definidos pelo volume de vendas gerado, e a indicação rende uma comissão recorrente toda vez que a pessoa indicada compra créditos — além de um bônus imediato assim que ela se cadastra pelo seu link.',
        ]},
      ]},
      { id:'coins', ic:'🪙', titulo:'Coins & Créditos', artigos: [
        { titulo:'O que são os créditos', corpo: [
          'Créditos (coins) são a moeda interna da plataforma — não existe mensalidade fixa. Cada ação relevante (cadastrar um imóvel, importar XML, a IA qualificar uma lead, gerar um match, mandar uma vitrine pelo WhatsApp) consome uma quantidade fixa e conhecida de créditos. Você só paga pelo que realmente usa, e o consumo é totalmente transparente — dá pra ver o histórico de cada débito.',
        ]},
        { titulo:'Como recarregar', corpo: [
          'A recarga é feita comprando um dos combos disponíveis (com valores fixos e bônus de créditos crescente conforme o combo), via Pix ou cartão através do Mercado Pago. Assim que o pagamento é confirmado, os créditos entram na conta na hora — não tem espera nem aprovação manual.',
        ]},
        { titulo:'O que acontece quando os créditos acabam', corpo: [
          'A plataforma avisa antes de zerar, com alertas de saldo baixo e depois crítico. Quando realmente chega a zero, só as ações que dependem de crédito ficam bloqueadas até a próxima recarga — seus dados, imóveis já cadastrados e histórico de leads continuam salvos e acessíveis normalmente, nada é perdido ou apagado por falta de saldo.',
        ]},
      ]},
    ];
  %>
  <div style="margin-top:6px" id="acTrilhas">
    <% _trilhas.forEach(function(t, ti){ %>
    <div class="ac-trilha" data-trilha="<%= t.id %>">
      <div class="ac-trilha-head" onclick="acAbrirTrilha('<%= t.id %>')">
        <span class="ic"><%= t.ic %></span>
        <div class="tx">
          <b><%= t.titulo %></b>
          <span id="acStatus-<%= t.id %>">0 de <%= t.artigos.length %> lidos</span>
        </div>
        <div class="ac-trilha-dots" id="acDots-<%= t.id %>">
          <% t.artigos.forEach(function(){ %><i></i><% }); %>
        </div>
        <span class="seta">→</span>
      </div>
      <div class="ac-leitor" id="acLeitor-<%= t.id %>">
        <div class="ac-leitor-cap" id="acCap-<%= t.id %>"></div>
        <div class="ac-leitor-titulo" id="acTit-<%= t.id %>"></div>
        <div class="ac-leitor-corpo" id="acCorpo-<%= t.id %>"></div>
        <div class="ac-leitor-nav">
          <button type="button" class="ac-leitor-voltar" onclick="acFecharTrilha('<%= t.id %>')">← Fechar</button>
          <button type="button" class="ac-btn-prox" id="acBtn-<%= t.id %>" onclick="acProximoArtigo('<%= t.id %>')" disabled>Aguarde <span class="cd">60</span>s</button>
        </div>
      </div>
    </div>
    <% }); %>
  </div>
</div>

<script>
(function(){
  // Dados das trilhas espelhados pro client-side (mesma fonte renderizada
  // acima em EJS) — precisa estar em JS pra controlar navegação/trava sem
  // recarregar a página.
  const _AC_TRILHAS = <%- JSON.stringify(_trilhas) %>;
  const _AC_SEGUNDOS_MIN = 60;
  const _AC_USER = <%- JSON.stringify((user && (user.codigoUsuario || user.id)) || 'anon') %>;
  const _AC_KEY = 'academia_progresso_' + _AC_USER;

  function _acLerProgresso(){
    try { return JSON.parse(localStorage.getItem(_AC_KEY) || '{}'); } catch(e) { return {}; }
  }
  function _acSalvarProgresso(p){
    try { localStorage.setItem(_AC_KEY, JSON.stringify(p)); } catch(e) {}
  }

  let _acAberta = null;
  let _acArtigoAtual = 0;
  let _acTimer = null;

  window.acAbrirTrilha = function(id){
    if (_acAberta && _acAberta !== id) acFecharTrilha(_acAberta);
    const trilha = _AC_TRILHAS.find(t => t.id === id);
    if (!trilha) return;
    const progresso = _acLerProgresso();
    const lidos = progresso[id] || [];
    // Retoma no primeiro artigo ainda não lido (ou reabre o último se já concluiu tudo).
    let idx = trilha.artigos.findIndex((_, i) => !lidos[i]);
    if (idx === -1) idx = trilha.artigos.length - 1;
    _acAberta = id;
    _acArtigoAtual = idx;
    document.getElementById('acLeitor-' + id).classList.add('on');
    _acRenderArtigo(id);
    document.getElementById('acLeitor-' + id).scrollIntoView({ behavior:'smooth', block:'nearest' });
  };

  window.acFecharTrilha = function(id){
    document.getElementById('acLeitor-' + id).classList.remove('on');
    if (_acTimer) { clearInterval(_acTimer); _acTimer = null; }
    if (_acAberta === id) _acAberta = null;
  };

  function _acRenderArtigo(id){
    const trilha = _AC_TRILHAS.find(t => t.id === id);
    const artigo = trilha.artigos[_acArtigoAtual];
    const progresso = _acLerProgresso();
    const lidos = progresso[id] || [];
    const jaLido = !!lidos[_acArtigoAtual];

    document.getElementById('acCap-' + id).textContent = 'Artigo ' + (_acArtigoAtual + 1) + ' de ' + trilha.artigos.length;
    document.getElementById('acTit-' + id).textContent = artigo.titulo;
    document.getElementById('acCorpo-' + id).innerHTML = artigo.corpo.map(p => '<p>' + p + '</p>').join('');

    const btn = document.getElementById('acBtn-' + id);
    const ultimo = _acArtigoAtual === trilha.artigos.length - 1;
    if (_acTimer) { clearInterval(_acTimer); _acTimer = null; }

    if (jaLido) {
      // Já leu esse artigo antes — sem trava, libera na hora (não pune reler).
      btn.disabled = false;
      btn.textContent = ultimo ? 'Concluir ✓' : 'Próximo artigo →';
    } else {
      let restante = _AC_SEGUNDOS_MIN;
      btn.disabled = true;
      btn.innerHTML = 'Aguarde <span class="cd">' + restante + '</span>s';
      _acTimer = setInterval(() => {
        restante--;
        if (restante <= 0) {
          clearInterval(_acTimer);
          _acTimer = null;
          // Marca esse artigo como lido assim que o tempo mínimo passa.
          const p = _acLerProgresso();
          if (!p[id]) p[id] = [];
          p[id][_acArtigoAtual] = true;
          _acSalvarProgresso(p);
          _acAtualizarCabecalho(id);
          btn.disabled = false;
          btn.textContent = ultimo ? 'Concluir ✓' : 'Próximo artigo →';
        } else {
          btn.innerHTML = 'Aguarde <span class="cd">' + restante + '</span>s';
        }
      }, 1000);
    }
  }

  window.acProximoArtigo = function(id){
    const trilha = _AC_TRILHAS.find(t => t.id === id);
    if (_acArtigoAtual < trilha.artigos.length - 1) {
      _acArtigoAtual++;
      _acRenderArtigo(id);
      document.getElementById('acLeitor-' + id).scrollIntoView({ behavior:'smooth', block:'nearest' });
    } else {
      acFecharTrilha(id);
    }
  };

  function _acAtualizarCabecalho(id){
    const trilha = _AC_TRILHAS.find(t => t.id === id);
    const progresso = _acLerProgresso();
    const lidos = progresso[id] || [];
    const total = trilha.artigos.length;
    const feitos = lidos.filter(Boolean).length;
    const status = document.getElementById('acStatus-' + id);
    status.textContent = feitos + ' de ' + total + ' lidos';
    status.classList.toggle('done', feitos === total);
    const dots = document.getElementById('acDots-' + id).children;
    for (let i = 0; i < dots.length; i++) dots[i].classList.toggle('lido', !!lidos[i]);
  }

  _AC_TRILHAS.forEach(t => _acAtualizarCabecalho(t.id));
})();
</script>
<%- include('partials/app-end') %>
