<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% const _loc = (typeof localizacao !== 'undefined' && localizacao) ? localizacao : null; %>
  <% const _tituloLoc = _loc ? (_loc.nivel==='bairro' ? (_loc.bairroNome+', '+_loc.cidadeNome) : (_loc.cidadeNome+', '+_loc.estadoNome)) : ''; %>
  <title><%= _loc ? ('Imóveis à venda e pra alugar em '+_tituloLoc+' · MatchImóveis') : 'MatchImóveis · Todos os imóveis da rede' %></title>
  <% const _descPortal = _loc
       ? (totalImoveis + ' imóve' + (totalImoveis===1?'l':'is') + ' à venda e pra alugar em ' + _tituloLoc + (_loc.stats ? (', de R$ '+_loc.stats.min.toLocaleString('pt-BR')+' a R$ '+_loc.stats.max.toLocaleString('pt-BR')) : '') + '.')
       : (totalImoveis + ' imóve' + (totalImoveis===1?'l':'is') + ' de corretores e imobiliárias parceiras, em todo o Brasil.'); %>
  <% const _urlPortal = _loc ? _loc.canonicalUrl : ((typeof siteOrigin !== 'undefined' && siteOrigin) ? siteOrigin + '/portal' : ''); %>
  <% const _sc = (typeof siteConfig !== 'undefined' && siteConfig) ? siteConfig : {}; %>
  <meta name="description" content="<%= _descPortal %>">
  <% if(_urlPortal){ %><link rel="canonical" href="<%= _urlPortal %>"><% } %>
  <% if(_loc && !_loc.indexavel){ %><meta name="robots" content="noindex,follow"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= _loc ? ('Imóveis em '+_tituloLoc+' · MatchImóveis') : 'MatchImóveis · Todos os imóveis da rede' %>">
  <meta property="og:description" content="<%= _descPortal %>">
  <% if(_urlPortal){ %><meta property="og:url" content="<%= _urlPortal %>"><% } %>
  <% if(_sc.logoUrl){ %><meta property="og:image" content="<%= _sc.logoUrl %>"><% } %>
  <meta name="twitter:card" content="<%= _sc.logoUrl ? 'summary_large_image' : 'summary' %>">
  <% if(_sc.logoUrl){ %><link rel="icon" href="<%= _sc.logoUrl %>"><% } %>
  <% if(_sc.googleAnalyticsId){ %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= _sc.googleAnalyticsId %>"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',<%- JSON.stringify(_sc.googleAnalyticsId) %>);</script>
  <% } %>
  <% if(_sc.metaPixelId){ %>
  <script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init',<%- JSON.stringify(_sc.metaPixelId) %>);fbq('track','PageView');</script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=<%= _sc.metaPixelId %>&ev=PageView&noscript=1"/></noscript>
  <% } %>
  <%
    const _jsonLdPortal = {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: _loc ? ('Imóveis em '+_tituloLoc) : 'MatchImóveis · Todos os imóveis da rede',
      description: _descPortal,
      url: _urlPortal || undefined,
      dateModified: _loc ? _loc.atualizadoEm : undefined,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: (typeof imoveis !== 'undefined' ? imoveis : []).slice(0, 20).map(function(im, i){
          const _slugLd = String(im.titulo || (im.tipo+' em '+im.bairro) || '').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,60);
          return {
            '@type': 'ListItem',
            position: i + 1,
            url: ((typeof siteOrigin !== 'undefined' && siteOrigin) ? siteOrigin : '') + '/imovel/' + (im.idExterno || im.idInterno || im.id) + (_slugLd ? '--'+_slugLd : '')
          };
        })
      }
    };
  %>
  <script type="application/ld+json"><%- JSON.stringify(_jsonLdPortal).replace(/</g, '\\u003c') %></script>
  <% if(_loc){
    const _jsonLdBreadcrumb = {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: _loc.breadcrumb.map(function(b, i){
        const item = { '@type': 'ListItem', position: i+1, name: b.nome };
        if (b.path) item.item = siteOrigin + b.path;
        return item;
      })
    };
  %>
  <script type="application/ld+json"><%- JSON.stringify(_jsonLdBreadcrumb).replace(/</g, '\\u003c') %></script>
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{
      --brand:<%= _sc.corPrimaria || '#FF385C' %>;
      --teal:#00A699; --teal-ink:#0E7268;
      --ink:#16181A; --paper:#FBF9F6;
      --sand:#F1EBE1; --line:#E2DBCC;
      --muted:#716C61; --muted-2:#948E80;
      --white:#FFFFFF;
      --shadow:0 1px 2px rgba(22,20,14,.04), 0 12px 32px -12px rgba(22,20,14,.18);
      --radius:16px;
    }
    body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--paper);color:var(--ink);-webkit-font-smoothing:antialiased}
    a{color:inherit}

    header{background:<%= _sc.corCabecalho ? _sc.corCabecalho : 'color-mix(in srgb, var(--paper) 90%, transparent)' %>;<% if(!_sc.corCabecalho){ %>backdrop-filter:blur(10px);<% } %>border-bottom:1px solid var(--line);padding:16px 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
    .logo{display:flex;align-items:center;gap:9px;font-weight:800;font-size:15px;letter-spacing:-.4px;text-decoration:none;color:var(--ink)}
    .logo .dot{width:8px;height:8px;border-radius:50%;background:var(--brand)}
    .logo img{height:36px;max-width:210px;object-fit:contain;display:block}
    .header-acoes{display:flex;align-items:center;gap:10px}
    .banners{max-width:1200px;margin:0 auto;padding:20px 24px 0}
    .banners-track{position:relative;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);aspect-ratio:16/4;background:var(--sand)}
    .banners-track img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .6s ease}
    .banners-track img.ativo{opacity:1}
    .banners-dots{display:flex;justify-content:center;gap:6px;margin-top:10px}
    .banners-dots button{width:7px;height:7px;border-radius:50%;border:none;background:var(--line);cursor:pointer;padding:0}
    .banners-dots button.ativo{background:var(--brand);width:18px;border-radius:4px;transition:width .2s}
    @media(max-width:640px){ .banners-track{aspect-ratio:16/7} }
    .btn-anuncie-header{display:flex;align-items:center;gap:7px;background:var(--paper);border:1px solid var(--line);color:var(--ink);padding:9px 16px;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none}
    .btn-corretor-header{display:flex;align-items:center;gap:7px;background:#111827;color:#fff;padding:9px 16px;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none}

    .hero{padding:40px 24px 8px;max-width:1200px;margin:0 auto}
    .hero h1{font-size:23px;font-weight:800;letter-spacing:-.6px;margin-bottom:4px}
    .hero p{color:var(--muted);font-size:14px}
    .breadcrumb{max-width:1200px;margin:0 auto;padding:16px 24px 0;font-size:12.5px;color:var(--muted-2)}
    .breadcrumb a{color:var(--muted-2);text-decoration:none}
    .breadcrumb a:hover{color:var(--brand);text-decoration:underline}
    .breadcrumb .bc-sep{margin:0 6px;color:var(--line)}
    .breadcrumb .bc-atual{color:var(--ink);font-weight:600}
    .bairros-vizinhos{max-width:1200px;margin:0 auto;padding:4px 24px 20px;font-size:12.5px;color:var(--muted);display:flex;flex-wrap:wrap;gap:8px;align-items:center}
    .bairros-vizinhos .bv-label{font-weight:700;color:var(--ink);margin-right:2px}
    .bairros-vizinhos a{color:var(--teal-ink);text-decoration:none;background:var(--sand);border-radius:20px;padding:4px 10px;white-space:nowrap}
    .bairros-vizinhos a:hover{background:var(--line)}

    .filtros{max-width:1200px;margin:20px auto 0;padding:0 24px}
    .filtros-box{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow);display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end}
    .ffield{display:flex;flex-direction:column;gap:5px;min-width:120px;flex:1;position:relative}
    .ffield label{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
    .ffield select,.ffield input{border:1px solid var(--line);border-radius:9px;padding:9px 10px;font-size:13.5px;font-family:inherit;background:var(--paper);color:var(--ink);outline:none}
    .ffield select:focus,.ffield input:focus{border-color:var(--brand)}
    .portal-suggest{position:absolute;top:100%;left:0;right:0;background:var(--white);border:1px solid var(--line);border-radius:9px;margin-top:4px;max-height:220px;overflow-y:auto;z-index:50;display:none;box-shadow:var(--shadow)}
    .portal-suggest.on{display:block}
    .portal-suggest div{padding:9px 12px;font-size:13.5px;cursor:pointer;color:var(--ink)}
    .portal-suggest div:hover,.portal-suggest div.hl{background:var(--paper)}
    .portal-suggest .vazio{color:var(--muted);cursor:default}
    .portal-bairro-chips{display:flex;flex-wrap:wrap;gap:5px}
    .portal-bairro-chips:not(:empty){margin-bottom:5px}
    .chip-bairro{display:inline-flex;align-items:center;gap:5px;background:var(--teal);color:#fff;border-radius:20px;padding:4px 6px 4px 10px;font-size:12px;font-weight:600;white-space:nowrap}
    .chip-bairro button{background:rgba(255,255,255,.25);border:none;color:#fff;width:16px;height:16px;border-radius:50%;font-size:11px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;flex-shrink:0}
    .chip-bairro button:hover{background:rgba(255,255,255,.4)}
    .faixa{display:flex;gap:6px}
    .faixa input{width:100%}
    .btn-limpar{color:var(--muted);font-size:12.5px;text-decoration:none;padding:10px 4px;white-space:nowrap}

    .container{max-width:1200px;margin:0 auto;padding:24px}
    .grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(270px, 1fr));gap:18px}

    .card{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);text-decoration:none;color:inherit;display:flex;flex-direction:column;transition:transform .15s, box-shadow .15s}
    .card:hover{transform:translateY(-2px);box-shadow:0 4px 10px rgba(22,20,14,.08), 0 16px 36px -12px rgba(22,20,14,.22)}
    .card-img{position:relative;height:190px;background:var(--sand)}
    .card-img img{width:100%;height:100%;object-fit:cover;display:block}
    .card-badge{position:absolute;top:10px;left:10px;color:#fff;font-size:10.5px;font-weight:700;padding:4px 11px;border-radius:999px;letter-spacing:.03em}
    .card-body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1}
    .card-price{font-size:18px;font-weight:800;letter-spacing:-.4px;color:var(--brand);font-variant-numeric:tabular-nums}
    .card-title{font-size:13.5px;font-weight:600;color:var(--ink)}
    .card-loc{font-size:12px;color:var(--muted)}
    .card-specs{display:flex;gap:12px;margin-top:auto;padding-top:10px;border-top:1px solid var(--line);font-size:11.5px;color:var(--muted)}
    .card-specs b{color:var(--ink);font-weight:700}

    .vazio{text-align:center;padding:60px 20px;color:var(--muted)}
    .vazio .ico{font-size:36px;margin-bottom:10px}

    .paginacao{display:flex;justify-content:center;gap:6px;margin-top:28px;flex-wrap:wrap}
    .pg-link{display:inline-flex;align-items:center;justify-content:center;min-width:36px;height:36px;padding:0 10px;border-radius:9px;border:1px solid var(--line);background:var(--white);color:var(--ink);text-decoration:none;font-size:13px;font-weight:600}
    .pg-link.atual{background:var(--brand);border-color:var(--brand);color:#fff}
    .pg-link.desabilitado{opacity:.4;pointer-events:none}

    .site-footer{background:<%= _sc.corRodape ? _sc.corRodape : 'transparent' %>;border-top:1px solid var(--line);margin-top:40px;padding:32px 24px;text-align:center;color:<%= _sc.corTextoRodape ? _sc.corTextoRodape : 'var(--muted)' %>;font-size:13px;line-height:1.9}
    .site-footer b{color:<%= _sc.corTextoRodape ? _sc.corTextoRodape : 'var(--ink)' %>;display:block;font-size:16px;margin-bottom:4px}
    .site-footer a{color:<%= _sc.corTextoRodape ? _sc.corTextoRodape : 'var(--muted)' %>;text-decoration:none}
    .site-footer a:hover{color:var(--brand)}

    @media(max-width:640px){
      header{padding:14px 16px}
      .hero{padding:28px 16px 4px}
      .breadcrumb{padding:12px 16px 0}
      .bairros-vizinhos{padding:4px 16px 16px}
      .filtros{padding:0 16px}
      .container{padding:16px}
      .ffield{min-width:100%}
    }
  </style>
</head>
<body>

<header>
  <a href="/portal" class="logo">
    <% if(_sc.logoUrl){ %><img src="<%= _sc.logoUrl %>" alt="<%= _sc.rodapeNome %>">
    <% } else { %><span class="dot"></span>Match<span style="color:var(--brand)">Imóveis</span><% } %>
  </a>
  <div class="header-acoes">
    <a href="/captar/REN-G9K6" class="btn-anuncie-header" title="Área do Proprietário">📢 Anuncie seu imóvel</a>
    <a href="/?ref=REN-G9K6" class="btn-corretor-header">👤 Sou corretor</a>
  </div>
</header>

<% if(_sc.banners && _sc.banners.length){ %>
<div class="banners">
  <div class="banners-track" id="banners-track">
    <% _sc.banners.forEach(function(b, i){ %>
    <img src="<%= b %>" class="<%= i===0?'ativo':'' %>" data-i="<%= i %>" alt="">
    <% }); %>
  </div>
  <% if(_sc.banners.length > 1){ %>
  <div class="banners-dots" id="banners-dots">
    <% _sc.banners.forEach(function(b, i){ %>
    <button class="<%= i===0?'ativo':'' %>" data-i="<%= i %>"></button>
    <% }); %>
  </div>
  <% } %>
</div>
<% } %>

<% if(_loc){ %>
<nav class="breadcrumb" aria-label="breadcrumb">
  <% _loc.breadcrumb.forEach(function(b, i){ %>
    <% if(i>0){ %><span class="bc-sep">›</span><% } %>
    <% if(b.path){ %><a href="<%= b.path %>"><%= b.nome %></a><% } else { %><span class="bc-atual"><%= b.nome %></span><% } %>
  <% }); %>
</nav>
<div class="hero">
  <h1>Imóveis à venda e pra alugar em <%= _tituloLoc %></h1>
  <p><%= totalImoveis %> imóve<%= totalImoveis===1?'l':'is' %> disponí<%= totalImoveis===1?'vel':'veis' %> de corretores e imobiliárias parceiras
  <% if(_loc.stats){ %> · de R$ <%= _loc.stats.min.toLocaleString('pt-BR') %> a R$ <%= _loc.stats.max.toLocaleString('pt-BR') %> · média R$ <%= _loc.stats.media.toLocaleString('pt-BR') %><% } %></p>
</div>
<% } else { %>
<div class="hero">
  <h1>Todos os imóveis da rede MatchImóveis</h1>
  <p><%= totalImoveis %> imóve<%= totalImoveis===1?'l':'is' %> disponí<%= totalImoveis===1?'vel':'veis' %> de corretores e imobiliárias parceiras</p>
</div>
<% } %>

<% var _bairrosSelecionados = (Array.isArray(filtros.bairro) ? filtros.bairro : (filtros.bairro ? [filtros.bairro] : [])).filter(Boolean); %>
<% var _temBairroFiltro = _bairrosSelecionados.length > 0; %>
<% var _basePath = _loc ? _loc.canonicalPath : '/portal'; %>
<div class="filtros">
  <form class="filtros-box" method="GET" action="<%= _basePath %>">
    <div class="ffield" style="min-width:200px;flex:2">
      <label>Buscar</label>
      <input type="text" name="busca" placeholder="Bairro, título..." value="<%= filtros.busca||'' %>">
    </div>
    <% if(!_loc){ %>
    <div class="ffield">
      <label>Cidade</label>
      <input type="text" name="cidade" id="portal-cidade-input" value="<%= filtros.cidade||'' %>" placeholder="Digite pra buscar..." autocomplete="off">
      <div class="portal-suggest" id="portal-cidade-suggest"></div>
    </div>
    <div class="ffield">
      <label>Bairro</label>
      <div class="portal-bairro-chips" id="portal-bairro-chips">
        <% _bairrosSelecionados.forEach(function(b){ %>
        <span class="chip-bairro"><%= b %><input type="hidden" name="bairro" value="<%= b %>"><button type="button" onclick="removerBairroChip(this)" aria-label="Remover <%= b %>">×</button></span>
        <% }); %>
      </div>
      <input type="text" id="portal-bairro-input" placeholder="Digite pra adicionar..." autocomplete="off">
      <div class="portal-suggest" id="portal-bairro-suggest"></div>
    </div>
    <% } %>
    <div class="ffield">
      <label>Tipo</label>
      <select name="tipo" onchange="this.form.submit()">
        <option value="">Todos</option>
        <% ['Apartamento','Casa','Cobertura','Sobrado','Studio / Flat','Terreno','Sala Comercial','Loja'].forEach(function(t){ %>
        <option value="<%= t %>" <%= filtros.tipo===t?'selected':'' %>><%= t %></option>
        <% }); %>
      </select>
    </div>
    <div class="ffield">
      <label>Operação</label>
      <select name="operacao" onchange="this.form.submit()">
        <option value="">Todas</option>
        <option value="venda" <%= filtros.operacao==='venda'?'selected':'' %>>Venda</option>
        <option value="aluguel" <%= filtros.operacao==='aluguel'?'selected':'' %>>Aluguel</option>
      </select>
    </div>
    <div class="ffield">
      <label>Condição</label>
      <select name="condicao" onchange="this.form.submit()">
        <option value="">Todas</option>
        <option value="lancamento" <%= filtros.condicao==='lancamento'?'selected':'' %>>Lançamento</option>
        <option value="usado" <%= filtros.condicao==='usado'?'selected':'' %>>Usado</option>
        <option value="pronto" <%= filtros.condicao==='pronto'?'selected':'' %>>Pronto novo</option>
      </select>
    </div>
    <div class="ffield">
      <label>Quartos</label>
      <select name="quartosMin" onchange="this.form.submit()">
        <option value="">Qualquer</option>
        <% [1,2,3,4].forEach(function(n){ %>
        <option value="<%= n %>" <%= String(filtros.quartosMin)===String(n)?'selected':'' %>><%= n %>+</option>
        <% }); %>
      </select>
    </div>
    <div class="ffield" style="min-width:200px">
      <label>Faixa de valor</label>
      <div class="faixa">
        <input type="text" name="valorMin" placeholder="Mín." value="<%= filtros.valorMin||'' %>">
        <input type="text" name="valorMax" placeholder="Máx." value="<%= filtros.valorMax||'' %>">
      </div>
    </div>
    <div class="ffield">
      <label>Ordenar por</label>
      <select name="ordenar" onchange="this.form.submit()">
        <option value="menor-preco" <%= (!filtros.ordenar||filtros.ordenar==='menor-preco')?'selected':'' %>>Menor preço</option>
        <option value="maior-preco" <%= filtros.ordenar==='maior-preco'?'selected':'' %>>Maior preço</option>
        <option value="recentes" <%= filtros.ordenar==='recentes'?'selected':'' %>>Mais recentes</option>
      </select>
    </div>
    <% if(filtros.busca||(!_loc&&filtros.cidade)||(!_loc&&_temBairroFiltro)||filtros.tipo||filtros.operacao||filtros.condicao||filtros.quartosMin||filtros.valorMin||filtros.valorMax||(filtros.ordenar&&filtros.ordenar!=='menor-preco')){ %>
    <a href="<%= _basePath %>" class="btn-limpar">Limpar filtros</a>
    <% } %>
  </form>
</div>

<% if(_loc && _loc.bairrosIrmaos.length){ %>
<div class="container" style="padding-top:0;padding-bottom:0">
  <div class="bairros-vizinhos">
    <span class="bv-label">Outros bairros em <%= _loc.cidadeNome %>:</span>
    <% _loc.bairrosIrmaos.forEach(function(b){ %><a href="<%= b.path %>"><%= b.nome %> (<%= b.count %>)</a><% }); %>
  </div>
</div>
<% } %>

<div class="container">
  <% if(!imoveis.length){ %>
  <div class="vazio">
    <div class="ico">🏠</div>
    <p>Nenhum imóvel encontrado com esses filtros.</p>
  </div>
  <% } else { %>
  <div class="grid">
    <% imoveis.forEach(function(im){ %>
    <% const _idLink = im.idExterno || im.idInterno || im.id; %>
    <% const _trans = (im.transacao||'').toLowerCase(); %>
    <% const _slugLink = String(im.titulo || (im.tipo+' em '+im.bairro) || '').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,60); %>
    <a href="/imovel/<%= _idLink %><%= _slugLink ? '--'+_slugLink : '' %>?voltar=<%= encodeURIComponent(typeof portalUrl!=='undefined'&&portalUrl?portalUrl:'/portal') %>" class="card">
      <div class="card-img">
        <% if(im.fotos && im.fotos.length){ %><img src="<%= im.fotos[0] %>" alt="<%= im.titulo || (im.tipo + ' em ' + im.bairro) %>" loading="lazy">
        <% } else { %><div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--muted-2);font-size:13px">Sem foto</div><% } %>
        <% if(_trans==='venda'||_trans==='aluguel'){ %><span class="card-badge" style="background:<%= _trans==='aluguel'?'var(--teal)':'var(--brand)' %>"><%= _trans==='aluguel'?'ALUGUEL':'VENDA' %></span><% } %>
      </div>
      <div class="card-body">
        <div class="card-price">R$ <%= Number(im.valor_imovel||0).toLocaleString('pt-BR') %></div>
        <div class="card-title"><%= im.titulo || (im.tipo + ' em ' + im.bairro) %></div>
        <div class="card-loc"><%= [im.bairro, im.cidade].filter(Boolean).join(', ') %></div>
        <div class="card-specs">
          <% if(im.area_m2){ %><span><b><%= im.area_m2 %></b>m²</span><% } %>
          <% if(im.quartos){ %><span><b><%= im.quartos %></b> qto<%= im.quartos>1?'s':'' %></span><% } %>
          <% if(im.banheiros){ %><span><b><%= im.banheiros %></b> banh.</span><% } %>
          <% if(im.vagas){ %><span><b><%= im.vagas %></b> vaga<%= im.vagas>1?'s':'' %></span><% } %>
        </div>
      </div>
    </a>
    <% }); %>
  </div>
  <% } %>

  <% if(totalPages > 1){
    const _maxVisiveis = 20;
    let _paginas = [];
    if (totalPages <= _maxVisiveis) {
      for (let p=1; p<=totalPages; p++) _paginas.push(p);
    } else {
      const _lado = Math.floor((_maxVisiveis - 3) / 2);
      let _inicio = Math.max(2, page - _lado);
      let _fim = Math.min(totalPages - 1, page + _lado);
      if (page - _lado < 2) _fim = Math.min(totalPages - 1, _fim + (2 - (page - _lado)));
      if (page + _lado > totalPages - 1) _inicio = Math.max(2, _inicio - ((page + _lado) - (totalPages - 1)));
      _paginas.push(1);
      if (_inicio > 2) _paginas.push('...');
      for (let p=_inicio; p<=_fim; p++) _paginas.push(p);
      if (_fim < totalPages - 1) _paginas.push('...');
      _paginas.push(totalPages);
    }
  %>
  <div class="paginacao">
    <a class="pg-link <%= page<=1?'desabilitado':'' %>" href="<%= _basePath %>?page=<%= page-1 %>&<%= queryPagina %>">‹</a>
    <% _paginas.forEach(p => { %>
      <% if(p==='...'){ %>
      <span class="pg-link desabilitado" style="border:none;background:transparent">…</span>
      <% } else { %>
      <a class="pg-link <%= p===page?'atual':'' %>" href="<%= _basePath %>?page=<%= p %>&<%= queryPagina %>"><%= p %></a>
      <% } %>
    <% }) %>
    <a class="pg-link <%= page>=totalPages?'desabilitado':'' %>" href="<%= _basePath %>?page=<%= page+1 %>&<%= queryPagina %>">›</a>
  </div>
  <% } %>
</div>

<footer class="site-footer">
  <b><%= _sc.rodapeNome || 'MatchImóveis' %></b>
  <% if(_sc.rodapeEndereco){ %><%= _sc.rodapeEndereco %><br><% } %>
  <% if(_sc.rodapeTelefone){ %><%= _sc.rodapeTelefone %><% } %>
  <% if(_sc.rodapeInstagram || _sc.rodapeFacebook){ %>
    <div class="social-links" style="margin-top:12px;display:flex;justify-content:center;gap:10px">
      <% if(_sc.rodapeInstagram){ %>
      <a href="<%= _sc.rodapeInstagram %>" target="_blank" aria-label="Instagram" style="width:36px;height:36px;border-radius:50%;border:1px solid currentColor;display:flex;align-items:center;justify-content:center;opacity:.85">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
      <% } %>
      <% if(_sc.rodapeFacebook){ %>
      <a href="<%= _sc.rodapeFacebook %>" target="_blank" aria-label="Facebook" style="width:36px;height:36px;border-radius:50%;border:1px solid currentColor;display:flex;align-items:center;justify-content:center;opacity:.85">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.89h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94z"/></svg>
      </a>
      <% } %>
    </div>
  <% } %>
  <div style="margin-top:10px;max-width:52ch;margin-left:auto;margin-right:auto"><%= _sc.rodapeTexto || 'A maior rede de corretores e imobiliárias parceiras — anuncie ou encontre seu próximo imóvel.' %></div>
  <div style="margin-top:14px;font-size:11px;color:var(--muted-2)"><a href="https://www.matchimoveis.ia.br" target="_blank">matchimoveis.ia.br</a></div>
</footer>

<script>
(function(){
  var track = document.getElementById('banners-track');
  if(!track) return;
  var imgs = Array.prototype.slice.call(track.querySelectorAll('img'));
  var dots = document.querySelectorAll('#banners-dots button');
  if(imgs.length < 2) return;
  var atual = 0;
  function mostrar(i){
    imgs[atual].classList.remove('ativo');
    if(dots[atual]) dots[atual].classList.remove('ativo');
    atual = i;
    imgs[atual].classList.add('ativo');
    if(dots[atual]) dots[atual].classList.add('ativo');
  }
  dots.forEach(function(dot){
    dot.addEventListener('click', function(){ mostrar(parseInt(dot.dataset.i, 10)); reiniciar(); });
  });
  var timer;
  function reiniciar(){
    clearInterval(timer);
    timer = setInterval(function(){ mostrar((atual + 1) % imgs.length); }, 5000);
  }
  reiniciar();
})();

<% if(!_loc && !filtros.busca && !filtros.cidade && !_temBairroFiltro && !filtros.tipo && !filtros.operacao && !filtros.condicao && !filtros.quartosMin && !filtros.valorMin && !filtros.valorMax && !filtros.page){ %>
(function(){
  // Sem nenhum filtro aplicado ainda: se o navegador autorizar, pré-filtra pela cidade do visitante.
  if(localStorage.getItem('mi_portal_geo_perguntado')) return;
  if(!navigator.geolocation) return;
  localStorage.setItem('mi_portal_geo_perguntado', '1');
  navigator.geolocation.getCurrentPosition(function(pos){
    fetch('/api/portal/geo-cidade?lat=' + pos.coords.latitude + '&lng=' + pos.coords.longitude)
      .then(function(r){ return r.json(); })
      .then(function(d){
        if(d && d.cidade) window.location.href = '/portal?cidade=' + encodeURIComponent(d.cidade);
      })
      .catch(function(){});
  }, function(){ /* usuário negou ou indisponível — segue sem filtro */ }, { timeout: 8000 });
})();
<% } %>

(function(){
  // Autocomplete de cidade/bairro em JS puro (não usa <datalist> — o
  // dropdown nativo dele não funciona de forma confiável no Safari do
  // iPhone, reportado pelo Renato, ago/2026). Lista já vem pronta do
  // servidor (mesmos dados que alimentavam os <select> antigos).
  // Cidade continua single (escolheu, já busca); bairro virou multi —
  // cada clique numa sugestão ADICIONA um chip em vez de substituir
  // (ago/2026, pedido do Renato: dá pra marcar mais de um bairro).
  var CIDADES = <%- JSON.stringify(Object.keys(cidades).reduce(function(acc,k){ return acc.concat(cidades[k]||[]); }, [])) %>;
  var BAIRROS = <%- JSON.stringify(Object.keys(bairros).reduce(function(acc,k){ return acc.concat(bairros[k]||[]); }, [])) %>;

  function norm(s){ return String(s||'').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase(); }
  function escAttr(s){ return String(s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  // Cidade: comportamento de antes, um valor só.
  (function(){
    var input = document.getElementById('portal-cidade-input');
    var box = document.getElementById('portal-cidade-suggest');
    if(!input || !box) return;
    var filtrados = [];
    function renderizar(){
      var termoNorm = norm(input.value.trim());
      filtrados = termoNorm ? CIDADES.filter(function(c){ return norm(c).indexOf(termoNorm) !== -1; }).slice(0,8) : [];
      if(!filtrados.length){ box.classList.remove('on'); box.innerHTML=''; return; }
      box.innerHTML = filtrados.map(function(c){ return '<div>'+c+'</div>'; }).join('');
      box.classList.add('on');
      Array.prototype.forEach.call(box.children, function(el, i){
        el.addEventListener('mousedown', function(ev){
          ev.preventDefault();
          input.value = filtrados[i];
          box.classList.remove('on');
          input.form.submit();
        });
      });
    }
    input.addEventListener('input', renderizar);
    input.addEventListener('focus', renderizar);
    input.addEventListener('blur', function(){ setTimeout(function(){ box.classList.remove('on'); }, 150); });
  })();

  // Bairro: multi, por chip.
  function bairrosJaSelecionados(){
    return Array.prototype.map.call(document.querySelectorAll('#portal-bairro-chips input[name="bairro"]'), function(i){ return i.value; });
  }
  window.removerBairroChip = function(btnEl){
    var chip = btnEl.closest('.chip-bairro');
    if(chip) chip.parentNode.removeChild(chip);
    document.querySelector('.filtros-box').submit();
  };
  window.adicionarBairroChip = function(nome){
    if(!nome || bairrosJaSelecionados().indexOf(nome) !== -1) return;
    var chips = document.getElementById('portal-bairro-chips');
    var chip = document.createElement('span');
    chip.className = 'chip-bairro';
    chip.innerHTML = escAttr(nome) + '<input type="hidden" name="bairro" value="' + escAttr(nome) + '"><button type="button" onclick="removerBairroChip(this)" aria-label="Remover ' + escAttr(nome) + '">×</button>';
    chips.appendChild(chip);
    document.querySelector('.filtros-box').submit();
  };
  (function(){
    var input = document.getElementById('portal-bairro-input');
    var box = document.getElementById('portal-bairro-suggest');
    if(!input || !box) return;
    var filtrados = [];
    function renderizar(){
      var termoNorm = norm(input.value.trim());
      var jaSelecionados = bairrosJaSelecionados();
      filtrados = termoNorm ? BAIRROS.filter(function(b){ return jaSelecionados.indexOf(b) === -1 && norm(b).indexOf(termoNorm) !== -1; }).slice(0,8) : [];
      if(!filtrados.length){ box.classList.remove('on'); box.innerHTML=''; return; }
      box.innerHTML = filtrados.map(function(b){ return '<div>'+b+'</div>'; }).join('');
      box.classList.add('on');
      Array.prototype.forEach.call(box.children, function(el, i){
        el.addEventListener('mousedown', function(ev){
          ev.preventDefault();
          box.classList.remove('on');
          adicionarBairroChip(filtrados[i]);
        });
      });
    }
    input.addEventListener('input', renderizar);
    input.addEventListener('focus', renderizar);
    input.addEventListener('blur', function(){ setTimeout(function(){ box.classList.remove('on'); }, 150); });
  })();
})();
</script>

</body>
</html>
