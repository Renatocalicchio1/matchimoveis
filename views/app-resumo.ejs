<script>
function toggleMaisMenu(){
  const m=document.getElementById('maisMenu');
  const o=document.getElementById('maisOverlay');
  const open=m.style.display==='none';
  m.style.display=open?'block':'none';
  o.style.display=open?'block':'none';
  document.body.style.overflow=open?'hidden':'';
  document.documentElement.style.overflow=open?'hidden':'';
}
</script>

<script>
const CARDS = <%- JSON.stringify(cards || []) %>;
const BUSCA_INDEX = <%- JSON.stringify(buscaIndex || []) %>;
const LEADS_RESUMO = <%- JSON.stringify(leadsResumo || {}) %>;

let idx = 0, timer = null, dur = 7000, startedAt = 0, remaining = dur, micOpen = false;
// Marca o link com "?voltar=resumo" pra página de destino (lead, imóvel,
// perfil etc.) saber que veio daqui e mostrar um "← Voltar pro Tempo
// Real" — só em links internos de verdade (nunca WhatsApp/externo). O
// card em si já é lembrado sozinho via sessionStorage (ver renderCard).
// Escopo no topo do script (não dentro do "if (CARDS.length)") de
// propósito — é chamada tanto de dentro desse bloco (criarBotaoAcao)
// quanto de fora (abrirInfoLead/abrirInfoImovel, mais abaixo no arquivo).
function _comVoltarResumo(link) {
  if (!link || link.indexOf('/app/') !== 0) return link;
  const [caminho, hash] = link.split('#');
  const sep = caminho.indexOf('?') >= 0 ? '&' : '?';
  return caminho + sep + 'voltar=resumo' + (hash ? '#' + hash : '');
}
const bars = document.getElementById('bars');
const facesEl = document.getElementById('faces');
const screenEl = document.getElementById('screen');
// Precisa ficar num escopo acessível tanto por renderCard() quanto por
// montarOnboardingWhatsapp() (chamada de dentro de renderCard, mas definida
// fora dela) — bug real encontrado por simulação: como só existia dentro de
// renderCard, montarOnboardingWhatsapp jogava "onbWrap is not defined" e o
// card de "Conectar WhatsApp" ficava com a tela em branco (nunca chegava a
// escrever nada no DOM).
const onbWrap = document.getElementById('onbCardWrap');

function hexToRgba(hex, a) {
  const n = parseInt(hex.slice(1), 16);
  return 'rgba(' + [(n >> 16) & 255, (n >> 8) & 255, n & 255].join(',') + ',' + a + ')';
}

// Foto do card: galeria com scroll horizontal quando tem mais de 1 foto
// (pedido do Renato: "correr pro lado pra ver as fotos"), 1 foto só quando
// só tem uma, ou o ícone padrão quando o imóvel não tem foto nenhuma.
function _htmlFoto(c) {
  const fotos = (c.fotos && c.fotos.length ? c.fotos : (c.foto ? [c.foto] : []));
  if (fotos.length > 1) {
    return '<div class="k-foto-gallery">' + fotos.map(f => '<img src="' + f + '" alt="">').join('') + '</div>';
  }
  if (fotos.length === 1) return '<img class="k-foto" src="' + fotos[0] + '" alt="">';
  return '<span class="k-icon">' + c.icon + '</span>';
}

if (CARDS.length) {
  CARDS.forEach((c, i) => {
    const b = document.createElement('div');
    b.className = 'bar'; b.innerHTML = '<i></i>';
    bars.appendChild(b);
    const f = document.createElement('div');
    f.className = 'card-face';
    // Cor de fundo bem mais presente (pedido do Renato: "usar mais as
    // cores da plataforma"), não só um brilho fraco — a cor da categoria
    // (Rausch/Arches/Babu, paleta oficial Airbnb já usada no resto do
    // app) domina o topo do card e escurece pra baixo, onde fica o texto.
    f.style.background = 'radial-gradient(140% 110% at 15% -15%,' + hexToRgba(c.accent, .22) + ',transparent 62%),linear-gradient(175deg,' + hexToRgba(c.accent, .09) + ' 0%,#fff 70%)';
    f.style.opacity = '0';
    facesEl.appendChild(f);
  });

  // Monta um botão de ação — se o link aponta pra /app/lead/:id e a gente
  // já tem o resumo dessa lead (LEADS_RESUMO), abre o painel inline em vez
  // de navegar embora da tela do resumo; mesma ideia pra /app/imovel/:id
  // (usa a foto/nome/detalhe que o PRÓPRIO card já tem — é o mesmo imóvel
  // sendo mostrado, não precisa buscar de novo). Qualquer outro link
  // (WhatsApp, /app/visitas, /app/leads etc.) continua navegação normal.
  function criarBotaoAcao(label, link, isPrimary, accent, c) {
    const leadId = link && link.indexOf('/app/lead/') === 0 ? link.slice('/app/lead/'.length) : null;
    if (leadId && LEADS_RESUMO[leadId]) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'act-btn' + (isPrimary ? ' primary' : '');
      if (isPrimary) btn.style.setProperty('--card-accent', accent);
      btn.textContent = label;
      btn.addEventListener('click', () => abrirInfoLead(leadId));
      return btn;
    }
    if (link && link.indexOf('/app/imovel/') === 0 && c) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'act-btn' + (isPrimary ? ' primary' : '');
      if (isPrimary) btn.style.setProperty('--card-accent', accent);
      btn.textContent = label;
      btn.addEventListener('click', () => abrirInfoImovel(c, link));
      return btn;
    }
    const a = document.createElement('a');
    a.className = 'act-btn' + (isPrimary ? ' primary' : '');
    if (isPrimary) a.style.setProperty('--card-accent', accent);
    a.textContent = label;
    a.href = _comVoltarResumo(link || '#');
    if ((link || '').indexOf('wa.me') >= 0) a.target = '_blank';
    return a;
  }

  // Coraçõezinhos subindo quando o card é de "curtiu um imóvel" — feedback
  // visual rápido, puramente decorativo (pedido do Renato).
  const heartsLayer = document.getElementById('heartsLayer');
  function dispararCoracoes() {
    const cores = ['❤️', '💗', '💕'];
    for (let hi = 0; hi < 10; hi++) {
      setTimeout(() => {
        const h = document.createElement('span');
        h.className = 'heart-fly';
        h.textContent = cores[Math.floor(Math.random() * cores.length)];
        h.style.left = (20 + Math.random() * 60) + '%';
        h.style.setProperty('--drift', (Math.random() * 60 - 30) + 'px');
        h.style.setProperty('--rot', (Math.random() * 40 - 20) + 'deg');
        h.style.animationDuration = (2 + Math.random()) + 's';
        heartsLayer.appendChild(h);
        setTimeout(() => h.remove(), 3200);
      }, hi * 140);
    }
  }

  function renderCard(i) {
    const c = CARDS[i];
    // Sempre grava o card atual — é o que permite voltar exatamente aqui
    // se a pessoa sair pra outra página (ver renderCard(_idxInicial) mais
    // abaixo, no início do carrossel).
    try { sessionStorage.setItem('resumoIdx', i); } catch (e) {}
    document.getElementById('chipCat').textContent = c.cat;
    if (c.coracoes) dispararCoracoes();
    const body = document.getElementById('cardBody');
    const actions = document.getElementById('cardActions');

    // "Primeiro passo" com ação inline (ex: importar XML, conectar
    // WhatsApp) — usa um container PRÓPRIO (#onbCardWrap), separado de
    // #cardBody/#cardActions, pra não depender de 2 blocos ancorados por
    // `bottom` que podem se sobrepor quando o texto quebra em mais linhas
    // do que o previsto.
    if (c.tipoAcao === 'onboarding_xml' || c.tipoAcao === 'onboarding_whatsapp' || c.tipoAcao === 'onboarding_leadmanual') {
      body.style.display = 'none';
      actions.style.display = 'none';
      onbWrap.style.display = 'flex';
      if (c.tipoAcao === 'onboarding_xml') {
        onbWrap.innerHTML =
          (c.foto ? '<img class="k-foto" src="' + c.foto + '" alt="">' : '<span class="k-icon">' + c.icon + '</span>') +
          '<h2 class="k-name">' + c.nome + '</h2>' +
          '<p class="k-detail">' + c.detalhe + '</p>' +
          '<div class="onb-form">' +
            '<input type="text" id="onbXmlUrl" placeholder="Cole o link do XML aqui" class="onb-input" inputmode="url" autocapitalize="off" autocorrect="off">' +
            '<button type="button" id="onbXmlBtn" class="act-btn primary" style="--card-accent:' + c.accent + '">📥 Importar XML</button>' +
            '<div class="onb-status" id="onbXmlStatus"></div>' +
          '</div>';
        document.getElementById('onbXmlUrl').addEventListener('focus', pauseTimer);
        document.getElementById('onbXmlBtn').addEventListener('click', iniciarImportacaoXml);
      } else if (c.tipoAcao === 'onboarding_whatsapp') {
        montarOnboardingWhatsapp(c);
      } else {
        montarOnboardingLeadManual(c);
      }
      [...facesEl.children].forEach((f, fi) => f.style.opacity = fi === i ? '1' : '0');
      return;
    }
    body.style.display = '';
    actions.style.display = '';
    onbWrap.style.display = 'none';
    onbWrap.innerHTML = '';

    body.innerHTML =
      _htmlFoto(c) +
      '<h2 class="k-name">' + c.nome + '</h2>' +
      '<p class="k-detail">' + c.detalhe + '</p>' +
      '<div class="k-meta"><span class="k-tag ' + c.tag + '">' + c.tagText + '</span><span class="k-time">' + c.time + '</span></div>';
    actions.innerHTML = '';

    if (c.curtirImovel) {
      const curtirEl = document.createElement('button');
      curtirEl.type = 'button';
      curtirEl.className = 'act-btn primary';
      curtirEl.style.setProperty('--card-accent', c.accent);
      curtirEl.textContent = c.primary;
      curtirEl.addEventListener('click', () => {
        fetch('/api/favoritos/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ imovelId: c.curtirImovel })
        }).catch(() => {});
        curtirEl.textContent = '❤️ Curtido!';
        curtirEl.disabled = true;
        dispararCoracoes();
      });
      actions.appendChild(curtirEl);
    } else {
      actions.appendChild(criarBotaoAcao(c.primary, c.primaryLink, true, c.accent, c));
    }

    if (c.marcarFalado) {
      const secEl = document.createElement('button');
      secEl.type = 'button';
      secEl.className = 'act-btn';
      secEl.textContent = c.secondary;
      secEl.addEventListener('click', () => {
        fetch('/app/lead/' + c.marcarFalado + '/marcar-falado', { method: 'POST' }).catch(() => {});
        secEl.textContent = '✓ Falado';
        secEl.disabled = true;
      });
      actions.appendChild(secEl);
    } else if (c.verPassos) {
      const secEl = document.createElement('button');
      secEl.type = 'button';
      secEl.className = 'act-btn';
      secEl.textContent = c.secondary;
      secEl.addEventListener('click', abrirPassos);
      actions.appendChild(secEl);
    } else {
      actions.appendChild(criarBotaoAcao(c.secondary, c.secondaryLink, false, c.accent, c));
    }

    [...facesEl.children].forEach((f, fi) => f.style.opacity = fi === i ? '1' : '0');
  }

  // Conectar WhatsApp direto do card (QR ou código), sem sair do resumo —
  // reaproveita as mesmas rotas de /app/perfil (GET /app/whatsapp/qrcode,
  // GET /app/whatsapp/pairing-code, GET /app/whatsapp/status).
  let _onbWaModo = 'qr';
  let _onbWaTimer = null;

  function montarOnboardingWhatsapp(c) {
    onbWrap.innerHTML =
      '<span class="k-icon">' + c.icon + '</span>' +
      '<h2 class="k-name">' + c.nome + '</h2>' +
      '<p class="k-detail">' + c.detalhe + '</p>' +
      '<div class="onb-toggle">' +
        '<button type="button" id="onbWaTabQr" class="on">📷 QR Code</button>' +
        '<button type="button" id="onbWaTabCode">🔢 Código</button>' +
      '</div>' +
      '<div class="onb-qr-box" id="onbWaQrBox"><img id="onbWaQrImg" alt=""></div>' +
      '<div class="onb-code-box" id="onbWaCodeBox">' +
        '<input type="tel" id="onbWaNumero" class="onb-input" placeholder="Ex: 11999999999" inputmode="numeric">' +
        '<div class="onb-code-big" id="onbWaCodeBig" style="display:none"></div>' +
      '</div>' +
      '<button type="button" id="onbWaBtn" class="act-btn primary" style="--card-accent:' + c.accent + '">🚀 Conectar WhatsApp</button>' +
      '<div class="onb-status" id="onbWaStatus"></div>';

    _onbWaModo = 'qr';
    document.getElementById('onbWaTabQr').addEventListener('click', () => _alternarOnbWaModo('qr'));
    document.getElementById('onbWaTabCode').addEventListener('click', () => _alternarOnbWaModo('code'));
    document.getElementById('onbWaNumero').addEventListener('focus', pauseTimer);
    document.getElementById('onbWaBtn').addEventListener('click', _conectarOnbWhatsapp);
  }

  function _alternarOnbWaModo(modo) {
    _onbWaModo = modo;
    document.getElementById('onbWaTabQr').classList.toggle('on', modo === 'qr');
    document.getElementById('onbWaTabCode').classList.toggle('on', modo === 'code');
    document.getElementById('onbWaQrBox').style.display = modo === 'qr' ? 'block' : 'none';
    document.getElementById('onbWaCodeBox').style.display = modo === 'code' ? 'block' : 'none';
  }

  async function _conectarOnbWhatsapp() {
    if (_onbWaModo === 'code') return _conectarOnbWhatsappCodigo();
    const btn = document.getElementById('onbWaBtn');
    const status = document.getElementById('onbWaStatus');
    pauseTimer();
    btn.textContent = '⏳ Gerando QR...';
    btn.disabled = true;
    status.textContent = '';
    try {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 15000);
      const resp = await fetch('/app/whatsapp/qrcode', { signal: controller.signal });
      clearTimeout(timeout);
      const d = await resp.json();
      if (d.base64) {
        const img = document.getElementById('onbWaQrImg');
        img.src = d.base64.indexOf('data:image') === 0 ? d.base64 : ('https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(d.base64));
        document.getElementById('onbWaQrBox').style.display = 'block';
        btn.textContent = '🔄 Gerar novo QR';
        btn.disabled = false;
        _iniciarPollOnbWa();
      } else {
        btn.textContent = '🚀 Conectar WhatsApp';
        btn.disabled = false;
        status.textContent = '❌ ' + (d.erro || 'Não consegui gerar o QR.');
      }
    } catch (e) {
      btn.textContent = '🚀 Conectar WhatsApp';
      btn.disabled = false;
      status.textContent = '❌ Conexão falhou, tenta de novo.';
    }
  }

  async function _conectarOnbWhatsappCodigo() {
    const btn = document.getElementById('onbWaBtn');
    const status = document.getElementById('onbWaStatus');
    const numero = (document.getElementById('onbWaNumero').value || '').replace(/\D/g, '');
    if (!numero || numero.length < 10) { status.textContent = '⚠️ Informe um número válido com DDD.'; return; }
    pauseTimer();
    btn.textContent = '⏳ Gerando código...';
    btn.disabled = true;
    status.textContent = '';
    try {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 35000);
      const resp = await fetch('/app/whatsapp/pairing-code?numero=' + numero, { signal: controller.signal });
      clearTimeout(timeout);
      const d = await resp.json();
      if (d.pairingCode) {
        const big = document.getElementById('onbWaCodeBig');
        big.textContent = d.pairingCode;
        big.style.display = 'block';
        btn.textContent = '🔄 Gerar novo código';
        btn.disabled = false;
        _iniciarPollOnbWa();
      } else {
        btn.textContent = '🚀 Conectar WhatsApp';
        btn.disabled = false;
        status.textContent = '❌ ' + (d.erro || 'Não consegui gerar o código.');
      }
    } catch (e) {
      btn.textContent = '🚀 Conectar WhatsApp';
      btn.disabled = false;
      status.textContent = '❌ Conexão falhou, tenta de novo.';
    }
  }

  function _iniciarPollOnbWa() {
    if (_onbWaTimer) clearInterval(_onbWaTimer);
    _onbWaTimer = setInterval(async () => {
      try {
        const d = await (await fetch('/app/whatsapp/status')).json();
        if (d.status === 'open') {
          clearInterval(_onbWaTimer);
          _onbWaTimer = null;
          const status = document.getElementById('onbWaStatus');
          if (status) status.textContent = '✅🎉 WhatsApp conectado! (' + (d.numero || '') + ')';
          const btn = document.getElementById('onbWaBtn');
          if (btn) { btn.textContent = '✅ Conectado!'; btn.disabled = true; }
        }
      } catch (e) {}
    }, 3000);
  }

  // Importa o XML direto do card, sem sair do resumo, e mostra o resultado
  // ali mesmo — reaproveita POST /app/importar (mesma rota de /app/cadastro)
  // + GET /import-status pra acompanhar o job assíncrono.
  function iniciarImportacaoXml() {
    const input = document.getElementById('onbXmlUrl');
    const status = document.getElementById('onbXmlStatus');
    const btn = document.getElementById('onbXmlBtn');
    const url = (input.value || '').trim();
    if (!url) { status.textContent = 'Cole o link do XML primeiro.'; return; }
    pauseTimer();
    btn.disabled = true;
    status.textContent = 'Enviando…';
    const fd = new FormData();
    fd.append('xmlUrl', url);
    fetch('/app/importar', { method: 'POST', body: fd })
      .then(r => r.json())
      .then(d => {
        if (!d || !d.ok) {
          status.textContent = '❌ ' + ((d && d.erro) || 'Erro ao importar');
          btn.disabled = false;
          return;
        }
        status.textContent = '⏳ Importando…';
        _acompanharImportacaoXml(status, btn);
      })
      .catch(() => { status.textContent = '❌ Erro de conexão'; btn.disabled = false; });
  }

  function _acompanharImportacaoXml(status, btn) {
    let tentativas = 0;
    const t = setInterval(() => {
      tentativas++;
      fetch('/import-status').then(r => r.json()).then(d => {
        const st = d && d.status;
        if (!st || typeof st === 'string') return; // ainda não iniciou de verdade
        if (st.status === 'finalizado' || st.status === 'finalizado_parcial') {
          clearInterval(t);
          status.textContent = '✅ ' + (st.mensagem || (st.total + ' imóveis importados'));
          btn.textContent = '📥 Importar outro XML';
          btn.disabled = false;
        } else {
          status.textContent = '⏳ Importando… (' + (st.total || 0) + ' até agora)';
        }
      }).catch(() => {});
      if (tentativas > 240) clearInterval(t); // ~10min de segurança
    }, 2500);
  }

  // Cadastro rápido de lead manual, inline (mesmo padrão do XML) — pedido
  // do Renato: "manter na página de resumo". Só nome+telefone (mínimo pra
  // criar a lead e já rodar o match); o resto dá pra completar depois na
  // tela normal de detalhe da lead.
  function montarOnboardingLeadManual(c) {
    onbWrap.innerHTML =
      '<span class="k-icon">' + c.icon + '</span>' +
      '<h2 class="k-name">' + c.nome + '</h2>' +
      '<p class="k-detail">' + c.detalhe + '</p>' +
      '<div class="onb-form">' +
        '<input type="text" id="onbLeadNome" placeholder="Nome da lead" class="onb-input" autocapitalize="words">' +
        '<input type="tel" id="onbLeadTel" placeholder="WhatsApp (com DDD)" class="onb-input" inputmode="numeric">' +
        '<button type="button" id="onbLeadBtn" class="act-btn primary" style="--card-accent:' + c.accent + '">👤 Cadastrar lead</button>' +
        '<div class="onb-status" id="onbLeadStatus"></div>' +
      '</div>';
    document.getElementById('onbLeadNome').addEventListener('focus', pauseTimer);
    document.getElementById('onbLeadTel').addEventListener('focus', pauseTimer);
    document.getElementById('onbLeadBtn').addEventListener('click', _cadastrarLeadManual);
  }
  function _cadastrarLeadManual() {
    const nome = (document.getElementById('onbLeadNome').value || '').trim();
    const telefone = (document.getElementById('onbLeadTel').value || '').replace(/\D/g, '');
    const btn = document.getElementById('onbLeadBtn');
    const status = document.getElementById('onbLeadStatus');
    if (!nome) { status.textContent = 'Coloca o nome da lead primeiro.'; return; }
    if (!telefone || telefone.length < 10) { status.textContent = 'WhatsApp inválido, coloca com DDD.'; return; }
    btn.disabled = true;
    status.textContent = 'Cadastrando…';
    fetch('/app/lead/manual', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ nome, telefone })
    })
      .then(r => r.json())
      .then(d => {
        if (!d || !d.ok) {
          status.textContent = '❌ ' + ((d && d.erro) || 'Erro ao cadastrar');
          btn.disabled = false;
          return;
        }
        status.textContent = '✅ Lead cadastrada! Rodando o match…';
        btn.textContent = '👤 Cadastrar outra lead';
        btn.disabled = false;
        document.getElementById('onbLeadNome').value = '';
        document.getElementById('onbLeadTel').value = '';
      })
      .catch(() => { status.textContent = '❌ Erro de conexão'; btn.disabled = false; });
  }

  function resetBars(from) {
    [...bars.children].forEach((b, bi) => {
      b.querySelector('i').style.transition = 'none';
      b.querySelector('i').style.width = bi < from ? '100%' : '0%';
    });
  }

  function playBar(i) {
    resetBars(i);
    const fill = bars.children[i].querySelector('i');
    requestAnimationFrame(() => {
      fill.style.transition = 'width ' + remaining + 'ms linear';
      fill.style.width = '100%';
    });
  }

  function goTo(i) {
    idx = (i + CARDS.length) % CARDS.length;
    remaining = dur;
    renderCard(idx);
    playBar(idx);
    restartTimer();
  }
  function next() { goTo(idx + 1); }
  function prev() { goTo(idx - 1); }

  function restartTimer() {
    clearTimeout(timer);
    if (micOpen) return;
    startedAt = Date.now();
    timer = setTimeout(next, remaining);
  }
  function pauseTimer() {
    clearTimeout(timer);
    remaining = Math.max(400, remaining - (Date.now() - startedAt));
  }

  // Navegação real por arrastar (swipe) + toque nas laterais como atalho —
  // tudo num único listener em vez das zonas de toque fixas de antes, que
  // ficavam por baixo dos botões de ação e às vezes roubavam o clique deles.
  // Ignora qualquer interação que comece dentro de .actions/.mic-wrap/
  // .voice-sheet pra nunca competir com um botão de verdade.
  let _dragAtivo = false, _dragX = 0, _dragY = 0, _arrastou = false;
  screenEl.addEventListener('pointerdown', (e) => {
    if (e.target.closest('.actions, .mic-wrap, .voice-sheet')) return;
    _dragAtivo = true; _arrastou = false;
    _dragX = e.clientX; _dragY = e.clientY;
    pauseTimer();
  });
  screenEl.addEventListener('pointermove', (e) => {
    if (!_dragAtivo) return;
    if (Math.abs(e.clientX - _dragX) > 10) _arrastou = true;
  });
  screenEl.addEventListener('pointerup', (e) => {
    if (e.target.closest('.actions, .mic-wrap, .voice-sheet')) return;
    if (!_dragAtivo) return;
    _dragAtivo = false;
    const deltaX = e.clientX - _dragX, deltaY = e.clientY - _dragY;
    if (micOpen) return;
    if (Math.abs(deltaX) > 50 && Math.abs(deltaX) > Math.abs(deltaY)) {
      deltaX < 0 ? next() : prev();
    } else if (!_arrastou) {
      const w = window.innerWidth;
      if (e.clientX < w * 0.35) prev();
      else if (e.clientX > w * 0.65) next();
      else restartTimer();
    } else {
      restartTimer();
    }
  });

  // Volta exatamente no card onde a pessoa estava, se ela saiu pra outra
  // página (ex: "Perfil completo"/"Ver página completa") e voltou — pedido
  // do Renato: "voltar pra página de tempo real exatamente onde ele
  // estava". idx some da memória (não é query string) então funciona sem
  // sujar a URL, mas só sobrevive enquanto a aba ficar aberta.
  let _idxInicial = 0;
  try {
    const _salvo = parseInt(sessionStorage.getItem('resumoIdx'), 10);
    if (!isNaN(_salvo) && _salvo >= 0 && _salvo < CARDS.length) _idxInicial = _salvo;
    sessionStorage.removeItem('resumoIdx');
  } catch (e) {}
  renderCard(_idxInicial);
  playBar(_idxInicial);
  idx = _idxInicial;
  restartTimer();

  // Reconstrói o carrossel inteiro (barras + faces + card atual) quando
  // chega um conjunto de cards novo do polling em tempo real abaixo —
  // preserva a posição atual quando possível (não faz sentido voltar pro
  // card 1 só porque um "há X min" mudou em outro card).
  function reconstruirCarrossel(novosCards) {
    CARDS.length = 0;
    novosCards.forEach(c => CARDS.push(c));
    bars.innerHTML = '';
    facesEl.innerHTML = '';
    CARDS.forEach((c) => {
      const b = document.createElement('div');
      b.className = 'bar'; b.innerHTML = '<i></i>';
      bars.appendChild(b);
      const f = document.createElement('div');
      f.className = 'card-face';
      // Cor de fundo bem mais presente (pedido do Renato: "usar mais as
    // cores da plataforma"), não só um brilho fraco — a cor da categoria
    // (Rausch/Arches/Babu, paleta oficial Airbnb já usada no resto do
    // app) domina o topo do card e escurece pra baixo, onde fica o texto.
    f.style.background = 'radial-gradient(140% 110% at 15% -15%,' + hexToRgba(c.accent, .22) + ',transparent 62%),linear-gradient(175deg,' + hexToRgba(c.accent, .09) + ' 0%,#fff 70%)';
      f.style.opacity = '0';
      facesEl.appendChild(f);
    });
    idx = Math.max(0, Math.min(idx, CARDS.length - 1));
    remaining = dur;
    renderCard(idx);
    playBar(idx);
    restartTimer();
  }

  // Tempo real (set/2026, pedido do Renato: "vai ser tempo real, ele tem
  // que acessar o tempo real") — busca dados novos a cada 40s (GET
  // /api/resumo/dados, mesma função de montagem do servidor que a página
  // usou no load) e só reconstrói o carrossel se os cards realmente
  // mudaram (novo sinal, não só o "há X min" andando) — e nunca enquanto o
  // corretor está com um sheet de voz/lead aberto, pra não interromper ele.
  async function _atualizarDadosResumo() {
    if (micOpen) return;
    try {
      const r = await fetch('/api/resumo/dados');
      const d = await r.json();
      if (!d || !d.ok) return;
      Object.assign(LEADS_RESUMO, d.leadsResumo || {});
      BUSCA_INDEX.length = 0;
      (d.buscaIndex || []).forEach(it => BUSCA_INDEX.push(it));
      const novosCards = d.cards || [];
      const chaveAtual = CARDS.map(c => c.nome + '|' + c.cat).join('~');
      const chaveNova = novosCards.map(c => c.nome + '|' + c.cat).join('~');
      if (chaveAtual !== chaveNova && novosCards.length) reconstruirCarrossel(novosCards);
    } catch (e) {}
  }
  setInterval(_atualizarDadosResumo, 40000);
}

// ── comando de voz real (Web Speech API — precisa HTTPS + Chrome/Android;
// sem suporte em iOS Safari nem em navegador sem microfone liberado) ──
const micBtn = document.getElementById('micBtn');
const sheet = document.getElementById('voiceSheet');
const vStatus = document.getElementById('voiceStatus');
const vTranscript = document.getElementById('voiceTranscript');
const vResults = document.getElementById('voiceResults');

// ── painel rápido de lead (abre "Ver lead" dentro do resumo, sem navegar
// embora) — mesmo cartão visual do resultado de voz (.voice-card), só que
// alimentado por LEADS_RESUMO (já veio pronto do servidor, sem round-trip) ──
const infoSheet = document.getElementById('infoSheet');
const infoContent = document.getElementById('infoContent');

// Esconde o menu de baixo enquanto o voice-sheet/infoSheet estiver aberto —
// sem isso o menu (z-index mais alto, precisa ficar acima do carrossel)
// cobria o rodapé do sheet, cortando o fim da transcrição/resultado.
const _navBottom = document.querySelector('.bottom-nav');
function _toggleNavParaSheet(aberto) { if (_navBottom) _navBottom.style.display = aberto ? 'none' : ''; }

function abrirInfoLead(id) {
  const info = LEADS_RESUMO[id];
  if (!info) { location.href = '/app/lead/' + id; return; }
  if (typeof pauseTimer === 'function') pauseTimer();
  micOpen = true; // reaproveita a trava que impede o carrossel de avançar sozinho com um sheet aberto
  _toggleNavParaSheet(true);
  const gostei = info.gostei && info.gostei.length ? ('<div class="vc-detail">❤️ Curtiu: ' + info.gostei.join(', ') + '</div>') : '';
  const atividade = info.ultimaAtividade ? ('<div class="vc-detail">🕓 Última atividade: ' + info.ultimaAtividade + '</div>') : '';
  const telLimpo = (info.telefone || '').replace(/\D/g, '');
  infoContent.innerHTML =
    '<div class="voice-card" style="margin:0">' +
      '<div class="vc-top"><span class="vc-icon">👤</span><div>' +
        '<div class="vc-name">' + info.nome + '</div>' +
        '<div class="vc-detail">' + (info.telefone || 'sem telefone') + ' · ' + info.matchCount + ' imóve' + (info.matchCount === 1 ? 'l' : 'is') + ' em match · origem: ' + info.origem + '</div>' +
        gostei + atividade +
      '</div></div>' +
      '<div class="vc-actions">' +
        (telLimpo ? '<a class="vc-btn" target="_blank" href="https://wa.me/55' + telLimpo.replace(/^55/, '') + '">💬 Falar</a>' : '') +
        '<a class="vc-btn sec" href="' + _comVoltarResumo(info.link) + '">Perfil completo</a>' +
      '</div>' +
    '</div>';
  infoSheet.classList.add('open');

  // "✓ Já falei" — set/2026, pedido do Renato: "mostrar que já foi
  // comunicado". Fica aqui (não em cada card) pra não empilhar botão em
  // cima de botão — esse painel já é o ponto comum de "ver essa lead"
  // vindo de QUALQUER tipo de card, então marcar aqui já silencia ela em
  // todos eles (propensão, curtiu, vitrine, nova lead) até surgir sinal novo.
  const jaFaladoBtn = document.createElement('button');
  jaFaladoBtn.type = 'button';
  jaFaladoBtn.className = 'vc-btn sec';
  jaFaladoBtn.style.marginTop = '2px';
  jaFaladoBtn.textContent = '✓ Já falei com ela';
  jaFaladoBtn.addEventListener('click', () => {
    fetch('/app/lead/' + id + '/marcar-falado', { method: 'POST' }).catch(() => {});
    jaFaladoBtn.textContent = '✅ Marcado como falado';
    jaFaladoBtn.disabled = true;
  });
  infoContent.appendChild(jaFaladoBtn);
}
// Cartãozinho inline do imóvel — mesma ideia de abrirInfoLead, só que pro
// "Ver imóvel": reaproveita a foto/nome/detalhe que o card já tem (é o
// mesmo imóvel), sem sair da tela do resumo. "Ver página completa" é o
// único link de verdade (navega), igual "Perfil completo" faz pra lead.
function abrirInfoImovel(c, link) {
  if (typeof pauseTimer === 'function') pauseTimer();
  micOpen = true;
  _toggleNavParaSheet(true);
  infoContent.innerHTML =
    '<div class="voice-card" style="margin:0">' +
      (c.foto ? '<img class="vc-foto" src="' + c.foto + '" alt="">' : '') +
      '<div class="vc-top"><span class="vc-icon">🏠</span><div>' +
        '<div class="vc-name">' + c.nome + '</div>' +
        '<div class="vc-detail">' + c.detalhe + '</div>' +
      '</div></div>' +
      '<div class="vc-actions">' +
        '<a class="vc-btn sec" href="' + _comVoltarResumo(link) + '">🔍 Ver página completa</a>' +
      '</div>' +
    '</div>';
  infoSheet.classList.add('open');
}
// "Ver todos os passos" — mesma ideia, painel inline em vez de navegar pra
// /app-home. Busca a mesma rota que o modal "Primeiros Passos" do resto da
// plataforma já usa (/api/onboarding/status), fonte única, sem duplicar
// lista.
function abrirPassos() {
  if (typeof pauseTimer === 'function') pauseTimer();
  micOpen = true;
  _toggleNavParaSheet(true);
  infoContent.innerHTML = '<div class="voice-card" style="margin:0"><div class="vc-detail">Carregando…</div></div>';
  infoSheet.classList.add('open');
  fetch('/api/onboarding/status').then(r => r.json()).then(d => {
    const passos = (d && d.passos) || [];
    const linhas = passos.map(p =>
      '<div class="vc-top" style="align-items:center">' +
        '<span class="vc-icon">' + (p.feito ? '✅' : '⬜') + '</span>' +
        '<div><div class="vc-name" style="font-size:14px">' + p.label + '</div>' +
        (p.feito ? '' : '<a class="vc-detail" style="color:var(--rausch);text-decoration:underline" href="' + p.link + '">' + p.acao + ' →</a>') +
        '</div>' +
      '</div>'
    ).join('');
    infoContent.innerHTML =
      '<div class="voice-card" style="margin:0">' +
        '<div class="vc-name" style="margin-bottom:8px">✅ Primeiros passos (' + (d.feitos||0) + '/' + (d.total||passos.length) + ')</div>' +
        linhas +
      '</div>';
  }).catch(() => { infoContent.innerHTML = '<div class="voice-card" style="margin:0"><div class="vc-detail">❌ Não consegui carregar agora.</div></div>'; });
}
function fecharInfoSheet() {
  infoSheet.classList.remove('open');
  micOpen = false;
  _toggleNavParaSheet(false);
  if (typeof restartTimer === 'function') restartTimer();
}
infoSheet.addEventListener('click', (e) => { if (e.target === infoSheet) fecharInfoSheet(); });
// Botão "✕" explícito — antes só dava pra fechar tocando fora do cartão
// (área estreita, pouco óbvia). Pedido do Renato: precisa ter como fechar.
document.getElementById('infoSheetClose').addEventListener('click', fecharInfoSheet);
document.getElementById('voiceSheetClose').addEventListener('click', () => micBtn.click());

function normalizar(s) {
  return String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
}

function abrirSheet() {
  micOpen = true;
  if (typeof pauseTimer === 'function') pauseTimer();
  micBtn.classList.add('on');
  sheet.classList.add('open');
  _toggleNavParaSheet(true);
  vStatus.textContent = 'ouvindo…';
  vTranscript.textContent = '';
  vTranscript.classList.remove('show');
  vResults.innerHTML = '';
}
function fecharSheet() {
  micOpen = false;
  micBtn.classList.remove('on');
  sheet.classList.remove('open');
  _toggleNavParaSheet(false);
  if (typeof restartTimer === 'function') restartTimer();
}

// Mostra o resultado de um comando de voz como CARD de verdade (mesma
// linguagem visual dos cards do carrossel principal), nunca como lista de
// texto — pedido do Renato: "qualquer ação que ele fizer você tem que
// mostrar num card da ação acontecendo".
// Monta o HTML de um botão de resultado de voz — se o link aponta pra uma
// lead que já temos em LEADS_RESUMO, abre inline (abrirInfoLead) em vez de
// navegar embora do resumo, igual os cards do carrossel principal já
// fazem via criarBotaoAcao. set/2026, pedido do Renato: "ele não tem que
// ir pro painel" — esse era o buraco que faltava (resultado de voz sempre
// navegava, nunca checava se dava pra ficar inline).
function _botaoResultadoVozHtml(label, link, classe) {
  if (!link) return '';
  const leadId = link.indexOf('/app/lead/') === 0 ? link.slice('/app/lead/'.length) : null;
  if (leadId && LEADS_RESUMO[leadId]) {
    return '<button type="button" class="' + classe + '" onclick="abrirInfoLead(\'' + leadId + '\')">' + label + '</button>';
  }
  return '<a class="' + classe + '" href="' + link + '"' + (link.indexOf('wa.me') >= 0 ? ' target="_blank"' : '') + '>' + label + '</a>';
}

function mostrarCardResultado(item) {
  const card = document.createElement('div');
  card.className = 'voice-card';
  const botoes = [];
  if (item.primaryLink) botoes.push(_botaoResultadoVozHtml(item.primaryLabel || 'Abrir', item.primaryLink, 'vc-btn'));
  if (item.secondaryLink) botoes.push(_botaoResultadoVozHtml(item.secondaryLabel || 'Ver', item.secondaryLink, 'vc-btn sec'));
  card.innerHTML =
    (item.foto ? '<img class="vc-foto" src="' + item.foto + '" alt="">' : '') +
    '<div class="vc-top"><span class="vc-icon">' + (item.icon || '👤') + '</span><div><div class="vc-name">' + item.nome + '</div>' +
    (item.detalhe ? '<div class="vc-detail">' + item.detalhe + '</div>' : '') + '</div></div>' +
    (botoes.length ? '<div class="vc-actions">' + botoes.join('') + '</div>' : '');
  vResults.appendChild(card);
}

// Resposta de texto livre do assistente de verdade (Central
// Operacional/IA, reaproveita POST /app/assistente/chat) — pra perguntas
// que não são busca por nome, tipo "quantas leads eu tenho". Construído via
// textContent (não innerHTML) porque o texto vem de fora (a IA), nunca
// confiar nele como HTML.
function mostrarRespostaAssistente(texto) {
  const card = document.createElement('div');
  card.className = 'voice-card';
  const top = document.createElement('div');
  top.className = 'vc-top';
  const icon = document.createElement('span');
  icon.className = 'vc-icon';
  icon.textContent = '🤖';
  const detail = document.createElement('div');
  detail.className = 'vc-detail';
  // mesmo campo que o chat de /app/assistente já renderiza como HTML
  // (cerebro/index.js monta a resposta com <strong>/<br> de propósito) —
  // textContent mostrava as tags literalmente em vez de formatar.
  detail.innerHTML = texto;
  top.appendChild(icon);
  top.appendChild(detail);
  card.appendChild(top);
  vResults.appendChild(card);
}

function perguntarAssistente(texto) {
  vStatus.textContent = '🤔 pensando…';
  fetch('/app/assistente/chat', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ mensagem: texto })
  }).then(r => r.json()).then(d => {
    vStatus.textContent = 'aqui está';
    mostrarRespostaAssistente((d && d.resposta) || 'Não consegui entender, tenta de novo.');
  }).catch(() => {
    vStatus.textContent = '❌ não consegui falar com o assistente agora';
  });
}

const _PALAVRAS_GENERICAS = /\b(uma?|o|a|de|do|da|lead|cliente|leads|clientes|imovel|imóvel|imoveis|imóveis)\b/g;

function processarComando(texto) {
  // Memória de tudo que o corretor fala por voz aqui — fire-and-forget,
  // não atrasa a resposta na tela. Pedido do Renato: "capturar e criar uma
  // memória de tudo o que ele está falando".
  fetch('/api/resumo/comando-voz', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ texto })
  }).catch(() => {});

  const t = normalizar(texto);
  vResults.innerHTML = '';
  const m = t.match(/^(?:busca|procura|abre|abrir|ver|mostra|traz|traga|me traz|me traga|puxa)\s+(.+)/);
  const bruto = m ? m[1].trim() : t;
  const termo = bruto.replace(_PALAVRAS_GENERICAS, ' ').replace(/\s+/g, ' ').trim();

  const _pareceComando = /^(?:busca|procura|abre|abrir|ver|mostra|traz|traga|me traz|me traga|puxa)\b/.test(t);
  const _pareceProgunta = /\b(quant|quem|qual|quais|onde|como|por ?que)\b|\?$/.test(t);

  if (termo) {
    const resultados = BUSCA_INDEX.filter(it => normalizar(it.nome).indexOf(termo) >= 0);
    if (resultados.length) {
      vStatus.textContent = resultados.length === 1 ? 'encontrei' : (resultados.length + ' resultados');
      resultados.slice(0, 5).forEach(r => {
        mostrarCardResultado({
          icon: r.tipo === 'lead' ? '👤' : '🏠',
          foto: r.foto || '',
          nome: r.nome,
          primaryLink: r.tipo === 'lead' && r.tel ? ('https://wa.me/55' + r.tel.replace(/\D/g, '').replace(/^55/, '')) : r.link,
          primaryLabel: r.tipo === 'lead' ? '💬 Falar' : 'Ver imóvel',
          secondaryLink: r.tipo === 'lead' ? r.link : '',
          secondaryLabel: 'Ver lead'
        });
      });
      return;
    }
  }

  // Sem nome específico, mas parece pedido pra trazer algo (ex: "traga uma
  // lead", "quem eu falo agora") — não uma pergunta — traz o card de maior
  // prioridade do carrossel como resultado da ação.
  if (/\b(lead|cliente)\b/.test(t) && CARDS.length && (_pareceComando || !_pareceProgunta)) {
    const c = CARDS[0];
    vStatus.textContent = 'aqui está';
    mostrarCardResultado({ icon: c.icon, foto: c.foto || '', nome: c.nome, detalhe: c.detalhe, primaryLink: c.primaryLink, primaryLabel: c.primary, secondaryLink: c.secondaryLink, secondaryLabel: c.secondary });
    return;
  }

  // Nada disso — pergunta aberta de verdade (ex: "quantas leads eu tenho",
  // "tem alguma visita hoje"). Usa o assistente real (Central
  // Operacional/IA) em vez de tentar adivinhar aqui — pedido do Renato:
  // "precisa colocar a nossa inteligência pra entender o que ele está
  // perguntando".
  perguntarAssistente(texto);
}

const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
if (SR) {
  const recognition = new SR();
  recognition.lang = 'pt-BR';
  recognition.interimResults = true;
  recognition.maxAlternatives = 1;
  let ultimaTranscricao = '';
  let silencioTimer = null;
  let jaProcessouEsseCiclo = false;
  function _finalizarEscuta(texto) {
    if (jaProcessouEsseCiclo) return;
    jaProcessouEsseCiclo = true;
    clearTimeout(silencioTimer);
    vStatus.textContent = 'entendi';
    recognition.stop();
    processarComando(texto);
  }
  recognition.onresult = (e) => {
    let texto = '';
    for (let i = e.resultIndex; i < e.results.length; i++) texto += e.results[i][0].transcript;
    ultimaTranscricao = texto;
    vTranscript.textContent = '"' + texto + '"';
    vTranscript.classList.add('show');
    clearTimeout(silencioTimer);
    if (e.results[e.results.length - 1].isFinal) {
      // Bug real reportado pelo Renato: terminou de falar e o microfone
      // continuava captando (ficava "aberto" esperando mais áudio). Já
      // temos o resultado final — para a escuta na hora, não espera o
      // navegador decidir sozinho quando encerrar.
      _finalizarEscuta(texto);
    } else {
      // Fallback pra navegador que não marca isFinal de forma confiável
      // (Safari/iOS é inconsistente nisso) — se ficar 1.5s sem nenhuma
      // palavra nova, considera que a pessoa parou de falar e processa o
      // que já foi captado, em vez de deixar o mic "preso" escutando.
      silencioTimer = setTimeout(() => _finalizarEscuta(texto), 1500);
    }
  };
  recognition.onerror = () => { clearTimeout(silencioTimer); vStatus.textContent = 'não peguei o áudio, tenta de novo'; };
  recognition.onend = () => { micBtn.classList.remove('on'); };
  micBtn.addEventListener('click', () => {
    if (micOpen) { clearTimeout(silencioTimer); recognition.stop(); fecharSheet(); return; }
    jaProcessouEsseCiclo = false;
    abrirSheet();
    try { recognition.start(); } catch (e) {}
  });
} else {
  micBtn.addEventListener('click', () => {
    abrirSheet();
    vStatus.textContent = 'comando de voz não é suportado nesse navegador';
  });
}

sheet.addEventListener('click', (e) => { if (e.target === sheet) fecharSheet(); });
</script>
</body>
</html>
