<!-- MASCOTE DO ASSISTENTE — aparece de tempos em tempos convidando pro chat com IA -->
<style>
  #robo-wrap{position:fixed;right:20px;bottom:24px;z-index:9500;display:flex;flex-direction:column;align-items:flex-end;gap:10px}
  @media(max-width:900px){ #robo-wrap{bottom:84px;right:14px} }
  #robo-bolha{display:none;max-width:220px;background:#fff;border:0.5px solid rgba(0,0,0,.1);border-radius:14px 14px 4px 14px;padding:12px 14px;box-shadow:0 8px 24px rgba(0,0,0,.14);font-size:13px;color:#111;line-height:1.4;position:relative;animation:robo-pop .25s ease}
  #robo-bolha b{display:block;font-size:11px;color:var(--brand,#FF385C);font-weight:700;margin-bottom:3px;text-transform:uppercase;letter-spacing:.03em}
  #robo-fechar{position:absolute;top:4px;right:6px;background:none;border:none;cursor:pointer;color:#9ca3af;font-size:13px;padding:2px}
  #robo-btn{width:56px;height:56px;border-radius:50%;background:var(--brand,#FF385C);border:none;cursor:pointer;font-size:28px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(0,0,0,.22);animation:robo-flutua 2.6s ease-in-out infinite}
  #robo-btn:hover{filter:brightness(1.06)}
  @keyframes robo-flutua{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
  @keyframes robo-pop{from{opacity:0;transform:translateY(6px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
</style>
<div id="robo-wrap">
  <div id="robo-bolha">
    <button id="robo-fechar" onclick="event.stopPropagation();document.getElementById('robo-bolha').style.display='none'">✕</button>
    <b id="robo-titulo">Assistente MatchImóveis</b>
    <span id="robo-msg"></span>
    <div id="robo-cta" style="display:none;margin-top:8px;font-size:12px;font-weight:700;color:var(--brand,#FF385C)">Ver agora →</div>
  </div>
  <button id="robo-btn" aria-label="Falar com o assistente" title="Falar com o assistente">🤖</button>
</div>
<script>
(function(){
  var MSGS = [
    { titulo: 'Assistente MatchImóveis', texto: 'Oi! Eu sou o seu suporte aqui na MatchImóveis. Qualquer dúvida, é só me chamar! 👋', link: '/app/assistente', cta: false },
    { titulo: 'Assistente MatchImóveis', texto: 'Precisa de ajuda? Sou o suporte automático — pergunta pra mim, resolvo na hora!', link: '/app/assistente', cta: false },
    { titulo: 'Assistente MatchImóveis', texto: 'Ficou com dúvida em alguma tela? Fala comigo, eu resolvo — não precisa esperar suporte humano.', link: '/app/assistente', cta: false },
    { titulo: 'Assistente MatchImóveis', texto: 'Quer saber como funciona o match automático? Eu te explico agora.', link: '/app/assistente', cta: false },
    { titulo: 'Assistente MatchImóveis', texto: 'Posso te ajudar a configurar alguma coisa? É só clicar aqui.', link: '/app/assistente', cta: false },
    { titulo: 'Assistente MatchImóveis', texto: 'Quer importar imóveis ou leads? Eu te guio passo a passo, na hora.', link: '/app/assistente', cta: false },
    { titulo: 'Novidade 📸', texto: 'Sabia que dá pra postar seus imóveis no Instagram com 1 clique, direto da plataforma?', link: '/app/imoveis', cta: true },
    { titulo: 'Parceria QuintoAndar 🤝', texto: 'Você pode enviar seus imóveis pro QuintoAndar vender, ou ter acesso à carteira deles pra fazer match com seus leads. Vem ver como funciona!', link: '/app/parceria-quintoandar', cta: true }
  ];
  var INTERVALO = 1 * 60 * 1000;
  function mostrar(){
    var bolha = document.getElementById('robo-bolha');
    var msg = document.getElementById('robo-msg');
    var titulo = document.getElementById('robo-titulo');
    var cta = document.getElementById('robo-cta');
    var btn = document.getElementById('robo-btn');
    if(!bolha || !msg) return;
    var escolhida = MSGS[Math.floor(Math.random()*MSGS.length)];
    titulo.textContent = escolhida.titulo;
    msg.textContent = escolhida.texto;
    cta.style.display = escolhida.cta ? 'block' : 'none';
    btn.onclick = function(){ window.location.href = escolhida.link; };
    bolha.onclick = function(){ window.location.href = escolhida.link; };
    bolha.style.cursor = 'pointer';
    bolha.style.display = 'block';
    sessionStorage.setItem('mi_robo_ultimo', String(Date.now()));
    setTimeout(function(){ bolha.style.display = 'none'; }, 9000);
  }
  document.getElementById('robo-btn').onclick = function(){ window.location.href = '/app/assistente'; };
  var ultimo = parseInt(sessionStorage.getItem('mi_robo_ultimo')||'0', 10);
  var agora = Date.now();
  if(!ultimo){
    setTimeout(mostrar, 6000);
  } else if(agora - ultimo > INTERVALO){
    setTimeout(mostrar, 4000);
  }
  setInterval(mostrar, INTERVALO);
})();
</script>
<% } %>

<script>
(function(){
  function _batePresenca(){
    fetch('/api/presenca/heartbeat', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ rota: window.location.pathname }) }).catch(function(){});
  }
  _batePresenca();
  setInterval(_batePresenca, 45000);
})();
</script>

<script>
(function(){
  var _onbCache = null;

  function onbBonusTag(p){
    return p.bonusCoins ? '<span style="display:inline-flex;align-items:center;gap:3px;background:#fff7ed;color:#c2410c;font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:20px;margin-left:8px">🎁 +' + p.bonusCoins + ' coins</span>' : '';
  }

  // Passo em destaque — o próximo a fazer, card maior no topo do modal (em
  // vez de lista plana igual todos os outros, direciona pra 1 ação só).
  function onbRenderPassoDestaque(p){
    return '<div style="border:1.5px solid #FF385C;background:#fff5f5;border-radius:14px;padding:18px">'
      + '<div style="font-size:10px;font-weight:700;color:#FF385C;text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px">▶ Seu próximo passo</div>'
      + '<div style="font-size:15px;font-weight:700;color:#111;display:flex;align-items:center;flex-wrap:wrap">' + p.label + onbBonusTag(p) + '</div>'
      + '<div style="font-size:12.5px;color:#6b7280;line-height:1.6;margin-top:6px">' + p.desc + '</div>'
      + '<div style="margin-top:12px">'
      + '<a href="' + p.link + '" onclick="document.getElementById(\'modalPrimeirosPassos\').style.display=\'none\'" style="display:inline-flex;align-items:center;gap:4px;background:#FF385C;color:#fff;border-radius:8px;padding:9px 16px;font-size:12.5px;font-weight:700;text-decoration:none">' + p.acao + ' →</a>'
      + '</div></div>';
  }

  // Resto dos passos pendentes — lista compacta abaixo do destaque, sem
  // numeração grande (a ordem de prioridade já foi comunicada pelo destaque).
  function onbRenderPasso(p){
    return '<div style="border:1px solid #e5e5e3;border-radius:12px;padding:12px 14px;display:flex;align-items:center;justify-content:space-between;gap:10px">'
      + '<div>'
      + '<div style="font-size:13px;font-weight:600;color:#111;display:flex;align-items:center;flex-wrap:wrap">' + p.label + onbBonusTag(p) + '</div>'
      + '<div style="font-size:11.5px;color:#9ca3af;margin-top:2px">' + p.desc + '</div>'
      + '</div>'
      + '<a href="' + p.link + '" onclick="document.getElementById(\'modalPrimeirosPassos\').style.display=\'none\'" style="flex-shrink:0;font-size:11px;font-weight:600;color:#111;text-decoration:none;background:#f3f4f6;border-radius:8px;padding:6px 10px">' + p.acao + '</a>'
      + '</div>';
  }

  function onbRenderTudoPronto(){
    return '<div style="text-align:center;padding:20px 0">'
      + '<div style="font-size:36px;margin-bottom:8px">🎉</div>'
      + '<div style="font-size:14px;font-weight:600;color:#111">Você já conhece tudo!</div>'
      + '<div style="font-size:12px;color:#6b7280;margin-top:4px">Completou os primeiros passos do MatchImóveis.</div>'
      + '</div>';
  }

  function onbAtualizarBotaoMenu(pendentes){
    document.querySelectorAll('.onb-nav-link').forEach(function(el){
      var badge = el.querySelector('.onb-badge');
      if (pendentes > 0){
        el.classList.add('_btn-primeiros-passos');
        if (!badge){
          badge = document.createElement('span');
          badge.className = 'onb-badge nav-badge';
          badge.style.position = 'absolute';
          badge.style.top = '4px';
          badge.style.right = '4px';
          el.appendChild(badge);
        }
        badge.textContent = pendentes;
        badge.style.display = '';
      } else {
        el.classList.remove('_btn-primeiros-passos');
        if (badge) badge.style.display = 'none';
      }
    });
  }

  function onbCarregar(cb){
    fetch('/api/onboarding/status').then(function(r){ return r.json(); }).then(function(data){
      _onbCache = data;
      onbAtualizarBotaoMenu(data.total - data.feitos);
      if (cb) cb(data);
    }).catch(function(){});
  }

  window.onbAbrirModal = function(){
    document.getElementById('modalPrimeirosPassos').style.display = 'flex';
    onbCarregar(function(data){
      var pendentes = (data.passos || []).filter(function(p){ return !p.feito; });
      document.getElementById('onb-subtitulo').textContent = data.completo
        ? 'Você concluiu todos os passos! 🎉'
        : pendentes.length + ' de ' + data.total + ' passos restantes';
      document.getElementById('onb-lista').innerHTML = data.completo
        ? onbRenderTudoPronto()
        : onbRenderPassoDestaque(pendentes[0]) + pendentes.slice(1).map(onbRenderPasso).join('');
    });
  };

  document.addEventListener('DOMContentLoaded', function(){ onbCarregar(); });
})();
</script>

<!-- BALÕES "TEM COISA NOVA" NO MENU — busca em /api/menu/badges em toda
     página (não depende de cada rota lembrar de passar a contagem como
     local, que é como Visitas/Notificações funcionavam antes e ficavam
     mortos na maioria das telas). -->
<script>
(function(){
  function _menuBadgeAtualizar(key, count){
    document.querySelectorAll('[data-badge-key="' + key + '"]').forEach(function(el){
      var badge = el.querySelector('.menu-novo-badge');
      if (count > 0){
        if (!badge){
          badge = document.createElement('span');
          badge.className = 'menu-novo-badge nav-badge';
          badge.style.position = 'absolute';
          badge.style.top = '4px';
          badge.style.right = '4px';
          badge.style.fontSize = '9px';
          badge.style.padding = '1px 4px';
          el.appendChild(badge);
        }
        badge.textContent = count > 99 ? '99+' : count;
        badge.style.display = '';
      } else if (badge) {
        badge.style.display = 'none';
      }
    });
  }
  function _menuBadgesCarregar(){
    fetch('/api/menu/badges').then(function(r){ return r.json(); }).then(function(data){
      Object.keys(data || {}).forEach(function(key){ _menuBadgeAtualizar(key, data[key]); });
    }).catch(function(){});
  }
  document.addEventListener('DOMContentLoaded', _menuBadgesCarregar);
  setInterval(_menuBadgesCarregar, 60000);
})();
</script>

<% if(typeof title!=='undefined'&&title){ %>
  <div class="page-head">
    <h1><%= title %></h1>
    <% if(typeof subtitle!=='undefined'&&subtitle){ %><p><%= subtitle %></p><% } %>
  </div>
  <% } %>
