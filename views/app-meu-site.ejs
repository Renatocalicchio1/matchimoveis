<%- include('partials/app-shell',{active:'meu-site',title:'Meu Site',subtitle:'Site público com os seus imóveis, sua marca.',perfil:(user && user.tipo)||'corretor',user:user}) %>

<style>
.pf-card{background:#fff;border:0.5px solid rgba(0,0,0,.08);border-radius:16px;padding:20px;margin-bottom:12px}
.pf-card-title{font-size:15px;font-weight:500;color:#111827;margin:0 0 4px}
.pf-card-sub{font-size:13px;color:#9ca3af;margin:0 0 16px}
.pf-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:480px){.pf-grid{grid-template-columns:1fr}}
.pf-field label{display:block;font-size:11px;font-weight:500;color:#6b7280;text-transform:uppercase;letter-spacing:.03em;margin-bottom:4px}
.pf-field input,.pf-field textarea{width:100%;padding:9px 12px;border:0.5px solid rgba(0,0,0,.12);border-radius:8px;font-size:14px;color:#111827;background:#fff;box-sizing:border-box;outline:none;font-family:inherit}
.pf-field input:focus,.pf-field textarea:focus{border-color:rgba(0,0,0,.3)}
.pf-btn{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;border:0.5px solid rgba(0,0,0,.12);background:#111827;color:#fff;margin-top:14px}
.pf-btn:hover{background:#1f2937}
.pf-btn-outline{background:#fff;color:#374151;border-color:rgba(0,0,0,.12)}
.pf-btn-outline:hover{background:#f9fafb}

.ms-cor-row{display:flex;align-items:center;gap:12px}
.ms-cor-row input[type=color]{width:52px;height:40px;border:0.5px solid rgba(0,0,0,.12);border-radius:8px;padding:2px;cursor:pointer;background:#fff}
.ms-cor-row input[type=text]{max-width:140px}

.ms-logo-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.ms-logo-preview{width:72px;height:72px;border-radius:12px;border:0.5px solid rgba(0,0,0,.1);background:#f9fafb;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0}
.ms-logo-preview img{width:100%;height:100%;object-fit:contain}
.ms-banners-grid{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.ms-banner-item{position:relative;width:140px;height:52px;border-radius:8px;border:0.5px solid rgba(0,0,0,.1);overflow:hidden;flex-shrink:0}
.ms-banner-item img{width:100%;height:100%;object-fit:cover;display:block}
.ms-banner-item form{position:absolute;top:3px;right:3px}
.ms-banner-item button{width:20px;height:20px;border-radius:50%;border:none;background:rgba(0,0,0,.55);color:#fff;font-size:12px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0}

.ms-toggle-row{display:flex;gap:10px}
.ms-toggle-opt{flex:1;display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:10px;border:1px solid rgba(0,0,0,.1);cursor:pointer}
.ms-toggle-opt.on{border-color:#16a34a;background:#f0fdf4}
.ms-toggle-opt.off{border-color:rgba(0,0,0,.1)}
.ms-toggle-opt input{width:16px;height:16px;flex-shrink:0}
.ms-toggle-opt span{font-size:13px;color:#374151}

.ms-msg{font-size:12px;margin-bottom:12px}
.ms-msg.ok{color:#16a34a}
.ms-msg.err{color:#dc2626}

.ms-link-box{display:flex;align-items:center;gap:8px;background:#f9fafb;border:0.5px solid rgba(0,0,0,.08);border-radius:10px;padding:10px 14px;font-size:12.5px;color:#374151;font-family:monospace}

.ms-dom-badge{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:600;padding:4px 11px;border-radius:20px;margin-bottom:14px}
.ms-dom-badge.nc{background:#f3f4f6;color:#6b7280}
.ms-dom-badge.aguardando{background:#fefce8;color:#a16207}
.ms-dom-badge.verificado{background:#f0fdf4;color:#16a34a}
.ms-dom-badge.erro{background:#fef2f2;color:#dc2626}
.ms-dns-box{background:#f9fafb;border:0.5px solid rgba(0,0,0,.08);border-radius:10px;padding:14px;margin:12px 0;font-size:12.5px;color:#374151}
.ms-dns-box table{width:100%;border-collapse:collapse;margin-top:8px}
.ms-dns-box td{padding:6px 8px;font-family:monospace;font-size:12px;border-bottom:1px solid rgba(0,0,0,.06)}
.ms-dns-box td:first-child{color:#9ca3af;width:70px}

.ms-cep-row{display:flex;gap:8px;align-items:flex-end;margin-bottom:12px}
.ms-cep-row .pf-field{flex:0 0 160px;margin-bottom:0}
.ms-cep-btn{background:#111827;color:#fff;border:none;padding:9px 16px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;height:38px}
.ms-cep-msg{font-size:12px;margin:-4px 0 12px;padding:7px 12px;border-radius:7px;display:none}
.ms-addr-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px;margin-bottom:12px}
.ms-addr-grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:480px){.ms-addr-grid,.ms-addr-grid2{grid-template-columns:1fr}}
</style>

<% if(locals.msg==='salvo') { %><div class="ms-msg ok">✅ Configurações salvas!</div><% } %>
<% if(locals.msg==='erro') { %><div class="ms-msg err">❌ Erro ao salvar. Tente novamente.</div><% } %>
<% if(locals.msg==='banner_limite') { %><div class="ms-msg err">❌ Máximo de 8 banners. Exclua algum antes de adicionar outro.</div><% } %>
<% if(locals.msg==='dominio_salvo') { %><div class="ms-msg ok">✅ Domínio salvo! Siga as instruções de DNS abaixo.</div><% } %>
<% if(locals.msg==='dominio_verificado') { %><div class="ms-msg ok">🔄 Verificação atualizada.</div><% } %>
<% if(locals.msg==='dominio_removido') { %><div class="ms-msg ok">✅ Domínio removido.</div><% } %>
<% if(locals.msg==='dominio_invalido') { %><div class="ms-msg err">❌ Domínio inválido. Digite algo como <code>seusite.com.br</code>, sem "https://" ou barras.</div><% } %>
<% if(locals.msg==='dominio_erro') { %><div class="ms-msg err">❌ Erro ao configurar domínio<% if(locals.erro){ %>: <%= erro %><% } %></div><% } %>

<div class="pf-card">
  <div class="pf-card-title">🔗 Seu site</div>
  <div class="pf-card-sub">Compartilhe este link — mostra só os seus imóveis, com a sua marca.</div>
  <div class="ms-link-box">
    <span>matchimoveis.ia.br/site/<%= codigoUsuario %></span>
  </div>
  <a href="/site/<%= codigoUsuario %>" target="_blank" class="pf-btn pf-btn-outline">↗ Ver meu site</a>
</div>

<div class="pf-card">
  <div class="pf-card-title">Domínio próprio</div>
  <div class="pf-card-sub">Use um domínio seu (ex: seusite.com.br) no lugar do link acima.</div>

  <% const _domStatus = siteConfig.dominio_status || 'nao_configurado'; %>
  <% const _domBadge = {nao_configurado:{cls:'nc',txt:'○ Não configurado'}, aguardando_dns:{cls:'aguardando',txt:'⏳ Aguardando DNS'}, verificado:{cls:'verificado',txt:'✅ Verificado e ativo'}, erro:{cls:'erro',txt:'❌ Erro'}}[_domStatus] || {cls:'nc',txt:_domStatus}; %>
  <div class="ms-dom-badge <%= _domBadge.cls %>"><%= _domBadge.txt %></div>

  <% if(_domStatus==='nao_configurado'){ %>
  <form method="POST" action="/app/meu-site/dominio" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
    <input type="text" name="dominio" placeholder="seusite.com.br" style="flex:1;min-width:220px;padding:9px 12px;border:0.5px solid rgba(0,0,0,.12);border-radius:8px;font-size:14px" required>
    <button type="submit" class="pf-btn" style="margin-top:0">Configurar</button>
  </form>
  <% } else { %>
  <div class="ms-link-box" style="margin-bottom:0"><span><%= siteConfig.dominio_personalizado %></span></div>

  <% if(_domStatus==='aguardando_dns' || _domStatus==='erro'){ %>
  <div class="ms-dns-box">
    <b>Configure o DNS do seu domínio</b> — no painel onde você registrou <%= siteConfig.dominio_personalizado %>, crie um registro:
    <table>
      <tr><td>Tipo</td><td>CNAME</td></tr>
      <tr><td>Nome</td><td><%= siteConfig.dominio_personalizado %></td></tr>
      <tr><td>Valor</td><td><%= cnameTarget || '(peça esse valor pro suporte MatchImóveis)' %></td></tr>
    </table>
    <div style="margin-top:8px;color:#9ca3af">Pode levar de alguns minutos a algumas horas pra propagar. Clique em "Verificar" depois de configurar.</div>
  </div>
  <% } %>

  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
    <% if(_domStatus!=='verificado'){ %>
    <form method="POST" action="/app/meu-site/dominio/verificar"><button type="submit" class="pf-btn" style="margin-top:0">🔄 Verificar configuração</button></form>
    <% } else { %>
    <a href="https://<%= siteConfig.dominio_personalizado %>" target="_blank" class="pf-btn" style="margin-top:0">↗ Abrir <%= siteConfig.dominio_personalizado %></a>
    <% } %>
    <form method="POST" action="/app/meu-site/dominio/remover" onsubmit="return confirm('Remover este domínio? O site volta a ficar só no link matchimoveis.ia.br/site/<%= codigoUsuario %>.')">
      <button type="submit" class="pf-btn pf-btn-outline" style="margin-top:0">Remover domínio</button>
    </form>
  </div>
  <% } %>
</div>

<div class="pf-card">
  <div class="pf-card-title">Status do site</div>
  <div class="pf-card-sub">Desativado, o link mostra uma página de manutenção — os imóveis continuam normais no resto da plataforma.</div>
  <form method="POST" action="/app/meu-site" id="form-toggle">
    <input type="hidden" name="cor_primaria" value="<%= siteConfig.cor_primaria %>">
    <input type="hidden" name="cor_cabecalho" value="<%= siteConfig.cor_cabecalho||'' %>">
    <input type="hidden" name="cor_rodape" value="<%= siteConfig.cor_rodape||'' %>">
    <input type="hidden" name="cor_texto_rodape" value="<%= siteConfig.cor_texto_rodape||'' %>">
    <input type="hidden" name="rodape_nome" value="<%= siteConfig.rodape_nome %>">
    <input type="hidden" name="rodape_telefone" value="<%= siteConfig.rodape_telefone %>">
    <input type="hidden" name="rodape_cep" value="<%= siteConfig.rodape_cep||'' %>">
    <input type="hidden" name="rodape_rua" value="<%= siteConfig.rodape_rua||'' %>">
    <input type="hidden" name="rodape_numero" value="<%= siteConfig.rodape_numero||'' %>">
    <input type="hidden" name="rodape_complemento" value="<%= siteConfig.rodape_complemento||'' %>">
    <input type="hidden" name="rodape_cidade" value="<%= siteConfig.rodape_cidade||'' %>">
    <input type="hidden" name="rodape_estado" value="<%= siteConfig.rodape_estado||'' %>">
    <input type="hidden" name="rodape_texto" value="<%= siteConfig.rodape_texto %>">
    <input type="hidden" name="rodape_instagram" value="<%= siteConfig.rodape_instagram %>">
    <input type="hidden" name="rodape_facebook" value="<%= siteConfig.rodape_facebook %>">
    <div class="ms-toggle-row">
      <label class="ms-toggle-opt <%= siteConfig.site_ativo!==false?'on':'' %>">
        <input type="radio" name="site_ativo" value="1" <%= siteConfig.site_ativo!==false?'checked':'' %> onchange="this.form.submit()">
        <span>✅ Ativo</span>
      </label>
      <label class="ms-toggle-opt <%= siteConfig.site_ativo===false?'off':'' %>">
        <input type="radio" name="site_ativo" value="0" <%= siteConfig.site_ativo===false?'checked':'' %> onchange="this.form.submit()">
        <span>⏸ Desativado</span>
      </label>
    </div>
  </form>
</div>

<div class="pf-card">
  <div class="pf-card-title">Identidade visual</div>
  <div class="pf-card-sub">Cor de destaque e logo aplicados em todo o site.</div>

  <div class="pf-field" style="margin-bottom:16px">
    <label>Cores</label>
    <form method="POST" action="/app/meu-site" id="form-cor">
      <input type="hidden" name="rodape_nome" value="<%= siteConfig.rodape_nome %>">
      <input type="hidden" name="rodape_telefone" value="<%= siteConfig.rodape_telefone %>">
      <input type="hidden" name="rodape_cep" value="<%= siteConfig.rodape_cep||'' %>">
      <input type="hidden" name="rodape_rua" value="<%= siteConfig.rodape_rua||'' %>">
      <input type="hidden" name="rodape_numero" value="<%= siteConfig.rodape_numero||'' %>">
      <input type="hidden" name="rodape_complemento" value="<%= siteConfig.rodape_complemento||'' %>">
      <input type="hidden" name="rodape_cidade" value="<%= siteConfig.rodape_cidade||'' %>">
      <input type="hidden" name="rodape_estado" value="<%= siteConfig.rodape_estado||'' %>">
      <input type="hidden" name="rodape_texto" value="<%= siteConfig.rodape_texto %>">
      <input type="hidden" name="rodape_instagram" value="<%= siteConfig.rodape_instagram %>">
      <input type="hidden" name="rodape_facebook" value="<%= siteConfig.rodape_facebook %>">
      <input type="hidden" name="site_ativo" value="<%= siteConfig.site_ativo!==false?'1':'0' %>">
      <div class="ms-cor-row" style="margin-bottom:10px">
        <input type="color" name="cor_primaria" id="cor-picker" value="<%= siteConfig.cor_primaria || '#FF385C' %>" onchange="document.getElementById('cor-texto').value=this.value">
        <input type="text" id="cor-texto" value="<%= siteConfig.cor_primaria || '#FF385C' %>" oninput="document.getElementById('cor-picker').value=this.value" readonly>
        <span style="font-size:12px;color:#6b7280">Cor principal (botões, preços, links)</span>
      </div>
      <div class="ms-cor-row" style="margin-bottom:10px">
        <input type="color" name="cor_cabecalho" id="cor-cabecalho-picker" value="<%= siteConfig.cor_cabecalho || '#FBF9F6' %>" onchange="document.getElementById('cor-cabecalho-texto').value=this.value">
        <input type="text" id="cor-cabecalho-texto" value="<%= siteConfig.cor_cabecalho || '#FBF9F6' %>" oninput="document.getElementById('cor-cabecalho-picker').value=this.value" readonly>
        <span style="font-size:12px;color:#6b7280">Fundo do cabeçalho</span>
      </div>
      <div class="ms-cor-row" style="margin-bottom:10px">
        <input type="color" name="cor_rodape" id="cor-rodape-picker" value="<%= siteConfig.cor_rodape || '#FBF9F6' %>" onchange="document.getElementById('cor-rodape-texto').value=this.value">
        <input type="text" id="cor-rodape-texto" value="<%= siteConfig.cor_rodape || '#FBF9F6' %>" oninput="document.getElementById('cor-rodape-picker').value=this.value" readonly>
        <span style="font-size:12px;color:#6b7280">Fundo do rodapé</span>
      </div>
      <div class="ms-cor-row" style="margin-bottom:10px">
        <input type="color" name="cor_texto_rodape" id="cor-texto-rodape-picker" value="<%= siteConfig.cor_texto_rodape || '#716C61' %>" onchange="document.getElementById('cor-texto-rodape-texto').value=this.value">
        <input type="text" id="cor-texto-rodape-texto" value="<%= siteConfig.cor_texto_rodape || '#716C61' %>" oninput="document.getElementById('cor-texto-rodape-picker').value=this.value" readonly>
        <span style="font-size:12px;color:#6b7280">Cor do texto do rodapé</span>
      </div>
      <button type="submit" class="pf-btn">Salvar cores</button>
    </form>
  </div>

  <div class="pf-field">
    <label>Logo</label>
    <div class="ms-logo-row">
      <div class="ms-logo-preview">
        <% if(siteConfig.logo_url){ %><img src="<%= siteConfig.logo_url %>"><% } else { %><span style="font-size:10px;color:#9ca3af">sem logo</span><% } %>
      </div>
      <form method="POST" action="/app/meu-site/logo" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <input type="file" name="logo" accept="image/*" required style="max-width:220px">
        <button type="submit" class="pf-btn"><%= siteConfig.logo_url ? 'Trocar logo' : 'Enviar logo' %></button>
      </form>
      <% if(siteConfig.logo_url){ %>
      <form method="POST" action="/app/meu-site/logo/excluir" onsubmit="return confirm('Excluir a logo atual?')">
        <button type="submit" class="pf-btn pf-btn-outline">Excluir logo</button>
      </form>
      <% } %>
    </div>
    <div style="font-size:11px;color:#9ca3af;margin-top:6px">Sem logo, o nome do rodapé aparece no lugar.</div>
  </div>

  <div class="pf-field">
    <label>Banners do topo (carrossel)</label>
    <% const _banners = (function(){ try { return JSON.parse(siteConfig.banners||'[]'); } catch(e){ return []; } })(); %>
    <% if(_banners.length){ %>
    <div class="ms-banners-grid">
      <% _banners.forEach(function(b, i){ %>
      <div class="ms-banner-item">
        <img src="<%= b %>">
        <form method="POST" action="/app/meu-site/banner/excluir" onsubmit="return confirm('Excluir este banner?')">
          <input type="hidden" name="idx" value="<%= i %>">
          <button type="submit" title="Excluir">✕</button>
        </form>
      </div>
      <% }); %>
    </div>
    <% } %>
    <% if(_banners.length < 8){ %>
    <form method="POST" action="/app/meu-site/banner" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <input type="file" name="banner" accept="image/*" required style="max-width:220px">
      <button type="submit" class="pf-btn">Adicionar banner</button>
    </form>
    <% } %>
    <div style="font-size:11px;color:#9ca3af;margin-top:6px">Aparece em destaque entre o cabeçalho e os filtros do site. Pode adicionar até 8 — com mais de 1, passam automaticamente a cada 5 segundos. Recomendado formato bem largo (ex: 1600×500px).</div>
  </div>
</div>

<div class="pf-card">
  <div class="pf-card-title">Rodapé</div>
  <div class="pf-card-sub">Aparece no fim de todas as páginas do site.</div>
  <form method="POST" action="/app/meu-site">
    <input type="hidden" name="cor_primaria" value="<%= siteConfig.cor_primaria %>">
    <input type="hidden" name="cor_cabecalho" value="<%= siteConfig.cor_cabecalho||'' %>">
    <input type="hidden" name="cor_rodape" value="<%= siteConfig.cor_rodape||'' %>">
    <input type="hidden" name="cor_texto_rodape" value="<%= siteConfig.cor_texto_rodape||'' %>">
    <input type="hidden" name="site_ativo" value="<%= siteConfig.site_ativo!==false?'1':'0' %>">
    <div class="pf-grid">
      <div class="pf-field">
        <label>Nome / Razão social</label>
        <input type="text" name="rodape_nome" value="<%= siteConfig.rodape_nome||'' %>" placeholder="<%= user.nome||'' %>">
      </div>
      <div class="pf-field">
        <label>Telefone</label>
        <input type="text" name="rodape_telefone" value="<%= siteConfig.rodape_telefone||'' %>" placeholder="(11) 99999-9999">
      </div>
    </div>

    <div class="ms-cep-row">
      <div class="pf-field">
        <label>CEP</label>
        <input type="text" id="ms-cep" name="rodape_cep" value="<%= siteConfig.rodape_cep||'' %>" placeholder="00000-000" maxlength="9" oninput="msFmtCEP(this)">
      </div>
      <button type="button" class="ms-cep-btn" onclick="msBuscarCEP()">Buscar</button>
    </div>
    <div id="ms-cep-msg" class="ms-cep-msg"></div>

    <div class="ms-addr-grid">
      <div class="pf-field">
        <label>Rua / Avenida</label>
        <input type="text" id="ms-rua" name="rodape_rua" value="<%= siteConfig.rodape_rua||'' %>" placeholder="Rua das Flores">
      </div>
      <div class="pf-field">
        <label>Número</label>
        <input type="text" name="rodape_numero" value="<%= siteConfig.rodape_numero||'' %>" placeholder="123">
      </div>
      <div class="pf-field">
        <label>Complemento</label>
        <input type="text" name="rodape_complemento" value="<%= siteConfig.rodape_complemento||'' %>" placeholder="Sala 2">
      </div>
    </div>

    <div class="ms-addr-grid2">
      <div class="pf-field">
        <label>Cidade</label>
        <input type="text" id="ms-cidade" name="rodape_cidade" value="<%= siteConfig.rodape_cidade||'' %>" placeholder="Cidade">
      </div>
      <div class="pf-field">
        <label>Estado</label>
        <select id="ms-estado" name="rodape_estado">
          <option value="">Selecione</option>
          <option value="AC">Acre</option><option value="AL">Alagoas</option><option value="AP">Amapá</option><option value="AM">Amazonas</option><option value="BA">Bahia</option><option value="CE">Ceará</option><option value="DF">Distrito Federal</option><option value="ES">Espírito Santo</option><option value="GO">Goiás</option><option value="MA">Maranhão</option><option value="MT">Mato Grosso</option><option value="MS">Mato Grosso do Sul</option><option value="MG">Minas Gerais</option><option value="PA">Pará</option><option value="PB">Paraíba</option><option value="PR">Paraná</option><option value="PE">Pernambuco</option><option value="PI">Piauí</option><option value="RJ">Rio de Janeiro</option><option value="RN">Rio Grande do Norte</option><option value="RS">Rio Grande do Sul</option><option value="RO">Rondônia</option><option value="RR">Roraima</option><option value="SC">Santa Catarina</option><option value="SP">São Paulo</option><option value="SE">Sergipe</option><option value="TO">Tocantins</option>
        </select>
      </div>
    </div>

    <div class="pf-grid">
      <div class="pf-field">
        <label>Instagram (link)</label>
        <input type="text" name="rodape_instagram" value="<%= siteConfig.rodape_instagram||'' %>" placeholder="https://instagram.com/...">
      </div>
      <div class="pf-field">
        <label>Facebook (link)</label>
        <input type="text" name="rodape_facebook" value="<%= siteConfig.rodape_facebook||'' %>" placeholder="https://facebook.com/...">
      </div>
    </div>
    <div class="pf-field" style="margin-top:12px">
      <label>Texto livre</label>
      <textarea name="rodape_texto" rows="3" placeholder="Ex: Atendimento personalizado há 15 anos."><%= siteConfig.rodape_texto||'' %></textarea>
    </div>

    <div class="pf-card-title" style="margin-top:24px">Botão de Simulação de Financiamento</div>
    <div class="pf-card-sub">Mostra um botão "Simular Financiamento" na página de cada imóvel, apontando pro link do seu simulador (banco parceiro, correspondente etc).</div>
    <div class="ms-toggle-row" style="margin-bottom:12px">
      <label class="ms-toggle-opt <%= siteConfig.financiamento_ativo?'on':'' %>">
        <input type="radio" name="financiamento_ativo" value="1" <%= siteConfig.financiamento_ativo?'checked':'' %>>
        <span>✅ Habilitado</span>
      </label>
      <label class="ms-toggle-opt <%= !siteConfig.financiamento_ativo?'off':'' %>">
        <input type="radio" name="financiamento_ativo" value="0" <%= !siteConfig.financiamento_ativo?'checked':'' %>>
        <span>⏸ Desabilitado</span>
      </label>
    </div>
    <div class="pf-field">
      <label>Link do simulador</label>
      <input type="text" name="financiamento_url" value="<%= siteConfig.financiamento_url||'' %>" placeholder="https://...">
    </div>

    <div class="pf-card-title" style="margin-top:24px">Métricas e Anúncios</div>
    <div class="pf-card-sub">Cole os IDs pra rastrear conversões dos seus próprios anúncios (Facebook/Instagram Ads, Google Ads) apontando pro seu site.</div>
    <div class="pf-grid">
      <div class="pf-field">
        <label>Meta Pixel ID</label>
        <input type="text" name="meta_pixel_id" value="<%= siteConfig.meta_pixel_id||'' %>" placeholder="Ex: 1234567890123">
      </div>
      <div class="pf-field">
        <label>Google Analytics (GA4)</label>
        <input type="text" name="google_analytics_id" value="<%= siteConfig.google_analytics_id||'' %>" placeholder="Ex: G-ABC1234XYZ">
      </div>
    </div>

    <button type="submit" class="pf-btn" style="margin-top:16px">Salvar configurações</button>
  </form>
</div>

<script>
document.getElementById('ms-estado').value = <%- JSON.stringify(siteConfig.rodape_estado||'') %>;

function msFmtCEP(input) {
  let v = input.value.replace(/\D/g,'');
  if (v.length>5) v = v.slice(0,5)+'-'+v.slice(5,8);
  input.value = v;
  if (v.replace(/\D/g,'').length===8) msBuscarCEP();
}

async function msBuscarCEP() {
  const cep = document.getElementById('ms-cep').value.replace(/\D/g,'');
  if (cep.length !== 8) { alert('CEP inválido'); return; }
  const msg = document.getElementById('ms-cep-msg');
  msg.style.display = 'block';
  msg.style.background = '#f9fafb'; msg.style.color = '#6b7280';
  msg.textContent = 'Buscando...';
  try {
    const d = await (await fetch('https://viacep.com.br/ws/'+cep+'/json/')).json();
    if (d.erro) { msg.style.background='#fef2f2'; msg.style.color='#dc2626'; msg.textContent='CEP não encontrado'; return; }
    document.getElementById('ms-rua').value = d.logradouro||'';
    document.getElementById('ms-cidade').value = d.localidade||'';
    const sel = document.getElementById('ms-estado');
    for(let i=0;i<sel.options.length;i++) if(sel.options[i].value===d.uf){sel.selectedIndex=i;break;}
    msg.style.background='#f0fdf4'; msg.style.color='#166534';
    msg.textContent = '✅ '+(d.logradouro?d.logradouro+', ':'')+d.localidade+'/'+d.uf;
  } catch(e) { msg.style.background='#fef2f2'; msg.style.color='#dc2626'; msg.textContent='Erro ao buscar CEP'; }
}
</script>

<%- include('partials/app-end') %>
