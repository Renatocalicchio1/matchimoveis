<%- include("partials/app-shell",{active:"imoveis",title:"Editar Imóvel",subtitle:"Atualize os dados do imóvel",user:user}) %>

<style>
.fm-card{background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:16px;margin-bottom:12px}
.fm-title{font-size:10px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.6px;margin-bottom:14px;padding-bottom:8px;border-bottom:1px solid var(--border-light)}
.fg2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fg3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.fg4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px}
@media(max-width:700px){.fg2,.fg3,.fg4{grid-template-columns:1fr 1fr}.foto-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:480px){.fg2,.fg3,.fg4{grid-template-columns:1fr}.foto-grid{grid-template-columns:repeat(2,1fr)}}
.campo label{display:block;font-size:11px;font-weight:500;color:var(--text-sec);margin-bottom:4px}
.campo input,.campo select,.campo textarea{width:100%;padding:9px 11px;border:1px solid var(--border);border-radius:8px;font-size:13px;box-sizing:border-box;font-family:'Inter',sans-serif;color:var(--dark);background:var(--white)}
.campo input:focus,.campo select:focus,.campo textarea:focus{border-color:var(--dark);outline:none}
.dif-sec{font-size:10px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.5px;margin:14px 0 8px}
.dif-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:6px}
.dif-item{display:flex;align-items:center;gap:6px;background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:7px 10px;font-size:12px;cursor:pointer;transition:border .1s}
.dif-item:hover{border-color:var(--dark)}
.dif-item input{width:auto;margin:0;flex-shrink:0}
.portal-wrap{display:flex;flex-wrap:wrap;gap:8px}
.portal-item{display:flex;align-items:center;gap:6px;background:var(--bg);border:1px solid var(--border);border-radius:20px;padding:6px 14px;font-size:12px;font-weight:500;cursor:pointer;transition:border .1s}
.portal-item:hover{border-color:var(--dark)}
.foto-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:10px}
.foto-thumb{aspect-ratio:1;border-radius:7px;overflow:hidden;background:var(--bg);position:relative}
.foto-thumb img{width:100%;height:100%;object-fit:cover}
</style>

<%
const _pid = (imovel.idExterno && imovel.idExterno.trim()) ? imovel.idExterno : (imovel.idInterno || imovel.id || '');
const _portaisRaw = imovel.portais || [];
const _portaisArr = Array.isArray(_portaisRaw) ? _portaisRaw : Object.keys(_portaisRaw).filter(k=>_portaisRaw[k]);
const _difsRaw = imovel.diferenciais || (imovel.dados && imovel.dados.diferenciais) || [];
const _difsArr = Array.isArray(_difsRaw) ? _difsRaw : Object.keys(_difsRaw).filter(k=>_difsRaw[k]);
const _temDif = (k) => _difsArr.includes(k);
const _temPortal = (k) => _portaisArr.includes(k);
const _dados = imovel.dados || {};
const _val = (campo, fallback) => imovel[campo] !== undefined && imovel[campo] !== null ? imovel[campo] : (_dados[campo] !== undefined ? _dados[campo] : (fallback || ''));
%>

<% if(salvo){ %>
<div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:13px;color:#166534;font-weight:500">✅ Alterações salvas com sucesso.</div>
<% } %>

<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--border-light)">
    <div>
      <div style="font-size:15px;font-weight:600;color:var(--dark)"><%= imovel.titulo || 'Imóvel sem título' %></div>
      <div style="font-size:12px;color:var(--text-sec);margin-top:2px"><%= _pid %></div>
    </div>
    <a href="/app/imoveis" class="btn btn-outline btn-sm">← Voltar</a>
  </div>

  <form method="POST" action="/app/imovel/<%= _pid %>/editar">

    <!-- TÍTULO E STATUS -->
    <div class="fm-card">
      <div class="fm-title">Identificação</div>
      <div class="fg2">
        <!-- Código do usuário -->
        <div class="campo" style="grid-column:span 2">
          <label style="font-size:11px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.4px">Código do corretor</label>
          <input value="<%= imovel.codigoUsuario || imovel.codigo_usuario || imovel.userId || imovel.user_id || '' %>" readonly style="background:#f3f4f6;color:#6b7280;cursor:not-allowed;font-family:monospace;font-size:12px;width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:8px;box-sizing:border-box">
        </div>
        <!-- IDs do imóvel -->
        <div class="campo" style="grid-column:span 2;display:flex;gap:12px">
          <div style="flex:1">
            <label style="font-size:11px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.4px">ID Interno (gerado pelo sistema)</label>
            <input value="<%= imovel.idInterno || imovel.id_interno || imovel.id || '' %>" readonly style="background:#f3f4f6;color:#6b7280;cursor:not-allowed;font-family:monospace;font-size:12px;width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:8px;box-sizing:border-box">
          </div>
          <% if (imovel.idExterno || imovel.id_externo) { %>
          <div style="flex:1">
            <label style="font-size:11px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.4px">ID Externo (importação)</label>
            <input value="<%= imovel.idExterno || imovel.id_externo || '' %>" readonly style="background:#f3f4f6;color:#6b7280;cursor:not-allowed;font-family:monospace;font-size:12px;width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:8px;box-sizing:border-box">
          </div>
          <% } %>
        </div>
        <div class="campo" style="grid-column:span 2"><label>Título do imóvel</label><input name="titulo" value="<%= _val('titulo') %>" placeholder="Ex: Apartamento 3 quartos com varanda em Moema"></div>
      </div>
      <div class="fg3" style="margin-top:12px">
        <div class="campo">
          <label>Status</label>
          <select name="status">
            <option value="ativo" <%=_val('status')==='ativo'?'selected':''%>>Publicado</option>
            <option value="inativo" <%=_val('status')==='inativo'?'selected':''%>>Arquivado</option>
            <option value="rascunho" <%=_val('status')==='rascunho'?'selected':''%>>Rascunho</option>
          </select>
        </div>
        <div class="campo">
          <label>Tipo de imóvel</label>
          <select name="tipo">
            <optgroup label="Residencial">
              <option value="Apartamento" <%=_val('tipo')==='Apartamento'?'selected':''%>>Apartamento</option>
              <option value="Casa" <%=_val('tipo')==='Casa'?'selected':''%>>Casa</option>
              <option value="Cobertura" <%=_val('tipo')==='Cobertura'?'selected':''%>>Cobertura</option>
              <option value="Sobrado" <%=_val('tipo')==='Sobrado'?'selected':''%>>Sobrado</option>
              <option value="Loft" <%=_val('tipo')==='Loft'?'selected':''%>>Loft</option>
              <option value="Studio" <%=_val('tipo')==='Studio'?'selected':''%>>Studio / Flat</option>
              <option value="Kitnet" <%=_val('tipo')==='Kitnet'?'selected':''%>>Kitnet / Conjugado</option>
              <option value="Duplex" <%=_val('tipo')==='Duplex'?'selected':''%>>Duplex</option>
              <option value="Mansão" <%=_val('tipo')==='Mansão'?'selected':''%>>Mansão</option>
              <option value="Chácara" <%=_val('tipo')==='Chácara'?'selected':''%>>Chácara</option>
              <option value="Sítio" <%=_val('tipo')==='Sítio'?'selected':''%>>Sítio</option>
              <option value="Fazenda" <%=_val('tipo')==='Fazenda'?'selected':''%>>Fazenda</option>
              <option value="Casa de Condomínio" <%=_val('tipo')==='Casa de Condomínio'?'selected':''%>>Casa de Condomínio</option>
              <option value="Flat" <%=_val('tipo')==='Flat'?'selected':''%>>Flat / Apart Hotel</option>
            </optgroup>
            <optgroup label="Comercial">
              <option value="Sala Comercial" <%=_val('tipo')==='Sala Comercial'?'selected':''%>>Sala Comercial</option>
              <option value="Loja" <%=_val('tipo')==='Loja'?'selected':''%>>Loja</option>
              <option value="Conjunto Comercial" <%=_val('tipo')==='Conjunto Comercial'?'selected':''%>>Conjunto Comercial</option>
              <option value="Galpão" <%=_val('tipo')==='Galpão'?'selected':''%>>Galpão / Depósito</option>
              <option value="Prédio Comercial" <%=_val('tipo')==='Prédio Comercial'?'selected':''%>>Prédio Comercial</option>
              <option value="Hotel" <%=_val('tipo')==='Hotel'?'selected':''%>>Hotel / Pousada</option>
              <option value="Consultório" <%=_val('tipo')==='Consultório'?'selected':''%>>Consultório</option>
              <option value="Restaurante" <%=_val('tipo')==='Restaurante'?'selected':''%>>Restaurante / Bar</option>
            </optgroup>
            <optgroup label="Terrenos">
              <option value="Terreno" <%=_val('tipo')==='Terreno'?'selected':''%>>Terreno / Lote</option>
              <option value="Terreno Comercial" <%=_val('tipo')==='Terreno Comercial'?'selected':''%>>Terreno Comercial</option>
              <option value="Área Rural" <%=_val('tipo')==='Área Rural'?'selected':''%>>Área Rural</option>
            </optgroup>
          </select>
        </div>
        <div class="campo">
          <label>Transação</label>
          <select name="transacao">
            <option value="venda" <%=_val('transacao')==='venda'?'selected':''%>>Venda</option>
            <option value="aluguel" <%=_val('transacao')==='aluguel'?'selected':''%>>Aluguel</option>
            <option value="temporada" <%=_val('transacao')==='temporada'?'selected':''%>>Temporada</option>
            <option value="permuta" <%=_val('transacao')==='permuta'?'selected':''%>>Permuta</option>
          </select>
        </div>
      </div>
      <div class="fg2" style="margin-top:12px">
        <div class="campo">
          <label>Condição</label>
          <select name="condicao">
            <option value="usado" <%=_val('condicao')==='usado'?'selected':''%>>Usado</option>
            <option value="novo" <%=_val('condicao')==='novo'?'selected':''%>>Novo / Pronto</option>
            <option value="lancamento" <%=_val('condicao')==='lancamento'?'selected':''%>>Lançamento</option>
          </select>
        </div>
        <div class="campo">
          <label>Fase</label>
          </div>
          <div class="campo"><label>Categoria</label><select name="categoria">
            <option value="residencial" <%= _val('categoria')==='residencial'?'selected':'' %>>Residencial</option>
            <option value="comercial" <%= _val('categoria')==='comercial'?'selected':'' %>>Comercial</option>
            <option value="rural" <%= _val('categoria')==='rural'?'selected':'' %>>Rural</option>
            <option value="terreno" <%= _val('categoria')==='terreno'?'selected':'' %>>Terreno</option>
          </select></div>
          <div class="campo"><label>Fase</label><select name="fase">
            <option value="pronto" <%=(_val('fase')||_dados.fase||'')==='pronto'?'selected':''%>>Pronto para morar</option>
            <option value="lancamento" <%=(_val('fase')||_dados.fase||'')==='lancamento'?'selected':''%>>Lançamento</option>
            <option value="na_planta" <%=(_val('fase')||_dados.fase||'')==='na_planta'?'selected':''%>>Na planta</option>
            <option value="em_construcao" <%=(_val('fase')||_dados.fase||'')==='em_construcao'?'selected':''%>>Em construção</option>
          </select>
        </div>
      </div>
    </div>

    <!-- LOCALIZAÇÃO -->
    <div class="fm-card">
      <div class="fm-title">Localização</div>
      <div class="fg2" style="margin-bottom:10px">
        <div class="campo"><label>Rua / Avenida</label><input name="endereco" value="<%= _val('endereco') %>" placeholder="Rua das Flores"></div>
        <div class="fg2">
          <div class="campo"><label>Número</label><input name="numero" value="<%= _val('numero') %>" placeholder="123"></div>
          <div class="campo"><label>Complemento</label><input name="complemento" value="<%= _val('complemento') %>" placeholder="Apto 42"></div>
        </div>
      </div>
      <div class="fg4" style="margin-bottom:10px">
        <div class="campo">
          <label>Estado</label>
          <select name="estado">
            <option value="">Selecione</option>
            <option value="AC" <%=_val('estado')==='AC'?'selected':''%>>Acre</option>
            <option value="AL" <%=_val('estado')==='AL'?'selected':''%>>Alagoas</option>
            <option value="AP" <%=_val('estado')==='AP'?'selected':''%>>Amapá</option>
            <option value="AM" <%=_val('estado')==='AM'?'selected':''%>>Amazonas</option>
            <option value="BA" <%=_val('estado')==='BA'?'selected':''%>>Bahia</option>
            <option value="CE" <%=_val('estado')==='CE'?'selected':''%>>Ceará</option>
            <option value="DF" <%=_val('estado')==='DF'?'selected':''%>>Distrito Federal</option>
            <option value="ES" <%=_val('estado')==='ES'?'selected':''%>>Espírito Santo</option>
            <option value="GO" <%=_val('estado')==='GO'?'selected':''%>>Goiás</option>
            <option value="MA" <%=_val('estado')==='MA'?'selected':''%>>Maranhão</option>
            <option value="MT" <%=_val('estado')==='MT'?'selected':''%>>Mato Grosso</option>
            <option value="MS" <%=_val('estado')==='MS'?'selected':''%>>Mato Grosso do Sul</option>
            <option value="MG" <%=_val('estado')==='MG'?'selected':''%>>Minas Gerais</option>
            <option value="PA" <%=_val('estado')==='PA'?'selected':''%>>Pará</option>
            <option value="PB" <%=_val('estado')==='PB'?'selected':''%>>Paraíba</option>
            <option value="PR" <%=_val('estado')==='PR'?'selected':''%>>Paraná</option>
            <option value="PE" <%=_val('estado')==='PE'?'selected':''%>>Pernambuco</option>
            <option value="PI" <%=_val('estado')==='PI'?'selected':''%>>Piauí</option>
            <option value="RJ" <%=_val('estado')==='RJ'?'selected':''%>>Rio de Janeiro</option>
            <option value="RN" <%=_val('estado')==='RN'?'selected':''%>>Rio Grande do Norte</option>
            <option value="RS" <%=_val('estado')==='RS'?'selected':''%>>Rio Grande do Sul</option>
            <option value="RO" <%=_val('estado')==='RO'?'selected':''%>>Rondônia</option>
            <option value="RR" <%=_val('estado')==='RR'?'selected':''%>>Roraima</option>
            <option value="SC" <%=_val('estado')==='SC'?'selected':''%>>Santa Catarina</option>
            <option value="SP" <%=_val('estado')==='SP'?'selected':''%>>São Paulo</option>
            <option value="SE" <%=_val('estado')==='SE'?'selected':''%>>Sergipe</option>
            <option value="TO" <%=_val('estado')==='TO'?'selected':''%>>Tocantins</option>
          </select>
        </div>
        <div class="campo"><label>Cidade</label><input name="cidade" value="<%= _val('cidade') %>" placeholder="Cidade"></div>
        <div class="campo" style="grid-column:span 2"><label>Bairro</label><input name="bairro" value="<%= _val('bairro') %>" placeholder="Moema"></div>
      </div>
      <div class="fg2">
        <div class="campo"><label>CEP</label><input name="cep" value="<%= _val('cep') %>" placeholder="00000-000"></div>
        <div class="campo"></div>
      </div>
      <div class="fg2" style="margin-top:10px">
        <div class="campo"><label>Latitude</label><input name="latitude" value="<%= _val('latitude') %>" type="number" step="any" readonly style="background:#f3f4f6;color:#9ca3af;cursor:not-allowed"></div>
        <div class="campo"><label>Longitude</label><input name="longitude" value="<%= _val('longitude') %>" type="number" step="any" readonly style="background:#f3f4f6;color:#9ca3af;cursor:not-allowed"></div>
      </div>
    </div>

    <!-- VALORES -->
    <div class="fm-card">
      <div class="fm-title">Valores</div>
      <div class="fg3" style="margin-bottom:10px">
        <div class="campo"><label>Valor (R$)</label><input name="valor_imovel" type="number" value="<%= _val('valor_imovel') %>" placeholder="500000"></div>
        <div class="campo"><label>Condomínio (R$)</label><input name="condominio" type="number" value="<%= _val('condominio') %>" placeholder="1200"></div>
        <div class="campo"><label>IPTU anual (R$)</label><input name="iptu" type="number" value="<%= _val('iptu') %>" placeholder="3600"></div>
      </div>
      <div class="fg2">
        <div class="campo">
          <label>Aceita financiamento?</label>
          <select name="aceita_financiamento">
            <option value="sim" <%=(_val('aceita_financiamento')||_dados.aceita_financiamento||'sim')==='sim'?'selected':''%>>Sim</option>
            <option value="nao" <%=(_val('aceita_financiamento')||_dados.aceita_financiamento)==='nao'?'selected':''%>>Não</option>
            <option value="a_combinar" <%=(_val('aceita_financiamento')||_dados.aceita_financiamento)==='a_combinar'?'selected':''%>>A combinar</option>
          </select>
        </div>
        <div class="campo">
          <label>Aceita permuta?</label>
          <select name="aceita_permuta">
            <option value="nao" <%=(_val('aceita_permuta')||_dados.aceita_permuta||'nao')==='nao'?'selected':''%>>Não</option>
            <option value="sim" <%=(_val('aceita_permuta')||_dados.aceita_permuta)==='sim'?'selected':''%>>Sim</option>
            <option value="a_combinar" <%=(_val('aceita_permuta')||_dados.aceita_permuta)==='a_combinar'?'selected':''%>>A combinar</option>
          </select>
        </div>
      </div>
    </div>

    <!-- CARACTERÍSTICAS -->
    <div class="fm-card">
      <div class="fm-title">Características</div>
      <div class="fg4" style="margin-bottom:10px">
        <div class="campo"><label>Área útil (m²)</label><input name="area_m2" type="number" value="<%= _val('area_m2') %>" placeholder="80"></div>
        <div class="campo"><label>Área total (m²)</label><input name="area_total" type="number" value="<%= _val('area_total') %>" placeholder="100"></div>
        <div class="campo"><label>Área construída (m²)</label><input name="area_construida" type="number" value="<%= _val('area_construida')||_dados.area_construida||'' %>" placeholder="90"></div>
        <div class="campo"><label>Torre</label><input name="torre" value="<%= _val('torre') %>" placeholder="Torre A"></div>
          <div class="campo"><label>Unidade</label><input name="unidade" value="<%= _val('unidade') %>" placeholder="101"></div>
          <div class="campo"><label>Nome do Condomínio</label><input name="condominio_nome" value="<%= _val('condominio_nome') || _val('condominioNome') %>" placeholder="Ex: Residencial das Flores"></div>
          <div class="campo"><label>Ano de Construção</label><input name="ano_construcao" type="number" value="<%= _val('ano_construcao') || _val('anoConstrucao') %>" placeholder="2010"></div>
          <div class="campo"><label>Tour Virtual (URL)</label><input name="tour_virtual" value="<%= _val('tour_virtual') || _val('tourVirtual') %>" placeholder="https://..."></div>
          <div class="campo"><label>Andar</label><input name="andar" type="number" value="<%= _val('andar') %>" placeholder="5"></div>
      </div>
      <div class="fg4" style="margin-bottom:10px">
        <div class="campo"><label>Quartos</label><input name="quartos" type="number" value="<%= _val('quartos') %>" placeholder="2" min="0"></div>
        <div class="campo"><label>Suítes</label><input name="suites" type="number" value="<%= _val('suites') %>" placeholder="1" min="0"></div>
        <div class="campo"><label>Banheiros</label><input name="banheiros" type="number" value="<%= _val('banheiros') %>" placeholder="2" min="0"></div>
        <div class="campo"><label>Salas</label><input name="salas" type="number" min="0" value="<%= _val('salas') %>" placeholder="1"></div>
          <div class="campo"><label>Vagas</label><input name="vagas" type="number" value="<%= _val('vagas') %>" placeholder="1" min="0"></div>
      </div>
      <div class="fg3">
        <div class="campo"><label>Total de andares</label><input name="total_andares" type="number" value="<%= _val('total_andares')||_dados.total_andares||'' %>" placeholder="10"></div>
        <div class="campo"><label>Unidades por andar</label><input name="unidades_por_andar" type="number" value="<%= _val('unidades_por_andar')||_dados.unidades_por_andar||'' %>" placeholder="4"></div>
        <div class="campo">
          <label>Posição solar</label>
          <select name="posicao_solar">
            <option value="">Selecione</option>
            <option value="norte" <%=(_val('posicao_solar')||_dados.posicao_solar||'')==='norte'?'selected':''%>>Norte</option>
            <option value="sul" <%=(_val('posicao_solar')||_dados.posicao_solar||'')==='sul'?'selected':''%>>Sul</option>
            <option value="leste" <%=(_val('posicao_solar')||_dados.posicao_solar||'')==='leste'?'selected':''%>>Leste</option>
            <option value="oeste" <%=(_val('posicao_solar')||_dados.posicao_solar||'')==='oeste'?'selected':''%>>Oeste</option>
            <option value="nordeste" <%=(_val('posicao_solar')||_dados.posicao_solar||'')==='nordeste'?'selected':''%>>Nordeste</option>
            <option value="sudeste" <%=(_val('posicao_solar')||_dados.posicao_solar||'')==='sudeste'?'selected':''%>>Sudeste</option>
            <option value="sudoeste" <%=(_val('posicao_solar')||_dados.posicao_solar||'')==='sudoeste'?'selected':''%>>Sudoeste</option>
            <option value="noroeste" <%=(_val('posicao_solar')||_dados.posicao_solar||'')==='noroeste'?'selected':''%>>Noroeste</option>
          </select>
        </div>
      </div>
    </div>

    <!-- DIFERENCIAIS -->
    <div class="fm-card">
      <div class="fm-title">Diferenciais</div>
      <div class="dif-sec">Lazer</div>
      <div class="dif-grid" style="margin-bottom:12px">
        <label class="dif-item"><input type="checkbox" name="dif_piscina" <%=_temDif('piscina')?'checked':''%>> Piscina</label>
