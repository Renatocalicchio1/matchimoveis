      </div>
      <div class="pf-field">
        <label>Bairros onde atua (escolha quantos quiser)</label>
        <div style="position:relative">
          <input type="text" id="pfAreaBairroInput" placeholder="Selecione uma cidade primeiro..." autocomplete="off" disabled style="width:100%">
          <div id="pfAreaBairroSugestoes" class="sugestoes-dropdown" style="display:none"></div>
        </div>
        <div id="pfAreaBairrosChips" class="chips"></div>
        <input type="hidden" name="areaAtuacaoEstado" id="pfAreaAtuacaoEstadoHidden">
        <input type="hidden" name="areaAtuacaoCidades" id="pfAreaAtuacaoCidadesHidden">
