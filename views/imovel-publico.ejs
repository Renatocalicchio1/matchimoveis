<script>
const fotos = <%- JSON.stringify(imovel.fotos || []) %>;
const imovelId = '<%= imovel.idExterno || imovel.id || imovel.codigoImovel || "" %>';
const imovelTitulo = '<%= (imovel.titulo || imovel.tipo + " em " + imovel.bairro).replace(/'/g, "") %>';
let linkDestino = '';
let modalTipo = 'visita';

function compartilharImovel(btn){
  const url = window.location.href;
  const texto = encodeURIComponent(imovelTitulo + ' - ' + url);
  window.open('https://wa.me/?text=' + texto, '_blank');
}

function abrirWhatsAppFlutuante(){
  const principal = document.getElementById('btn-wa-principal');
  if(principal) abrirModal(principal.dataset.href, 'whatsapp');
}

const FAV_KEY = 'mi_favoritos';
function _lerFavoritos(){
  try { return JSON.parse(localStorage.getItem(FAV_KEY)) || []; } catch(e) { return []; }
}
function toggleFavoritoDetalhe(){
  let favs = _lerFavoritos();
  const btn = document.getElementById('btn-favoritar');
  if(favs.includes(imovelId)){
    favs = favs.filter(id => id !== imovelId);
    btn.classList.remove('ativo'); btn.textContent = '♡';
  } else {
    favs.push(imovelId);
    btn.classList.add('ativo'); btn.textContent = '♥';
  }
  localStorage.setItem(FAV_KEY, JSON.stringify(favs));
}
(function(){
  const btn = document.getElementById('btn-favoritar');
  if(btn && _lerFavoritos().includes(imovelId)){ btn.classList.add('ativo'); btn.textContent = '♥'; }
})();

function abrirModal(link, tipo = 'visita') {
  linkDestino = link;
  modalTipo = tipo;
  document.getElementById('modal-contato').style.display = 'flex';
  document.getElementById('modal-step-contato').style.display = 'block';
  document.getElementById('modal-step-horario').style.display = 'none';
  document.getElementById('modal-nome').focus();
}

function fecharModal() {
  document.getElementById('modal-contato').style.display = 'none';
}

const imovelUserId = "<%= imovel.codigoUsuario || imovel.userId || corretor.id || '' %>";
function confirmarContato() {
  const nome = document.getElementById('modal-nome').value.trim();
  const celular = document.getElementById('modal-celular').value.trim();
  const email = document.getElementById('modal-email').value.trim();

  const celularLimpo = (celular||'').replace(/\D/g,'');
  if (!nome || nome.length < 3) { alert('Digite seu nome completo'); return; }
  if (!celular || celularLimpo.length < 10 || celularLimpo.length > 11) { alert('Celular inválido. Use o formato: 47992010888 ou 4792010888');
    return;
  }

  const params = new URLSearchParams(window.location.search);
  const leadIdOrigem = params.get('leadId') || params.get('lid') || '';
  const userIdOrigem = params.get('userId') || params.get('uid') || '';

  if (modalTipo === 'whatsapp') {
    fetch('/api/lead-interesse', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ nome, celular, email, imovelId, imovelTitulo, leadId: leadIdOrigem, userId: userIdOrigem || imovelUserId, canal: 'WhatsApp' })
    }).catch(() => {});

    window.open(linkDestino, '_blank');
    fecharModal();
    return;
  }

  document.getElementById('modal-step-contato').style.display = 'none';
  document.getElementById('modal-step-horario').style.display = 'block';
}

function voltarContato(){
  document.getElementById('modal-step-contato').style.display = 'block';
  document.getElementById('modal-step-horario').style.display = 'none';
}

function confirmarVisita() {
  const nome = document.getElementById('modal-nome').value.trim();
  const celular = document.getElementById('modal-celular').value.trim();
  const email = document.getElementById('modal-email').value.trim();
  const data = document.getElementById('modal-data').value;
  const hora = document.getElementById('modal-hora').value;

  if (!data || !hora) {
    alert('Escolha a data e o horário da visita');
    return;
  }

  const agora = new Date();

  const visitaDataHora = new Date(data + 'T' + hora);

  if (visitaDataHora < agora) {
    alert('Não é permitido selecionar data ou horário no passado.');
    return;
  }

  const params = new URLSearchParams(window.location.search);
  const leadIdOrigem = params.get('leadId') || params.get('lid') || '';
  const userIdOrigem = params.get('userId') || params.get('uid') || '';

  fetch('/api/lead-interesse', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ nome, celular, email, imovelId, imovelTitulo, leadId: leadIdOrigem, userId: userIdOrigem || imovelUserId, dataVisita: data, horaVisita: hora, acao: 'solicitar_visita', visita: 'true', querVisita: 'true' })
  }).catch(() => {});

  alert('Visita solicitada com sucesso!');
  fecharModal();
}

function enviarInteresse() {
  const nome = document.getElementById('int-nome').value.trim();
  const celular = document.getElementById('int-celular').value.trim();
  const email = document.getElementById('int-email').value.trim();
  const celularLimpo = (celular||'').replace(/\D/g,'');
  const msg = document.getElementById('interesse-msg');

  if (!nome || nome.length < 3) { alert('Digite seu nome completo'); return; }
  if (!celular || celularLimpo.length < 10 || celularLimpo.length > 11) { alert('Celular inválido. Use o formato: 47992010888 ou 4792010888'); return; }

  const params = new URLSearchParams(window.location.search);
  const leadIdOrigem = params.get('leadId') || params.get('lid') || '';
  const userIdOrigem = params.get('userId') || params.get('uid') || '';

  fetch('/api/lead-interesse', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ nome, celular, email, imovelId, imovelTitulo, leadId: leadIdOrigem, userId: userIdOrigem || imovelUserId, canal: 'Site' })
  }).then(r => r.json()).then(d => {
    msg.style.display = 'block';
    if (d.ok !== false) {
      msg.style.color = 'var(--teal-ink)';
      msg.textContent = '✅ Recebemos seu interesse! O corretor vai te chamar em breve.';
    } else {
      msg.style.color = '#dc2626';
      msg.textContent = '❌ ' + (d.error || 'Erro ao enviar. Tente novamente.');
    }
  }).catch(() => {
    msg.style.display = 'block';
    msg.style.color = '#dc2626';
    msg.textContent = '❌ Erro ao enviar. Tente novamente.';
  });
}

let fotoAtual = 0;
function abrirGaleria(idx) { fotoAtual=idx; document.getElementById('lightbox').classList.add('open'); atualizarLb(); }
function fecharLightbox() { document.getElementById('lightbox').classList.remove('open'); }
function navFoto(dir) { fotoAtual=(fotoAtual+dir+fotos.length)%fotos.length; atualizarLb(); }
function atualizarLb() { document.getElementById('lb-img').src=fotos[fotoAtual]; document.getElementById('lb-counter').textContent=(fotoAtual+1)+' / '+fotos.length; }
document.getElementById('lightbox').addEventListener('click',e=>{ if(e.target===document.getElementById('lightbox')) fecharLightbox(); });
document.addEventListener('keydown',e=>{ if(e.key==='Escape') fecharLightbox(); if(e.key==='ArrowLeft') navFoto(-1); if(e.key==='ArrowRight') navFoto(1); });

// Carrossel de fotos (mobile) — atualiza o contador ao arrastar
const heroCarousel = document.getElementById('hero-carousel');
const hcCounter = document.getElementById('hc-counter');
if (heroCarousel && hcCounter) {
  heroCarousel.addEventListener('scroll', () => {
    const idx = Math.round(heroCarousel.scrollLeft / heroCarousel.clientWidth);
    hcCounter.textContent = (idx + 1) + ' / ' + fotos.length;
  }, { passive: true });
}

// Bloqueia datas passadas
document.addEventListener('DOMContentLoaded', () => {
  const campoData = document.getElementById('modal-data');

  if (campoData) {
    const hoje = new Date();
    const yyyy = hoje.getFullYear();
    const mm = String(hoje.getMonth()+1).padStart(2,'0');
    const dd = String(hoje.getDate()).padStart(2,'0');

    campoData.setAttribute('min', `${yyyy}-${mm}-${dd}`);

    const campoHora = document.getElementById('modal-hora');

    function validarHorario(){
      if(!campoHora || !campoData) return;

      const hojeStr = `${yyyy}-${mm}-${dd}`;

      if(campoData.value === hojeStr){
        const agora = new Date();
        const hh = String(agora.getHours()).padStart(2,'0');
        const mi = String(agora.getMinutes()).padStart(2,'0');

        campoHora.setAttribute('min', `${hh}:${mi}`);
      } else {
        campoHora.removeAttribute('min');
      }
    }

    function popularHorariosDisponiveis(){
      if(!campoHora || !campoData) return;

      const hoje = new Date();
      const hojeStr = `${yyyy}-${mm}-${dd}`;

      const horaAtual = hoje.getHours();
      const minutoAtual = hoje.getMinutes();

      const horarios = [];

      for(let h=8; h<=20; h++){
        for(let m of [0,30]){

          if(
            campoData.value === hojeStr &&
            (
              h < horaAtual ||
              (h === horaAtual && m <= minutoAtual)
            )
          ){
            continue;
          }

          const hh = String(h).padStart(2,'0');
          const mm2 = String(m).padStart(2,'0');

          horarios.push(`${hh}:${mm2}`);
        }
      }

      if(horarios.length){
        campoHora.innerHTML = horarios.map(h =>
          `<option value="${h}">${h}</option>`
        ).join('');
      }
    }

    campoData.addEventListener('change', () => {
      validarHorario();
      popularHorariosDisponiveis();
    });

    popularHorariosDisponiveis();
    validarHorario();
  }
});
</script>
</body>
</html>
