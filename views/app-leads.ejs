<script>
const _fl = { temp:'', origem:'' };

function scrollKanban(dir) {
  const board = document.getElementById('kanban-board');
  board.scrollBy({ left: dir * 280, behavior: 'smooth' });
}

// Esconde hint após primeiro scroll
document.addEventListener('DOMContentLoaded', () => {
  const board = document.getElementById('kanban-board');
  const hint = document.getElementById('kanban-hint');
  if (board) {
    board.addEventListener('scroll', () => {
      if (hint) hint.style.opacity = '0.4';
    }, { once: true });
  }
});

function setChip(campo, valor, btn) {
  _fl[campo] = valor;
  btn.parentElement.querySelectorAll('.fchip').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  aplicarFiltros();
}

function toggleFAdv() {
  const el = document.getElementById('fadv');
  el.style.display = el.style.display==='none'?'block':'none';
}

function limparFiltros() {
  _fl.temp=''; _fl.origem='';
  document.getElementById('filter-search').value='';
  ['filter-score','filter-tipo-lead','filter-intencao'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});
  document.querySelectorAll('.fchip').forEach(b=>{b.classList.remove('on');if(b.textContent.trim()==='Todas'||b.textContent.trim()==='Todos')b.classList.add('on');});
  aplicarFiltros();
}

function aplicarFiltros() {
  const busca = (document.getElementById('filter-search')?.value||'').toLowerCase();
  const scoreMin = parseInt(document.getElementById('filter-score')?.value||'0');
  const tipoLead = (document.getElementById('filter-tipo-lead')?.value||'').toLowerCase();
  const intencao = (document.getElementById('filter-intencao')?.value||'').toLowerCase();

  const cards = document.querySelectorAll('.lead-card');
  let total = 0;

  // Conta por coluna
  const counts = {};

  cards.forEach(card => {
    let ok = true;
    if(_fl.temp && card.dataset.temperatura !== _fl.temp) ok=false;
    if(_fl.origem && !(card.dataset.origem||'').includes(_fl.origem)) ok=false;
    if(parseInt(card.dataset.score||'0') < scoreMin) ok=false;
    if(busca && !(card.dataset.search||'').includes(busca)) ok=false;
    if(tipoLead && !(card.dataset.tipoLead||'').includes(tipoLead)) ok=false;
    if(intencao && !(card.dataset.intencao||'').includes(intencao)) ok=false;

    card.style.display = ok ? '' : 'none';
    if(ok) {
      total++;
      const col = card.dataset.col;
      counts[col] = (counts[col]||0)+1;
    }
  });

  // Atualiza contadores das colunas
  Object.keys(counts).forEach(col => {
    const el = document.getElementById('count-'+col);
    if(el) el.textContent = counts[col]||0;
  });
  // Zera colunas sem resultado
  document.querySelectorAll('.kanban-col-count').forEach(el => {
    const col = el.id.replace('count-','');
    if(!counts[col]) el.textContent = '0';
  });

  // Empty state por coluna
  document.querySelectorAll('.kanban-col').forEach(col => {
    const colKey = col.dataset.col;
    const visCards = Array.from(col.querySelectorAll('.lead-card')).filter(c=>c.style.display!=='none');
    let empty = col.querySelector('.empty-col');
    if(!empty){ empty=document.createElement('div'); empty.className='empty-col'; empty.textContent='Nenhuma lead'; col.appendChild(empty); }
    empty.style.display = visCards.length===0?'block':'none';
  });

  const counter = document.getElementById('filter-counter');
  if(counter) counter.textContent = total+' leads exibidas';
}

function rodarMatchBase() {
  const btn = document.getElementById('btn-match-base');
  btn.disabled=true; btn.textContent='Rodando...';
  fetch('/admin/rodar-match/<%= userId %>')
    .then(r=>r.json())
    .then(d=>{
      btn.textContent='Match IA'; btn.disabled=false;
      if(d.ok){alert('Match concluído!\nCom match: '+d.comMatch+'\nSem match: '+d.semMatch);location.reload();}
      else alert('Erro: '+d.error);
    })
    .catch(()=>{btn.textContent='Match IA';btn.disabled=false;});
}

function abrirModalImportarLeads(){document.getElementById('modal-importar-leads').style.display='flex';}
function fecharModalImportarLeads(){document.getElementById('modal-importar-leads').style.display='none';}

// Modal Nova Lead
let _nlTipo = 'residencial';
function abrirModalNovaLead(){
  _nlTipo='residencial';
  setTipoLead('residencial');
  document.getElementById('modal-nova-lead').style.display='flex';
}
function fecharModalNovaLead(){document.getElementById('modal-nova-lead').style.display='none';}
function setTipoLead(tipo){
  _nlTipo = tipo;
  ['residencial','comercial','terreno'].forEach(t => {
    const btn = document.getElementById('nl-btn-'+t);
    const ativo = t === tipo;
    btn.style.borderColor = ativo ? '#FF385C' : '#e5e7eb';
    btn.style.background  = ativo ? '#ffe4e9' : '#f9fafb';
    btn.style.color       = ativo ? '#FF385C' : '#6b7280';
  });
  const avisos = {
    residencial: '🏠 Residencial — obrigatório: Nome, Celular, Tipo, Transação, Cidade, Bairro, Valor, Quartos',
    comercial:   '🏢 Comercial — obrigatório: Tipo, Transação, Cidade, Bairro, Valor, Área (m²)',
    terreno:     '🌿 Terreno — obrigatório: Tipo, Transação, Cidade, Bairro, Valor, Área (m²)'
  };
  document.getElementById('nl-aviso').textContent = avisos[tipo];
  document.getElementById('nl-campos-residencial').style.display = tipo==='residencial' ? '' : 'none';
  document.getElementById('nl-campos-area').style.display = tipo!=='residencial' ? '' : 'none';

  // Filtra opções do select de tipo
  const sel = document.getElementById('nl-tipo');
  sel.value = '';
  Array.from(sel.options).forEach(opt => {
    if(!opt.value) { opt.style.display=''; return; }
    const grp = opt.closest('optgroup')?.label?.toLowerCase()||'';
    if(tipo==='residencial') opt.style.display = grp==='residencial' ? '' : 'none';
    else if(tipo==='comercial') opt.style.display = grp==='comercial' ? '' : 'none';
    else if(tipo==='terreno') opt.style.display = grp==='terrenos' ? '' : 'none';
  });
  Array.from(sel.querySelectorAll('optgroup')).forEach(grp => {
    const label = grp.label.toLowerCase();
    if(tipo==='residencial') grp.style.display = label==='residencial' ? '' : 'none';
    else if(tipo==='comercial') grp.style.display = label==='comercial' ? '' : 'none';
    else if(tipo==='terreno') grp.style.display = label==='terrenos' ? '' : 'none';
  });
}
async function salvarNovaLead(){
  const err = document.getElementById('nl-erro');
  err.style.display='none';
  const nome     = document.getElementById('nl-nome').value.trim();
  const telefone = document.getElementById('nl-telefone').value.replace(/\D/g,'');
  const email    = document.getElementById('nl-email').value.trim();
  const tipo     = document.getElementById('nl-tipo').value;
  const transacao= document.getElementById('nl-transacao').value;
  const estado   = document.getElementById('nl-estado').value.trim();
  const cidade   = document.getElementById('nl-cidade').value.trim();
  const bairro   = document.getElementById('nl-bairro').value.trim();
  const valor    = parseFloat(String(document.getElementById('nl-valor').value).replace(/\./g,'').replace(',','.').replace(/[^0-9.]/g,''))||0;
  const quartos  = parseInt(document.getElementById('nl-quartos').value)||0;
  const suites   = parseInt(document.getElementById('nl-suites').value)||0;
  const vagas    = parseInt(document.getElementById('nl-vagas').value)||0;
  const banheiros= parseInt(document.getElementById('nl-banheiros').value)||0;
  const area     = parseFloat(document.getElementById('nl-area').value)||0;
  const fase     = document.getElementById('nl-fase').value;

  // Validação por tipo
  const faltando = [];
  if(_nlTipo==='residencial'){
    if(!nome) faltando.push('Nome');
    if(!telefone) faltando.push('Celular');
    if(!tipo) faltando.push('Tipo');
    if(!transacao) faltando.push('Transação');
    if(!cidade) faltando.push('Cidade');
    if(!bairro) faltando.push('Bairro');
    if(!valor) faltando.push('Valor');
    if(!quartos) faltando.push('Quartos');
  } else {
    if(!tipo) faltando.push('Tipo');
    if(!transacao) faltando.push('Transação');
    if(!cidade) faltando.push('Cidade');
    if(!bairro) faltando.push('Bairro');
    if(!valor) faltando.push('Valor');
    if(!area) faltando.push('Área (m²)');
  }
  if(faltando.length){ err.textContent='Preencha: '+faltando.join(', '); err.style.display='block'; return; }

  const payload = {
    nome, telefone, email, tipo, transacao, estado, cidade, bairro,
    valorMax: valor, valorMin: 0,
    quartos, suites, vagas, banheiros, area, fase,
    origem: 'manual', origemEntrada: 'manual'
  };

  try {
    const r = await fetch('/app/lead/manual', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const d = await r.json();
    if(d.ok){ fecharModalNovaLead(); window.location.href='/app/lead/'+d.id; }
    else { err.textContent = d.erro||'Erro ao cadastrar'; err.style.display='block'; }
  } catch(e){ err.textContent='Erro de conexão'; err.style.display='block'; }
}

