<%- include('partials/app-shell', {active:'notificacoes', title:'Notificações', subtitle:'Acompanhe tudo que acontece na sua conta.', user:user}) %>

<style>
.notif-list{display:flex;flex-direction:column;gap:2px}
.notif-item{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border-radius:10px;border:1px solid transparent;transition:all .1s;cursor:pointer;text-decoration:none;color:inherit}
.notif-item:hover{background:#fff;border-color:var(--border)}
.notif-item.nao-lida{background:#fff;border-color:var(--border)}
.notif-item.nao-lida::before{content:'';width:6px;height:6px;background:var(--brand);border-radius:50%;flex-shrink:0;margin-top:6px}
.notif-item.lida::before{content:'';width:6px;height:6px;flex-shrink:0;margin-top:6px}
.notif-ic{width:36px;height:36px;border-radius:50%;background:var(--bg);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
.notif-body{flex:1;min-width:0}
.notif-titulo{font-size:13px;font-weight:500;color:var(--dark);margin-bottom:2px}
.notif-item.nao-lida .notif-titulo{font-weight:600}
.notif-msg{font-size:12px;color:var(--text-sec);line-height:1.5}
.notif-tempo{font-size:11px;color:var(--text-ter);margin-top:4px}
.notif-empty{text-align:center;padding:60px 20px;color:var(--text-ter)}
.tabs{display:flex;gap:4px;margin-bottom:16px;background:var(--bg);border-radius:10px;padding:4px;max-width:100%;overflow-x:auto}
/* Botão de aba não tem espaço nenhum internamente pra quebrar — sem
   white-space:nowrap aqui, o word-break:break-word global de app-shell.ejs
   (trava geral de overflow de todo /app/*) quebra o texto caractere por
   caractere quando a fila de abas fica espremida no mobile (mesmo bug do
   link de afiliados, ago/2026). O overflow-x:auto do .tabs acima já resolve
   telas estreitas — não precisa quebrar linha. */
.tab{padding:6px 16px;border-radius:8px;font-size:12px;font-weight:500;color:var(--text-sec);cursor:pointer;border:none;background:transparent;transition:all .1s;white-space:nowrap;flex-shrink:0}
.tab.on{background:#fff;color:var(--dark);font-weight:600;box-shadow:0 1px 3px rgba(0,0,0,.08)}
.radar-item{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border-radius:10px;border:1px solid var(--border);text-decoration:none;color:inherit;margin-bottom:8px}
.radar-item:hover{background:var(--bg)}
.radar-sev{width:6px;align-self:stretch;border-radius:4px;flex-shrink:0}
.radar-sev.crit{background:#FF385C}
.radar-sev.atencao{background:#f59e0b}
.radar-sev.oportunidade{background:#00A699}
.radar-sev.info{background:#d1d5db}
.radar-body{flex:1;min-width:0}
.radar-titulo{font-size:13px;font-weight:600;color:var(--dark);margin-bottom:2px}
.radar-msg{font-size:12px;color:var(--text-sec);line-height:1.5}
.radar-tag{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;padding:2px 8px;border-radius:20px;flex-shrink:0}
.radar-tag.crit{background:#fff1f3;color:#FF385C}
.radar-tag.atencao{background:#fffbeb;color:#b45309}
.radar-tag.oportunidade{background:#f0fdfa;color:#00847A}
.radar-tag.info{background:#f3f4f6;color:#6b7280}
.radar-prop{display:inline-block;margin-top:4px;font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px}
.radar-prop.alta{background:#fff1f3;color:#FF385C}
.radar-prop.media{background:#fffbeb;color:#b45309}
.radar-prop.baixa{background:#f3f4f6;color:#6b7280}
.rf-chip{padding:6px 12px;border-radius:20px;font-size:12px;font-weight:500;border:1px solid var(--border);background:#fff;color:var(--text-sec);cursor:pointer;white-space:nowrap;flex-shrink:0}
.rf-chip.on{background:var(--dark);color:#fff;border-color:var(--dark)}
</style>

<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:16px">
  <div class="tabs">
    <button class="tab on" onclick="filtrarNotif('todas',this)">Todas</button>
    <button class="tab" onclick="filtrarNotif('nao_lida',this)">Não lidas</button>
    <button class="tab" onclick="filtrarNotif('visita',this)">Visitas</button>
    <button class="tab" onclick="filtrarNotif('match',this)">Matches</button>
    <button class="tab" id="tab-radar" onclick="abrirRadar(this)">🎯 Radar</button>
  </div>
  <% if(notificacoes && notificacoes.length) { %>
  <button onclick="marcarTodasLidas()" style="background:transparent;border:1px solid var(--border);border-radius:8px;padding:7px 14px;font-size:12px;font-weight:500;color:var(--text-sec);cursor:pointer;white-space:nowrap;flex-shrink:0">
    Marcar todas como lidas
  </button>
  <% } %>
</div>

<div id="pane-notif" class="card" style="padding:8px">
  <% if(!notificacoes || !notificacoes.length) { %>
    <div class="notif-empty">
      <div style="font-size:36px;margin-bottom:12px;opacity:.3">🔔</div>
      <div style="font-size:14px;font-weight:500;color:var(--text-sec);margin-bottom:4px">Nenhuma notificação</div>
      <div style="font-size:12px">Você está em dia com tudo!</div>
    </div>
  <% } else { %>
  <div class="notif-list" id="notif-list">
    <% notificacoes.forEach(n => {
      const tipo = n.tipo || '';
      const lida = n.lida;
      const ic = tipo.includes('visita') ? '📅' :
                 tipo.includes('quente') ? '🔥' :
                 tipo.includes('gostei') || tipo.includes('like') ? '❤️' :
                 tipo.includes('captacao') ? '🏠' :
                 tipo.includes('match') || tipo.includes('vitrine') ? '🎯' :
                 tipo.includes('lead') ? '👤' :
                 tipo.includes('proposta') ? '💰' :
                 tipo.includes('conta_pausada') || tipo.includes('saldo_zerado') || tipo.includes('creditos_criticos') ? '🚫' :
                 tipo.includes('saldo_baixo') || tipo.includes('creditos_baixos') ? '⚠️' :
                 tipo.includes('saldo_medio') ? '💛' :
                 tipo.includes('recarga') ? '✅' :
                 tipo.includes('sistema') ? '⚙️' : '🔔';
    %>
    <div class="notif-item <%= lida ? 'lida' : 'nao-lida' %>"
      data-tipo="<%= tipo %>"
      data-lida="<%= lida %>"
      onclick="marcarLida('<%= n.id %>', this)">
      <div class="notif-ic"><%= ic %></div>
      <div class="notif-body">
        <div class="notif-titulo"><%= n.titulo || 'Notificação' %></div>
        <div class="notif-msg"><%= n.mensagem || '' %></div>
        <div class="notif-tempo"><%= n.criadaEm || '' %></div>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<div id="pane-radar" class="card" style="padding:8px;display:none">
  <div id="radar-carregando" style="text-align:center;padding:40px 20px;color:var(--text-ter);font-size:13px">Analisando sua conta...</div>
  <div id="radar-vazio" class="notif-empty" style="display:none">
    <div style="font-size:36px;margin-bottom:12px;opacity:.3">🎯</div>
    <div style="font-size:14px;font-weight:500;color:var(--text-sec);margin-bottom:4px">Nenhum alerta agora</div>
    <div style="font-size:12px">Sua conta está redonda — nada pedindo atenção no momento.</div>
  </div>
  <div id="radar-filtro" style="display:none;gap:6px;flex-wrap:wrap;margin-bottom:12px">
    <button class="rf-chip on" data-tier="" onclick="filtrarRadarPropensao('',this)">Todos</button>
    <button class="rf-chip" data-tier="alta" onclick="filtrarRadarPropensao('alta',this)">🔥 Propensão alta</button>
    <button class="rf-chip" data-tier="media" onclick="filtrarRadarPropensao('media',this)">🌤 Propensão média</button>
    <button class="rf-chip" data-tier="baixa" onclick="filtrarRadarPropensao('baixa',this)">🧊 Propensão baixa</button>
  </div>
  <div id="radar-list"></div>
  <div id="radar-filtro-vazio" class="notif-empty" style="display:none;padding:30px 20px">
    <div style="font-size:12px">Nenhum lead com essa propensão no radar agora.</div>
  </div>
</div>

<script>
// Radar do Corretor — mesmo motor de sinais do balão flutuante
// (services/agenteProativo.js), mas mostrando TODOS os sinais ativos, não
// só o mais urgente. Calculado ao vivo a cada abertura da aba (não fica
// salvo em tabela) — some sozinho da lista assim que a causa é resolvida.
let _radarCarregado = false;
let _radarFiltroPropensao = '';
function abrirRadar(btn) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('on'));
  btn.classList.add('on');
  document.getElementById('pane-notif').style.display = 'none';
  document.getElementById('pane-radar').style.display = 'block';
  if (!_radarCarregado) carregarRadar();
}
async function carregarRadar() {
  const carregando = document.getElementById('radar-carregando');
  const vazio = document.getElementById('radar-vazio');
  const lista = document.getElementById('radar-list');
  const filtroRow = document.getElementById('radar-filtro');
  try {
    const r = await fetch('/api/agente/todos-sinais');
    const d = await r.json();
    _radarCarregado = true;
    carregando.style.display = 'none';
    const sinais = (d && d.sinais) || [];
    if (!sinais.length) { vazio.style.display = 'block'; return; }
    filtroRow.style.display = 'flex';
    const rotulo = { crit: 'Urgente', atencao: 'Atenção', oportunidade: 'Oportunidade', info: 'Info' };
    const rotuloProp = { alta: '🔥 Propensão alta', media: '🌤 Propensão média', baixa: '🧊 Propensão baixa' };
    // Construção via DOM (não innerHTML) — título/texto do sinal podem
    // carregar nome de lead/imóvel cadastrado por qualquer pessoa, então
    // vão sempre por textContent, nunca concatenados como HTML.
    lista.innerHTML = '';
    sinais.forEach(function(s) {
      const a = document.createElement('a');
      a.className = 'radar-item';
      a.href = s.link || '#';
      a.dataset.categoria = s.categoria || '';
      a.dataset.propensao = s.propensaoTier || '';
      const sev = document.createElement('div');
      sev.className = 'radar-sev ' + s.severidade;
      const body = document.createElement('div');
      body.className = 'radar-body';
      const titulo = document.createElement('div');
      titulo.className = 'radar-titulo';
      titulo.textContent = s.titulo || '';
      const msg = document.createElement('div');
      msg.className = 'radar-msg';
      msg.textContent = s.texto || '';
      body.appendChild(titulo);
      body.appendChild(msg);
      if (s.propensaoTier && rotuloProp[s.propensaoTier]) {
        const prop = document.createElement('div');
        prop.className = 'radar-prop ' + s.propensaoTier;
        prop.textContent = rotuloProp[s.propensaoTier];
        body.appendChild(prop);
      }
      const tag = document.createElement('span');
      tag.className = 'radar-tag ' + s.severidade;
      tag.textContent = rotulo[s.severidade] || s.severidade;
      a.appendChild(sev);
      a.appendChild(body);
      a.appendChild(tag);
      lista.appendChild(a);
    });
  } catch(e) {
    carregando.style.display = 'none';
    vazio.style.display = 'block';
  }
}
// Filtro por propensão dentro do Radar — só afeta sinais categoria "leads"
// (que agora chegam com propensaoTier anexado, ver /api/agente/todos-sinais
// em server.js); sinais de visitas/imóveis/financeiro etc continuam sempre
// visíveis, não fazem sentido escondidos atrás de um filtro de lead.
function filtrarRadarPropensao(tier, btn) {
  _radarFiltroPropensao = tier;
  document.querySelectorAll('.rf-chip').forEach(c => c.classList.remove('on'));
  if (btn) btn.classList.add('on');
  let visiveis = 0;
  const itens = document.querySelectorAll('#radar-list .radar-item');
  itens.forEach(item => {
    const cat = item.dataset.categoria || '';
    const prop = item.dataset.propensao || '';
    const ok = !tier || cat !== 'leads' || prop === tier;
    item.style.display = ok ? '' : 'none';
    if (ok) visiveis++;
  });
  document.getElementById('radar-filtro-vazio').style.display = (tier && visiveis === 0 && itens.length > 0) ? 'block' : 'none';
}
// Chegou aqui pelo badge "🎯 Radar" do cabeçalho fixo (/app/notificacoes#radar)
// — abre a aba certa direto, sem precisar clicar de novo.
if (location.hash === '#radar') {
  const btnRadar = document.getElementById('tab-radar');
  if (btnRadar) abrirRadar(btnRadar);
}
</script>

<script>
function filtrarNotif(filtro, btn) {
  document.getElementById('pane-notif').style.display = '';
  document.getElementById('pane-radar').style.display = 'none';
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('on'));
  btn.classList.add('on');
  document.querySelectorAll('.notif-item').forEach(item => {
    const tipo = item.dataset.tipo || '';
    const lida = item.dataset.lida === 'true';
    let ok = true;
    if (filtro === 'nao_lida' && lida) ok = false;
    if (filtro === 'visita' && !tipo.includes('visita')) ok = false;
    if (filtro === 'match' && !tipo.includes('match') && !tipo.includes('vitrine')) ok = false;
    item.style.display = ok ? '' : 'none';
  });
}

async function marcarLida(id, el) {
  if (!id) return;
  try {
    await fetch('/app/notificacoes/' + id + '/lida', { method: 'POST' });
    el.classList.remove('nao-lida');
    el.classList.add('lida');
    el.dataset.lida = 'true';
  } catch(e) {}
}

async function marcarTodasLidas() {
  try {
    await fetch('/app/notificacoes/marcar-todas-lidas', { method: 'POST' });
    document.querySelectorAll('.notif-item').forEach(el => {
      el.classList.remove('nao-lida');
      el.classList.add('lida');
      el.dataset.lida = 'true';
    });
  } catch(e) {}
}
</script>

<%- include('partials/app-end') %>
