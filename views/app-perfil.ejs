<script>
function copiarMcpCampo(id, btn) {
  var campo = document.getElementById(id);
  if (!campo) return;
  navigator.clipboard.writeText(campo.value).then(function(){
    var textoOriginal = btn.textContent;
    btn.textContent = 'Copiado ✓';
    setTimeout(function(){ btn.textContent = textoOriginal; }, 1500);
  }).catch(function(){ campo.select(); });
}
</script>
<% } %>

<script>
(function(){
  var p = new URLSearchParams(window.location.search);
  var msg = p.get('msg'), err = p.get('err');
  if (msg || err) {
    var box = document.getElementById('ig-msg');
    if (box) {
      box.style.display = 'block';
      box.style.background = err ? '#fef2f2' : '#f0fdf4';
      box.style.color = err ? '#dc2626' : '#16a34a';
      box.style.border = '1px solid ' + (err ? '#fecaca' : '#bbf7d0');
      box.textContent = (err ? '⚠️ ' : '✅ ') + (err || msg);
    }
  }
})();
</script>

<% if (!_afiliadoSimples) { %>
<script>
let _cepPerfilLat = null, _cepPerfilLng = null;

function fmtCEPPerfil(input) {
  let v = input.value.replace(/\D/g,'');
  if (v.length > 5) v = v.slice(0,5) + '-' + v.slice(5,8);
  input.value = v;
  if (v.replace(/\D/g,'').length === 8) buscarCEPPerfil(v);
}

async function buscarCEPPerfil(cepFormatado) {
  const cep = cepFormatado.replace(/\D/g,'');
  const res = document.getElementById('cep-resultado-perfil');
  res.style.display = 'block';
  res.style.background = '#f9fafb'; res.style.color = '#6b7280';
  res.textContent = 'Buscando CEP...';
  try {
    const d = await (await fetch('https://viacep.com.br/ws/'+cep+'/json/')).json();
    if (d.erro) {
      res.style.background = '#fef2f2'; res.style.color = '#dc2626';
      res.textContent = 'CEP não encontrado';
      return;
    }
    document.getElementById('rua-input').value = d.logradouro || '';
    document.getElementById('bairro-input').value = d.bairro || '';
    document.getElementById('cidade-input').value = d.localidade || '';
    const sel = document.getElementById('estado-input');
    for (let i=0;i<sel.options.length;i++) if (sel.options[i].value === d.uf) { sel.selectedIndex = i; break; }
    res.style.background = '#f0fdf4'; res.style.color = '#16a34a';
    res.textContent = '✅ Endereço preenchido automaticamente';
    _cepPerfilLat = null; _cepPerfilLng = null;
    try {
      const enderecoBusca = [d.logradouro, d.bairro, d.localidade + (d.uf ? '/'+d.uf : '')].filter(Boolean).join(', ');
      const q = encodeURIComponent(enderecoBusca + ', Brasil');
      const geo = await (await fetch('https://nominatim.openstreetmap.org/search?format=json&q='+q+'&limit=1')).json();
      if (geo && geo[0]) {
        _cepPerfilLat = parseFloat(geo[0].lat);
        _cepPerfilLng = parseFloat(geo[0].lon);
      }
    } catch(e) {}
  } catch(e) {
    res.style.display = 'block';
    res.style.background = '#fef2f2'; res.style.color = '#dc2626';
    res.textContent = 'Erro ao buscar CEP';
  }
}

function salvarEnderecoCep() {
  const rua = document.getElementById('rua-input').value;
  const numero = document.getElementById('numero-input').value;
  const bairro = document.getElementById('bairro-input').value;
  const cidade = document.getElementById('cidade-input').value;
  const estado = document.getElementById('estado-input').value;
  const enderecoCompleto = [rua && numero ? rua+', '+numero : rua, bairro, cidade && estado ? cidade+'/'+estado : cidade].filter(Boolean).join(' - ');
  document.getElementById('inp-lat').value = _cepPerfilLat || '';
  document.getElementById('inp-lng').value = _cepPerfilLng || '';
  document.getElementById('inp-endereco').value = enderecoCompleto;
  document.getElementById('inp-cep').value = document.getElementById('cep-input').value;
  document.getElementById('inp-rua').value = rua;
  document.getElementById('inp-numero').value = numero;
  document.getElementById('inp-bairro').value = bairro;
  document.getElementById('inp-cidade').value = cidade;
  document.getElementById('inp-estado').value = estado;
  document.getElementById('form-loc').submit();
}

function pegarLocalizacao() {
  const btn = document.getElementById('btn-loc');
  const status = document.getElementById('loc-status');
  btn.textContent = 'Obtendo localização...';
  btn.disabled = true;

  if (!navigator.geolocation) {
    status.innerHTML = '<span style="color:#b91c1c">● Geolocalização não suportada neste navegador.</span>';
    btn.disabled = false;
    return;
  }

  navigator.geolocation.getCurrentPosition(async (pos) => {
    const lat = pos.coords.latitude;
    const lng = pos.coords.longitude;
    _cepPerfilLat = lat;
    _cepPerfilLng = lng;
    try {
      const r = await fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat='+lat+'&lon='+lng);
      const d = await r.json();
      const a = d.address || {};
      document.getElementById('rua-input').value = a.road || a.pedestrian || a.residential || '';
      document.getElementById('numero-input').value = a.house_number || '';
      document.getElementById('bairro-input').value = a.suburb || a.neighbourhood || a.city_district || '';
      document.getElementById('cidade-input').value = a.city || a.town || a.municipality || a.village || '';
      if (a.postcode) document.getElementById('cep-input').value = a.postcode;
      const sel = document.getElementById('estado-input');
      for (let i=0;i<sel.options.length;i++) if (sel.options[i].text === a.state) { sel.selectedIndex = i; break; }
      status.innerHTML = '<span style="color:#15803d">●</span> <span style="font-size:13px">Localização obtida — revise os campos e clique em Salvar</span>';
    } catch(e) {
      status.innerHTML = '<span style="color:#b91c1c">● Localização obtida, mas não foi possível identificar o endereço.</span>';
    }
    btn.textContent = '📍 Usar minha localização atual';
    btn.disabled = false;
  }, () => {
    status.innerHTML = '<span style="color:#b91c1c">● Não foi possível obter localização. Verifique as permissões do navegador.</span>';
    btn.textContent = '📍 Usar minha localização atual';
    btn.disabled = false;
  }, { enableHighAccuracy: true, timeout: 10000 });
}

// Primeiro acesso (via botão do disparo) — captura e salva a localização
// sozinho, sem esperar clique. Falha silenciosa (sem geolocalização, sem
// permissão etc): o botão manual "Usar minha localização atual" continua
// disponível pra tentar depois.
<% if ((locals.bemvindo || locals.completarPerfil) && !(user.lat && user.lng)) { %>
function _pegarLocalizacaoAutomatico() {
  if (!navigator.geolocation) return;
  navigator.geolocation.getCurrentPosition(async (pos) => {
    const lat = pos.coords.latitude;
    const lng = pos.coords.longitude;
    let a = {};
    try {
      const r = await fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat='+lat+'&lon='+lng);
      const d = await r.json();
      a = d.address || {};
    } catch(e) {}
    const rua = a.road || a.pedestrian || a.residential || '';
    const numero = a.house_number || '';
    const bairro = a.suburb || a.neighbourhood || a.city_district || '';
    const cidade = a.city || a.town || a.municipality || a.village || '';
    const cep = a.postcode || '';
    const sel = document.getElementById('estado-input');
    let estado = '';
    if (sel) for (let i=0;i<sel.options.length;i++) if (sel.options[i].text === a.state) { estado = sel.options[i].value; break; }
    const enderecoCompleto = [rua && numero ? rua+', '+numero : rua, bairro, cidade && estado ? cidade+'/'+estado : cidade].filter(Boolean).join(' - ');
    try {
      await fetch('/app/perfil/localizacao', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lat, lng, endereco: enderecoCompleto, cep, rua, numero, bairro, cidade, estado })
      });
      // Reflete na tela sem precisar recarregar (recarregar perderia o banner de boas-vindas)
      if (document.getElementById('cep-input')) document.getElementById('cep-input').value = cep;
      if (document.getElementById('rua-input')) document.getElementById('rua-input').value = rua;
      if (document.getElementById('numero-input')) document.getElementById('numero-input').value = numero;
      if (document.getElementById('bairro-input')) document.getElementById('bairro-input').value = bairro;
      if (document.getElementById('cidade-input')) document.getElementById('cidade-input').value = cidade;
      if (sel) sel.value = estado;
      const status = document.getElementById('loc-status');
      if (status) status.innerHTML = '<span style="color:#15803d">●</span> <span style="font-size:13px">'+(enderecoCompleto||(lat+', '+lng))+'</span>';
    } catch(e) {}
  }, () => {}, { enableHighAccuracy: true, timeout: 10000 });
}
_pegarLocalizacaoAutomatico();
<% } %>



let _waTimer = null;
let _waModo = 'qr';
// Alterna entre "escanear QR" e "digitar código" (pareamento por número) —
// mesmo fluxo de conexão por trás, só troca qual rota conectarWA() chama.
function alternarModoWA(modo) {
  _waModo = modo;
  document.getElementById('wa-tab-qr').classList.toggle('on', modo === 'qr');
  document.getElementById('wa-tab-code').classList.toggle('on', modo === 'code');
  // Bug real (auditoria de UX, set/2026): aqui escondia os dois blocos sem
  // nunca mostrar o de "código por número" — clicar na aba não fazia nada
  // aparecer, e o campo pra digitar o número ficava impossível de achar.
  // QR só aparece depois que conectarWA() busca o QR de verdade; o campo
  // de número, por outro lado, precisa aparecer JÁ ao trocar de aba (é
  // nele que o usuário digita antes de clicar em "Conectar").
  document.getElementById('wa-qr-wrap').style.display = 'none';
  document.getElementById('wa-code-wrap').style.display = modo === 'code' ? 'block' : 'none';
  document.getElementById('wa-code-resultado').style.display = 'none';
  const aviso = document.getElementById('wa-aviso');
  if (aviso) aviso.style.display = 'none';
  const btn = document.getElementById('btn-wa');
  if (btn && !btn.disabled) btn.textContent = modo === 'qr' ? 'Conectar WhatsApp' : 'Gerar código';
}

async function checkWA() {
  try {
    const d = await (await fetch('/app/whatsapp/status')).json();
    const badge = document.getElementById('wa-badge');
    if (d.status === 'open') {
      badge.className = 'pf-badge pf-badge-green';
      badge.textContent = 'Conectado';
      document.getElementById('wa-ok').style.display = 'block';
      document.getElementById('wa-num').textContent = d.numero || '';
      document.getElementById('wa-qr-wrap').style.display = 'none';
      document.getElementById('wa-code-wrap').style.display = 'none';
      document.getElementById('wa-toggle').style.display = 'none';
      document.getElementById('btn-wa').style.display = 'none';
      document.getElementById('btn-wa-off').style.display = 'inline-flex';
      if (_waTimer) { clearInterval(_waTimer); _waTimer = null; }
    } else {
      document.getElementById('wa-toggle').style.display = 'flex';
      badge.className = 'pf-badge pf-badge-red';
      badge.textContent = 'Desconectado';
      document.getElementById('wa-ok').style.display = 'none';
      document.getElementById('btn-wa').style.display = 'inline-flex';
      document.getElementById('btn-wa-off').style.display = 'none';
    }
  } catch(e) {}
}

let _waTentativas = 0;
async function conectarWA() {
  if (_waModo === 'code') return conectarWACodigo();
  const btn = document.getElementById('btn-wa');
  const aviso = document.getElementById('wa-aviso');
  btn.textContent = 'Gerando QR...';
  btn.disabled = true;
  if (aviso) aviso.style.display = 'none';
  _waTentativas++;
  try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 15000);
    const resp = await fetch('/app/whatsapp/qrcode', { signal: controller.signal });
    clearTimeout(timeout);
    const d = await resp.json();
    _waTentativas = 0;
    if (d.base64) {
      const qrVal = d.base64;
      if (qrVal.startsWith('data:image')) {
        document.getElementById('wa-qr').src = qrVal;
      } else {
        document.getElementById('wa-qr').src = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(qrVal);
      }
      document.getElementById('wa-qr-wrap').style.display = 'block';
      btn.textContent = 'Gerar novo QR';
      btn.disabled = false;
      _waTimer = setInterval(checkWA, 3000);
    } else {
      btn.textContent = 'Tentar novamente';
      btn.disabled = false;
      if (aviso) { aviso.textContent = d.erro || 'Não foi possível gerar o QR code. Clique em "Gerar novo QR" para tentar novamente.'; aviso.style.display = 'block'; }
    }
  } catch(e) {
    btn.textContent = 'Gerar novo QR';
    btn.disabled = false;
    if (aviso) { aviso.textContent = 'Conexão falhou. Clique em "Gerar novo QR" para tentar novamente.'; aviso.style.display = 'block'; }
  }
}

async function conectarWACodigo() {
  const btn = document.getElementById('btn-wa');
  const aviso = document.getElementById('wa-aviso');
  const numeroInput = document.getElementById('wa-numero-input');
  const numero = (numeroInput.value || '').replace(/\D/g, '');
  if (aviso) aviso.style.display = 'none';
  if (!numero || numero.length < 10) {
    if (aviso) { aviso.textContent = 'Informe um número válido, com DDD.'; aviso.style.display = 'block'; }
    return;
  }
  document.getElementById('wa-code-resultado').style.display = 'none';
  btn.textContent = 'Gerando código...';
  btn.disabled = true;
  try {
    // Timeout mais folgado que o do QR — a rota tenta por até ~30s do lado
    // do servidor antes de desistir (10 tentativas de 3s).
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 35000);
    const resp = await fetch('/app/whatsapp/pairing-code?numero=' + numero, { signal: controller.signal });
    clearTimeout(timeout);
    const d = await resp.json();
    if (d.pairingCode) {
      document.getElementById('wa-code-big').textContent = d.pairingCode;
      document.getElementById('wa-code-resultado').style.display = 'block';
      btn.textContent = 'Gerar novo código';
      btn.disabled = false;
      _waTimer = setInterval(checkWA, 3000);
    } else {
      btn.textContent = 'Tentar novamente';
      btn.disabled = false;
      if (aviso) { aviso.textContent = d.erro || 'Não foi possível gerar o código. Tente novamente.'; aviso.style.display = 'block'; }
    }
  } catch(e) {
    btn.textContent = 'Gerar novo código';
    btn.disabled = false;
    if (aviso) { aviso.textContent = 'Conexão falhou. Tente novamente.'; aviso.style.display = 'block'; }
  }
}

async function desconectarWA() {
  await fetch('/app/whatsapp/desconectar', { method: 'POST' });
  checkWA();
}

checkWA();
</script>
<% } %>

