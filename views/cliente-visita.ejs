<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <title>Confirme sua Visita • MatchImóveis</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f5f5f4;color:#1a1a1a}
    .topbar{background:#fff;border-bottom:1px solid #e5e7eb;padding:16px 24px}
    .logo{color:#FF385C;font-size:20px;font-weight:700}
    .container{max-width:560px;margin:40px auto;padding:0 20px}
    .card{background:#fff;border-radius:16px;padding:32px;border:0.5px solid rgba(0,0,0,.08)}
    .badge{display:inline-flex;align-items:center;gap:6px;background:#f0fdf4;color:#15803d;border:0.5px solid #86efac;padding:5px 14px;border-radius:999px;font-size:12px;font-weight:500;margin-bottom:16px}
    h1{font-size:22px;font-weight:600;margin-bottom:8px;color:#111}
    .sub{color:#6b7280;margin-bottom:24px;font-size:14px;line-height:1.6}
    .info-row{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #f3f4f6;font-size:14px}
    .info-row:last-of-type{border:none}
    .info-label{color:#9ca3af}
    .info-val{font-weight:500;color:#111}
    .btns{display:flex;flex-direction:column;gap:10px;margin-top:28px}
    .btn{padding:14px;border-radius:10px;border:none;font-size:14px;font-weight:600;cursor:pointer;width:100%;transition:opacity .15s}
    .btn:hover{opacity:.88}
    .btn-confirmar{background:#22c55e;color:#fff}
    .btn-recusar{background:#f9fafb;color:#6b7280;border:0.5px solid rgba(0,0,0,.1)}
    .btn-remarcar{background:#f9fafb;color:#6b7280;border:0.5px solid rgba(0,0,0,.1)}
    .footer{text-align:center;font-size:11px;color:#d1d5db;margin-top:24px}
  </style>
</head>
<body>
  <div class="topbar"><span class="logo">MatchImóveis</span></div>
  <div class="container">
    <div class="card">
      <div class="badge">🏠 Visita confirmada pelo responsável</div>
      <h1>Olá, <%= visita.nome||'cliente' %>!</h1>
      <p class="sub">Sua visita foi confirmada. Por favor confirme sua presença abaixo.</p>
      <div class="info-row"><span class="info-label">Imóvel</span><span class="info-val"><%= visita.imovelTitulo||visita.imovelBairro||'—' %></span></div>
      <div class="info-row"><span class="info-label">Bairro</span><span class="info-val"><%= visita.imovelBairro||'—' %></span></div>
      <div class="info-row"><span class="info-label">Data</span><span class="info-val"><%= visita.dataVisita||'A confirmar' %></span></div>
      <div class="info-row"><span class="info-label">Horário</span><span class="info-val"><%= visita.horaVisita||'A confirmar' %></span></div>
      <div class="btns">
        <form method="POST" action="/cliente/visita/<%= visita.id %>/confirmar">
          <button class="btn btn-confirmar" type="submit">✅ Confirmo minha presença</button>
        </form>
        <form method="POST" action="/cliente/visita/<%= visita.id %>/recusar">
          <button class="btn btn-recusar" type="submit">❌ Não poderei comparecer</button>
        </form>
        <a href="/cliente/visita/<%= visita.id %>/remarcar" class="btn btn-remarcar" style="text-align:center;text-decoration:none;display:block">📅 Preciso remarcar a data</a>
      </div>
    </div>
    <p class="footer">MatchImóveis · Assistente imobiliário com memória</p>
  </div>
</body>
</html>
