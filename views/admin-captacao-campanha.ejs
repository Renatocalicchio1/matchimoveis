<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Admin — Campanha de Captação</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f5f5f3;color:#111827;font-size:14px}
header{background:#111827;color:#fff;padding:16px 24px;display:flex;align-items:center;gap:16px;position:sticky;top:0;z-index:100;margin-left:var(--sidebar-w)}
header h1{font-size:16px;font-weight:500}
header .badge{background:#FF385C;color:#fff;font-size:11px;padding:2px 8px;border-radius:20px}
@media(max-width:900px){ header{margin-left:0} }
.content{padding:24px;max-width:1700px;margin:0 auto 0 calc(var(--sidebar-w) + 24px)}
@media(max-width:900px){ .content{margin-left:auto} }
.status-box{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:20px;margin-bottom:20px;display:flex;align-items:center;gap:14px}
.status-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.status-dot.rodando{background:#16a34a;animation:pulso 1.4s ease-in-out infinite}
.status-dot.parada{background:#9ca3af}
.status-dot.concluida{background:#2563eb}
@keyframes pulso{0%,100%{opacity:1}50%{opacity:.4}}
.status-txt{font-weight:600;font-size:14px}
.status-sub{font-size:12px;color:#6b7280;margin-top:2px}
.actions{margin-left:auto;display:flex;gap:8px}
.btn{padding:9px 18px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:none}
.btn-iniciar{background:#16a34a;color:#fff}
.btn-pausar{background:#dc2626;color:#fff}
.btn:disabled{opacity:.5;cursor:not-allowed}
.funil{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:20px}
.funil-card{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:16px;text-align:center}
.funil-n{font-size:26px;font-weight:700;color:#111827}
.funil-l{font-size:11.5px;color:#6b7280;margin-top:4px}
.funil-pct{font-size:12px;color:#00A699;font-weight:600;margin-top:2px}
.barra-box{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:20px;margin-bottom:20px}
.barra-titulo{font-size:12px;color:#6b7280;margin-bottom:10px;display:flex;justify-content:space-between}
.barra{height:10px;background:#f0f0ee;border-radius:999px;overflow:hidden}
.barra-fill{height:100%;background:linear-gradient(90deg,#FF385C,#FC642D);transition:width .3s}
.aviso{background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:10px;padding:12px 16px;font-size:12.5px;margin-bottom:20px}
@media(max-width:700px){ .funil{grid-template-columns:repeat(2,1fr)} table{min-width:700px} }
.tabela-box{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:16px;overflow-x:auto}
.tabela-titulo{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.tabela-titulo h2{font-size:14px;font-weight:600}
table{width:100%;border-collapse:collapse;font-size:12px;min-width:1120px}
th{text-align:left;padding:8px;background:#f9f9f7;font-size:10.5px;text-transform:uppercase;color:#6b7280;white-space:nowrap;border-bottom:1px solid #e5e5e3}
td{padding:8px;border-bottom:1px solid #f0f0ee;white-space:nowrap}
.tag{display:inline-block;padding:2px 8px;border-radius:20px;font-size:10.5px;font-weight:600}
.tag-sim{background:#f0fdf4;color:#16a34a}
.tag-nao{background:#f3f4f6;color:#9ca3af}
.tag-erro{background:#fef2f2;color:#dc2626}
.link-preview{color:#FF385C;font-weight:600;text-decoration:none}
<%- adminShellCss %>
</style>
</head>
<body>
<div class="admin-app">
<%- adminSidebar %>

<header>
  <div><h1>Campanha de Captação <span class="badge">Admin</span></h1></div>
</header>

<div class="content">
  <% if(!status){ %>
    <div class="aviso">⚠️ Erro ao carregar status da campanha.</div>
  <% } else { %>
    <div class="aviso">
      Dispara e-mails com intervalo aleatório de 1 a 3 minutos (nunca fixo, pra não parecer robô pros provedores de email) pra leads sem imóvel captado ainda — busca em <strong>duas fontes</strong>: leads que já buscaram imóvel na plataforma (tabela leads) e a base de Interessados de Portal que você importou, sempre convidando a cadastrar via <strong>matchimoveis.ia.br/captar/REN-G9K6</strong>. Título e corpo também alternam entre várias variações pra não cair em spam. Não mexe no e-mail individual que já dispara quando uma lead nova entra (esse continua igual, com o link do corretor dono dela).
    </div>

    <% if (isSuper) { %>
    <div class="status-box">
      <span class="status-dot <%= status.ativo ? 'rodando' : (status.pendentes===0 ? 'concluida' : 'parada') %>" id="statusDot"></span>
      <div>
        <div class="status-txt" id="statusTxt"><%= status.ativo ? '🟢 Rodando' : (status.pendentes===0 && status.enviados>0 ? '✓ Concluída' : '⏸ Parada') %></div>
        <div class="status-sub" id="statusSub"><%= status.pendentes %> pendente<%= status.pendentes===1?'':'s' %> — estimativa de <strong>~<%= status.minutosRestantes %></strong> min restantes (intervalo de 1 a 3 min por envio)</div>
      </div>
      <div class="actions">
        <button class="btn btn-iniciar" id="btnIniciar" onclick="iniciarCampanha()" <%= status.ativo || status.pendentes===0 ? 'disabled' : '' %>>▶ Iniciar</button>
        <button class="btn btn-pausar" id="btnPausar" onclick="pausarCampanha()" <%= !status.ativo ? 'disabled' : '' %>>⏸ Pausar</button>
      </div>
    </div>
    <% } %>

    <% if (isSuper) { %>
    <div class="status-box" style="flex-direction:column;align-items:flex-start;gap:6px">
      <div style="font-weight:600;font-size:13.5px">🤝 Distribuir atendimentos abertos</div>
      <div style="font-size:12px;color:#6b7280">Quem clicou e ainda não tem sub-admin atendendo é dividido em round-robin entre os sub-admins ativos — não mexe em quem já tem atendente. Cada sub-admin só vê os que são dele em "Envios recentes" abaixo.</div>
      <button class="btn btn-iniciar" onclick="distribuirAtendimentos()">🔀 Distribuir agora</button>
      <div id="distribuir-resultado" style="font-size:12.5px"></div>
    </div>
    <% } %>

    <div class="barra-box">
      <div class="barra-titulo"><span>Progresso do envio</span><span id="barraTxt"><%= status.enviados %> / <%= status.elegiveis %></span></div>
      <div class="barra"><div class="barra-fill" id="barraFill" style="width:<%= status.elegiveis ? Math.round(status.enviados/status.elegiveis*100) : 0 %>%"></div></div>
    </div>

    <div class="funil">
      <div class="funil-card"><div class="funil-n" id="fElegiveis"><%= status.elegiveis %></div><div class="funil-l">Elegíveis</div></div>
      <div class="funil-card"><div class="funil-n" id="fEnviados"><%= status.enviados %></div><div class="funil-l">Enviados</div></div>
      <div class="funil-card"><div class="funil-n" id="fAbertos"><%= status.abertos %></div><div class="funil-l">Abriram</div><div class="funil-pct" id="fPctAbertura"><%= status.pctAbertura %>%</div></div>
      <div class="funil-card"><div class="funil-n" id="fClicados"><%= status.clicados %></div><div class="funil-l">Clicaram no link</div><div class="funil-pct" id="fPctClique"><%= status.pctClique %>%</div></div>
      <div class="funil-card"><div class="funil-n" id="fIniciaram"><%= status.iniciaram %></div><div class="funil-l">Iniciaram cadastro</div><div class="funil-pct" id="fPctIniciaram"><%= status.pctIniciaram %>%</div></div>
    </div>

    <div class="tabela-box">
      <div class="tabela-titulo">
        <h2>Envios recentes</h2>
      </div>
      <div style="margin-bottom:12px">
        <input type="text" id="busca" placeholder="Buscar por nome ou email..." style="width:260px;display:inline-block;padding:8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px" oninput="buscar()">
        <select id="filtro" onchange="buscar()" style="width:180px;display:inline-block;margin-left:8px;padding:8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px">
          <option value="">Todos</option>
          <option value="abriu">Quem abriu</option>
          <option value="clicou">Quem clicou</option>
          <option value="cadastrou">Quem cadastrou</option>
          <option value="erro">Erros</option>
        </select>
      </div>
      <table>
        <thead><tr><th>Nome</th><th>Email</th><th>Celular</th><th>Data enviado</th><th>Abriu</th><th>Clicou</th><th>Iniciou cadastro</th><th>Imóvel captado</th><th>QuintoAndar</th><th>F.up 1</th><th>F.up 2</th><th>F.up 3</th><th>E-mail</th></tr></thead>
        <tbody id="tabelaEnvios"><tr><td colspan="13" style="text-align:center;color:#9ca3af">Carregando...</td></tr></tbody>
      </table>
      <div id="paginacao" style="margin-top:10px;font-size:12.5px;color:#6b7280"></div>
    </div>
  <% } %>
</div>
</div>

<script>
async function _post(url){
  const r = await fetch(url, { method:'POST' });
  return r.json();
}
function escHtml(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function _setTxt(id, val){ const el = document.getElementById(id); if(el) el.textContent = val; }
// status-box (dot/texto/botões Iniciar-Pausar) some da tela pra conta admin
// secundária (ver isSuper no server) — os ids dela podem não existir no DOM,
// por isso os _setTxt/checks abaixo em vez de document.getElementById direto
// (sem isso, o primeiro elemento ausente travava o resto da função e o funil/
// tabela, que a conta secundária PODE ver, parava de atualizar sozinho).
function _atualizarTela(s){
  _setTxt('fElegiveis', s.elegiveis);
  _setTxt('fEnviados', s.enviados);
  _setTxt('fAbertos', s.abertos);
  _setTxt('fPctAbertura', s.pctAbertura + '%');
  _setTxt('fClicados', s.clicados);
  _setTxt('fPctClique', s.pctClique + '%');
  _setTxt('fIniciaram', s.iniciaram);
  _setTxt('fPctIniciaram', s.pctIniciaram + '%');
  _setTxt('barraTxt', s.enviados + ' / ' + s.elegiveis);
  const barraFill = document.getElementById('barraFill');
  if(barraFill) barraFill.style.width = (s.elegiveis ? Math.round(s.enviados/s.elegiveis*100) : 0) + '%';
  const dot = document.getElementById('statusDot');
  const txt = document.getElementById('statusTxt');
  const sub = document.getElementById('statusSub');
  const concluida = s.pendentes === 0 && s.enviados > 0;
  if(dot) dot.className = 'status-dot ' + (s.ativo ? 'rodando' : (concluida ? 'concluida' : 'parada'));
  if(txt) txt.textContent = s.ativo ? '🟢 Rodando' : (concluida ? '✓ Concluída' : '⏸ Parada');
  if(sub) sub.innerHTML = s.pendentes + ' pendente' + (s.pendentes===1?'':'s') + ' — estimativa de <strong>~' + s.minutosRestantes + '</strong> min restantes (intervalo de 1 a 3 min por envio)';
  const btnIniciar = document.getElementById('btnIniciar');
  if(btnIniciar) btnIniciar.disabled = s.ativo || s.pendentes === 0;
  const btnPausar = document.getElementById('btnPausar');
  if(btnPausar) btnPausar.disabled = !s.ativo;
}
async function iniciarCampanha(){
  if(!confirm('Iniciar o disparo? Vai mandar os emails com intervalo aleatório de 1 a 3 minutos até esgotar as leads elegíveis.')) return;
  const d = await _post('/admin/captacao-campanha/iniciar');
  if(d.ok) _atualizarTela(d.status);
}
async function pausarCampanha(){
  const d = await _post('/admin/captacao-campanha/pausar');
  if(d.ok) _atualizarTela(d.status);
}
async function distribuirAtendimentos(){
  const el = document.getElementById('distribuir-resultado');
  el.innerHTML = '<p>⏳ Distribuindo...</p>';
  const d = await _post('/admin/captacao-campanha/distribuir-atendimentos');
  if(!d.ok){ el.innerHTML = '<p style="color:#dc2626">Erro: '+d.erro+'</p>'; return; }
  el.innerHTML = '<p style="color:#16a34a">✅ '+d.distribuidos+' contato(s) distribuído(s).</p>';
  carregarTabela(_paginaEnvios);
}
function _tag(cond){ return cond ? '<span class="tag tag-sim">Sim</span>' : '<span class="tag tag-nao">Não</span>'; }
function _dataFmt(iso){ return iso ? new Date(iso).toLocaleString('pt-BR', { timeZone:'America/Sao_Paulo' }) : ''; }

// ── WhatsApp manual + follow-up (mesmo sistema de /admin/campanha) ─────────
const LINK_CAPTACAO = 'https://matchimoveis.ia.br/captar/REN-G9K6';
// Link de opt-out de 1 clique (rota pública /wa-optout/captacao/:id em
// server.js) — token vem pronto em e.optoutToken (calculado no servidor em
// /admin/captacao-campanha/lista, o cliente não pode gerar sozinho).
function _avisoOptOutWA(e){
  const linkOptOut = 'https://www.matchimoveis.ia.br/wa-optout/captacao/'+e.id+'?t='+(e.optoutToken||'');
  return '\n\n(Se esse número não é seu ou você não quer mais receber mensagens, clique aqui: '+linkOptOut+')';
}

// Campo às vezes vem com mais de um número junto (fixo + celular na mesma
// célula) — separa por vírgula/barra/ponto-e-vírgula e prioriza celular
// (11 dígitos de DDD+número) sobre fixo (10 dígitos, que nem tem WhatsApp).
function _celularWA(raw){
  const candidatos = String(raw||'').split(/[,/;]+/)
    .map(function(p){ return p.replace(/\D/g,'').replace(/^55/,''); })
    .filter(Boolean);
  const movel = candidatos.find(function(d){ return d.length === 11; });
  if(movel) return '55'+movel;
  const fixo = candidatos.find(function(d){ return d.length === 10; });
  if(fixo) return '55'+fixo;
  return '';
}

// Estágio por estado atual (sem prazo de 24h — isso é só pro follow-up
// automático; o botão manual reflete o funil agora, na hora do clique).
function _whatsappEstagio(e){
  if(!_celularWA(e.telefone)) return null;
  if(e.iniciou_cadastro_em) return null; // já iniciou, converteu
  if(e.clicado_em) return 'clicou_sem_iniciar';
  if(e.aberto_em) return 'abriu_sem_clicar';
  if(e.enviado_em) return 'nao_abriu';
  return null;
}

const WHATSAPP_VARIACOES = {
  nao_abriu: function(nome, link){ return [
    'Oi '+nome+'! Te mandei um e-mail sobre cadastrar seu imóvel com a gente, mas acho que passou despercebido. Dá uma olhada aqui: '+link,
    'Oi '+nome+', tudo bem? Reforçando o convite pra cadastrar seu imóvel — sem custo, leva 2 minutos: '+link,
    'Oi '+nome+'! Passando rapidinho — mandei um e-mail sobre colocar seu imóvel na nossa rede de corretores. Segue o link: '+link,
    'Oi '+nome+', bom dia! Vi que meu e-mail sobre cadastrar seu imóvel ainda não foi aberto. Vale a pena conferir: '+link,
    'Oi '+nome+'! Quero te ajudar a divulgar seu imóvel sem custo nenhum. Cadastra aqui quando puder: '+link,
  ]; },
  abriu_sem_clicar: function(nome, link){ return [
    'Oi '+nome+'! Vi que você abriu o e-mail sobre cadastrar seu imóvel, mas ainda não deu uma olhada na página. Segue o link: '+link,
    'Oi '+nome+', tudo certo? Notei que você abriu meu e-mail sobre o imóvel. Falta só clicar aqui pra cadastrar: '+link,
    'Oi '+nome+'! Você chegou a ver o convite pra cadastrar seu imóvel — se quiser continuar, é só entrar aqui: '+link,
    'Oi '+nome+', passando pra lembrar: você abriu o e-mail sobre o imóvel mas ainda não visitou a página. Segue de novo: '+link,
    'Oi '+nome+'! Vi que você abriu o e-mail. Ainda dá tempo de cadastrar seu imóvel sem custo: '+link,
  ]; },
  clicou_sem_iniciar: function(nome){ return [
    'Oi '+nome+'! Vi que você chegou a entrar na página do seu imóvel, mas não finalizou o cadastro. Posso te ajudar a terminar?',
    'Oi '+nome+', tudo bem? Notei que você visitou a página de cadastro do imóvel, mas ficou pela metade. Quer ajuda pra finalizar?',
    'Oi '+nome+'! Faltou só terminar o cadastro do seu imóvel. Posso te ajudar com alguma dúvida?',
    'Oi '+nome+', passando pra lembrar: seu cadastro ficou incompleto. Se quiser, te ajudo a finalizar agora.',
    'Oi '+nome+'! Vi que você chegou perto de cadastrar seu imóvel com a gente. Bora terminar? Me chama se tiver alguma dúvida.',
  ]; },
};
function _sorteiaWA(lista){ return lista[Math.floor(Math.random()*lista.length)]; }
function _whatsappMensagem(e, estagio){
  const nome = (e.nome||'').trim().split(' ')[0] || 'tudo bem';
  const gerador = WHATSAPP_VARIACOES[estagio];
  if(!gerador) return '';
  const msg = _sorteiaWA(gerador(nome, LINK_CAPTACAO));
  return msg + _avisoOptOutWA(e);
}
// Texto de e-mail manual — mesmo espírito das variações de WhatsApp acima,
// só que pra mandar pelo próprio cliente de e-mail do sub-admin (mailto:).
// Link usa a rota de rastreio (/captacao-campanha/click/:id) igual ao e-mail
// automático, então continua contando como clique se ela entrar por aqui.
function _mailtoLink(e){
  const nome = (e.nome||'').trim().split(' ')[0] || 'tudo bem';
  const link = 'https://matchimoveis.ia.br/captacao-campanha/click/'+e.id;
  const assunto = 'Seu imóvel pode estar rendendo mais — cadastro rápido e sem custo';
  const corpo = 'Oi '+nome+', tudo bem?\n\nMandei um e-mail sobre cadastrar seu imóvel na nossa rede de mais de 9.000 corretores, sem nenhum custo — leva menos de 2 minutos.\n\nSegue o link direto: '+link+'\n\nQualquer dúvida, me chama por aqui mesmo.';
  return 'mailto:'+encodeURIComponent(e.email||'')+'?subject='+encodeURIComponent(assunto)+'&body='+encodeURIComponent(corpo);
}
// Sob o nome: quem já atendeu aparece marcado, com um botão de e-mail manual
// que continua disponível mesmo depois de atendido (pra mandar follow-up de
// novo) — enquanto não integra o disparo dessa campanha com template de
// WhatsApp da Meta, o canal manual pra reativar quem tá parado é o e-mail.
// Botão de WhatsApp só aparece ANTES de atender (é o mesmo clique que
// reivindica o atendimento — ver _clicarWhatsapp).
function _subNome(e){
  let html = '';
  if(e.atendido_por_nome){
    html += '<div style="font-size:11px;font-weight:600;color:'+escHtml(e.atendido_por_cor||'#6b7280')+';margin-top:2px">✅ Atendido por '+escHtml(e.atendido_por_nome)+'</div>';
  } else {
    const estagio = _whatsappEstagio(e);
    if(estagio){
      const rotulos = { nao_abriu: '📲 Reenviar link', abriu_sem_clicar: '📲 Lembrar cadastro', clicou_sem_iniciar: '📲 Ajudar a terminar' };
      html += '<button type="button" class="btn-atender-wa" data-id="'+e.id+'" style="margin-top:4px;background:#25D366;color:#fff;border:none;border-radius:6px;padding:4px 8px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap">'+rotulos[estagio]+'</button>';
    }
  }
  if(!e.iniciou_cadastro_em && e.email){
    html += '<a href="'+_mailtoLink(e)+'" class="btn-mailto-atender" data-id="'+e.id+'" style="display:inline-block;margin-top:4px;margin-left:4px;background:#2563eb;color:#fff;border-radius:6px;padding:4px 8px;font-size:11px;font-weight:600;text-decoration:none;white-space:nowrap">📧 E-mail manual</a>';
  }
  return html;
}
async function _clicarWhatsapp(e){
  const estagio = _whatsappEstagio(e);
  if(!estagio) return;
  const tel = _celularWA(e.telefone);
  if(!tel) return;
  const link = 'https://wa.me/'+tel+'?text='+encodeURIComponent(_whatsappMensagem(e, estagio));
  try {
    const r = await fetch('/admin/captacao-campanha/contatos/'+e.id+'/atender', { method:'POST' });
    const d = await r.json();
    if(d.ok === false && d.jaAtendido){
      alert('Esse contato já está sendo atendido por '+(d.nome||'outra pessoa')+'.');
      carregarTabela(_paginaEnvios);
      return;
    }
  } catch(err){}
  window.open(link, '_blank');
  carregarTabela(_paginaEnvios);
}

let _paginaEnvios = 1;
function buscar(){ _paginaEnvios = 1; carregarTabela(); }
function irParaPaginaCaptacao(){
  const v = parseInt(document.getElementById('input-ir-pagina-captacao').value) || 1;
  carregarTabela(Math.max(1, v));
}
let _ultimosEnvios = [];
async function carregarTabela(pagina){
  if(pagina) _paginaEnvios = pagina;
  try {
    const q = document.getElementById('busca').value;
    const filtro = document.getElementById('filtro').value;
    const r = await fetch('/admin/captacao-campanha/lista?pagina='+_paginaEnvios+'&q='+encodeURIComponent(q)+'&filtro='+encodeURIComponent(filtro));
    const d = await r.json();
    const tbody = document.getElementById('tabelaEnvios');
    if(!tbody) return;
    if(!d.ok || !d.envios.length){ tbody.innerHTML = '<tr><td colspan="13" style="text-align:center;color:#9ca3af">Nenhum envio encontrado.</td></tr>'; document.getElementById('paginacao').innerHTML = ''; return; }
    _ultimosEnvios = d.envios;
    tbody.innerHTML = d.envios.map(function(e){
      const trBg = e.atendido_por_cor ? ' style="background:'+escHtml(e.atendido_por_cor)+'1a"' : '';
      const celularCel = e.telefone
        ? escHtml(e.telefone)+' <button type="button" class="btn-excluir-celular" data-id="'+e.id+'" title="Excluir celular (número errado ou pediu pra não receber mais)" style="background:none;border:none;cursor:pointer;font-size:11px;padding:0;margin-left:2px">🗑️</button>'
        : '<span style="color:#9ca3af">—</span>';
      // "Imóvel captado": bonus_captacao_pago_em só existe quando o cadastro foi
      // finalizado E tinha sub-admin atendendo (creditou os 200 coins) — ver
      // /captar/imovel/:id (finalizar=true) em server.js.
      const captadoCel = e.bonus_captacao_pago_em ? '<span class="tag tag-sim">✅ +200 coins</span>' : (e.imovel_captado_id ? '<span class="tag tag-nao">Em cadastro</span>' : '<span style="color:#9ca3af">—</span>');
      const qaCel = e.elegivel_quintoandar ? '<span class="tag tag-sim">🏠 Foi pro QuintoAndar</span>' : '<span style="color:#9ca3af">—</span>';
      if(e.erro) return '<tr'+trBg+'><td>'+escHtml(e.nome)+_subNome(e)+'</td><td>'+escHtml(e.email)+'</td><td>'+celularCel+'</td><td>'+_dataFmt(e.enviado_em)+'</td><td colspan="8"><span class="tag tag-erro">Erro: '+escHtml(e.erro)+'</span></td><td>—</td></tr>';
      return '<tr'+trBg+'><td>'+escHtml(e.nome)+_subNome(e)+'</td><td>'+escHtml(e.email)+'</td><td>'+celularCel+'</td><td>'+_dataFmt(e.enviado_em)+'</td><td>'+_tag(e.aberto_em)+'</td><td>'+_tag(e.clicado_em)+'</td><td>'+_tag(e.iniciou_cadastro_em)+'</td><td>'+captadoCel+'</td><td>'+qaCel+'</td><td>'+_tag(e.followup1_enviado_em)+'</td><td>'+_tag(e.followup2_enviado_em)+'</td><td>'+_tag(e.followup3_enviado_em)+'</td><td><a class="link-preview" href="/admin/captacao-campanha/preview/'+e.id+'" target="_blank">Ver e-mail →</a></td></tr>';
    }).join('');
    document.querySelectorAll('.btn-atender-wa').forEach(function(btn){
      btn.addEventListener('click', function(){
        const id = btn.getAttribute('data-id');
        const contato = _ultimosEnvios.find(function(e){ return String(e.id) === String(id); });
        if(contato) _clicarWhatsapp(contato);
      });
    });
    // "E-mail manual" é um <a href="mailto:...">, não intercepta o clique
    // (senão o cliente de e-mail não abre) — só dispara o "atender" em
    // paralelo, sem esperar resposta, pra reivindicar o lead se ainda não
    // tinha atendente. Se já tinha, o servidor ignora (marcarAtendido não
    // sobrescreve quem já pegou).
    document.querySelectorAll('.btn-mailto-atender').forEach(function(btn){
      btn.addEventListener('click', function(){
        const id = btn.getAttribute('data-id');
        fetch('/admin/captacao-campanha/contatos/'+id+'/atender', { method:'POST' }).catch(function(){});
        setTimeout(function(){ carregarTabela(_paginaEnvios); }, 1000);
      });
    });
    document.querySelectorAll('.btn-excluir-celular').forEach(function(btn){
      btn.addEventListener('click', async function(){
        if(!confirm('Excluir o celular desse contato? O e-mail e o histórico continuam guardados, só o número some.')) return;
        const id = btn.getAttribute('data-id');
        const r = await fetch('/admin/captacao-campanha/contatos/'+id+'/excluir-celular', { method:'POST' });
        const d = await r.json();
        if(!d.ok){ alert(d.erro || 'Erro'); return; }
        carregarTabela(_paginaEnvios);
      });
    });
    // 200 por página (bate com _CAPTACAO_TAMANHO_PAGINA no servidor) +
    // campo "Ir pra página" pra pular direto, mesmo padrão da Campanha Email.
    const totalPaginas = Math.max(1, Math.ceil(d.total / 200));
    let pag = '';
    if(_paginaEnvios > 1) pag += '<button class="btn" style="background:#6b7280;color:#fff" onclick="carregarTabela('+(_paginaEnvios-1)+')">← Anterior</button> ';
    pag += '<span>Página '+_paginaEnvios+' de '+totalPaginas+' — '+d.total+' envio'+(d.total===1?'':'s')+'</span> ';
    if(d.envios.length === 200) pag += ' <button class="btn" style="background:#6b7280;color:#fff" onclick="carregarTabela('+(_paginaEnvios+1)+')">Próximo →</button>';
    pag += ' <span style="margin-left:12px">Ir pra página: <input type="number" id="input-ir-pagina-captacao" min="1" max="'+totalPaginas+'" value="'+_paginaEnvios+'" style="width:70px;display:inline-block;padding:6px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;margin:0 4px"><button type="button" id="btn-ir-pagina-captacao" class="btn" style="background:#6b7280;color:#fff">Ir</button></span>';
    document.getElementById('paginacao').innerHTML = pag;
    document.getElementById('btn-ir-pagina-captacao').addEventListener('click', irParaPaginaCaptacao);
    document.getElementById('input-ir-pagina-captacao').addEventListener('keydown', function(ev){ if(ev.key === 'Enter') irParaPaginaCaptacao(); });
  } catch(e){}
}
setInterval(async function(){
  try {
    const r = await fetch('/admin/captacao-campanha/status');
    const d = await r.json();
    if(d.ok) _atualizarTela(d.status);
  } catch(e){}
  carregarTabela();
}, 15000);
carregarTabela();
</script>
</body>
</html>
