              <label class="mc-label">Texto do botão</label>
              <select class="mc-select" id="mc-editar-cta-<%= c.id %>" onchange="atualizarPreviewEdicao(<%= c.id %>)">
                <option value="SIGN_UP" <%= c.ctaLeadForm==='SIGN_UP'?'selected':'' %>>Cadastre-se</option>
                <option value="LEARN_MORE" <%= c.ctaLeadForm==='LEARN_MORE'?'selected':'' %>>Saiba mais</option>
                <option value="CONTACT_US" <%= c.ctaLeadForm==='CONTACT_US'?'selected':'' %>>Fale conosco</option>
                <option value="GET_QUOTE" <%= c.ctaLeadForm==='GET_QUOTE'?'selected':'' %>>Peça um orçamento</option>
                <option value="APPLY_NOW" <%= c.ctaLeadForm==='APPLY_NOW'?'selected':'' %>>Candidate-se</option>
                <option value="REGISTER_NOW" <%= c.ctaLeadForm==='REGISTER_NOW'?'selected':'' %>>Registre-se</option>
                <option value="MAKE_AN_APPOINTMENT" <%= c.ctaLeadForm==='MAKE_AN_APPOINTMENT'?'selected':'' %>>Marque uma consulta</option>
                <option value="GET_IN_TOUCH" <%= c.ctaLeadForm==='GET_IN_TOUCH'?'selected':'' %>>Entre em contato</option>
              </select>
            </div>
            <% } %>
          </div>
          <div>
            <div id="mc-editar-preview-vazio-<%= c.id %>" class="mc-vazio" style="display:none">Sem prévia disponível (imóvel sem foto na carteira ativa).</div>
            <div id="mc-editar-preview-<%= c.id %>" class="mc-preview">
              <div class="mc-preview-head">
                <div class="mc-preview-avatar">📷</div>
                <div>
                  <div class="mc-preview-pagina">Sua Página</div>
                  <div class="mc-preview-patrocinado">Patrocinado · <span id="mc-editar-preview-cta-label-<%= c.id %>"></span></div>
                </div>
              </div>
              <div class="mc-preview-texto"><span class="mc-selo mc-selo-1">1</span><span id="mc-editar-preview-texto-<%= c.id %>"></span></div>
              <div class="mc-preview-img-wrap">
                <img class="mc-preview-img" id="mc-editar-preview-img-<%= c.id %>" src="" alt="Prévia do anúncio">
                <button type="button" class="mc-preview-seta mc-preview-seta-prev" id="mc-editar-preview-seta-prev-<%= c.id %>" onclick="previewFotoEdicao(<%= c.id %>,-1)" aria-label="Foto anterior" style="display:none">‹</button>
                <button type="button" class="mc-preview-seta mc-preview-seta-next" id="mc-editar-preview-seta-next-<%= c.id %>" onclick="previewFotoEdicao(<%= c.id %>,1)" aria-label="Próxima foto" style="display:none">›</button>
                <div class="mc-preview-dots" id="mc-editar-preview-dots-<%= c.id %>"></div>
              </div>
              <div class="mc-preview-footer">
                <div class="mc-preview-info">
                  <div class="mc-preview-dominio"><%= dominioAnuncio %></div>
                  <div class="mc-preview-titulo-wrap"><span class="mc-selo mc-selo-2">2</span><div class="mc-preview-titulo" id="mc-editar-preview-titulo-<%= c.id %>"></div></div>
                  <div class="mc-preview-secundario-wrap" id="mc-editar-preview-secundario-wrap-<%= c.id %>" style="display:none"><span class="mc-selo mc-selo-3">3</span><div class="mc-preview-secundario" id="mc-editar-preview-secundario-<%= c.id %>"></div></div>
                </div>
                <div class="mc-preview-cta" id="mc-editar-preview-cta-<%= c.id %>">Saiba mais</div>
              </div>
            </div>
          </div>
        </div>

        <div class="mc-row" style="margin-top:8px">
          <div class="mc-field" style="margin-bottom:0">
            <label class="mc-label">Orçamento diário (R$)</label>
