function abrirMiniModalExcluir(id, nome) {
  document.getElementById('mini-modal-nome').textContent = nome || 'Lead';
  document.getElementById('mini-modal-body').innerHTML =
    '<p style="font-size:12px;color:#6b7280;margin-bottom:16px">O que deseja fazer com esta lead?</p>' +
