<%- include('partials/app-shell',{active:'imoveis',title:'Meus Imóveis',subtitle:'Base indexada pela IA — pronta para match com leads.',user:user}) %>
<% if (typeof qaIncompleto !== 'undefined' && qaIncompleto) { %>
<div style="background:#fff7ed;border:1px solid #f97316;border-radius:10px;padding:12px 16px;margin-bottom:16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
  <div>
    <div style="font-weight:700;color:#c2410c;font-size:13px">⚠️ Imóveis com dados incompletos para o QuintoAndar</div>
    <div style="font-size:12px;color:#92400e;margin-top:3px">Preencha CEP, endereço, número e dados do proprietário para que estes imóveis sejam incluídos no XML.</div>
  </div>
  <a href="/app/imoveis" style="font-size:12px;color:#c2410c;text-decoration:underline;white-space:nowrap">✕ Fechar filtro</a>
</div>
<% } %>

<style>
.im-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:14px}
/* Dropdown */
.nf-dropdown{position:fixed;background:#fff;border:1.5px solid var(--border);border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,.12);z-index:9999;min-width:220px;overflow:hidden;display:none}
.nf-dropdown.open{display:block}
.nf-dd-search{width:100%;padding:10px 14px;border:none;border-bottom:1px solid var(--border);outline:none;font-size:12px;font-family:inherit}
.nf-dd-list{max-height:260px;overflow-y:auto}
.nf-dd-item{padding:9px 14px;font-size:12px;cursor:pointer;display:flex;align-items:center;gap:8px;transition:background .08s}
.nf-dd-item:hover{background:#f5f3ff;color:#FF385C}
.nf-dd-item.on{background:#f5f3ff;color:#FF385C;font-weight:600}
.nf-dd-sep{padding:6px 14px 2px;font-size:10px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.5px;background:#fafafa;border-top:1px solid var(--border)}
/* Input numérico no dropdown */
.nf-dd-input{padding:10px 14px;border-top:1px solid var(--border)}
.nf-dd-input input{width:100%;padding:7px 10px;border:1.5px solid var(--border);border-radius:8px;font-size:12px;outline:none;box-sizing:border-box}
.nf-dd-input input:focus{border-color:#FF385C}
.nf-dd-input button{margin-top:6px;width:100%;padding:7px;border-radius:8px;border:none;background:#FF385C;color:#fff;font-size:12px;font-weight:600;cursor:pointer}
/* Busca geral */
.nf-search-wrap{display:flex;align-items:center;gap:8px;background:#fff;border:1.5px solid var(--border);border-radius:12px;padding:9px 14px;margin-bottom:10px;transition:border-color .12s}
.nf-search-wrap:focus-within{border-color:#FF385C;box-shadow:0 0 0 3px #FF385C14}
.nf-search-wrap input{border:none;outline:none;font-size:13px;color:var(--dark);background:transparent;flex:1;font-family:inherit}
.nf-search-wrap input::placeholder{color:#b0b0b8}

.im-stats{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.im-stat{padding:4px 12px;border-radius:20px;font-size:11px;font-weight:600;background:var(--bg);border:1px solid var(--border);color:var(--text-sec)}
.im-stat.verde{background:#f0fdf4;color:#16a34a;border-color:#bbf7d0}
.im-stat.vermelho{background:#fef2f2;color:#dc2626;border-color:#fecaca}
.im-stat.azul{background:#eff6ff;color:#2563eb;border-color:#bfdbfe}

.barra-sel{display:none;position:sticky;top:0;z-index:50;background:var(--dark);color:#fff;padding:12px 16px;border-radius:10px;margin-bottom:14px;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
.barra-portais{display:flex;gap:6px;flex-wrap:wrap}
.portal-btn-sel{background:rgba(255,255,255,.12);border:none;color:#fff;padding:7px 12px;border-radius:7px;cursor:pointer;font-size:11px;font-weight:600;transition:background .1s}
.portal-btn-sel:hover{background:rgba(255,255,255,.2)}
.im-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.im-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column;cursor:pointer;transition:all .15s}
.im-card:hover{border-color:#c4b5fd;box-shadow:var(--shadow-md)}
.im-card.sel{border-color:#FF385C;box-shadow:0 0 0 2px #FF385C33}
.im-img{position:relative;width:100%;height:130px;background:var(--bg);display:flex;align-items:center;justify-content:center;overflow:hidden}
.im-img img{width:100%;height:100%;object-fit:cover}
.im-img-ic{font-size:28px;opacity:.25}
.im-check{position:absolute;top:8px;left:8px;width:20px;height:20px;border-radius:5px;border:2px solid rgba(255,255,255,.8);background:rgba(0,0,0,.25);display:flex;align-items:center;justify-content:center}
.im-check.on{background:#FF385C;border-color:#FF385C}
.im-badge-status{position:absolute;top:8px;right:8px;background:#ef4444;color:#fff;font-size:9px;font-weight:700;padding:2px 7px;border-radius:20px}
.im-body{padding:12px;display:flex;flex-direction:column;flex:1}
.im-tipo{display:inline-block;padding:2px 8px;border-radius:20px;font-size:10px;font-weight:600;background:var(--brand-light);color:var(--brand);margin-bottom:6px}
.im-valor{font-size:16px;font-weight:700;color:var(--dark);letter-spacing:-.3px;margin-bottom:3px}
.im-end{font-size:11px;color:var(--text-ter);margin-bottom:8px}
.im-prop{font-size:11px;color:var(--text-sec);background:var(--bg);border:1px solid var(--border-light);border-radius:7px;padding:6px 8px;margin-bottom:8px;line-height:1.4}
.im-tags{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:10px}
.im-tag{font-size:10px;color:var(--text-sec);background:var(--bg);border:1px solid var(--border-light);border-radius:5px;padding:2px 7px}
.im-actions{display:flex;gap:6px;margin-top:auto}
.im-btn{flex:1;text-align:center;font-size:11px;font-weight:600;padding:7px 8px;border-radius:7px;text-decoration:none;border:none;cursor:pointer;transition:all .1s}
.im-btn.ver{background:var(--bg);color:var(--text);border:1px solid var(--border)}
.im-btn.ver:hover{background:#f0f0ee}
.im-btn.edit{background:var(--brand);color:#fff}
.im-btn.edit:hover{background:var(--brand-dark)}
.im-empty{text-align:center;padding:60px 20px;color:var(--text-ter)}
.modal-xml{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:999;align-items:center;justify-content:center;padding:20px}
.modal-xml-box{background:#fff;border-radius:var(--radius-lg);padding:28px;max-width:480px;width:100%;text-align:center}
@keyframes spin{to{transform:rotate(360deg)}}
.spin{width:36px;height:36px;border:3px solid var(--border);border-top-color:var(--dark);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto}

.filtro-box{background:#fff;border:1px solid var(--border);border-radius:12px;padding:14px 16px;margin-bottom:16px}
.filtro-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr 1fr;gap:10px;align-items:end}
.filtro-grid2{display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr 1fr;gap:10px;margin-top:10px}
.filtro-field label{display:block;font-size:10px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px}
.filtro-field input,.filtro-field select{width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:8px;font-size:12px;color:var(--dark);background:#fff;outline:none;box-sizing:border-box;transition:border .1s;font-family:inherit}
.filtro-field input:focus,.filtro-field select:focus{border-color:#FF385C}
.filtro-field input::placeholder{color:#b0b0b8}
.filtro-rodape{display:flex;align-items:center;justify-content:space-between;margin-top:10px;padding-top:10px;border-top:1px solid var(--border-light)}
@media(max-width:900px){.filtro-grid{grid-template-columns:1fr 1fr 1fr}.filtro-grid2{grid-template-columns:1fr 1fr 1fr}}
@media(max-width:600px){.filtro-grid,.filtro-grid2{grid-template-columns:1fr 1fr}}
@media(max-width:900px){.im-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.im-grid{grid-template-columns:1fr}}
</style>

<!-- Barra de seleção -->
<div class="barra-sel" id="barra-sel">
  <div style="display:flex;align-items:center;gap:10px">
    <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:12px;font-weight:600">
      <input type="checkbox" id="chk-todos" onchange="toggleTodos(this)" style="width:16px;height:16px;accent-color:#FF385C"> Todos
    </label>
    <span id="cnt-sel" style="font-size:13px;font-weight:600">0 selecionados</span>
    <button onclick="deselectAll()" style="background:rgba(255,255,255,.15);border:none;color:#fff;padding:4px 10px;border-radius:6px;cursor:pointer;font-size:11px">✕ Limpar</button>
  </div>
  <div style="display:flex;gap:8px;align-items:center">
    <button onclick="abrirModalPortais()" style="background:#FF385C;border:none;color:#fff;padding:8px 16px;border-radius:8px;cursor:pointer;font-size:12px;font-weight:700">📡 Publicar em portais</button>
  </div>
</div>

<!-- Modal portais lote -->
<div id="modal-portais" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;padding:20px">
  <div style="background:#fff;border-radius:16px;padding:28px;max-width:440px;width:100%">
    <div style="font-size:15px;font-weight:700;color:var(--dark);margin-bottom:4px">Publicar em portais</div>
    <div style="font-size:12px;color:var(--text-sec);margin-bottom:20px" id="modal-portais-cnt">Aplicar para os imóveis selecionados</div>
    <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px">
      <% [['vivareal','VivaReal'],['zap','ZAP Imóveis'],['olx','OLX'],['chaves','Chaves na Mão'],['imovelweb','ImovelWeb'],['123i','123i']].forEach(([k,l]) => { %>
      <label style="display:flex;align-items:center;gap:6px;background:var(--bg);border:1.5px solid var(--border);border-radius:20px;padding:7px 14px;cursor:pointer;font-size:12px;font-weight:500;transition:border .1s" class="portal-lote-label">
        <input type="checkbox" class="portal-lote-chk" value="<%= k %>" style="accent-color:#FF385C"> <%= l %>
      </label>
      <% }) %>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end">
      <button onclick="fecharModalPortais()" style="padding:9px 18px;border-radius:8px;border:1.5px solid var(--border);background:#fff;cursor:pointer;font-size:12px;font-weight:600">Cancelar</button>
      <button onclick="salvarPortaisLote()" id="btn-salvar-portais" style="padding:9px 18px;border-radius:8px;border:none;background:#FF385C;color:#fff;cursor:pointer;font-size:12px;font-weight:700">Salvar</button>
    </div>
  </div>
</div>

<!-- Toolbar -->
<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:12px">
  <div class="im-stats">
    <span class="im-stat"><%= typeof imoveis !== 'undefined' ? imoveis.length : 0 %> total</span>
    <span class="im-stat verde" id="count-ativos">—</span>
    <span class="im-stat vermelho" id="count-inativos">—</span>
    <span class="im-stat azul" id="count-sem-foto">—</span>
    <span class="im-stat" id="count-sem-prop">—</span>
  </div>
  <div style="display:flex;gap:8px;align-items:center">

    <a href="/app/cadastro" class="btn btn-primary btn-sm">+ Cadastrar</a>
  </div>
</div>


<!-- Filtro -->
<div class="filtro-box">
  <div class="filtro-grid">
    <div class="filtro-field"><label>Status</label>
      <select id="f-status" onchange="filtrar()">
        <option value="">Todos</option>
        <option value="ativo">Ativo</option>
        <option value="inativo">Inativo</option>
        <option value="rascunho">Rascunho</option>
      </select>
    </div>
    <div class="filtro-field"><label>Transação</label>
      <select id="f-operacao" onchange="filtrar()">
        <option value="">Todas</option>
        <option value="venda">Venda</option>
        <option value="aluguel">Aluguel</option>
        <option value="temporada">Temporada</option>
        <option value="permuta">Permuta</option>
      </select>
    </div>
    <div class="filtro-field"><label>Tipo</label>
      <select id="f-tipo" onchange="filtrar()">
        <option value="">Todos</option>
        <optgroup label="Residencial">
          <option value="apartamento">Apartamento</option>
          <option value="casa">Casa</option>
          <option value="cobertura">Cobertura</option>
          <option value="sobrado">Sobrado</option>
          <option value="loft">Loft</option>
          <option value="studio">Studio</option>
          <option value="kitnet">Kitnet</option>
          <option value="duplex">Duplex</option>
          <option value="mansao">Mansão</option>
          <option value="casa de condomínio">Casa de Condomínio</option>
          <option value="chacara">Chácara</option>
          <option value="sitio">Sítio</option>
          <option value="fazenda">Fazenda</option>
        </optgroup>
        <optgroup label="Comercial">
          <option value="sala">Sala Comercial</option>
          <option value="loja">Loja</option>
          <option value="galpao">Galpão</option>
          <option value="conjunto">Conjunto</option>
          <option value="predio">Prédio</option>
        </optgroup>
        <optgroup label="Terrenos">
          <option value="terreno">Terreno</option>
          <option value="area rural">Área Rural</option>
        </optgroup>
      </select>
    </div>
    <div class="filtro-field"><label>Condição</label>
      <select id="f-condicao" onchange="filtrar()">
        <option value="">Todas</option>
        <option value="usado">Usado</option>
        <option value="novo">Novo</option>
        <option value="lancamento">Lançamento</option>
      </select>
    </div>
    <div class="filtro-field"><label>Fase</label>
      <select id="f-fase" onchange="filtrar()">
        <option value="">Todas</option>
        <option value="pronto">Pronto</option>
        <option value="lancamento">Lançamento</option>
        <option value="na_planta">Na planta</option>
        <option value="em_construcao">Em construção</option>
      </select>
    </div>
  </div>
  <div class="filtro-grid2" style="margin-top:10px">
    <div class="filtro-field"><label>Estado</label>
      <select id="f-estado" onchange="atualizarCidades()">
        <option value="">Todos</option>
        <% (typeof estados !== 'undefined' ? estados : []).forEach(e => { %>
        <option value="<%= e.toLowerCase() %>"><%= e %></option>
        <% }) %>
      </select>
    </div>
    <div class="filtro-field"><label>Cidade</label>
      <select id="f-cidade" onchange="atualizarBairros()">
        <option value="">Todas</option>
      </select>
    </div>
    <div class="filtro-field"><label>Bairro</label>
      <select id="f-bairro" onchange="filtrar()">
        <option value="">Todos</option>
      </select>
    </div>
    <div class="filtro-field"><label>Valor mín. R$</label>
      <input id="f-valor-min" type="text" placeholder="Ex: 500.000" oninput="fmtValor(this);filtrar()" style="ime-mode:disabled">
    </div>
    <div class="filtro-field"><label>Valor máx. R$</label>
      <input id="f-valor-max" type="text" placeholder="Ex: 2.000.000" oninput="fmtValor(this);filtrar()" style="ime-mode:disabled">
    </div>
    <div class="filtro-field"><label>Área mín. m²</label>
      <input id="f-area-min" type="number" placeholder="0" oninput="filtrar()">
    </div>
  </div>
  <div class="filtro-grid2" style="margin-top:10px">
    <div class="filtro-field"><label>Área máx. m²</label>
      <input id="f-area-max" type="number" placeholder="∞" oninput="filtrar()">
    </div>
    <div class="filtro-field"><label>Quartos mín.</label>
      <input id="f-quartos" type="number" min="0" placeholder="0" oninput="filtrar()">
    </div>
    <div class="filtro-field"><label>Quartos máx.</label>
      <input id="f-quartos-max" type="number" min="0" placeholder="∞" oninput="filtrar()">
    </div>
    <div class="filtro-field"><label>Suítes mín.</label>
      <input id="f-suites" type="number" min="0" placeholder="0" oninput="filtrar()">
    </div>
    <div class="filtro-field"><label>Suítes máx.</label>
      <input id="f-suites-max" type="number" min="0" placeholder="∞" oninput="filtrar()">
    </div>
    <div class="filtro-field"><label>Banheiros mín.</label>
      <input id="f-banheiros" type="number" min="0" placeholder="0" oninput="filtrar()">
    </div>
  </div>
  <div class="filtro-grid2" style="margin-top:10px">
    <div class="filtro-field"><label>Vagas mín.</label>
      <input id="f-vagas" type="number" min="0" placeholder="0" oninput="filtrar()">
    </div>
    <div class="filtro-field"><label>Vagas máx.</label>
      <input id="f-vagas-max" type="number" min="0" placeholder="∞" oninput="filtrar()">
    </div>
    <div class="filtro-field"><label>Proprietário</label>
      <select id="f-proprietario" onchange="filtrar()">
        <option value="">Todos</option>
        <option value="sim">Com proprietário</option>
        <option value="nao">Sem proprietário</option>
      </select>
    </div>
    <div class="filtro-field"><label>Fotos</label>
      <select id="f-fotos" onchange="filtrar()">
        <option value="">Todos</option>
        <option value="sim">Com fotos</option>
        <option value="nao">Sem fotos</option>
      </select>
    </div>
    <div class="filtro-field"><label>🔍 Busca geral</label>
      <input id="busca" placeholder="ID interno ou externo..." oninput="filtrar()">
    </div>
  </div>
  <div class="filtro-rodape">
    <span id="nf-count" style="font-size:11px;color:var(--text-ter)"></span>
    <button onclick="limpar()" class="btn btn-outline btn-sm">↺ Limpar filtros</button>
    <a href="/app/imoveis?qa_incompleto=1" class="btn btn-sm" style="background:#fff7ed;border:1px solid #f97316;color:#c2410c;text-decoration:none;<%= (typeof qaIncompleto !== 'undefined' && qaIncompleto) ? 'display:none' : '' %>">⚠️ Ver imóveis incompletos</a>
    <% if (typeof qaIncompleto !== 'undefined' && qaIncompleto) { %>
    <a href="/app/imoveis" class="btn btn-sm" style="background:#f0fdf4;border:1px solid #86efac;color:#15803d;text-decoration:none;">✅ Ver todos os imóveis</a>
    <% } %>
  </div>
</div>


<script>
const _cidades = <%- JSON.stringify(typeof cidades !== 'undefined' ? cidades : {}) %>;
const _bairros = <%- JSON.stringify(typeof bairros !== 'undefined' ? bairros : {}) %>;
</script>
<!-- Grid -->
<div id="im-grid" class="im-grid">
<% (typeof imoveis !== 'undefined' ? imoveis : []).forEach((item, idx) => { %>
  <div class="im-card"
    data-id="<%= item.id || item.idExterno || idx %>"
    data-id_interno="<%= item.idInterno || item.id_interno || '' %>"
    data-id_externo="<%= item.idExterno || item.id_externo || '' %>"
    data-tipo="<%= (item.tipo||'').toLowerCase() %>"
    data-bairro="<%= (item.bairro||'').toLowerCase() %>"
    data-cidade="<%= (item.cidade||'').toLowerCase() %>"
    data-valor="<%= item.valor_imovel || 0 %>"
    data-area="<%= item.area_m2 || 0 %>"
    data-quartos="<%= item.quartos || 0 %>"
    data-vagas="<%= item.vagas || 0 %>"
    data-suites="<%= item.suites || 0 %>"
    data-banheiros="<%= item.banheiros || 0 %>"
    data-status="<%= (item.status||'ativo').toLowerCase() %>"
    data-condicao="<%= (item.condicao||'').toLowerCase() %>"
    data-fase="<%= (item.fase||item.dados&&item.dados.fase||'').toLowerCase() %>"
    data-estado="<%= (item.estado||'').toLowerCase() %>"
    data-operacao="<%= (item.transacao||item.operacao||'').toLowerCase() %>"
    data-proprietario="<%= (item.proprietario && item.proprietario.nome) ? item.proprietario.nome.toLowerCase() : '' %>"
    data-fotos="<%= (item.fotos && item.fotos.length>0) ? item.fotos.length : '0' %>"
    onclick="toggleCard(this)">

    <!-- Imagem -->
    <div class="im-img">
      <% if(item.fotos && item.fotos.length > 0) { %>
        <img src="<%= item.fotos[0] %>" alt="foto" loading="lazy">
      <% } else { %>
        <div class="im-img-ic">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
      <% } %>
      <div class="im-check" id="chk-<%= item.id || idx %>"></div>
      <% if((item.status||'ativo').toLowerCase() !== 'ativo') { %>
        <div class="im-badge-status"><%= (item.status||'inativo').toUpperCase() %></div>
        <% if(item.condicao && item.condicao !== 'usado') { %>
        <div style="position:absolute;top:8px;left:8px;font-size:9px;font-weight:700;padding:2px 7px;border-radius:20px;<%=item.condicao==='lancamento'?'background:#FF385C;color:#fff':item.condicao==='novo'?'background:#059669;color:#fff':''%>">
          <%=item.condicao==='lancamento'?'LANÇAMENTO':'NOVO'%>
        </div>
        <% } %>
      <% } %>
    </div>

    <!-- Body -->
    <div class="im-body" onclick="event.stopPropagation()">
      <span class="im-tipo"><%= item.tipo || 'Imóvel' %></span>
      <% const _trans = (item.transacao||item.operacao||'').toLowerCase(); if(_trans==='aluguel'||_trans==='venda'){ %><span style="display:inline-block;background:<%= _trans==='aluguel'?'#2563eb':'#FF385C' %>;color:#fff;font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;margin-left:4px"><%= _trans==='aluguel'?'ALUGUEL':'VENDA' %></span><% } %>
      <% const _faseMapI = {pronto:'✅ Pronto',lancamento:'🚀 Lançamento',na_planta:'📐 Na planta',em_construcao:'🏗 Em construção',planta:'📐 Na planta',construcao:'🏗 Em construção'}; const _faseLabelI = _faseMapI[(item.fase||'').toLowerCase().replace(/\s/g,'_')]; %>
      <% if(_faseLabelI){ %><span style="display:inline-block;background:#1D9E75;color:#fff;font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;margin-left:4px"><%=_faseLabelI%></span><% } %>
      <div class="im-valor">R$ <%= item.valor_imovel ? Number(item.valor_imovel).toLocaleString('pt-BR') : '—' %></div>
      <div class="im-end"><%= [item.bairro, item.cidade].filter(Boolean).join(', ') || '—' %></div>
      <div style="font-size:9px;color:var(--text-sec);margin-bottom:4px;display:flex;gap:6px;flex-wrap:wrap">
        <% if(item.idInterno||item.id_interno){ %>
        <span style="background:#e8e8e6;border:1px solid #ccc;border-radius:4px;padding:2px 7px;display:flex;align-items:center;gap:4px">
          INT: <%= item.idInterno||item.id_interno %>
          <button onclick="event.stopPropagation();navigator.clipboard.writeText('<%= item.idInterno||item.id_interno %>');this.textContent='✓';setTimeout(()=>this.textContent='⎘',1000)" style="background:none;border:none;cursor:pointer;font-size:10px;padding:0;color:#555">⎘</button>
        </span>
        <% } %>
        <% if(item.idExterno||item.id_externo){ %>
        <span style="background:#e8e8e6;border:1px solid #ccc;border-radius:4px;padding:2px 7px;display:flex;align-items:center;gap:4px">
          EXT: <%= item.idExterno||item.id_externo %>
          <button onclick="event.stopPropagation();navigator.clipboard.writeText('<%= item.idExterno||item.id_externo %>');this.textContent='✓';setTimeout(()=>this.textContent='⎘',1000)" style="background:none;border:none;cursor:pointer;font-size:10px;padding:0;color:#555">⎘</button>
        </span>
        <% } %>
      </div>

      <% if(item.proprietario && item.proprietario.nome) { %>
      <div class="im-prop">
        <strong><%= item.proprietario.nome %></strong><br>
        <%= item.proprietario.telefone || item.proprietario.celular || '' %>
      </div>
      <% } %>

      <div class="im-tags">
        <% if(item.area_m2) { %><span class="im-tag"><%= item.area_m2 %>m²</span><% } %>
        <% if(item.quartos) { %><span class="im-tag"><%= item.quartos %>q</span><% } %>
        <% if(item.suites) { %><span class="im-tag"><%= item.suites %>s</span><% } %>
        <% if(item.vagas) { %><span class="im-tag"><%= item.vagas %>vg</span><% } %>
        <% if(item.banheiros) { %><span class="im-tag"><%= item.banheiros %>bnh</span><% } %>
        <% if(item.andar) { %><span class="im-tag"><%= item.andar %>º andar</span><% } %>
      </div>

      <% const _portaisCard = Array.isArray(item.portais) ? item.portais : (item.portais && typeof item.portais==='object' ? Object.keys(item.portais).filter(k=>item.portais[k]) : []); %>
      <% if(_portaisCard.length > 0){ %>
      <div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:6px">
        <% const _labelPortal={vivareal:'VR',zap:'ZAP',olx:'OLX',chaves:'CHV',imovelweb:'IW','123i':'123',quintoandar:'QA'}; %>
        <% _portaisCard.forEach(p=>{ %>
        <span style="font-size:9px;font-weight:700;padding:2px 6px;border-radius:4px;background:#fff0f3;color:#FF385C"><%=_labelPortal[p]||p.toUpperCase()%></span>
        <% }) %>
      </div>
      <% } %>
      <div style="font-size:10px;color:var(--text-ter);margin-bottom:6px;display:flex;gap:8px;flex-wrap:wrap">
        <% if(item.dataCadastro||item.data_cadastro||item.criadoEm){ %><span>📅 <%= new Date(item.dataCadastro||item.data_cadastro||item.criadoEm).toLocaleDateString('pt-BR') %></span><% } %>
        <% if(item.dataAtualizacao||item.updatedAt){ %><span>🔄 <%= new Date(item.dataAtualizacao||item.updatedAt).toLocaleDateString('pt-BR') %></span><% } %>
      </div>
      <div class="im-actions">
        <a href="/app/imovel/<%= item.id || item.idExterno || item.idInterno || item.codigoImovel %>" class="im-btn ver" onclick="event.stopPropagation()">Ver</a>
        <button onclick="event.stopPropagation();(() => { const id='<%= item.idInterno||item.id_interno||item.id %>'; const titulo=encodeURIComponent('<%= (item.titulo||(item.tipo+' em '+(item.bairro||item.cidade||''))).replace(/'/g,'') %>'); const link='https://www.matchimoveis.ia.br/imovel/'+id; const msg='Olá! Segue o link de um imóvel que pode te interessar:%0A%0A*<%= (item.tipo||'Imóvel') %> em <%= (item.bairro||item.cidade||'') %>*%0AR$ <%= item.valor_imovel ? Number(item.valor_imovel).toLocaleString('pt-BR') : '—' %>%0A%0A'+encodeURIComponent(link); window.open('https://wa.me/?text='+msg,'_blank'); })()" style="background:#25D366;color:#fff;border:none;border-radius:8px;padding:6px 10px;font-size:12px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:4px" title="Compartilhar via WhatsApp">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.858L0 24l6.335-1.51A11.933 11.933 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.371l-.36-.214-3.724.888.936-3.617-.235-.372A9.818 9.818 0 1112 21.818z"/></svg>
          WA
        </button>
        <a href="/app/imovel/<%= item.id || item.idExterno || item.idInterno || item.codigoImovel %>/editar" class="im-btn edit" onclick="event.stopPropagation()">Editar</a>
        <form method="POST" action="/app/imovel/<%= (item.idExterno && item.idExterno.trim()) ? item.idExterno : (item.idInterno || item.id) %>/excluir" style="display:inline" onsubmit="return confirm('Excluir este imóvel? Esta ação não pode ser desfeita.')"><button type="submit" class="im-btn" style="background:#fef2f2;color:#b91c1c;border-color:#fca5a5" onclick="event.stopPropagation()">Excluir</button></form>
      </div>
    </div>
  </div>
<% }) %>
</div>

<div id="im-empty" style="display:none" class="im-empty">
  <div style="font-size:36px;margin-bottom:12px;opacity:.3">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
  </div>
  <div style="font-size:14px;font-weight:500;color:var(--text-sec);margin-bottom:4px">Nenhum imóvel encontrado</div>
  <div style="font-size:12px">Tente ajustar os filtros</div>
</div>

<!-- Modal XML -->
<div class="modal-xml" id="modal-xml">
  <div class="modal-xml-box">
    <div style="font-size:13px;font-weight:600;color:var(--dark);margin-bottom:8px" id="modal-titulo">Gerando XML...</div>
    <div style="font-size:12px;color:var(--text-sec);margin-bottom:20px" id="modal-desc"></div>
    <div id="modal-loading"><div class="spin"></div></div>
    <div id="modal-link" style="display:none">
      <input id="modal-url" readonly style="margin-bottom:10px;font-size:11px">
      <div style="display:flex;gap:8px;justify-content:center">
        <button onclick="copiarURL()" class="btn btn-dark btn-sm">Copiar URL</button>
        <button onclick="document.getElementById('modal-xml').style.display='none'" class="btn btn-outline btn-sm">Fechar</button>
      </div>
    </div>
  </div>
</div>

<script>
const selecionados = new Set();

function toggleCard(card) {
  const id = card.dataset.id;
  const chk = document.getElementById('chk-' + id) || card.querySelector('.im-check');
  if (selecionados.has(id)) {
    selecionados.delete(id);
    card.classList.remove('sel');
    if (chk) chk.classList.remove('on');
  } else {
    selecionados.add(id);
    card.classList.add('sel');
    if (chk) chk.classList.add('on');
  }
  atualizarBarra();
}

function toggleTodos(chk) {
  document.querySelectorAll('.im-card').forEach(card => {
    if (card.style.display === 'none') return;
    const tem = selecionados.has(card.dataset.id);
    if (chk.checked && !tem) toggleCard(card);
    else if (!chk.checked && tem) toggleCard(card);
  });
}

function deselectAll() {
  document.querySelectorAll('.im-card').forEach(card => {
    if (selecionados.has(card.dataset.id)) toggleCard(card);
  });
}

function atualizarBarra() {
  const barra = document.getElementById('barra-sel');
  document.getElementById('cnt-sel').textContent = selecionados.size + ' selecionado' + (selecionados.size !== 1 ? 's' : '');
  barra.style.display = selecionados.size > 0 ? 'flex' : 'none';
}

function copiarURL() {
  const u = document.getElementById('modal-url');
  u.select();
  document.execCommand('copy');
}

function fmtValor(input) {
  let v = input.value.replace(/\D/g,'');
  if (!v) { input.value = ''; return; }
  input.value = Number(v).toLocaleString('pt-BR');
}

function norm(v) {
  return (v||'').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
}

function atualizarCidades() {
  const estadoVal = document.getElementById('f-estado').value;
  const selCidade = document.getElementById('f-cidade');
  selCidade.innerHTML = '<option value="">Todas</option>';
  const cidKey2 = Object.keys(_cidades).find(k => k.toLowerCase() === estadoVal.toLowerCase()) || estadoVal;
  const cids = cidKey2 && _cidades[cidKey2] ? _cidades[cidKey2] : [];
  cids.forEach(cv => {
    const opt = document.createElement('option');
    opt.value = norm(cv);
    opt.textContent = cv;
    selCidade.appendChild(opt);
  });
  document.getElementById('f-bairro').innerHTML = '<option value="">Todos</option>';
  filtrar();
}

function atualizarBairros() {
  const cidade = document.getElementById('f-cidade').value;
  const selBairro = document.getElementById('f-bairro');
  selBairro.innerHTML = '<option value="">Todos</option>';
  const cidKey = Object.keys(_bairros).find(k => norm(k) === cidade);
  const bairs = cidKey ? _bairros[cidKey] : [];
  bairs.forEach(b => {
    const opt = document.createElement('option');
    opt.value = norm(b);
    opt.textContent = b;
    selBairro.appendChild(opt);
  });
  filtrar();
}

function abrirModalPortais() {
  if (!selecionados.size) return;
  document.getElementById('modal-portais-cnt').textContent = selecionados.size + ' imóvel(is) selecionado(s)';
  document.getElementById('modal-portais').style.display = 'flex';
}

function fecharModalPortais() {
  document.getElementById('modal-portais').style.display = 'none';
}

async function salvarPortaisLote() {
  const portais = [...document.querySelectorAll('.portal-lote-chk:checked')].map(c => c.value);
  const btn = document.getElementById('btn-salvar-portais');
  btn.textContent = 'Salvando...';
  btn.disabled = true;
  try {
    const body = new URLSearchParams();
    body.append('ids', JSON.stringify([...selecionados]));
    body.append('portais', JSON.stringify(portais));
    const r = await fetch('/app/imoveis/portais-lote', { method: 'POST', body });
    const data = await r.json();
    if (data.ok) {
      fecharModalPortais();
      deselectAll();
      location.reload();
    } else {
      alert('Erro: ' + (data.erro || 'tente novamente'));
    }
  } catch(e) {
    alert('Erro de conexão');
  } finally {
    btn.textContent = 'Salvar';
    btn.disabled = false;
  }
}

// estilo hover portal lote
document.querySelectorAll('.portal-lote-label').forEach(l => {
  l.querySelector('input').addEventListener('change', function() {
    l.style.borderColor = this.checked ? '#FF385C' : 'var(--border)';
    l.style.background = this.checked ? '#fff0f3' : 'var(--bg)';
  });
});

function filtrar() {
  const busca = norm(document.getElementById('busca')?.value||'');
  const tipo = norm(document.getElementById('f-tipo')?.value||'');
  const operacao = norm(document.getElementById('f-operacao')?.value||'');
  const status = norm(document.getElementById('f-status')?.value||'');
  const condicao = norm(document.getElementById('f-condicao')?.value||'');
  const fase = norm(document.getElementById('f-fase')?.value||'');
  const estado = norm(document.getElementById('f-estado')?.value||'');
  const cidade = norm(document.getElementById('f-cidade')?.value||'');
  const bairro = norm(document.getElementById('f-bairro')?.value||'');
  const fotos = document.getElementById('f-fotos')?.value||'';
  const proprietario = document.getElementById('f-proprietario')?.value||'';
  const valorMin = Number((document.getElementById('f-valor-min')?.value||'').replace(/\./g,'').replace(',','.'))||0;
  const valorMax = Number((document.getElementById('f-valor-max')?.value||'').replace(/\./g,'').replace(',','.'))||0;
  const areaMin = Number(document.getElementById('f-area-min')?.value)||0;
  const areaMax = Number(document.getElementById('f-area-max')?.value)||0;
  const quartosMin = Number(document.getElementById('f-quartos')?.value)||0;
  const quartosMax = Number(document.getElementById('f-quartos-max')?.value)||0;
  const suitesMin = Number(document.getElementById('f-suites')?.value)||0;
  const suitesMax = Number(document.getElementById('f-suites-max')?.value)||0;
  const banheiros = Number(document.getElementById('f-banheiros')?.value)||0;
  const vagasMin = Number(document.getElementById('f-vagas')?.value)||0;
  const vagasMax = Number(document.getElementById('f-vagas-max')?.value)||0;

  let vis = 0;
  document.querySelectorAll('.im-card').forEach(card => {
    let ok = true;
    const d = card.dataset;
    if (busca && !norm((d.tipo||'')+' '+(d.bairro||'')+' '+(d.cidade||'')+' '+(d.estado||'')+' '+(d.id||'')+' '+(d.id_externo||d.idExterno||'')+' '+(d.id_interno||d.idInterno||d.codigo_imovel||d.codigoImovel||'')).includes(busca)) ok = false;
    if (tipo && norm(d.tipo||'') !== tipo) ok = false;
    if (operacao && !norm(d.operacao||'').includes(operacao)) ok = false;
    if (status && norm(d.status||'') !== status) ok = false;
    if (condicao && !norm(d.condicao||'').includes(condicao)) ok = false;
    if (fase && !norm(d.fase||'').includes(fase)) ok = false;
    if (estado && !norm(d.estado||'').includes(estado)) ok = false;
    if (cidade && norm(d.cidade||'') !== cidade) ok = false;
    if (bairro && norm(d.bairro||'') !== bairro) ok = false;
    const _vIm = Number((d.valor||'0').toString().replace(/\./g,'').replace(',','.'))||0;
    if (valorMin && _vIm < valorMin) ok = false;
    if (valorMax && _vIm > valorMax) ok = false;
    if (areaMin && Number(d.area||0) < areaMin) ok = false;
    if (areaMax && Number(d.area||0) > areaMax) ok = false;
    if (quartosMin && Number(d.quartos||0) < quartosMin) ok = false;
    if (quartosMax && Number(d.quartos||0) > quartosMax) ok = false;
    if (suitesMin && Number(d.suites||0) < suitesMin) ok = false;
    if (suitesMax && Number(d.suites||0) > suitesMax) ok = false;
    if (banheiros && Number(d.banheiros||0) < banheiros) ok = false;
    if (vagasMin && Number(d.vagas||0) < vagasMin) ok = false;
    if (vagasMax && Number(d.vagas||0) > vagasMax) ok = false;
    if (proprietario === 'sim' && !d.proprietario) ok = false;
    if (proprietario === 'nao' && d.proprietario) ok = false;
    if (fotos === 'sim' && d.fotos === '0') ok = false;
    if (fotos === 'nao' && d.fotos !== '0') ok = false;
    card.style.display = ok ? '' : 'none';
    if (ok) vis++;
  });

  const el = document.getElementById('nf-count');
  const total = document.querySelectorAll('.im-card').length;
  if (el) el.textContent = vis < total ? vis + ' de ' + total + ' imoveis' : total + ' imoveis';
  const empty = document.getElementById('im-empty');
  if (empty) empty.style.display = vis === 0 ? 'block' : 'none';
}

function limpar() {
  ['f-tipo','f-bairro','f-cidade','f-estado','f-valor-min','f-valor-max',
   'f-area-min','f-area-max','f-quartos','f-quartos-max','f-suites','f-suites-max',
   'f-banheiros','f-vagas','f-vagas-max','f-operacao','f-status','f-condicao',
   'f-fase','f-proprietario','f-fotos','busca'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = '';
  });
  document.getElementById('f-cidade').innerHTML = '<option value="">Todas</option>';
  document.getElementById('f-bairro').innerHTML = '<option value="">Todos</option>';
  filtrar();
}

function atualizarStats() {
  const cards = document.querySelectorAll('.im-card');
  let ativos=0, inativos=0, semFoto=0, semProp=0;
  cards.forEach(c => {
    if (c.dataset.status === 'ativo') ativos++; else inativos++;
    if (!c.dataset.fotos || c.dataset.fotos === '0') semFoto++;
    if (!c.dataset.proprietario) semProp++;
  });
  document.getElementById('count-ativos').textContent = ativos + ' ativos';
  document.getElementById('count-inativos').textContent = inativos + ' inativos';
  document.getElementById('count-sem-foto').textContent = semFoto + ' sem foto';
  document.getElementById('count-sem-prop').textContent = semProp + ' sem prop.';
}

window.addEventListener('DOMContentLoaded', atualizarStats);
</script>

<%- include('partials/app-end') %>
