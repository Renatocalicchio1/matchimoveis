<div class="modal-overlay" id="modal-login">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal()">×</button>
    <div class="modal-title">MatchImóveis</div>
    <div class="modal-sub">Entre ou crie sua conta</div>
    <% const _erroMap = {telefone_nao_encontrado:'Telefone não encontrado.',erro_interno:'Erro ao processar. Tente novamente.',nome_invalido:'Nome inválido.',telefone_invalido:'Telefone inválido.',celular_existente:'Este celular já está cadastrado.',email_existente:'Este e-mail já está cadastrado.',senha_incorreta:'Senha incorreta.',nao_cadastrado:'Celular não cadastrado.'}; %>
    <% if(typeof error !== 'undefined' && error && _erroMap[error]){ %>
    <div style="background:#fef2f2;border:1px solid #fca5a5;color:#b91c1c;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:12px"><%= _erroMap[error] %></div>
    <% } %>
    <% if(typeof msg !== 'undefined' && msg === 'senha_email_enviado'){ %>
    <div style="background:#f0fdf4;border:1px solid #86efac;color:#15803d;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:12px">Se esse celular tiver conta com e-mail cadastrado, uma nova senha foi enviada. Verifique também a pasta de spam.</div>
    <% } %>
    <div class="modal-tabs">
      <button class="modal-tab on" id="tab-e" onclick="setTab('entrar')">Entrar</button>
      <button class="modal-tab" id="tab-c" onclick="setTab('cadastro')">Criar conta</button>
    </div>
    <div id="form-entrar">
      <form method="POST" action="/login">
        <div class="m-field"><label>Celular</label><input name="telefone" placeholder="47999999999" required autocomplete="username"></div>
        <div class="m-field"><label>Senha</label><input name="senha" type="password" placeholder="••••••" autocomplete="current-password"></div>
        <button type="submit" class="m-btn">Entrar →</button>
      </form>
      <p class="m-note"><a href="#" onclick="setTab('esqueci');return false" style="color:#FF385C;text-decoration:none">Esqueci minha senha</a></p>
    </div>
    <div id="form-esqueci" style="display:none">
      <p style="font-size:13px;color:#6b7280;margin-bottom:12px">Informe o celular da sua conta — enviamos uma nova senha pro e-mail cadastrado.</p>
      <form method="POST" action="/esqueci-senha">
        <div class="m-field"><label>Celular</label><input name="telefone" placeholder="47999999999" required></div>
        <button type="submit" class="m-btn">Enviar nova senha por e-mail</button>
      </form>
      <p class="m-note"><a href="#" onclick="setTab('entrar');return false" style="color:#FF385C;text-decoration:none">← Voltar pro login</a></p>
    </div>
    <div id="form-cadastro" style="display:none">
      <form method="POST" action="/login">
        <input type="hidden" name="indicadoPor" value="<%= typeof ref !== 'undefined' ? ref : '' %>">
        <% if(typeof ref !== 'undefined' && ref){ %>
        <div style="background:#f0fdf4;border:1px solid #86efac;color:#15803d;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:12px">🎉 Você foi indicado por um parceiro MatchImóveis! Cadastre-se e ganhe <strong>500 créditos de bônus</strong>, além dos 1.000 iniciais.</div>
        <% } %>
        <div class="m-field"><label>Nome completo</label><input name="nome" placeholder="Seu nome" required></div>
        <div class="m-field"><label>E-mail</label><input name="email" type="email" placeholder="seu@email.com" required></div>
        <div class="m-field"><label>Celular</label><input name="telefone" placeholder="47999999999" required></div>
        <div class="m-field"><label>Tipo de conta</label>
          <select name="tipoConta">
            <option value="corretor">Corretor</option>
            <option value="imobiliaria">Imobiliária</option>
