<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Site Global · Admin</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;background:#f8f8f7;color:#111;font-size:13px;}
<%- adminShellCss %>
.admin-content{max-width:760px}
.card{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:20px;margin-bottom:16px}
.card-title{font-size:15px;font-weight:700;margin-bottom:4px}
.card-sub{font-size:12.5px;color:#888;margin-bottom:16px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:480px){.grid2{grid-template-columns:1fr}}
.field label{display:block;font-size:11px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:.03em;margin-bottom:4px}
.field input,.field textarea,.field select{width:100%;padding:9px 12px;border:1px solid #e5e5e3;border-radius:8px;font-size:13.5px;color:#111;background:#fff;box-sizing:border-box;outline:none;font-family:inherit}
.field input:focus,.field textarea:focus{border-color:#111}
.btn{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:1px solid #111;background:#111;color:#fff;margin-top:14px}
.btn:hover{background:#1f2937}
.btn-outline{background:#fff;color:#374151;border-color:#e5e5e3}
.btn-outline:hover{background:#f9fafb}
.cor-row{display:flex;align-items:center;gap:12px}
.cor-row input[type=color]{width:52px;height:40px;border:1px solid #e5e5e3;border-radius:8px;padding:2px;cursor:pointer;background:#fff}
.cor-row input[type=text]{max-width:140px}
.logo-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.logo-preview{width:72px;height:72px;border-radius:12px;border:1px solid #e5e5e3;background:#f9fafb;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0}
.logo-preview img{width:100%;height:100%;object-fit:contain}
.banners-grid{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.banner-item{position:relative;width:140px;height:52px;border-radius:8px;border:1px solid #e5e5e3;overflow:hidden;flex-shrink:0}
.banner-item img{width:100%;height:100%;object-fit:cover;display:block}
.banner-item form{position:absolute;top:3px;right:3px}
.banner-item button{width:20px;height:20px;border-radius:50%;border:none;background:rgba(0,0,0,.55);color:#fff;font-size:12px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0}
.toggle-row{display:flex;gap:10px}
.toggle-opt{flex:1;display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:10px;border:1px solid #e5e5e3;cursor:pointer}
.toggle-opt.on{border-color:#16a34a;background:#f0fdf4}
.toggle-opt input{width:16px;height:16px;flex-shrink:0}
.msg{font-size:12px;margin-bottom:12px;padding:8px 12px;border-radius:8px}
.msg.ok{color:#16a34a;background:#f0fdf4}
.msg.err{color:#dc2626;background:#fef2f2}
.link-box{display:flex;align-items:center;gap:8px;background:#f9fafb;border:1px solid #e5e5e3;border-radius:10px;padding:10px 14px;font-size:12.5px;color:#374151;font-family:monospace}
</style>
</head>
<body>
<div class="admin-app">
<%- adminSidebar %>
<main class="admin-content">
  <h1 style="font-size:18px;font-weight:700;margin-bottom:4px">🌍 Site Global</h1>
  <p style="color:#888;font-size:12.5px;margin-bottom:16px">Personalização visual do <a href="/portal" target="_blank" style="color:#2563eb">Site Global (/portal)</a> — o portal que agrega os imóveis de toda a rede.</p>

  <% if(msg==='salvo') { %><div class="msg ok">✅ Configurações salvas!</div><% } %>
  <% if(msg==='erro') { %><div class="msg err">❌ Erro ao salvar<% if(erro){ %>: <%= erro %><% } %>. Tente novamente.</div><% } %>
  <% if(msg==='banner_limite') { %><div class="msg err">❌ Máximo de 8 banners. Exclua algum antes de adicionar outro.</div><% } %>

  <div class="card">
    <div class="card-title">🔗 Link do portal</div>
    <div class="link-box"><span>matchimoveis.ia.br/portal</span></div>
    <a href="/portal" target="_blank" class="btn btn-outline">↗ Ver portal</a>
  </div>

  <div class="card">
    <div class="card-title">Status</div>
    <div class="card-sub">Desativado, o portal mostra uma página de manutenção — os imóveis continuam normais no resto da plataforma.</div>
    <form method="POST" action="/admin/site-global" id="form-toggle">
      <input type="hidden" name="cor_primaria" value="<%= siteConfig.cor_primaria||'' %>">
      <input type="hidden" name="cor_cabecalho" value="<%= siteConfig.cor_cabecalho||'' %>">
      <input type="hidden" name="cor_rodape" value="<%= siteConfig.cor_rodape||'' %>">
      <input type="hidden" name="cor_texto_rodape" value="<%= siteConfig.cor_texto_rodape||'' %>">
      <input type="hidden" name="rodape_nome" value="<%= siteConfig.rodape_nome||'' %>">
      <input type="hidden" name="rodape_telefone" value="<%= siteConfig.rodape_telefone||'' %>">
      <input type="hidden" name="rodape_cep" value="<%= siteConfig.rodape_cep||'' %>">
      <input type="hidden" name="rodape_rua" value="<%= siteConfig.rodape_rua||'' %>">
      <input type="hidden" name="rodape_numero" value="<%= siteConfig.rodape_numero||'' %>">
      <input type="hidden" name="rodape_complemento" value="<%= siteConfig.rodape_complemento||'' %>">
      <input type="hidden" name="rodape_cidade" value="<%= siteConfig.rodape_cidade||'' %>">
      <input type="hidden" name="rodape_estado" value="<%= siteConfig.rodape_estado||'' %>">
      <input type="hidden" name="rodape_texto" value="<%= siteConfig.rodape_texto||'' %>">
      <input type="hidden" name="rodape_instagram" value="<%= siteConfig.rodape_instagram||'' %>">
      <input type="hidden" name="rodape_facebook" value="<%= siteConfig.rodape_facebook||'' %>">
      <input type="hidden" name="meta_pixel_id" value="<%= siteConfig.meta_pixel_id||'' %>">
      <input type="hidden" name="google_analytics_id" value="<%= siteConfig.google_analytics_id||'' %>">
      <div class="toggle-row">
        <label class="toggle-opt <%= siteConfig.site_ativo!==false?'on':'' %>">
          <input type="radio" name="site_ativo" value="1" <%= siteConfig.site_ativo!==false?'checked':'' %> onchange="this.form.submit()">
          <span>✅ Ativo</span>
        </label>
        <label class="toggle-opt">
          <input type="radio" name="site_ativo" value="0" <%= siteConfig.site_ativo===false?'checked':'' %> onchange="this.form.submit()">
          <span>⏸ Desativado</span>
        </label>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="card-title">Identidade visual</div>
    <div class="card-sub">Cor de destaque e logo aplicados em todo o portal.</div>

    <div class="field" style="margin-bottom:16px">
      <label>Cores</label>
      <form method="POST" action="/admin/site-global" id="form-cor">
        <input type="hidden" name="rodape_nome" value="<%= siteConfig.rodape_nome||'' %>">
        <input type="hidden" name="rodape_telefone" value="<%= siteConfig.rodape_telefone||'' %>">
        <input type="hidden" name="rodape_cep" value="<%= siteConfig.rodape_cep||'' %>">
        <input type="hidden" name="rodape_rua" value="<%= siteConfig.rodape_rua||'' %>">
        <input type="hidden" name="rodape_numero" value="<%= siteConfig.rodape_numero||'' %>">
        <input type="hidden" name="rodape_complemento" value="<%= siteConfig.rodape_complemento||'' %>">
        <input type="hidden" name="rodape_cidade" value="<%= siteConfig.rodape_cidade||'' %>">
        <input type="hidden" name="rodape_estado" value="<%= siteConfig.rodape_estado||'' %>">
        <input type="hidden" name="rodape_texto" value="<%= siteConfig.rodape_texto||'' %>">
        <input type="hidden" name="rodape_instagram" value="<%= siteConfig.rodape_instagram||'' %>">
        <input type="hidden" name="rodape_facebook" value="<%= siteConfig.rodape_facebook||'' %>">
        <input type="hidden" name="meta_pixel_id" value="<%= siteConfig.meta_pixel_id||'' %>">
        <input type="hidden" name="google_analytics_id" value="<%= siteConfig.google_analytics_id||'' %>">
        <input type="hidden" name="site_ativo" value="<%= siteConfig.site_ativo!==false?'1':'0' %>">
        <div class="cor-row" style="margin-bottom:10px">
          <input type="color" name="cor_primaria" id="cor-picker" value="<%= siteConfig.cor_primaria || '#FF385C' %>" onchange="document.getElementById('cor-texto').value=this.value">
          <input type="text" id="cor-texto" value="<%= siteConfig.cor_primaria || '#FF385C' %>" oninput="document.getElementById('cor-picker').value=this.value" readonly>
          <span style="font-size:12px;color:#6b7280">Cor principal (botões, preços, links)</span>
        </div>
        <div class="cor-row" style="margin-bottom:10px">
          <input type="color" name="cor_cabecalho" id="cor-cab-picker" value="<%= siteConfig.cor_cabecalho || '#FBF9F6' %>" onchange="document.getElementById('cor-cab-texto').value=this.value">
          <input type="text" id="cor-cab-texto" value="<%= siteConfig.cor_cabecalho || '#FBF9F6' %>" oninput="document.getElementById('cor-cab-picker').value=this.value" readonly>
          <span style="font-size:12px;color:#6b7280">Fundo do cabeçalho</span>
        </div>
        <div class="cor-row" style="margin-bottom:10px">
          <input type="color" name="cor_rodape" id="cor-rod-picker" value="<%= siteConfig.cor_rodape || '#FBF9F6' %>" onchange="document.getElementById('cor-rod-texto').value=this.value">
          <input type="text" id="cor-rod-texto" value="<%= siteConfig.cor_rodape || '#FBF9F6' %>" oninput="document.getElementById('cor-rod-picker').value=this.value" readonly>
          <span style="font-size:12px;color:#6b7280">Fundo do rodapé</span>
        </div>
        <div class="cor-row" style="margin-bottom:10px">
          <input type="color" name="cor_texto_rodape" id="cor-txt-picker" value="<%= siteConfig.cor_texto_rodape || '#716C61' %>" onchange="document.getElementById('cor-txt-texto').value=this.value">
          <input type="text" id="cor-txt-texto" value="<%= siteConfig.cor_texto_rodape || '#716C61' %>" oninput="document.getElementById('cor-txt-picker').value=this.value" readonly>
          <span style="font-size:12px;color:#6b7280">Cor do texto do rodapé</span>
        </div>
        <button type="submit" class="btn">Salvar cores</button>
      </form>
    </div>

    <div class="field">
      <label>Logo</label>
      <div class="logo-row">
        <div class="logo-preview">
          <% if(siteConfig.logo_url){ %><img src="<%= siteConfig.logo_url %>" alt="Logo"><% } else { %><span style="font-size:10px;color:#9ca3af">sem logo</span><% } %>
        </div>
        <form method="POST" action="/admin/site-global/logo" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <input type="file" name="logo" accept="image/*" required style="max-width:220px;width:auto">
          <button type="submit" class="btn"><%= siteConfig.logo_url ? 'Trocar logo' : 'Enviar logo' %></button>
        </form>
        <% if(siteConfig.logo_url){ %>
        <form method="POST" action="/admin/site-global/logo/excluir" onsubmit="return confirm('Excluir a logo atual?')">
          <button type="submit" class="btn btn-outline">Excluir logo</button>
        </form>
        <% } %>
      </div>
      <div style="font-size:11px;color:#9ca3af;margin-top:6px">Sem logo, aparece "MatchImóveis" com o ponto de marca no lugar.</div>
    </div>

    <div class="field" style="margin-top:16px">
      <label>Banners do topo (carrossel)</label>
      <% const _banners = (function(){ try { return JSON.parse(siteConfig.banners||'[]'); } catch(e){ return []; } })(); %>
      <% if(_banners.length){ %>
      <div class="banners-grid">
        <% _banners.forEach(function(b, i){ %>
        <div class="banner-item">
          <img src="<%= b %>" alt="Banner <%= i+1 %>">
          <form method="POST" action="/admin/site-global/banner/excluir" onsubmit="return confirm('Excluir este banner?')">
            <input type="hidden" name="idx" value="<%= i %>">
            <button type="submit" title="Excluir" aria-label="Excluir">✕</button>
          </form>
        </div>
        <% }); %>
      </div>
      <% } %>
      <% if(_banners.length < 8){ %>
      <form method="POST" action="/admin/site-global/banner" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <input type="file" name="banner" accept="image/*" required style="max-width:220px;width:auto">
        <button type="submit" class="btn">Adicionar banner</button>
      </form>
      <% } %>
      <div style="font-size:11px;color:#9ca3af;margin-top:6px">Até 8 banners — com mais de 1, alternam a cada 5 segundos. Recomendado formato bem largo (ex: 1600×500px).</div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Rodapé e identificação</div>
    <div class="card-sub">Aparece no fim do portal.</div>
    <form method="POST" action="/admin/site-global">
      <input type="hidden" name="cor_primaria" value="<%= siteConfig.cor_primaria||'' %>">
      <input type="hidden" name="cor_cabecalho" value="<%= siteConfig.cor_cabecalho||'' %>">
      <input type="hidden" name="cor_rodape" value="<%= siteConfig.cor_rodape||'' %>">
      <input type="hidden" name="cor_texto_rodape" value="<%= siteConfig.cor_texto_rodape||'' %>">
      <input type="hidden" name="site_ativo" value="<%= siteConfig.site_ativo!==false?'1':'0' %>">
      <div class="grid2">
        <div class="field">
          <label>Nome exibido</label>
          <input type="text" name="rodape_nome" value="<%= siteConfig.rodape_nome||'' %>" placeholder="MatchImóveis">
        </div>
        <div class="field">
          <label>Telefone de contato</label>
          <input type="text" name="rodape_telefone" value="<%= siteConfig.rodape_telefone||'' %>" placeholder="(11) 99999-9999">
        </div>
      </div>
      <div class="grid2" style="margin-top:12px">
        <div class="field">
          <label>Instagram (link)</label>
          <input type="text" name="rodape_instagram" value="<%= siteConfig.rodape_instagram||'' %>" placeholder="https://instagram.com/...">
        </div>
        <div class="field">
          <label>Facebook (link)</label>
          <input type="text" name="rodape_facebook" value="<%= siteConfig.rodape_facebook||'' %>" placeholder="https://facebook.com/...">
        </div>
      </div>
      <div class="field" style="margin-top:12px">
        <label>Texto livre do rodapé</label>
        <textarea name="rodape_texto" rows="3" placeholder="Ex: A maior rede de corretores e imobiliárias parceiras do Brasil."><%= siteConfig.rodape_texto||'' %></textarea>
      </div>

      <div class="card-title" style="margin-top:24px;font-size:13px">Métricas e Anúncios</div>
      <div class="card-sub">IDs pra rastrear conversão de anúncios apontando pro portal.</div>
      <div class="grid2">
        <div class="field">
          <label>Meta Pixel ID</label>
          <input type="text" name="meta_pixel_id" value="<%= siteConfig.meta_pixel_id||'' %>" placeholder="Ex: 1234567890123">
        </div>
        <div class="field">
          <label>Google Analytics (GA4)</label>
          <input type="text" name="google_analytics_id" value="<%= siteConfig.google_analytics_id||'' %>" placeholder="Ex: G-ABC1234XYZ">
        </div>
      </div>

      <button type="submit" class="btn" style="margin-top:16px">Salvar configurações</button>
    </form>
  </div>
</main>
</div>
</body>
</html>
