        </div>
        <div class="m-field">
          <label>Cidade de atuação</label>
          <input type="text" id="areaCidadeInput" list="areaCidadeLista" placeholder="Digite pra buscar a cidade" autocomplete="off" disabled>
          <datalist id="areaCidadeLista"></datalist>
        </div>
        <div class="m-field" id="areaBairrosWrap" style="display:none">
          <label>Bairros onde atua</label>
          <div id="areaBairrosLista" style="max-height:160px;overflow-y:auto;border:1px solid #e5e7eb;border-radius:8px;padding:8px;font-size:13px"></div>
          <input type="hidden" name="areaAtuacaoEstado" id="areaAtuacaoEstadoHidden" value="">
          <input type="hidden" name="areaAtuacaoCidade" id="areaAtuacaoCidadeHidden" value="">
          <input type="hidden" name="areaAtuacaoBairros" id="areaAtuacaoBairrosHidden" value="[]">
        </div>
        <div class="m-field"><label>Senha</label><input name="senha" type="password" placeholder="Mínimo 4 caracteres" required minlength="4"></div>
        <button type="submit" class="m-btn">Criar conta grátis →</button>
        <p class="m-note">1.000 créditos grátis para começar</p>
      </form>
