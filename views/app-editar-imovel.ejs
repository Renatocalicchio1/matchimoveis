      <button type="submit" class="btn btn-primary">Salvar alterações</button>
    </div>

  </form>

  <!-- EXCLUIR fora do form principal -->
  <form method="POST" action="/app/imovel/<%= _pid %>/excluir" style="margin-bottom:24px" onsubmit="return confirm('Excluir este imóvel? Esta ação não pode ser desfeita.')">
    <button type="submit" style="background:#fef2f2;color:#b91c1c;border:1px solid #fca5a5;padding:10px 20px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer">Excluir imóvel</button>
  </form>

  <!-- FOTOS -->
  <div class="fm-card">
    <div class="fm-title">Fotos do imóvel</div>
    <% const _fotos = Array.isArray(imovel.fotos) ? imovel.fotos : []; %>
    <% if(_fotos.length === 0){ %>
      <div style="font-size:13px;color:var(--text-ter);margin-bottom:12px">Nenhuma foto cadastrada ainda.</div>
    <% } else { %>
    <div class="foto-grid">
      <% _fotos.forEach(function(foto){ %>
      <div class="foto-thumb">
        <img src="<%= foto %>" alt="foto">
        <div style="position:absolute;bottom:0;left:0;right:0;display:flex;gap:2px;padding:4px;background:rgba(0,0,0,.4)">
          <form method="POST" action="/app/imovel/<%= _pid %>/capa-foto" style="flex:1">
            <input type="hidden" name="foto" value="<%= foto %>">
            <button type="submit" style="width:100%;font-size:10px;padding:3px;border-radius:4px;border:none;background:#fff;cursor:pointer;font-weight:500;color:#374151">Capa</button>
          </form>
          <form method="POST" action="/app/imovel/<%= _pid %>/excluir-foto" style="flex:1">
            <input type="hidden" name="foto" value="<%= foto %>">
            <button type="submit" style="width:100%;font-size:10px;padding:3px;border-radius:4px;border:none;background:#fef2f2;cursor:pointer;font-weight:500;color:#b91c1c">Excluir</button>
          </form>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
    <form method="POST" action="/app/imovel/<%= _pid %>/upload-foto" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center;margin-top:8px">
      <input type="file" name="foto" accept="image/*" required style="flex:1;min-width:180px;padding:8px;border:1px solid var(--border);border-radius:8px;font-size:13px">
      <button type="submit" class="btn btn-primary">Subir foto</button>
    </form>
  </div>

  <div style="font-size:12px;color:var(--text-ter);margin-top:8px">
    📅 Cadastrado: <%= imovel.criadoEm ? new Date(imovel.criadoEm).toLocaleDateString('pt-BR') : '-' %>
    &nbsp;&nbsp;🔄 Atualizado: <%= imovel.atualizadoEm ? new Date(imovel.atualizadoEm).toLocaleDateString('pt-BR') : '-' %>
  </div>
</div>

<script>
async function gerarDescricaoIA(){
  const tipo = document.querySelector('[name="tipo"]')?.value||'imóvel';
  const bairro = document.querySelector('[name="bairro"]')?.value||'';
  const cidade = document.querySelector('[name="cidade"]')?.value||'';
  const quartos = document.querySelector('[name="quartos"]')?.value||'';
  const area = document.querySelector('[name="area_m2"]')?.value||'';
  const valor = document.querySelector('[name="valor_imovel"]')?.value||'';
  const res = await fetch('/api/gerar-descricao-imovel',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({tipo,bairro,cidade,quartos,area,valor})});
  const data = await res.json();
  const campo = document.querySelector('[name="descricao"]');
  if(campo && data.descricao) campo.value = data.descricao;
}
</script>

<%- include('partials/app-end') %>
