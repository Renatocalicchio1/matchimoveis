        <div class="campo"><label>Email</label><input name="proprietario_email" type="email" value="<%= (imovel.proprietario&&typeof imovel.proprietario==='object') ? (imovel.proprietario.email||'') : '' %>" placeholder="joao@email.com"></div>
        <div class="campo"><label>CPF</label><input name="proprietario_cpf" value="<%= (imovel.proprietario&&typeof imovel.proprietario==='object') ? (imovel.proprietario.cpf||'') : '' %>" placeholder="000.000.000-00"></div>
