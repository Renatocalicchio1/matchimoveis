<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Modelos de Email · Admin</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;background:#f8f8f7;color:#111;font-size:13px;}
<%- adminShellCss %>
.admin-content{max-width:1500px}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px}
@media(max-width:720px){.kpis{grid-template-columns:1fr}}
.kpi{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:16px 18px}
.kpi .n{font-size:24px;font-weight:800;letter-spacing:-.5px}
.kpi .l{font-size:11.5px;color:#888;text-transform:uppercase;letter-spacing:.03em;margin-top:2px}
.grupo{background:#fff;border:1px solid #e5e5e3;border-radius:12px;margin-bottom:14px;overflow:hidden}
.grupo-head{padding:12px 16px;background:#fafaf9;border-bottom:1px solid #e5e5e3;font-weight:700;font-size:13.5px;display:flex;align-items:center;justify-content:space-between}
.grupo-head .tot{font-weight:600;color:#888;font-size:12px}
table{width:100%;border-collapse:collapse}
th{text-align:left;font-size:10.5px;text-transform:uppercase;letter-spacing:.03em;color:#9ca3af;padding:8px 16px;border-bottom:1px solid #f0f0ee;white-space:nowrap}
td{padding:10px 16px;border-bottom:1px solid #f5f5f4;font-size:12.5px;vertical-align:middle}
tr:last-child td{border-bottom:none}
.assunto{max-width:320px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.num{font-variant-numeric:tabular-nums;font-weight:700}
.pct{font-size:11px;color:#888;margin-left:4px}
.pct.bom{color:#16a34a;font-weight:700}
.pct.medio{color:#d97706;font-weight:700}
.pct.baixo{color:#dc2626;font-weight:700}
.bar{width:70px;height:5px;border-radius:3px;background:#f0f0ee;overflow:hidden;display:inline-block;vertical-align:middle;margin-left:6px}
.bar i{display:block;height:100%;background:#00A699}
.vazio{text-align:center;padding:48px 20px;color:#aaa}
</style>
</head>
<body>
<div class="admin-app">
<%- adminSidebar %>
<main class="admin-content">
  <h1 style="font-size:18px;font-weight:700;margin-bottom:4px">📬 Modelos de Email</h1>
  <p style="color:#888;font-size:12.5px;margin-bottom:16px">Todo email disparado pela plataforma (notificações, convites, campanhas) com abertura e clique rastreados — agrupado por tipo, com cada variação de assunto/botão separada pra comparar performance.</p>

  <div class="kpis">
    <div class="kpi"><div class="n"><%= totalEnviados.toLocaleString('pt-BR') %></div><div class="l">Enviados</div></div>
    <div class="kpi"><div class="n"><%= totalAbertos.toLocaleString('pt-BR') %> <span class="pct"><%= totalEnviados ? Math.round(totalAbertos/totalEnviados*100) : 0 %>%</span></div><div class="l">Abertos</div></div>
    <div class="kpi"><div class="n"><%= totalClicados.toLocaleString('pt-BR') %> <span class="pct"><%= totalEnviados ? Math.round(totalClicados/totalEnviados*100) : 0 %>%</span></div><div class="l">Clicados</div></div>
  </div>

  <% if (!linhas.length) { %>
    <div class="vazio">Nenhum email rastreado ainda.</div>
  <% } else { %>
    <%
      // Agrupa por tipo (linhas já vêm ordenadas por tipo, enviados desc)
      const grupos = {};
      linhas.forEach(l => { (grupos[l.tipo] = grupos[l.tipo] || []).push(l); });
      function _pctClass(p) { return p >= 15 ? 'bom' : (p >= 5 ? 'medio' : 'baixo'); }
    %>
    <% Object.keys(grupos).forEach(function(tipo){ %>
      <% const linhasGrupo = grupos[tipo]; const totTipo = linhasGrupo.reduce((s,l)=>s+l.enviados,0); %>
      <div class="grupo">
        <div class="grupo-head">
          <span><%= tipo %></span>
          <span class="tot"><%= totTipo.toLocaleString('pt-BR') %> enviados</span>
        </div>
        <div style="overflow-x:auto">
        <table>
          <thead>
            <tr>
              <th>Variante</th>
              <th>Assunto</th>
              <th>Botão</th>
              <th>Enviados</th>
              <th>Abertos</th>
              <th>Clicados</th>
              <th>Último envio</th>
            </tr>
          </thead>
          <tbody>
            <% linhasGrupo.forEach(function(l){ %>
              <% const pctAb = l.enviados ? Math.round(l.abertos/l.enviados*100) : 0; %>
              <% const pctCl = l.enviados ? Math.round(l.clicados/l.enviados*100) : 0; %>
              <tr>
                <td><%= l.variante || '—' %></td>
                <td class="assunto" title="<%= l.assunto||'' %>"><%= l.assunto || '—' %></td>
                <td><%= l.botao_texto || '—' %></td>
                <td class="num"><%= l.enviados.toLocaleString('pt-BR') %></td>
                <td><span class="num"><%= l.abertos %></span><span class="pct <%= _pctClass(pctAb) %>"><%= pctAb %>%</span><span class="bar"><i style="width:<%= Math.min(100,pctAb) %>%"></i></span></td>
                <td><span class="num"><%= l.clicados %></span><span class="pct <%= _pctClass(pctCl) %>"><%= pctCl %>%</span><span class="bar"><i style="width:<%= Math.min(100,pctCl) %>%"></i></span></td>
                <td><%= new Date(l.ultimo_envio).toLocaleString('pt-BR', {timeZone:'America/Sao_Paulo', day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit'}) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      </div>
    <% }) %>
  <% } %>
</main>
</div>
</body>
</html>
