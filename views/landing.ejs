<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <title>MatchImóveis — Inteligência imobiliária com memória</title>
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
  <meta name="description" content="A IA que lembra de cada lead, faz o match certo e agenda visitas sozinha. Você só aparece para fechar.">
  <!-- Open Graph para preview no WhatsApp -->
  <meta property="og:title" content="MatchImóveis — IA que faz o match e agenda visitas sozinha">
  <meta property="og:description" content="Cadastre seus imóveis, importe seus leads e a IA envia vitrines personalizadas pelo WhatsApp automaticamente. Teste grátis com 1.000 créditos.">
  <meta property="og:image" content="https://www.matchimoveis.ia.br/og-image.png">
  <meta property="og:url" content="https://www.matchimoveis.ia.br">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="MatchImóveis">
  <link rel="canonical" href="https://www.matchimoveis.ia.br/">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="MatchImóveis — IA que faz o match e agenda visitas sozinha">
  <meta name="twitter:description" content="Cadastre seus imóveis, importe seus leads e a IA envia vitrines personalizadas pelo WhatsApp automaticamente. Teste grátis com 1.000 créditos.">
  <meta name="twitter:image" content="https://www.matchimoveis.ia.br/og-image.png">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"MatchImóveis","url":"https://www.matchimoveis.ia.br","logo":"https://www.matchimoveis.ia.br/og-image.png","description":"Plataforma de match imobiliário com IA — une leads e imóveis automaticamente para corretores e imobiliárias."}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@500;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{
      --rosa:#FF385C; --rosa-dark:#E22F51;
      --teal:#00A699; --teal-dark:#00847A;
      --laranja:#FC642D;
      --dark:#0F0F0F; --ink:#17181A;
      --text:#242628; --muted:#6B6660; --faint:#A39E97;
      --bg:#FDFBF8; --panel:#FFFFFF; --panel-2:#F6F2EC;
      --border:#EBE5DC; --border-soft:#F1ECE4;
      --shadow-sm:0 1px 2px rgba(23,20,15,.05);
      --shadow-md:0 8px 28px rgba(23,20,15,.08);
      --shadow-lg:0 24px 60px rgba(23,20,15,.14);
    }
    body{font-family:'Inter',-apple-system,sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;line-height:1.6}
    a{text-decoration:none;color:inherit}
    .disp{font-family:'Manrope',-apple-system,sans-serif}
    ::selection{background:var(--rosa);color:#fff}

    /* ── NAV ─────────────────────────────────────────────────────── */
    nav{position:sticky;top:0;z-index:100;background:rgba(253,251,248,.85);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--border);padding:0 48px;display:flex;align-items:center;justify-content:space-between;height:62px}
    .logo{font-family:'Manrope';font-size:17px;font-weight:800;color:var(--dark);letter-spacing:-.3px}
    .logo span{color:var(--rosa)}
    .nav-links{display:flex;align-items:center;gap:30px}
    .nav-links a{font-size:13.5px;color:var(--muted);font-weight:500;transition:color .15s}
    .nav-links a:hover{color:var(--dark)}
    .btn-entrar{background:var(--dark);color:#fff;padding:8px 19px;border-radius:8px;font-size:13px;font-weight:600;border:none;cursor:pointer;transition:transform .15s,opacity .15s}
    .btn-entrar:hover{opacity:.85;transform:translateY(-1px)}

    /* ── HERO (split) ────────────────────────────────────────────── */
    .hero-wrap{max-width:1180px;margin:0 auto;padding:76px 48px 60px;display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
    .hero-tag{display:inline-flex;align-items:center;gap:7px;background:var(--panel-2);color:var(--text);padding:6px 14px 6px 10px;border-radius:999px;font-size:12px;font-weight:600;margin-bottom:26px;border:1px solid var(--border)}
    .hero-tag i{width:7px;height:7px;border-radius:50%;background:var(--rosa);flex-shrink:0;animation:pulse-dot 2s infinite}
    @keyframes pulse-dot{0%,100%{opacity:1}50%{opacity:.35}}
    h1{font-family:'Manrope';font-size:54px;font-weight:800;line-height:1.03;letter-spacing:-2.2px;color:var(--dark);margin-bottom:20px;text-wrap:balance}
    h1 em{font-style:normal;color:var(--rosa);position:relative}
    .hero-sub{font-size:17.5px;color:var(--muted);max-width:480px;margin:0 0 34px;line-height:1.65}
    .hero-ctas{display:flex;flex-direction:column;gap:14px;align-items:flex-start}
    .cta-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
    .cta-path{display:flex;flex-direction:column;gap:6px;align-items:flex-start}
    .cta-path-label{font-size:11.5px;font-weight:700;color:var(--faint);text-transform:uppercase;letter-spacing:.06em}
    .btn-main{font-family:'Inter';background:var(--rosa);color:#fff;padding:14px 26px;border-radius:10px;font-size:14.5px;font-weight:700;border:none;cursor:pointer;box-shadow:0 10px 24px rgba(255,56,92,.28);transition:transform .15s,box-shadow .15s}
    .btn-main:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(255,56,92,.36)}
    .hero-links{font-size:12.5px;color:var(--faint);text-decoration:underline;margin-top:2px}
    .hero-note{font-size:12px;color:var(--faint);margin-top:18px}

    /* ── HERO VISUAL: fluxo animado ──────────────────────────────── */
    .hero-visual{position:relative;background:var(--dark);border-radius:22px;padding:34px 26px;box-shadow:var(--shadow-lg);overflow:hidden}
    .hero-visual::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 85% -10%,rgba(255,56,92,.28),transparent 55%),radial-gradient(circle at -10% 110%,rgba(0,166,153,.22),transparent 55%)}
    .hv-head{position:relative;font-size:11px;font-weight:700;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.09em;margin-bottom:20px}
    .hv-flow{position:relative;display:flex;flex-direction:column;gap:0}
    .hv-node{display:flex;align-items:center;gap:14px;padding:13px 4px;position:relative}
    .hv-node:not(:last-child)::after{content:'';position:absolute;left:20px;top:44px;width:1px;height:22px;background:rgba(255,255,255,.14)}
    .hv-ic{width:40px;height:40px;border-radius:11px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;transition:background .3s,border-color .3s,transform .3s}
    .hv-txt b{display:block;font-size:13.5px;font-weight:700;color:#fff}
    .hv-txt span{font-size:11.5px;color:rgba(255,255,255,.42)}
    .hv-node.on .hv-ic{background:var(--rosa);border-color:var(--rosa);transform:scale(1.08);box-shadow:0 0 0 6px rgba(255,56,92,.16)}
    .hv-foot{position:relative;margin-top:18px;padding-top:16px;border-top:1px solid rgba(255,255,255,.1);font-size:12px;color:rgba(255,255,255,.4);display:flex;justify-content:space-between}
    .hv-foot b{color:#fff}

    .sec-cta{display:flex;justify-content:center;margin-top:46px}
    .cta-flutuante{position:fixed;right:20px;bottom:20px;z-index:200;opacity:0;pointer-events:none;transform:translateY(12px);transition:opacity .25s ease,transform .25s ease}
    .cta-flutuante.visivel{opacity:1;pointer-events:auto;transform:translateY(0)}
    .cta-flutuante button{font-family:'Inter';background:var(--dark);color:#fff;padding:14px 22px;border-radius:999px;font-size:13.5px;font-weight:700;border:none;cursor:pointer;box-shadow:0 10px 30px rgba(0,0,0,.28)}
    .cta-flutuante button:hover{opacity:.92}
    @media(max-width:640px){ .cta-flutuante{left:16px;right:16px;bottom:16px} .cta-flutuante button{width:100%} }

    /* ── NÚMEROS ─────────────────────────────────────────────────── */
    .numeros{background:var(--dark);padding:44px 48px;position:relative;overflow:hidden}
    .numeros::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,56,92,.1),transparent 30%,transparent 70%,rgba(0,166,153,.1))}
    .numeros-inner{position:relative;max-width:820px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);text-align:center}
    .numeros-inner>div{border-left:1px solid rgba(255,255,255,.08);padding:0 12px}
    .numeros-inner>div:first-child{border-left:none}
    .num-val{font-family:'Manrope';font-size:36px;font-weight:800;color:#fff;letter-spacing:-1px;font-variant-numeric:tabular-nums}
    .num-lbl{font-size:12px;color:rgba(255,255,255,.42);margin-top:5px;font-weight:500}

    /* ── SEÇÕES GERAIS ───────────────────────────────────────────── */
    .sec-tag{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;font-weight:700;color:var(--rosa);text-transform:uppercase;letter-spacing:.09em;margin-bottom:16px}
    .sec-tag i{width:16px;height:1.5px;background:var(--rosa)}
    .sec-tag.teal{color:var(--teal-dark)} .sec-tag.teal i{background:var(--teal)}
    .sec-tag.laranja{color:var(--laranja)} .sec-tag.laranja i{background:var(--laranja)}
    .sec-title{font-family:'Manrope';font-size:36px;font-weight:800;color:var(--dark);letter-spacing:-1px;margin-bottom:14px;line-height:1.18;text-wrap:balance}
    .sec-sub{font-size:16px;color:var(--muted);line-height:1.7;max-width:540px}

    /* ── PROBLEMA ────────────────────────────────────────────────── */
    .problema{padding:96px 48px;max-width:1080px;margin:0 auto}
    .problema-head{text-align:center;margin:0 auto 52px;max-width:640px}
    .problema-head .sec-sub{margin:0 auto}
    .dores{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .dor{background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:30px 26px;transition:transform .2s,box-shadow .2s,border-color .2s}
    .dor:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);border-color:transparent}
    .dor-num{font-family:'Manrope';font-size:13px;font-weight:800;color:#fff;background:var(--rosa);width:26px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:18px}
    .dor:nth-child(2) .dor-num{background:var(--teal)}
    .dor:nth-child(3) .dor-num{background:var(--laranja)}
    .dor-title{font-family:'Manrope';font-size:16.5px;font-weight:700;color:var(--dark);margin-bottom:9px;letter-spacing:-.2px}
    .dor-desc{font-size:13.5px;color:var(--muted);line-height:1.7}

    /* ── COMO FUNCIONA ───────────────────────────────────────────── */
    .como{padding:96px 48px;background:var(--panel-2)}
    .como-inner{max-width:1080px;margin:0 auto}
    .como-header{text-align:center;margin-bottom:56px;max-width:600px;margin-left:auto;margin-right:auto}
    .fluxo{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
    .fluxo-step{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:20px 14px;text-align:center;position:relative;transition:transform .2s}
    .fluxo-step:hover{transform:translateY(-3px)}
    .fluxo-step:not(:last-child)::after{content:'→';position:absolute;right:-13px;top:38px;color:var(--faint);font-size:13px;z-index:1}
    @media(max-width:900px){ .fluxo-step:not(:last-child)::after{display:none} }
    .fluxo-icon{width:44px;height:44px;border-radius:12px;background:var(--panel-2);display:flex;align-items:center;justify-content:center;font-size:19px;margin:0 auto 12px}
    .fluxo-step.c1 .fluxo-icon{background:#FFE9EC}
    .fluxo-step.c2 .fluxo-icon{background:#E4F5F3}
    .fluxo-step.c3 .fluxo-icon{background:#FFE6DA}
    .fluxo-label{font-size:12.5px;font-weight:700;color:var(--dark)}
    .fluxo-sub{font-size:10.5px;color:var(--muted);margin-top:4px;line-height:1.4}

    /* ── FEATURES (bento) ────────────────────────────────────────── */
    .features{padding:96px 48px;max-width:1080px;margin:0 auto}
    .features-header{text-align:center;margin-bottom:52px;max-width:600px;margin-left:auto;margin-right:auto}
    .bento{display:grid;grid-template-columns:repeat(6,1fr);gap:16px}
    .feat{background:var(--panel);border:1px solid var(--border);border-radius:18px;padding:28px;transition:transform .2s,box-shadow .2s;display:flex;flex-direction:column}
    .feat:hover{transform:translateY(-4px);box-shadow:var(--shadow-md)}
    .feat.big{grid-column:span 3}
    .feat.small{grid-column:span 2}
    @media(max-width:900px){ .feat.big,.feat.small{grid-column:span 6} }
    .feat-ic{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:19px;margin-bottom:18px}
    .feat:nth-child(6n+1) .feat-ic,.feat:nth-child(6n+4) .feat-ic{background:#FFE9EC}
    .feat:nth-child(6n+2) .feat-ic,.feat:nth-child(6n+5) .feat-ic{background:#E4F5F3}
    .feat:nth-child(6n+3) .feat-ic,.feat:nth-child(6n+6) .feat-ic{background:#FFE6DA}
    .feat-title{font-family:'Manrope';font-size:16.5px;font-weight:700;color:var(--dark);letter-spacing:-.2px;margin-bottom:9px}
    .feat-desc{font-size:13.5px;color:var(--muted);line-height:1.7;margin-bottom:14px}
    .feat-items{display:flex;flex-direction:column;gap:7px;margin-top:auto}
    .feat-item{font-size:12.5px;color:var(--text);display:flex;align-items:flex-start;gap:7px}
    .feat-item::before{content:'✓';color:var(--teal-dark);flex-shrink:0;font-weight:700;font-size:11px;margin-top:2px}

    /* ── DEPOIMENTOS ─────────────────────────────────────────────── */
    .depos{padding:96px 48px;background:var(--dark)}
    .depos-inner{max-width:1080px;margin:0 auto}
    .depos-header{text-align:center;margin-bottom:48px}
    .depos-header .sec-title{color:#fff}
    .depos-header .sec-sub{color:rgba(255,255,255,.45);margin:0 auto}
    .depos-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .depo{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:28px}
    .depo-quote{font-family:'Manrope';font-size:30px;color:var(--rosa);line-height:1;margin-bottom:8px}
    .depo-resultado{font-size:11.5px;font-weight:700;color:var(--rosa);margin-bottom:14px;text-transform:uppercase;letter-spacing:.04em}
    .depo-text{font-size:14px;color:rgba(255,255,255,.82);line-height:1.7;margin-bottom:22px}
    .depo-autor{display:flex;align-items:center;gap:10px;border-top:1px solid rgba(255,255,255,.08);padding-top:16px}
    .depo-av{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.08);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .depo-nome{font-size:13px;font-weight:600;color:#fff}
    .depo-cargo{font-size:11.5px;color:rgba(255,255,255,.42)}

    /* ── CTA FINAL ───────────────────────────────────────────────── */
    .cta-final{padding:96px 48px;background:linear-gradient(155deg,var(--rosa) 0%,#C22347 100%);position:relative;overflow:hidden}
    .cta-final::before{content:'';position:absolute;width:520px;height:520px;border-radius:50%;background:rgba(255,255,255,.08);top:-260px;right:-140px}
    .cta-final-inner{position:relative;max-width:600px;margin:0 auto;text-align:center}
    .cta-final h2{font-family:'Manrope';font-size:38px;font-weight:800;color:#fff;letter-spacing:-1px;margin-bottom:14px;line-height:1.18}
    .cta-final p{font-size:16px;color:rgba(255,255,255,.82);margin-bottom:32px;line-height:1.7}
    .btn-cta{font-family:'Inter';background:#fff;color:var(--rosa-dark);padding:15px 34px;border-radius:10px;font-size:15px;font-weight:700;border:none;cursor:pointer;box-shadow:0 14px 30px rgba(0,0,0,.18);transition:transform .15s}
    .btn-cta:hover{transform:translateY(-2px)}
    .cta-note{font-size:12.5px;color:rgba(255,255,255,.68);margin-top:16px}

    /* ── QUEM USA (segmentação por persona, ago/2026) ───────────────
       Pesquisa de mercado (Asana/Pipedrive/SupportNinja etc): segmentar por
       audiência numa seção dedicada converte mais que 1 CTA genérico
       tentando falar com todo mundo ao mesmo tempo — mas mantém 1 único CTA
       principal (criar conta), só a mensagem de cada card muda. */
    .quemusa{padding:80px 48px;max-width:1080px;margin:0 auto}
    .quemusa-head{text-align:center;margin:0 auto 44px;max-width:640px}
    .quemusa-head .sec-sub{margin:0 auto}
    .qu-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
    .qu-card{background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:26px 22px;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s,border-color .2s}
    .qu-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);border-color:transparent}
    .qu-ic{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:19px;margin-bottom:16px;background:#FFE9EC}
    .qu-card:nth-child(2) .qu-ic{background:#E4F5F3}
    .qu-card:nth-child(3) .qu-ic{background:#FFE6DA}
    .qu-card:nth-child(4) .qu-ic{background:#FFE9EC}
    .qu-title{font-family:'Manrope';font-size:16px;font-weight:700;color:var(--dark);margin-bottom:8px;letter-spacing:-.2px}
    .qu-desc{font-size:13px;color:var(--muted);line-height:1.65;margin-bottom:16px;flex:1}
    .qu-link{font-size:12.5px;font-weight:700;color:var(--rosa)}
    @media(max-width:900px){ .qu-grid{grid-template-columns:1fr 1fr} }
    @media(max-width:640px){ .qu-grid{grid-template-columns:1fr} }

    /* ── FOOTER ──────────────────────────────────────────────────── */
    footer{background:#0A0A0A;padding:52px 48px 28px;display:flex;flex-direction:column;gap:28px}
    .footer-top{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px}
    .footer-logo{font-family:'Manrope';font-size:14px;font-weight:800;color:rgba(255,255,255,.65)}
    .footer-logo span{color:var(--rosa)}
    .footer-col-label{font-size:11.5px;font-weight:700;color:rgba(255,255,255,.32);text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px;display:block}
    .footer-links{display:flex;gap:22px;flex-wrap:wrap}
    .footer-links a{font-size:12.5px;color:rgba(255,255,255,.4);transition:color .15s}
    .footer-links a:hover{color:#fff}
    .footer-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;padding-top:24px;border-top:1px solid rgba(255,255,255,.07)}
    .footer-empresa{font-size:13px;color:rgba(255,255,255,.5)}
    .footer-note{font-size:12px;color:rgba(255,255,255,.28)}

    /* ── MODAL (mesmos IDs, novo visual) ─────────────────────────── */
    .modal-overlay{display:none;position:fixed;inset:0;background:rgba(15,13,10,.6);backdrop-filter:blur(2px);z-index:99999;align-items:center;justify-content:center;overflow-y:auto;padding:24px 0}
    .modal-box{background:#fff;border-radius:18px;padding:30px;width:360px;max-width:92vw;position:relative;max-height:calc(100vh - 48px);overflow-y:auto;box-shadow:var(--shadow-lg)}
    .modal-close{position:absolute;top:16px;right:18px;background:var(--panel-2);border:none;width:26px;height:26px;border-radius:50%;font-size:15px;cursor:pointer;color:var(--muted);line-height:1}
    .modal-title{font-family:'Manrope';font-size:17px;font-weight:800;color:var(--dark);margin-bottom:3px}
    .modal-sub{font-size:12.5px;color:var(--muted);margin-bottom:20px}
    .modal-tabs{display:flex;gap:4px;background:var(--panel-2);border-radius:9px;padding:3px;margin-bottom:18px}
    .modal-tab{flex:1;padding:7px;border-radius:6px;font-size:12.5px;font-weight:600;cursor:pointer;border:none;background:transparent;color:var(--muted);text-align:center}
    .modal-tab.on{background:#fff;color:var(--dark);box-shadow:var(--shadow-sm)}
    .m-field{margin-bottom:11px}
    .m-field label{display:block;font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:5px}
    .m-field input,.m-field select{width:100%;padding:10px 12px;border:1.5px solid var(--border);border-radius:9px;font-size:13.5px;color:var(--dark);outline:none;box-sizing:border-box;background:#fff;font-family:inherit}
    .m-field input:focus,.m-field select:focus{border-color:var(--rosa)}
    .m-field input[type="checkbox"],.m-field input[type="radio"]{width:auto;padding:0;border:none;border-radius:0;background:none;flex-shrink:0}
    .m-btn{width:100%;font-family:'Inter';background:var(--rosa);color:#fff;padding:11px;border:none;border-radius:9px;font-size:13.5px;font-weight:700;cursor:pointer;margin-top:6px}
    .m-note{font-size:11.5px;color:var(--muted);text-align:center;margin-top:11px}

    @media(max-width:900px){
