          <div style="display:flex;justify-content:space-between;margin-bottom:4px">
            <span style="font-size:13px;font-weight:600;color:#111"><%= _cat %></span>
            <span style="font-size:13px;font-weight:700;color:<%= _corCat[_cat] %>"><%= _val %> coins</span>
          </div>
          <div style="background:#f3f4f6;border-radius:99px;height:8px;overflow:hidden">
            <div style="height:100%;width:<%= _pct %>%;background:<%= _corCat[_cat] %>;border-radius:99px;transition:width .6s"></div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<!-- HISTÓRICO COM FILTRO -->
<div class="card" style="margin-bottom:16px">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
    <h2 style="font-size:15px;font-weight:700;margin:0">Histórico</h2>
    <div style="display:flex;gap:6px">
      <button onclick="filtrarHistorico('todos',this)" id="btn-todos" style="padding:6px 12px;border-radius:20px;border:none;background:#111;color:#fff;font-size:12px;font-weight:600;cursor:pointer">Todos</button>
      <button onclick="filtrarHistorico('debito',this)" id="btn-debito" style="padding:6px 12px;border-radius:20px;border:1px solid #e5e7eb;background:#fff;color:#555;font-size:12px;font-weight:600;cursor:pointer">Débitos</button>
      <button onclick="filtrarHistorico('recarga',this)" id="btn-recarga" style="padding:6px 12px;border-radius:20px;border:1px solid #e5e7eb;background:#fff;color:#555;font-size:12px;font-weight:600;cursor:pointer">Recargas</button>
    </div>
  </div>

  <% if (!historico || historico.length === 0) { %>
    <div style="text-align:center;padding:32px;color:#aaa;font-size:14px">Nenhuma movimentação ainda.</div>
  <% } else { %>
    <div id="lista-historico" style="display:flex;flex-direction:column;gap:8px">
      <% historico.forEach(function(t){ %>
        <%
          const _eh_credito = t.quantidade > 0;
          const _valor = Math.abs(t.quantidade);
          const _cor = _eh_credito ? '#22c55e' : '#ef4444';
          const _sinal = _eh_credito ? '+' : '-';
          const _data = new Date(t.data).toLocaleString('pt-BR', {timeZone:'America/Sao_Paulo', day:'2-digit', month:'2-digit', year:'2-digit', hour:'2-digit', minute:'2-digit'});
          const _unidadeItens = t.motivo === 'importar_lead' ? 'leads' : 'imóveis';
          const _label = (_labels[t.motivo] || t.motivo) + (t.itens > 1 ? ' (' + t.itens + ' ' + _unidadeItens + ')' : '');
          const _tipo = _eh_credito ? 'recarga' : 'debito';
        %>
        <div class="item-historico" data-tipo="<%= _tipo %>" style="display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:#f9fafb;border-radius:10px">
          <div style="flex:1;min-width:0">
            <div style="font-size:13px;font-weight:600;color:#111;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= _label %></div>
            <div style="font-size:11px;color:#aaa;margin-top:2px"><%= _data %> · saldo: <%= t.saldoApos %></div>
          </div>
          <div style="font-size:15px;font-weight:800;color:<%= _cor %>;margin-left:12px;white-space:nowrap"><%= _sinal %><%= _valor %></div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<script>
function filtrarHistorico(tipo, btn) {
  document.querySelectorAll('#lista-historico .item-historico').forEach(el => {
    el.style.display = (tipo === 'todos' || el.dataset.tipo === tipo) ? 'flex' : 'none';
  });
  document.querySelectorAll('[id^="btn-"]').forEach(b => {
    b.style.background = '#fff'; b.style.color = '#555'; b.style.border = '1px solid #e5e7eb';
  });
  btn.style.background = '#111'; btn.style.color = '#fff'; btn.style.border = 'none';
}
</script>

<script>
let valorSelecionado = 0;
function atualizarPreview(v){
  valorSelecionado = parseFloat(v)||0;
  document.getElementById("creditosPreview").innerText = Math.floor(valorSelecionado*20).toLocaleString("pt-BR")+" créditos";
}
async function iniciarCompra(){
  if(!valorSelecionado || valorSelecionado < 50){ alert("Valor mínimo é R$50."); return; }
  const btn = document.getElementById("btnPagar");
  btn.disabled = true; btn.textContent = "Aguarde...";
  try{
    const r = await fetch("/pagamento/criar",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({valor:valorSelecionado})});
    const d = await r.json();
    if(d.ok && d.url){ window.open(d.url, '_blank'); btn.disabled=false; btn.textContent='Adicionar créditos'; }
    else if(d.cpfNecessario){ btn.disabled=false; btn.textContent='Adicionar créditos'; abrirCpfModal(iniciarCompra); }
    else{ alert(d.erro||"Erro ao criar pagamento"); btn.disabled=false; btn.textContent="Adicionar créditos"; }
  } catch(e){
    alert("Erro de conexão"); btn.disabled=false; btn.textContent="Adicionar créditos";
  }
}
</script>

<%- include('partials/app-end') %>
