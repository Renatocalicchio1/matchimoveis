<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<meta name="theme-color" content="#ffffff">
<title>Resumo Inteligente — MatchImóveis</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#ffffff; --ink:#222222; --ink-dim:rgba(34,34,34,.64); --ink-faint:rgba(34,34,34,.38);
  --rausch:#FF385C; --babu:#00A699; --arches:#FC642D;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0;overflow:hidden;overscroll-behavior:none}
body{background:var(--bg);color:var(--ink);font-family:'Manrope',sans-serif}

.screen{position:relative;width:100vw;height:100dvh;overflow:hidden;background:var(--bg)}

.bars{position:absolute;top:calc(env(safe-area-inset-top,0px) + 12px);left:14px;right:14px;display:flex;gap:5px;z-index:20}
.bar{flex:1;height:3px;border-radius:3px;background:rgba(0,0,0,.1);overflow:hidden}
.bar > i{display:block;height:100%;width:0%;background:var(--rausch);border-radius:3px}

.card-top{position:absolute;top:calc(env(safe-area-inset-top,0px) + 26px);left:16px;right:16px;display:flex;align-items:center;justify-content:space-between;z-index:20}
.chip{display:inline-flex;align-items:center;gap:6px;font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;background:rgba(255,255,255,.85);backdrop-filter:blur(6px);border:1px solid rgba(0,0,0,.08);color:var(--ink);padding:6px 11px 6px 9px;border-radius:20px;box-shadow:0 1px 6px rgba(0,0,0,.05)}
.brand{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--ink-faint)}

.card-face{position:absolute;inset:0;transition:opacity .35s ease}

/* coraçõezinhos subindo quando uma lead curte um imóvel — puramente
   decorativo, não intercepta toque (pointer-events:none) */
.hearts-layer{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:18}
.heart-fly{position:absolute;bottom:110px;font-size:22px;opacity:0;animation:heartFly 2.6s ease-in forwards}
@keyframes heartFly{
  0%{opacity:0;transform:translateY(0) translateX(0) scale(.6) rotate(0deg)}
  12%{opacity:1;transform:translateY(-40px) translateX(var(--drift,0px)) scale(1) rotate(var(--rot,0deg))}
  100%{opacity:0;transform:translateY(-420px) translateX(var(--drift,0px)) scale(.9) rotate(var(--rot,0deg))}
}

.card-body{position:absolute;left:22px;right:22px;bottom:150px;z-index:15}
.k-icon{font-size:32px;margin-bottom:16px;display:block}
/* foto real do imóvel, quando tem — substitui o ícone, compacta de
   propósito (miniatura, não hero) pra não poluir o card */
.k-foto{width:clamp(150px,48vw,220px);aspect-ratio:1/1;border-radius:22px;object-fit:cover;margin:0 auto 16px;display:block;border:1px solid rgba(0,0,0,.08);box-shadow:0 6px 18px rgba(0,0,0,.1)}
/* Quando o imóvel tem mais de 1 foto — corre pro lado pra ver as outras
   (pedido do Renato). Mesmo tamanho/visual do .k-foto único, só que numa
   fileira com scroll horizontal em vez de 1 imagem fixa. */
.k-foto-gallery{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;margin:0 0 16px;padding-bottom:2px}
.k-foto-gallery img{flex:0 0 auto;width:clamp(150px,48vw,220px);aspect-ratio:1/1;object-fit:cover;border-radius:22px;border:1px solid rgba(0,0,0,.08);box-shadow:0 6px 18px rgba(0,0,0,.1);scroll-snap-align:start}
.k-name{font-family:'Sora',sans-serif;font-weight:800;font-size:clamp(24px,7vw,30px);line-height:1.15;text-wrap:balance;margin:0 0 9px;color:var(--ink)}
.k-detail{font-size:14.5px;color:var(--ink-dim);line-height:1.55;margin:0 0 13px;max-width:320px}
.k-meta{display:flex;align-items:center;gap:8px}
.k-tag{font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:600;padding:4px 10px;border-radius:20px}
.k-tag.rausch{background:rgba(255,56,92,.12);color:#c81e3a}
.k-tag.arches{background:rgba(252,100,45,.14);color:#c14a1a}
.k-tag.babu{background:rgba(0,166,153,.14);color:#00786e}
.k-time{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--ink-faint)}

.actions{position:absolute;left:22px;right:22px;bottom:92px;display:flex;gap:9px;z-index:20}
.act-btn{flex:1;text-align:center;font-family:'Manrope',sans-serif;font-weight:700;font-size:13.5px;padding:13px 8px;border-radius:14px;border:1px solid rgba(0,0,0,.1);background:#fff;color:var(--ink);box-shadow:0 1px 6px rgba(0,0,0,.05);text-decoration:none;display:block;cursor:pointer}
.act-btn.primary{background:var(--card-accent,var(--rausch));color:#fff;border-color:transparent;box-shadow:0 3px 10px rgba(0,0,0,.12)}

.empty-state{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;padding:0 32px;color:var(--ink-dim)}

/* card de "primeiro passo" com ação inline (ex: importar XML) — não sai da
   tela do resumo, preenche/confirma ali mesmo. Antes tentava reaproveitar
   .card-body + .actions (2 blocos independentes, cada um ancorado por
   `bottom` e crescendo pra cima) com uma folga calculada na mão — ficou
   frágil: em telas mais estreitas o texto quebra em mais linhas do que o
   previsto e o formulário acaba sobreposto (bug real reportado pelo
   Renato, com print do celular). Agora é 1 container só, em fluxo normal
   (flex-column, não posicionamento por cálculo), com overflow-y:auto como
   rede de segurança — pior caso ele rola dentro do próprio card, nunca
   mais sobrepõe outra coisa. */
.onb-card-wrap{position:absolute;top:96px;left:22px;right:22px;bottom:100px;z-index:20;display:flex;flex-direction:column;justify-content:center;gap:14px;overflow-y:auto}
.onb-card-wrap .k-icon{margin-bottom:0}
.onb-card-wrap .k-name{margin-bottom:0}
.onb-card-wrap .k-detail{margin-bottom:0}
.onb-form{display:flex;flex-direction:column;gap:10px;width:100%;flex-shrink:0}
.onb-input{width:100%;padding:14px;border-radius:13px;border:1px solid rgba(0,0,0,.16);background:#fff;color:var(--ink);font-size:14px;font-family:'Manrope',sans-serif;line-height:1.3;box-sizing:border-box}
.onb-input::placeholder{color:var(--ink-faint)}
.onb-status{font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:var(--ink-dim);min-height:14px}

/* Conectar WhatsApp inline (QR ou código) — mesmo mecanismo de
   /app/perfil, dentro do onb-card-wrap. */
.onb-toggle{display:flex;gap:8px;flex-shrink:0}
.onb-toggle button{flex:1;padding:9px 8px;border-radius:10px;border:1px solid rgba(0,0,0,.14);background:#fff;font-size:12px;font-weight:700;color:var(--ink-dim);cursor:pointer;font-family:'Manrope',sans-serif}
.onb-toggle button.on{background:var(--rausch);color:#fff;border-color:var(--rausch)}
.onb-qr-box{display:none;text-align:center;background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:14px;padding:14px;flex-shrink:0}
.onb-qr-box img{width:170px;height:170px;display:block;margin:0 auto;border-radius:8px}
.onb-code-box{display:none;text-align:center;flex-shrink:0}
.onb-code-big{font-family:'IBM Plex Mono',monospace;font-size:24px;font-weight:800;letter-spacing:4px;color:var(--ink);background:rgba(0,0,0,.03);border:1.5px dashed rgba(0,0,0,.22);border-radius:12px;padding:14px;margin-top:10px}

.mic-wrap{position:absolute;left:0;right:0;bottom:calc(env(safe-area-inset-bottom,0px) + 26px);display:flex;justify-content:center;z-index:25}
.mic{width:60px;height:60px;border-radius:50%;background:rgba(255,56,92,.16);border:1px solid rgba(255,56,92,.4);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;font-size:23px;cursor:pointer;transition:transform .15s,background .2s}
.mic.on{background:var(--rausch);animation:pulse 1.1s ease-in-out infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(255,56,92,.55)}50%{box-shadow:0 0 0 16px rgba(255,56,92,0)}}

.voice-sheet{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(180deg,rgba(255,255,255,0) 0%,rgba(255,255,255,.97) 20%,#fff 100%);box-shadow:0 -8px 30px rgba(0,0,0,.08);padding:28px 22px calc(env(safe-area-inset-bottom,0px) + 34px);transform:translateY(100%);transition:transform .32s cubic-bezier(.2,.8,.2,1);z-index:40;text-align:center}
.voice-sheet.open{transform:translateY(0)}
.sheet-close{position:absolute;top:14px;right:14px;width:34px;height:34px;border-radius:50%;border:1px solid rgba(0,0,0,.1);background:#fff;color:var(--ink-dim);font-size:15px;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.08);z-index:1}
.voice-wave{display:flex;gap:4px;align-items:center;justify-content:center;height:30px;margin-bottom:14px}
.voice-wave i{width:3.5px;border-radius:3px;background:var(--rausch);display:block;animation:wave 1s ease-in-out infinite}
.voice-wave i:nth-child(1){height:10px;animation-delay:0s} .voice-wave i:nth-child(2){height:22px;animation-delay:.1s}
.voice-wave i:nth-child(3){height:14px;animation-delay:.2s} .voice-wave i:nth-child(4){height:26px;animation-delay:.3s}
.voice-wave i:nth-child(5){height:12px;animation-delay:.4s} .voice-wave i:nth-child(6){height:20px;animation-delay:.5s}
.voice-wave i:nth-child(7){height:9px;animation-delay:.6s}
@keyframes wave{0%,100%{transform:scaleY(.4)}50%{transform:scaleY(1)}}
.voice-status{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:10px;min-height:14px}
.voice-transcript{font-family:'Sora',sans-serif;font-weight:700;font-size:18px;color:var(--ink);min-height:26px;opacity:0;transform:translateY(6px);transition:opacity .3s ease,transform .3s ease}
.voice-transcript.show{opacity:1;transform:translateY(0)}
.voice-results{margin-top:16px;display:flex;flex-direction:column;gap:10px}
/* card de resultado — mesma linguagem visual dos cards do carrossel
   principal (k-icon/k-name/act-btn), só compacto, pra qualquer ação de voz
   virar um card real na tela, não uma lista de texto */
.voice-card{text-align:left;padding:16px;border-radius:16px;background:#fff;border:1px solid rgba(0,0,0,.09);box-shadow:0 2px 10px rgba(0,0,0,.05);display:flex;flex-direction:column;gap:10px}
.vc-foto{width:100%;height:110px;object-fit:cover;border-radius:12px;display:block}
.vc-top{display:flex;align-items:flex-start;gap:10px}
.vc-icon{font-size:22px;line-height:1}
.vc-name{font-family:'Sora',sans-serif;font-weight:700;font-size:15px;color:var(--ink);margin:0 0 3px}
.vc-detail{font-size:12.5px;color:var(--ink-dim);line-height:1.4}
.vc-actions{display:flex;gap:8px}
.vc-btn{flex:1;text-align:center;padding:10px 6px;border-radius:11px;font-size:12.5px;font-weight:700;text-decoration:none;color:#fff;background:var(--rausch)}
.vc-btn.sec{background:rgba(0,0,0,.04);color:var(--ink);border:1px solid rgba(0,0,0,.12)}

/* Menu de navegação (mesmo bottom-nav + "Mais" de partials/app-shell.ejs —
   essa tela é um HTML isolado, sem o shell, então o menu vem duplicado
   aqui; pedido do Renato pra sempre dar acesso ao resto do app a partir
   do resumo, não só voz/swipe). Some com o teclado da busca por voz não
   entra em conflito porque o resumo não tem input de texto nativo. */
.bottom-nav{display:none;position:fixed;bottom:0;left:0;right:0;height:64px;background:#fff;border-top:1px solid #e5e5e3;z-index:500;align-items:center;justify-content:space-around;padding:0 4px 6px}
@media(max-width:900px){
  .bottom-nav{display:flex}
  .card-body{bottom:214px}
  .actions{bottom:156px}
  .onb-card-wrap{bottom:164px}
  .mic-wrap{bottom:calc(env(safe-area-inset-bottom,0px) + 90px)}
}
.mm-sec{font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#9ca3af;padding:16px 6px 6px}
.mm-sec:first-child{padding-top:6px}
.mm-row{display:flex;align-items:center;gap:12px;padding:11px 6px;border-radius:10px;color:#111827;text-decoration:none;font-size:14px;font-weight:500}
.mm-row:active{background:#f8f8f7}
.mm-row svg{flex-shrink:0;color:#6b7280}
.mm-row+.mm-sec{border-top:1px solid #f0f0ef;margin-top:4px}
</style>
</head>
<body>
<div class="screen" id="screen">
  <div class="bars" id="bars"></div>
  <div class="card-top">
    <span class="chip" id="chipCat">·</span>
    <span class="brand">MatchImóveis</span>
  </div>

  <div id="faces"></div>
  <div class="hearts-layer" id="heartsLayer"></div>

  <% if (cards && cards.length) { %>
  <div class="card-body" id="cardBody"></div>
  <div class="actions" id="cardActions"></div>
  <div class="onb-card-wrap" id="onbCardWrap" style="display:none"></div>
  <% } else { %>
  <div class="empty-state">
    <div style="font-size:38px">🎯</div>
    <div style="font-family:'Sora',sans-serif;font-weight:700;font-size:17px;color:var(--ink)">Tudo tranquilo por aqui</div>
    <div style="font-size:13px">Nada pedindo atenção agora — volte daqui a pouco.</div>
  </div>
  <% } %>

  <div class="mic-wrap"><button class="mic" id="micBtn" title="Falar um comando">🎙️</button></div>

  <div class="voice-sheet" id="voiceSheet">
    <button type="button" class="sheet-close" id="voiceSheetClose" title="Fechar">✕</button>
    <div class="voice-wave"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="voice-status" id="voiceStatus">ouvindo…</div>
    <div class="voice-transcript" id="voiceTranscript"></div>
    <div id="voiceResults" class="voice-results"></div>
  </div>

  <!-- Painel rápido de lead/imóvel — abre "Ver lead"/"Ver imóvel" dentro do
       próprio resumo, sem navegar embora (mesma mecânica de slide-up do
       voice-sheet). Botão "✕" explícito pra fechar — antes só dava pra
       fechar tocando fora do cartão, o que não é óbvio (pedido do Renato). -->
  <div class="voice-sheet" id="infoSheet">
    <button type="button" class="sheet-close" id="infoSheetClose" title="Fechar">✕</button>
    <div id="infoContent"></div>
  </div>
</div>

<nav class="bottom-nav">
  <a href="/app-home" style="display:flex;flex-direction:column;align-items:center;gap:2px;text-decoration:none;padding:6px 10px;border-radius:10px;flex:1">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
    <span style="font-size:10px;color:#9ca3af">Dashboard</span>
  </a>
  <a href="/app/resumo" style="display:flex;flex-direction:column;align-items:center;gap:2px;text-decoration:none;padding:6px 10px;border-radius:10px;flex:1;background:#fff1f3">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FF385C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h7v8l10-12h-7z"/></svg>
    <span style="font-size:10px;color:#FF385C;font-weight:600">Tempo Real</span>
  </a>
  <a href="/app/feed" style="display:flex;flex-direction:column;align-items:center;gap:2px;text-decoration:none;padding:6px 10px;border-radius:10px;flex:1">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/><rect x="3" y="17" width="18" height="4" rx="1"/></svg>
    <span style="font-size:10px;color:#9ca3af">Feed</span>
  </a>
  <a href="/app/leads" style="display:flex;flex-direction:column;align-items:center;gap:2px;text-decoration:none;padding:6px 10px;border-radius:10px;flex:1">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
    <span style="font-size:10px;color:#9ca3af">Leads</span>
  </a>
  <a href="/app/visitas" style="display:flex;flex-direction:column;align-items:center;gap:2px;text-decoration:none;padding:6px 10px;border-radius:10px;flex:1">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    <span style="font-size:10px;color:#9ca3af">Visitas</span>
  </a>
  <a href="/app/mapa" style="display:flex;flex-direction:column;align-items:center;gap:2px;text-decoration:none;padding:6px 10px;border-radius:10px;flex:1">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 13l4.553 2.276A1 1 0 0021 21.382V10.618a1 1 0 00-1.447-.894L15 12m0 8V12m0 0L9 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span style="font-size:10px;color:#9ca3af">Mapa</span>
  </a>
  <button onclick="toggleMaisMenu()" style="display:flex;flex-direction:column;align-items:center;gap:2px;background:none;border:none;padding:6px 10px;border-radius:10px;flex:1;cursor:pointer">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg>
    <span style="font-size:10px;color:#9ca3af">Mais</span>
  </button>
</nav>
<div id="maisOverlay" onclick="toggleMaisMenu()" style="display:none;position:fixed;inset:0;z-index:498;background:rgba(0,0,0,0.01)"></div>
<div id="maisMenu" style="display:none;position:fixed;bottom:64px;left:0;right:0;background:#fff;border-top:1px solid #e5e5e3;z-index:499;box-shadow:0 -4px 20px rgba(0,0,0,.1);border-radius:16px 16px 0 0;max-height:72vh;overflow-y:auto">
  <div style="padding:6px 14px 18px">
    <div class="mm-sec">Principal</div>
    <a class="mm-row" href="/app/imoveis" onclick="toggleMaisMenu()">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      Meus Imóveis
    </a>
    <a class="mm-row" href="/app/leads/planilha" onclick="toggleMaisMenu()">
      <span style="font-size:17px;line-height:1;width:19px;text-align:center">📊</span>
      Planilha de Leads
    </a>
    <a class="mm-row" href="/app/captacao" onclick="toggleMaisMenu()">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      Captação
    </a>
    <a class="mm-row" href="/app/parceiros" onclick="toggleMaisMenu()">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
      Parceiros
    </a>
    <a class="mm-row" href="/app/notificacoes" onclick="toggleMaisMenu()">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
      Notificações
    </a>

    <div class="mm-sec">Ferramentas</div>
    <a class="mm-row" href="/app/cadastro" onclick="toggleMaisMenu()">
