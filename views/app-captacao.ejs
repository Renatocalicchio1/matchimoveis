<%- include("partials/app-shell",{active:"captacao",user:user}) %>
<style>
.cap-table{width:100%;border-collapse:collapse;font-size:13px}
.cap-table th{background:#f9fafb;padding:10px 12px;text-align:left;border-bottom:2px solid #e5e7eb;font-weight:600;color:#374151}
.cap-table td{padding:10px 12px;border-bottom:1px solid #f3f4f6;color:#111}
.cap-table tr:hover{background:#fafafa}
.badge-captado{background:#f0fdf4;color:#16a34a;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600}
.badge-pendente{background:#fffbeb;color:#92400e;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600}
.btn-cadastrar{background:#FF385C;color:#fff;padding:5px 12px;border-radius:6px;font-size:12px;font-weight:600;text-decoration:none;white-space:nowrap}
</style>
<div style="max-width:1200px;margin:0 auto;padding:24px 16px">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
    <h1 style="font-size:20px;font-weight:700;margin:0">📋 Captação de Imóveis</h1>
    <span style="font-size:13px;color:#6b7280"><%= leads.length %> lead(s) com imóvel para captar</span>
  </div>
<script>
async function marcarCaptado(leadId, tel, nomeEnc){
  const nome = decodeURIComponent(nomeEnc);
  const r = await fetch('/app/captacao/marcar/'+leadId, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({})});
  const d = await r.json();
  const div = document.getElementById('imoveis-'+leadId);
  if(!div) return location.reload();
  if(!d.imoveis || !d.imoveis.length){
    div.innerHTML = '<p style="font-size:12px;color:#6b7280;padding:8px">Nenhum imóvel encontrado para este contato.</p>';
  } else {
    div.innerHTML = '<div style="padding:8px;background:#f9fafb;border-radius:8px;margin-top:6px"><p style="font-size:11px;font-weight:600;color:#374151;margin-bottom:6px">Imóveis encontrados:</p>' +
    d.imoveis.map(i => {
      const link = 'https://matchimoveis.ia.br/imovel/'+(i.id_interno||i.id);
      const msgWA = encodeURIComponent('Olá '+nome+'! Segue o link do seu imóvel cadastrado: '+link);
      const wa = 'https://wa.me/55'+tel.replace(/\D/g,'').replace(/^55/,'')+'?text='+msgWA;
      return '<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:12px">' +
        '<span>🏠 '+i.titulo+'</span>' +
        '<a href="'+wa+'" target="_blank" style="background:#25D366;color:#fff;padding:3px 8px;border-radius:5px;font-size:11px;font-weight:600;text-decoration:none">📲 Enviar</a>' +
        '</div>';
    }).join('') + '</div>';
  }
  div.style.display='block';
}
async function excluirCaptar(leadId){
  if(!confirm('Excluir esta captação?')) return;
  await fetch('/app/lead/'+leadId+'/excluir-captacao', {method:'POST'});
  location.reload();
}
</script>
  <div style="background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:16px;margin-bottom:20px;display:flex;align-items:center;gap:12px">
    <div style="flex:1">
      <p style="font-size:13px;font-weight:600;margin-bottom:4px">🔗 Link de captação para enviar aos seus leads</p>
      <p style="font-size:12px;color:#6b7280">Envie este link para leads que possam ter imóvel para vender ou alugar</p>
      <p style="font-size:11px;color:#9ca3af;margin-top:4px">💡 Leads que tiverem email cadastrado já recebem este link automaticamente por email assim que entram no sistema, seja qual for o canal (WhatsApp, planilha, portal ou manual) — não precisa reenviar pra elas.</p>
      <p style="font-size:11px;color:#9ca3af;margin-top:4px">💡 Leads que tiverem email cadastrado já recebem este link automaticamente por email assim que entram no sistema, seja qual for o canal (WhatsApp, planilha, portal ou manual) — não precisa reenviar pra elas.</p>
    </div>
    <button onclick="copiarLink()" style="background:#FF385C;color:#fff;border:none;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;cursor:pointer">📋 Copiar link</button>
  </div>
  <script>
  function copiarLink(){
    const link = 'https://matchimoveis.ia.br/captar/<%= user.id||user.codigoUsuario %>';
    navigator.clipboard.writeText(link);
    alert('Link copiado!');
  }
  </script>
  <% if(leads.length === 0) { %>
    <div style="text-align:center;padding:60px;color:#9ca3af">
      <div style="font-size:40px;margin-bottom:12px">📋</div>
      <p>Nenhuma lead sinalizou imóvel para captar ainda.</p>
      <p style="font-size:12px">Quando um lead informar que tem imóvel para vender ou alugar, aparecerá aqui.</p>
    </div>
  <% } else { %>
  <div style="overflow-x:auto;background:#fff;border-radius:12px;border:1px solid #e5e7eb">
    <table class="cap-table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Email</th>
          <th>Celular</th>
          <th>Tipo imóvel</th>
          <th>Transação</th>
          <th>Status</th>
          <th>Ação</th>
        </tr>
      </thead>
      <tbody>
        <% leads.forEach(function(l){ 
          const dados = l.dados || {};
          const perfil = l.perfil_ia || {};
          const imovelCaptado = dados.imovelCaptadoId;
        %>
        <tr>
          <td><strong><%= l.nome||'Sem nome' %></strong></td>
          <td><%= l.email||'-' %></td>
          <td><%= l.telefone||l.whatsapp||'-' %></td>
          <td><%= dados.tipoImovelCaptar||perfil.tipo||'-' %></td>
          <td><%= dados.transacaoCaptar||'-' %></td>
          <td>
            <% if(imovelCaptado) { %>
              <span class="badge-captado">✅ Captado</span>
            <% } else { %>
              <span class="badge-pendente">⏳ Pendente</span>
            <% } %>
          </td>
          <td style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
            <% if(!imovelCaptado) { %>
              <a href="https://matchimoveis.onrender.com/app/cadastro" class="btn-cadastrar">+ Cadastrar imóvel</a>
              
              <button onclick="excluirCaptar('<%= l.id %>')" style="background:#fef2f2;color:#dc2626;padding:5px 10px;border-radius:6px;font-size:11px;font-weight:600;border:1px solid #fca5a5;cursor:pointer">🗑️ Excluir</button>
            <% } else { %>
              <a href="https://matchimoveis.onrender.com/app/imovel/<%= imovelCaptado %>/editar" style="color:#2563eb;font-size:12px;margin-right:8px">Editar →</a>
              <a href="https://www.matchimoveis.ia.br/imovel/<%= imovelCaptado %>?userId=<%= user.codigoUsuario||user.id %>" target="_blank" style="color:#16a34a;font-size:12px;font-weight:600">🔗 Link público</a>
              <% const _tel = (l.telefone||l.whatsapp||'').replace(/\D/g,'').replace(/^55/,''); %>
              <% const _linkImovel = 'https://matchimoveis.ia.br/imovel/'+imovelCaptado; %>
              <% const _msgWA = encodeURIComponent('Olá ' + (l.nome||'') + '! Seu imóvel foi cadastrado. Acesse: ' + _linkImovel); %>
              <a href="https://wa.me/55<%= _tel %>?text=<%= _msgWA %>" target="_blank" style="background:#25D366;color:#fff;padding:5px 10px;border-radius:6px;font-size:11px;font-weight:600;text-decoration:none">📲 Enviar link</a>
            <% } %>
          </td>
        </tr>
        <% if(l.imoveisRelacionados && l.imoveisRelacionados.length > 0) { %>
        <tr style="background:#f9fafb">
          <td colspan="7" style="padding:8px 12px">
            <p style="font-size:11px;font-weight:600;color:#374151;margin-bottom:6px">🏠 Imóveis vinculados:</p>
            <% l.imoveisRelacionados.forEach(function(im){ %>
            <% const _tel2 = (l.telefone||l.whatsapp||'').replace(/\D/g,'').replace(/^55/,''); %>
            <% const _link2 = 'https://matchimoveis.ia.br/imovel/'+(im.id_interno||im.id); %>
            <% const _msg2 = encodeURIComponent('Olá '+(l.nome||'')+'! Seu imóvel foi cadastrado. Acesse: '+_link2); %>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:12px">
              <span style="flex:1">🏠 <%= im.titulo||im.tipo %> · <%= im.bairro||'' %> · R$ <%= im.valor_imovel?Number(im.valor_imovel).toLocaleString('pt-BR'):'—' %></span>
              <a href="https://wa.me/55<%= _tel2 %>?text=<%= _msg2 %>" target="_blank" style="background:#25D366;color:#fff;padding:3px 8px;border-radius:5px;font-size:11px;font-weight:600;text-decoration:none;white-space:nowrap">📲 Enviar link</a>
              <a href="https://matchimoveis.onrender.com/app/imovel/<%= im.id_interno||im.id %>/editar" style="color:#2563eb;font-size:11px;font-weight:600;white-space:nowrap">Editar →</a>
              <a href="https://www.matchimoveis.ia.br/imovel/<%= im.id_interno||im.id %>?userId=<%= user.codigoUsuario||user.id %>" target="_blank" style="color:#16a34a;font-size:11px;font-weight:600;white-space:nowrap">🔗 Link →</a>
            </div>
            <% }); %>
          </td>
        </tr>
        <% } %>
        <tr id="imoveis-row-<%= l.id %>" style="display:none">
          <td colspan="7"><div id="imoveis-<%= l.id %>" style="display:none"></div></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
