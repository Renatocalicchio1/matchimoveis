<%- include("partials/app-shell",{active:"home",title:"Dashboard",subtitle:"",user:user}) %>

<style>
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px}
.kpi-card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px;position:relative}
.kpi-card .bar{position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:var(--radius) 0 0 var(--radius)}
.kpi-card .bar.red{background:var(--brand)}
.kpi-card .bar.green{background:#22c55e}
.kpi-card .bar.blue{background:#3b82f6}
.kpi-card .bar.amber{background:#f59e0b}
.kpi-lbl{font-size:11px;font-weight:500;color:var(--text-ter);text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px}
.kpi-num{font-size:28px;font-weight:700;letter-spacing:-1px;line-height:1;color:var(--dark)}
.kpi-num.red{color:var(--brand)}
.kpi-num.green{color:#16a34a}
.kpi-num.blue{color:#2563eb}
.kpi-num.amber{color:#d97706}
.kpi-sub{font-size:11px;color:var(--text-ter);margin-top:4px}

.dash-main{display:grid;grid-template-columns:1.5fr 1fr;gap:14px;margin-bottom:14px}
.section-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.section-hd h3{font-size:13px;font-weight:600;color:var(--dark)}
.section-hd a{font-size:12px;color:var(--brand);text-decoration:none;font-weight:500}

.feed{display:flex;flex-direction:column}
.feed-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border-light)}
.feed-item:last-child{border-bottom:none}
.feed-av{width:32px;height:32px;border-radius:50%;background:var(--bg);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:var(--text-sec);flex-shrink:0}
.feed-body{flex:1;min-width:0}
.feed-nome{font-size:13px;font-weight:500;color:var(--dark);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.feed-desc{font-size:11px;color:var(--text-ter);margin-top:1px}
.feed-badge{padding:2px 8px;border-radius:20px;font-size:10px;font-weight:600;white-space:nowrap}
.feed-badge.match{background:var(--brand-light);color:var(--brand)}
.feed-badge.sem{background:var(--bg);color:var(--text-ter)}

.metrics{display:flex;flex-direction:column;gap:12px}
.metric-item{}
.metric-lbl{display:flex;justify-content:space-between;font-size:12px;color:var(--text-sec);margin-bottom:4px}
.metric-bar{height:4px;background:var(--border-light);border-radius:4px;overflow:hidden}
.metric-fill{height:4px;background:var(--dark);border-radius:4px;transition:width .3s}
.metric-fill.red{background:var(--brand)}
.metric-fill.green{background:#22c55e}

.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.quick-btn{display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:10px;border:1px solid var(--border);background:#fff;text-decoration:none;color:var(--text);transition:all .1s}
.quick-btn:hover{border-color:var(--brand);background:var(--brand-light)}
.quick-btn svg{color:var(--text-ter);flex-shrink:0}
.quick-btn:hover svg{color:var(--brand)}
.quick-lbl strong{display:block;font-size:12px;font-weight:600;color:var(--dark)}
.quick-lbl span{font-size:11px;color:var(--text-ter)}

.charts-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
.chart-card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:18px}

@keyframes pulse-dot{0%,100%{opacity:1}50%{opacity:.3}}
.live-dot{display:inline-block;width:6px;height:6px;background:#22c55e;border-radius:50%;animation:pulse-dot 2s infinite;margin-right:6px;vertical-align:middle}

@media(max-width:768px){
  .kpi-row{grid-template-columns:repeat(2,1fr)!important}
  .dash-main{grid-template-columns:1fr!important}
  .charts-row{grid-template-columns:1fr!important}
  .quick-grid{grid-template-columns:1fr 1fr!important}
}
@media(max-width:480px){
  .kpi-row{grid-template-columns:repeat(2,1fr)!important}
  .quick-grid{grid-template-columns:1fr 1fr!important}
}
</style>

<!-- KPIs -->
<div class="kpi-row">
  <div class="kpi-card">
    <div class="bar red"></div>
    <div class="kpi-lbl">Imóveis ativos</div>
    <div class="kpi-num red"><%= stats.imoveisAtivos %></div>
    <div class="kpi-sub">na carteira</div>
  </div>
  <div class="kpi-card">
    <div class="bar green"></div>
    <div class="kpi-lbl">Matches gerados</div>
    <div class="kpi-num green"><%= stats.matchesGerados %></div>
    <div class="kpi-sub"><%= stats.comMatch %> leads com match</div>
  </div>
  <div class="kpi-card">
    <div class="bar blue"></div>
    <div class="kpi-lbl">Total de leads</div>
    <div class="kpi-num blue"><%= stats.leadsNovos %></div>
    <div class="kpi-sub">Taxa: <%= stats.taxaMatch %>% com match</div>
  </div>
  <div class="kpi-card">
    <div class="bar amber"></div>
    <div class="kpi-lbl">Visitas agendadas</div>
    <div class="kpi-num amber"><%= stats.visitasAgendadas %></div>
    <div class="kpi-sub"><%= stats.visitasHoje %> hoje</div>
  </div>
</div>

<!-- Linha principal -->
<div class="dash-main">
  <!-- Atividade recente -->
  <div class="card">
    <div class="section-hd">
      <h3><span class="live-dot"></span>Atividade recente</h3>
      <a href="/app/leads">Ver todos →</a>
    </div>
    <div class="feed">
      <% if(!recentes || !recentes.length) { %>
        <div style="text-align:center;padding:32px 0;color:var(--text-ter)">
          <div style="font-size:32px;margin-bottom:8px;opacity:.3">👥</div>
          <div style="font-size:13px">Nenhuma atividade ainda</div>
        </div>
      <% } else { %>
        <% recentes.forEach(function(l) {
          var temMatch = l.matches && l.matches.length > 0;
          var bairro = l.bairro || (l.origin && l.origin.bairro) || '';
          var tipo = l.tipo || (l.origin && l.origin.tipo) || '';
          var inicial = (l.nome || l.clientName || 'L').charAt(0).toUpperCase();
        %>
        <div class="feed-item">
          <div class="feed-av"><%= inicial %></div>
          <div class="feed-body">
            <div class="feed-nome"><%= l.nome || l.clientName || 'Lead' %></div>
            <div class="feed-desc"><%= [bairro, tipo].filter(Boolean).join(' · ') || 'Novo lead' %></div>
          </div>
          <% if(temMatch) { %>
            <span class="feed-badge match"><%= l.matches.length %> match</span>
          <% } else { %>
            <span class="feed-badge sem">sem match</span>
          <% } %>
        </div>
        <% }); %>
      <% } %>
    </div>
  </div>

  <!-- Métricas + ações -->
  <div style="display:flex;flex-direction:column;gap:14px">
    <div class="card">
      <div class="section-hd"><h3>Métricas</h3></div>
      <div class="metrics">
        <div class="metric-item">
          <div class="metric-lbl"><span>Taxa de match</span><span><%= stats.taxaMatch %>%</span></div>
          <div class="metric-bar"><div class="metric-fill red" style="width:<%= stats.taxaMatch %>%"></div></div>
        </div>
        <div class="metric-item">
          <% var pctMatch = stats.leadsNovos > 0 ? Math.round(stats.comMatch/stats.leadsNovos*100) : 0; %>
          <div class="metric-lbl"><span>Leads com match</span><span><%= stats.comMatch %>/<%= stats.leadsNovos %></span></div>
          <div class="metric-bar"><div class="metric-fill green" style="width:<%= pctMatch %>%"></div></div>
        </div>
        <div class="metric-item">
          <% var pctVisitas = stats.visitasAgendadas > 0 ? Math.round(stats.visitasHoje/stats.visitasAgendadas*100) : 0; %>
          <div class="metric-lbl"><span>Visitas hoje</span><span><%= stats.visitasHoje %></span></div>
          <div class="metric-bar"><div class="metric-fill" style="width:<%= Math.min(pctVisitas,100) %>%"></div></div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="section-hd"><h3>Ações rápidas</h3></div>
      <div class="quick-grid">
        <a href="/app/leads" class="quick-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
          <div class="quick-lbl"><strong>Leads</strong><span>Gerenciar</span></div>
        </a>
        <a href="/app/imoveis" class="quick-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <div class="quick-lbl"><strong>Imóveis</strong><span>Carteira</span></div>
        </a>
        <a href="/app/cadastro" class="quick-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <div class="quick-lbl"><strong>Cadastrar</strong><span>Novo imóvel</span></div>
        </a>
        <a href="/app/visitas" class="quick-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <div class="quick-lbl"><strong>Visitas</strong><span>Agenda</span></div>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Gráficos -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>



<!-- SCORE DE SAÚDE -->
<div class="chart-card" style="margin-bottom:14px">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
    <div style="font-size:11px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.6px">Saúde da carteira</div>
    <div style="font-size:22px;font-weight:800;color:<%= stats.scoreCarteira>=70?'#10b981':stats.scoreCarteira>=40?'#f59e0b':'#ef4444' %>"><%= stats.scoreCarteira %><span style="font-size:12px;font-weight:500;color:var(--text-ter)">/100</span></div>
  </div>
  <div style="background:#f3f4f6;border-radius:20px;height:8px;overflow:hidden">
    <div style="height:100%;width:<%= stats.scoreCarteira %>%;background:<%= stats.scoreCarteira>=70?'#10b981':stats.scoreCarteira>=40?'#f59e0b':'#ef4444' %>;border-radius:20px;transition:width .5s"></div>
  </div>
  <div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap">
    <% if(stats.imoveisSemFoto>0){ %><div style="font-size:10px;background:#fff7ed;color:#f59e0b;padding:3px 8px;border-radius:20px">📷 <%= stats.imoveisSemFoto %> sem foto</div><% } %>
    <% if(stats.imoveisSemProprietario>0){ %><div style="font-size:10px;background:#fff7ed;color:#f59e0b;padding:3px 8px;border-radius:20px">👤 <%= stats.imoveisSemProprietario %> sem proprietário</div><% } %>
    <% if(stats.imoveisSemFoto===0 && stats.imoveisSemProprietario===0){ %><div style="font-size:10px;background:#f0fdf4;color:#10b981;padding:3px 8px;border-radius:20px">✅ Carteira completa</div><% } %>
  </div>
</div>

<!-- TEMPERATURA DAS LEADS -->
<div class="chart-card" style="margin-bottom:14px">
  <div style="font-size:11px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.6px;margin-bottom:12px">Temperatura das leads</div>
  <div style="display:flex;gap:10px">
    <a href="/app/leads" style="flex:1;text-align:center;background:#fff7ed;border-radius:10px;padding:12px 8px;text-decoration:none">
      <div style="font-size:22px">🔥</div>
      <div style="font-size:20px;font-weight:800;color:#ef4444"><%= stats.leadsQuentes %></div>
      <div style="font-size:9px;color:var(--text-ter);font-weight:600;text-transform:uppercase">Quentes</div>
      <div style="font-size:9px;color:var(--text-ter)">até 2 dias</div>
    </a>
    <a href="/app/leads" style="flex:1;text-align:center;background:#fffbeb;border-radius:10px;padding:12px 8px;text-decoration:none">
      <div style="font-size:22px">🟡</div>
      <div style="font-size:20px;font-weight:800;color:#f59e0b"><%= stats.leadsMornas %></div>
      <div style="font-size:9px;color:var(--text-ter);font-weight:600;text-transform:uppercase">Mornas</div>
      <div style="font-size:9px;color:var(--text-ter)">3 a 7 dias</div>
    </a>
    <a href="/app/leads" style="flex:1;text-align:center;background:#eff6ff;border-radius:10px;padding:12px 8px;text-decoration:none">
      <div style="font-size:22px">❄️</div>
      <div style="font-size:20px;font-weight:800;color:#6366f1"><%= stats.leadsFrias %></div>
      <div style="font-size:9px;color:var(--text-ter);font-weight:600;text-transform:uppercase">Frias</div>
      <div style="font-size:9px;color:var(--text-ter)">mais de 7 dias</div>
    </a>
  </div>
</div>

<!-- PRÓXIMAS VISITAS -->
<% if(stats.proximasVisitas && stats.proximasVisitas.length > 0){ %>
<div class="chart-card" style="margin-bottom:14px">
  <div style="font-size:11px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.6px;margin-bottom:12px">Próximas visitas</div>
  <div style="display:flex;flex-direction:column;gap:8px">
    <% stats.proximasVisitas.forEach(function(v){ %>
    <a href="/app/visitas" style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:<%= v.hoje?'#f0fdf4':'#f9fafb' %>;border-radius:8px;text-decoration:none;border-left:3px solid <%= v.hoje?'#10b981':'#d1d5db' %>">
      <div style="font-size:18px"><%= v.hoje?'📅':'🗓️' %></div>
      <div style="flex:1;min-width:0">
        <div style="font-size:12px;font-weight:600;color:var(--dark);white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= v.nome %></div>
        <div style="font-size:10px;color:var(--text-ter)"><%= v.titulo %> · <%= v.bairro %></div>
      </div>
      <div style="text-align:right;flex-shrink:0">
        <div style="font-size:11px;font-weight:700;color:<%= v.hoje?'#10b981':'var(--text-sec)' %>"><%= v.hoje?'Hoje':'Amanhã' %></div>
        <div style="font-size:10px;color:var(--text-ter)"><%= v.hora %></div>
      </div>
    </a>
    <% }); %>
  </div>
</div>
<% } %>



<!-- BI VISITAS -->
<div class="chart-card" style="margin-bottom:14px">
  <div style="font-size:11px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.6px;margin-bottom:14px">Visitas — painel</div>

  <!-- KPIs visitas -->
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:14px">
    <div style="text-align:center;background:#f0fdf4;border-radius:8px;padding:10px 6px">
      <div style="font-size:20px;font-weight:800;color:#10b981"><%= stats.visitasRealizadasMes %></div>
      <div style="font-size:9px;color:var(--text-ter);font-weight:600;text-transform:uppercase">Realizadas<br>este mês</div>
    </div>
    <div style="text-align:center;background:#eff6ff;border-radius:8px;padding:10px 6px">
      <div style="font-size:20px;font-weight:800;color:#6366f1"><%= stats.visitasTaxaConfirmacao %>%</div>
      <div style="font-size:9px;color:var(--text-ter);font-weight:600;text-transform:uppercase">Taxa de<br>confirmação</div>
    </div>
    <div style="text-align:center;background:<%= stats.visitasRealizadasMes >= stats.visitasRealizadasMesPassado ? '#f0fdf4' : '#fff7ed' %>;border-radius:8px;padding:10px 6px">
      <div style="font-size:20px;font-weight:800;color:<%= stats.visitasRealizadasMes >= stats.visitasRealizadasMesPassado ? '#10b981' : '#f59e0b' %>">
        <%= stats.visitasRealizadasMes >= stats.visitasRealizadasMesPassado ? '↑' : '↓' %><%= stats.visitasRealizadasMesPassado %>
      </div>
      <div style="font-size:9px;color:var(--text-ter);font-weight:600;text-transform:uppercase">Mês<br>anterior</div>
    </div>
  </div>

  <!-- Gráfico status -->
  <canvas id="chartVisitasBI" height="140"></canvas>

  <!-- Imóvel mais visitado -->
  <% if(stats.imovelMaisVisitado){ %>
  <div style="margin-top:12px;display:flex;align-items:center;gap:8px;background:#f9fafb;border-radius:8px;padding:10px 12px">
    <span style="font-size:16px">🏆</span>
    <div>
      <div style="font-size:11px;font-weight:700;color:var(--dark)">Imóvel mais visitado</div>
      <div style="font-size:10px;color:var(--text-ter)"><%= stats.imovelMaisVisitado.titulo %> · <%= stats.imovelMaisVisitado.bairro %> · <%= stats.imovelMaisVisitado.cnt %> visita<%= stats.imovelMaisVisitado.cnt>1?'s':'' %></div>
    </div>
  </div>
  <% } %>
</div>

<!-- ALERTA LEAD MAIS ANTIGA -->
<% if(stats.leadMaisAntigaSemVisita && stats.leadMaisAntigaSemVisita.dias >= 3){ %>
<div class="chart-card" style="margin-bottom:14px;border-left:3px solid #ef4444">
  <div style="display:flex;align-items:center;gap:10px">
    <div style="font-size:20px">⚠️</div>
    <div>
      <div style="font-size:12px;font-weight:700;color:#ef4444">Lead sem atenção há <%= stats.leadMaisAntigaSemVisita.dias %> dias</div>
      <div style="font-size:11px;color:var(--text-ter)"><%= stats.leadMaisAntigaSemVisita.nome %> ainda não tem visita agendada</div>
    </div>
    <a href="/app/leads" style="margin-left:auto;font-size:11px;background:#ef4444;color:white;padding:6px 12px;border-radius:6px;text-decoration:none;font-weight:600;flex-shrink:0">Ver agora</a>
  </div>
</div>
<% } %>

<!-- EVOLUÇÃO SEMANAL -->
<div class="chart-card" style="margin-bottom:14px">
  <div style="font-size:11px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.6px;margin-bottom:12px">Leads por semana</div>
  <canvas id="chartEvolucao" height="120"></canvas>
</div>

<!-- FUNIL DE CONVERSÃO -->
<div class="chart-card" style="margin-bottom:14px">
  <div style="font-size:11px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.6px;margin-bottom:16px">Funil de conversão</div>
  <div style="display:flex;align-items:flex-end;gap:8px;height:90px;margin-bottom:10px">
    <%
      const fSteps = [
        { label: 'Leads', val: stats.funnelLeads, color: '#6366f1' },
        { label: 'Com match', val: stats.funnelMatch, color: '#3b82f6' },
        { label: 'Visita agendada', val: stats.funnelVisitaAgendada, color: '#f59e0b' },
        { label: 'Visita confirmada', val: stats.funnelVisitaConfirmada, color: '#10b981' }
      ];
      const fMax = Math.max(...fSteps.map(f=>f.val), 1);
    %>
    <% fSteps.forEach(function(step){ %>
    <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4px">
      <div style="font-size:12px;font-weight:700;color:var(--dark)"><%= step.val %></div>
      <div style="width:100%;background:<%= step.color %>;border-radius:6px 6px 0 0;height:<%= Math.max(Math.round(step.val/fMax*70),4) %>px;transition:height .3s"></div>
    </div>
    <% }); %>
  </div>
  <div style="display:flex;gap:8px">
    <% fSteps.forEach(function(step){ %>
    <div style="flex:1;text-align:center;font-size:9px;color:var(--text-ter);font-weight:500"><%= step.label %></div>
    <% }); %>
  </div>
  <div style="display:flex;gap:6px;margin-top:12px;flex-wrap:wrap">
    <% if(stats.funnelLeads > 0){ %>
    <div style="font-size:10px;background:#f0f0ff;color:#6366f1;padding:3px 8px;border-radius:20px">Match: <%= stats.funnelPctMatch %>%</div>
    <% } %>
    <% if(stats.funnelMatch > 0){ %>
    <div style="font-size:10px;background:#fff7ed;color:#f59e0b;padding:3px 8px;border-radius:20px">Visita: <%= stats.funnelPctVisita %>%</div>
    <% } %>
    <% if(stats.funnelVisitaAgendada > 0){ %>
    <div style="font-size:10px;background:#f0fdf4;color:#10b981;padding:3px 8px;border-radius:20px">Confirmada: <%= stats.funnelPctConfirmada %>%</div>
    <% } %>
  </div>
</div>

<!-- INSIGHTS INTELIGENTES -->
<% const insights = []; %>
<% if(stats.leadsQuentesSemVisita > 0) insights.push({ icon: '🔥', txt: stats.leadsQuentesSemVisita + ' lead' + (stats.leadsQuentesSemVisita>1?'s':'') + ' com match sem visita agendada', cor: '#fff7ed', link: '/app/leads' }); %>
<% if(stats.imoveisSemLead > 0) insights.push({ icon: '🏠', txt: stats.imoveisSemLead + ' imóvel' + (stats.imoveisSemLead>1?'is':'') + ' sem nenhuma lead ainda', cor: '#f0f0ff', link: '/app/imoveis' }); %>
<% if(stats.bairroMaisDemandado && stats.bairroMaisDemandado !== stats.bairroMaisOferta) insights.push({ icon: '📍', txt: 'Bairro mais demandado: ' + stats.bairroMaisDemandado + ' — reforce seu portfólio lá', cor: '#f0fdf4', link: '/app/imoveis' }); %>
<% if(stats.visitasHoje > 0) insights.push({ icon: '📅', txt: stats.visitasHoje + ' visita' + (stats.visitasHoje>1?'s':'') + ' agendada' + (stats.visitasHoje>1?'s':'') + ' para hoje', cor: '#eff6ff', link: '/app/visitas' }); %>
<% if(insights.length > 0){ %>
<div class="chart-card" style="margin-bottom:14px">
  <div style="font-size:11px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.6px;margin-bottom:12px">Insights</div>
  <div style="display:flex;flex-direction:column;gap:8px">
    <% insights.forEach(function(ins){ %>
    <a href="<%= ins.link %>" style="display:flex;align-items:center;gap:10px;background:<%= ins.cor %>;border-radius:8px;padding:10px 12px;text-decoration:none">
      <span style="font-size:16px"><%= ins.icon %></span>
      <span style="font-size:12px;color:var(--dark);font-weight:500"><%= ins.txt %></span>
      <span style="margin-left:auto;font-size:11px;color:var(--text-ter)">→</span>
    </a>
    <% }); %>
  </div>
</div>
<% } %>

<div class="charts-row">
  <div class="chart-card">
    <div class="section-hd"><h3>Visitas por status</h3></div>
    <canvas id="chartVisitas" height="180"></canvas>
  </div>
  <div class="chart-card">
    <div class="section-hd"><h3>Leads por status</h3></div>
    <canvas id="chartLeads" height="180"></canvas>
  </div>
</div>

<div class="charts-row">
  <div class="chart-card">
    <div class="section-hd"><h3>Imóveis por tipo</h3></div>
    <canvas id="chartImoveisTipo" height="180"></canvas>
  </div>
  <div class="chart-card">
    <div class="section-hd"><h3>Imóveis por bairro</h3></div>
    <canvas id="chartImoveisBairro" height="180"></canvas>
  </div>
</div>

<div class="chart-card" style="margin-bottom:20px">
  <div class="section-hd"><h3>Leads por bairro</h3></div>
  <canvas id="chartLeadsBairro" height="100"></canvas>
</div>

<script>
const PALETTE = ['#111111','#FF385C','#6b7280','#9ca3af','#d1d5db','#374151','#4b5563','#1f2937'];

function makeDonut(id, data) {
  const labels = Object.keys(data), vals = Object.values(data);
  new Chart(document.getElementById(id), {
    type: 'doughnut',
    data: { labels, datasets: [{ data: vals, backgroundColor: PALETTE, borderWidth: 2, borderColor: '#fff' }] },
    options: { plugins: { legend: { position: 'right', labels: { font: { size: 11, family: 'Inter' }, color: '#6b7280', padding: 12 } } }, cutout: '68%' }
  });
}

function makeBar(id, data, horizontal) {
  const labels = Object.keys(data), vals = Object.values(data);
  new Chart(document.getElementById(id), {
    type: 'bar',
    data: { labels, datasets: [{ data: vals, backgroundColor: '#111111', borderRadius: 4, borderSkipped: false }] },
    options: {
      indexAxis: horizontal ? 'y' : 'x',
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false }, ticks: { color: '#9ca3af', font: { size: 10, family: 'Inter' } } },
        y: { grid: { color: '#f3f4f6' }, ticks: { color: '#9ca3af', font: { size: 10, family: 'Inter' } } }
      }
    }
  });
}

const visitasStatus = <%- graficoVisitasStatus %>;
const leadsStatus = <%- graficoLeadsStatus %>;
const imoveisTipo = <%- graficoImoveisTipo %>;
const imoveisBairro = <%- graficoImoveisBairro %>;
const leadsBairro = <%- graficoLeadsBairro %>;

makeDonut('chartVisitas', visitasStatus);
makeDonut('chartLeads', { 'Extraído': leadsStatus.ok||0, 'Incompleto': leadsStatus.incompleto||0, 'Sem status': leadsStatus.semStatus||0 });
makeDonut('chartImoveisTipo', imoveisTipo);
makeBar('chartImoveisBairro', imoveisBairro, true);
makeBar('chartLeadsBairro', leadsBairro, true);
</script>

<%- include('partials/app-end') %>

<style>
.ob-toast{position:fixed;bottom:24px;right:24px;z-index:9999;width:300px;background:#fff;border-radius:14px;box-shadow:0 8px 32px rgba(0,0,0,.15);border:1px solid #f0f0f0;padding:18px 18px 14px;animation:ob-in .3s ease}
@keyframes ob-in{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.ob-icon{font-size:22px;margin-bottom:8px}
.ob-title{font-size:14px;font-weight:700;color:#111827;margin-bottom:4px}
.ob-desc{font-size:12px;color:#6b7280;line-height:1.5;margin-bottom:12px}
.ob-btn{width:100%;padding:8px;border-radius:8px;border:none;background:#111827;color:#fff;font-size:12px;font-weight:600;cursor:pointer}
.ob-skip{display:block;text-align:center;margin-top:8px;font-size:11px;color:#9ca3af;cursor:pointer;background:none;border:none;width:100%}
</style>

<div class="ob-toast" id="ob-toast" style="display:none">
  <div class="ob-icon" id="ob-icon"></div>
  <div class="ob-title" id="ob-title"></div>
  <div class="ob-desc" id="ob-desc"></div>
  <button class="ob-btn" onclick="obFechar()">Já fiz isso ✓</button>
  <button class="ob-skip" onclick="obDepois()">Lembrar depois</button>
</div>

<script>
(function(){
  const passos = [
    {
      key: 'ob_whatsapp',
      icon: '📱',
      title: 'Conecte seu WhatsApp',
      desc: 'Acesse o menu lateral → Perfil para conectar seu número. Sem isso o sistema não recebe leads automaticamente.'
    },
    {
      key: 'ob_imoveis',
      icon: '🏠',
      title: 'Cadastre ou importe imóveis',
      desc: 'Acesse o menu lateral → Cadastrar Imóveis. Sem imóveis cadastrados não há match possível.'
    }
  ];

  function obProximo() {
    for (var i = 0; i < passos.length; i++) {
      var p = passos[i];
      if (!localStorage.getItem(p.key + '_done')) {
        document.getElementById('ob-icon').textContent = p.icon;
        document.getElementById('ob-title').textContent = p.title;
        document.getElementById('ob-desc').textContent = p.desc;
        document.getElementById('ob-toast').dataset.key = p.key;
        document.getElementById('ob-toast').style.display = 'block';
        return;
      }
    }
  }

  window.obFechar = function() {
    var key = document.getElementById('ob-toast').dataset.key;
    localStorage.setItem(key + '_done', '1');
    document.getElementById('ob-toast').style.display = 'none';
    setTimeout(obProximo, 500);
  };

  window.obDepois = function() {
    document.getElementById('ob-toast').style.display = 'none';
    setTimeout(obProximo, 5 * 60 * 1000);
  };

  setTimeout(obProximo, 1500);
})();
</script>
