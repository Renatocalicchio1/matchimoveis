<%- include('partials/app-shell', {active:'ranking',title:'Ranking',subtitle:'',user:user}) %>
<style>
.rk-wrap{max-width:520px}
.rk-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.rk-head h2{font-size:17px;font-weight:700;color:var(--dark)}
.rk-you{background:#fdf3f4;border:1px solid #fbdde1;border-radius:14px;padding:18px 20px;display:flex;align-items:center;gap:16px;margin-bottom:20px}
.rk-you .pos{font-size:30px;font-weight:800;color:#b3212f;font-variant-numeric:tabular-nums;line-height:1}
.rk-you .ctx{font-size:13px;color:var(--text-sec);line-height:1.5}
.rk-you .ctx b{color:var(--text)}
.rk-factors{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
.rk-factor{background:#fff;border:1px solid var(--border);border-radius:10px;padding:8px 12px;font-size:12px;color:var(--text-sec)}
.rk-factor b{color:var(--text);font-variant-numeric:tabular-nums}
.rk-list{background:var(--white);border:1px solid var(--border);border-radius:14px;overflow:hidden}
.rk-li{display:flex;align-items:center;gap:12px;padding:13px 18px;border-bottom:1px solid var(--border-light)}
.rk-li:last-child{border-bottom:none}
.rk-li .p{width:24px;font-weight:800;color:var(--text-ter);font-variant-numeric:tabular-nums;flex-shrink:0}
.rk-li .nm{flex:1;font-weight:600;color:var(--text)}
.rk-li .bd{font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:999px;color:#fff;flex-shrink:0}
.rk-empty{text-align:center;padding:40px 20px;color:var(--text-ter);font-size:13px}
.rk-optin{background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:14px 16px;font-size:12.5px;color:var(--text-sec);margin-top:18px;line-height:1.6}
.rk-optin a{color:var(--brand);font-weight:600;text-decoration:none}
</style>

<div class="rk-wrap">
  <div class="rk-head"><h2>📊 Ranking Regional</h2></div>

  <% if (!posicao) { %>
    <div class="rk-list"><div class="rk-empty">Ainda não há corretores suficientes na sua região + tipo de conta pra gerar uma comparação — ou você ainda não teve nenhuma visita/lead registrada. Volte aqui depois que sua carteira estiver mais ativa.</div></div>
  <% } else { %>
    <div class="rk-you">
      <div class="pos"><%= posicao.posicao %>º</div>
      <div class="ctx">de <b><%= posicao.totalGrupo %></b> corretores <%= posicao.tipo %> em<br><b><%= posicao.estado %></b></div>
    </div>
    <div class="rk-factors">
      <div class="rk-factor">Confirmação de visita: <b><%= posicao.taxaConfirmacao %>%</b></div>
      <div class="rk-factor">Conversão em negócio: <b><%= posicao.taxaConversao %>%</b></div>
    </div>

    <h2 style="font-size:14px;font-weight:700;color:var(--dark);margin:26px 0 12px">Top da sua região</h2>
    <% if (!top.length) { %>
      <div class="rk-list"><div class="rk-empty">Ninguém na sua região optou por aparecer na lista pública ainda.</div></div>
    <% } else { %>
    <div class="rk-list">
      <% top.forEach(function(t, i){ %>
      <div class="rk-li">
        <span class="p"><%= i+1 %>º</span>
        <span class="nm"><%= t.nome %></span>
        <span class="bd" style="background:<%= t.nivel==='MASTER'?'#FF385C':t.nivel==='ELITE'?'#FC642D':t.nivel==='PRO'?'#00A699':t.nivel==='ATIVO'?'#5fb8b0':'#9ca3af' %>"><%= t.nivel %></span>
      </div>
      <% }) %>
    </div>
    <% } %>
  <% } %>

  <div class="rk-optin">
    <% if (optIn) { %>
      ✅ Você optou por aparecer na lista pública da sua região. Pode mudar isso a qualquer momento em <a href="/app/perfil">seu perfil</a>.
    <% } else { %>
      🔒 Sua posição é privada — só você vê. Pra aparecer na lista pública acima, ative em <a href="/app/perfil">seu perfil</a>.
    <% } %>
  </div>
</div>
<%- include('partials/app-end') %>
