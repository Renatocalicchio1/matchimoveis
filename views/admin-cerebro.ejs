<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin — Cérebro do Assistente</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f5f5f3;color:#111827;font-size:14px}
header{background:#111827;color:#fff;padding:16px 24px;display:flex;align-items:center;gap:16px;position:sticky;top:0;z-index:100}
header h1{font-size:16px;font-weight:500}
header .badge{background:#FF385C;color:#fff;font-size:11px;padding:2px 8px;border-radius:20px}
.tabs{display:flex;gap:0;border-bottom:1px solid #e5e5e3;background:#fff;padding:0 24px;position:sticky;top:53px;z-index:99}
.tab{padding:12px 20px;font-size:13px;font-weight:500;cursor:pointer;border-bottom:2px solid transparent;color:#6b7280;background:none;border-top:none;border-left:none;border-right:none}
.tab.ativo{color:#FF385C;border-bottom-color:#FF385C}
.content{padding:24px;max-width:1100px;margin:0 auto 0 calc(var(--sidebar-w) + 24px)}
@media(max-width:900px){ .content{margin-left:auto} }
.modo-revisao-bar{margin-left:var(--sidebar-w)}
@media(max-width:900px){ .modo-revisao-bar{margin-left:0} }
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px}
.stat{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:16px;text-align:center}
.stat-n{font-size:28px;font-weight:500;color:#111827}
.stat-l{font-size:12px;color:#6b7280;margin-top:4px}
.search{width:100%;padding:10px 14px;border:1px solid #e5e5e3;border-radius:10px;font-size:14px;margin-bottom:16px;background:#fff}
.item{background:#fff;border:1px solid #e5e5e3;border-radius:10px;padding:14px 16px;margin-bottom:8px;display:flex;gap:12px;align-items:flex-start}
.item-body{flex:1;min-width:0}
.item-p{font-weight:500;font-size:13px;color:#111827;margin-bottom:4px}
.item-r{font-size:12px;color:#6b7280;line-height:1.5}
.item-cat{font-size:10px;color:#9ca3af;margin-bottom:6px}
.item-actions{display:flex;gap:6px;flex-shrink:0}
.btn{padding:6px 12px;border-radius:8px;font-size:12px;font-weight:500;cursor:pointer;border:1px solid #e5e5e3;background:#fff;color:#374151}
.btn:hover{background:#f9f9f7}
.btn-ok{background:#f0fdf4;color:#15803d;border-color:#bbf7d0}
.btn-err{background:#fef2f2;color:#dc2626;border-color:#fecaca}
.btn-edit{background:#e6f7f5;color:#00695c;border-color:#99d9d1}
.btn-del{background:#fef2f2;color:#dc2626;border-color:#fecaca}
.btn-save{background:#FF385C;color:#fff;border:none;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:200;align-items:center;justify-content:center}
.modal.open{display:flex}
.modal-box{background:#fff;border-radius:16px;padding:24px;width:560px;max-width:95vw;max-height:90vh;overflow-y:auto}
.modal-box h2{font-size:16px;font-weight:500;margin-bottom:16px}
.field{margin-bottom:14px}
.field label{display:block;font-size:12px;color:#6b7280;margin-bottom:4px;font-weight:500}
.field input,.field textarea{width:100%;padding:10px 12px;border:1px solid #e5e5e3;border-radius:8px;font-size:13px;font-family:inherit}
.field textarea{min-height:80px;resize:vertical}
.modal-btns{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}
.badge-ok{display:inline-block;background:#f0fdf4;color:#15803d;font-size:10px;padding:2px 6px;border-radius:4px}
.badge-err{display:inline-block;background:#fef2f2;color:#dc2626;font-size:10px;padding:2px 6px;border-radius:4px}
.pag{display:flex;gap:8px;margin-top:16px;align-items:center;justify-content:center}
.pag button{padding:6px 12px;border:1px solid #e5e5e3;border-radius:8px;background:#fff;cursor:pointer;font-size:12px}
.pag button.ativo{background:#111827;color:#fff;border-color:#111827}
.secao{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:16px;margin-bottom:12px}
.secao-titulo{font-size:13px;font-weight:500;margin-bottom:12px;color:#111827}
.secao-rota{font-size:11px;color:#6b7280;margin-bottom:8px}
.passo{display:flex;gap:8px;align-items:flex-start;margin-bottom:6px}
.passo-num{background:#FF385C;color:#fff;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0;margin-top:2px}
.hidden{display:none}
<%- adminShellCss %>
header{margin-left:var(--sidebar-w)}
.tabs{margin-left:var(--sidebar-w)}
@media(max-width:900px){ header,.tabs{margin-left:0} }
</style>
</head>
<body>
<div class="admin-app">
<%- adminSidebar %>

<header>
  <div>
    <h1>Cérebro do Assistente <span class="badge">Admin</span></h1>
  </div>
  <div style="margin-left:auto;display:flex;gap:12px;align-items:center">
    <span style="font-size:12px;color:#9ca3af">Base: <strong style="color:#fff"><%=totalBase%></strong> pares</span>
  </div>
</header>

<div class="modo-revisao-bar" style="background:#fff;border-bottom:1px solid #e5e5e3;padding:12px 24px;display:flex;gap:8px;align-items:center">
  <span style="font-size:13px;font-weight:500;color:#374151;margin-right:8px">Modo revisão:</span>
  <button onclick="iniciarRevisao('tudo')" style="background:#FF385C;color:#fff;border:none;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer">▶ Revisar tudo</button>
  <button onclick="iniciarRevisao('base')" style="background:#fff;border:1px solid #e5e5e3;padding:8px 16px;border-radius:8px;font-size:13px;cursor:pointer">Base de conhecimento</button>
  <button onclick="iniciarRevisao('paginas')" style="background:#fff;border:1px solid #e5e5e3;padding:8px 16px;border-radius:8px;font-size:13px;cursor:pointer">Páginas</button>
  <button onclick="iniciarRevisao('fluxos')" style="background:#fff;border:1px solid #e5e5e3;padding:8px 16px;border-radius:8px;font-size:13px;cursor:pointer">Fluxos</button>
</div>
<div class="tabs">
  <button class="tab ativo" onclick="mudarAba('base')">Base de conhecimento (<%= modulos.base_conhecimento.length %>)</button>
  <button class="tab" onclick="mudarAba('paginas')">Páginas (<%= modulos.paginas.length %>)</button>
  <button class="tab" onclick="mudarAba('fluxos')">Fluxos (<%= modulos.fluxos.length %>)</button>
  <button class="tab" onclick="mudarAba('novo')">+ Novo par</button>
</div>

<div class="content">

  <div class="stats">
    <div class="stat"><div class="stat-n" id="cnt-total"><%=modulos.base_conhecimento.length%></div><div class="stat-l">Total pares</div></div>
    <div class="stat"><div class="stat-n" style="color:#15803d" id="cnt-ok">0</div><div class="stat-l">Aprovados</div></div>
    <div class="stat"><div class="stat-n" style="color:#dc2626" id="cnt-err">0</div><div class="stat-l">Com problema</div></div>
    <div class="stat"><div class="stat-n" id="cnt-pct">0%</div><div class="stat-l">Revisados</div></div>
  </div>

  <!-- ABA BASE -->
  <div id="aba-base">
    <input class="search" type="text" placeholder="Buscar pergunta ou resposta..." oninput="filtrar(this.value)" id="busca">
    <div id="lista-base"></div>
    <div class="pag" id="paginacao"></div>
  </div>

  <!-- ABA PÁGINAS -->
  <div id="aba-paginas" class="hidden">
    <% modulos.paginas.forEach(p => { %>
    <div class="secao">
      <div class="secao-titulo"><%= p.titulo %></div>
      <div class="secao-rota"><%= p.rota %></div>
      <% if(p.oque_tem && p.oque_tem.length) { %>
        <div style="font-size:12px;color:#374151;margin-bottom:8px"><strong>O que tem:</strong><br><%= p.oque_tem.map(i=>'• '+i).join('<br>') %></div>
      <% } %>
      <% if(p.botoes && p.botoes.length) { %>
        <div style="font-size:12px;color:#374151"><strong>Ações:</strong> <%= p.botoes.join(', ') %></div>
      <% } %>
      <div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:4px">
        <% p.keywords.slice(0,6).forEach(k => { %><span style="background:#f3f4f6;color:#374151;font-size:10px;padding:2px 6px;border-radius:4px"><%= k %></span><% }) %>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- ABA FLUXOS -->
  <div id="aba-fluxos" class="hidden">
    <% modulos.fluxos.forEach(f => { %>
    <div class="secao">
      <div class="secao-titulo"><%= f.titulo %></div>
      <div class="secao-rota"><%= f.rota %></div>
      <% f.passos.forEach((p,i) => { %>
        <div class="passo"><div class="passo-num"><%= i+1 %></div><div style="font-size:12px;color:#374151"><%= p %></div></div>
      <% }) %>
    </div>
    <% }) %>
  </div>

  <!-- ABA NOVO -->
  <div id="aba-novo" class="hidden">
    <div style="background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:20px;max-width:560px">
      <h2 style="font-size:15px;font-weight:500;margin-bottom:16px">Adicionar novo par pergunta/resposta</h2>
      <div class="field"><label>Pergunta (como o usuário digita)</label><input type="text" id="novo-p" placeholder="ex: como exporto imoveis"></div>
      <div class="field"><label>Intenção / Resposta</label><input type="text" id="novo-r" placeholder="ex: exportar ou texto de resposta"></div>
      <button class="btn-save" onclick="salvarNovo()">Salvar</button>
    </div>
  </div>

</div>

<!-- MODAL EDITAR -->
<div class="modal" id="modal">
  <div class="modal-box">
    <h2>Editar par</h2>
    <div class="field"><label>Pergunta</label><input type="text" id="edit-p"></div>
    <div class="field"><label>Resposta / Intenção</label><textarea id="edit-r"></textarea></div>
    <input type="hidden" id="edit-id-original">
    <div class="modal-btns">
      <button class="btn" onclick="fecharModal()">Cancelar</button>
      <button class="btn-save" onclick="salvarEdicao()">Salvar</button>
    </div>
  </div>
</div>

<script>
const BASE = <%- JSON.stringify(modulos.base_conhecimento) %>;
let filtrado = [...BASE];
let pagAtual = 0;
const POR_PAG = 30;
let revisados = {ok:0, err:0};

function mudarAba(aba) {
  ['base','paginas','fluxos','novo'].forEach(a => {
    document.getElementById('aba-'+a).classList.toggle('hidden', a!==aba);
  });
  document.querySelectorAll('.tab').forEach((t,i) => {
    t.classList.toggle('ativo', ['base','paginas','fluxos','novo'][i]===aba);
  });
}

function filtrar(q) {
  pagAtual = 0;
  if (!q) { filtrado = [...BASE]; }
  else {
    const ql = q.toLowerCase();
    filtrado = BASE.filter(i => (i.p||'').toLowerCase().includes(ql) || (i.r||'').toLowerCase().includes(ql));
  }
  renderLista();
}

function renderLista() {
  const total = filtrado.length;
  const inicio = pagAtual * POR_PAG;
  const fim = Math.min(inicio + POR_PAG, total);
  const pagina = filtrado.slice(inicio, fim);

  document.getElementById('lista-base').innerHTML = pagina.map(function(item, i) {
    const idx = inicio + i;
    const variacoes = item.variacoes && item.variacoes.length 
      ? '<div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:4px">' +
        item.variacoes.map(function(v){ return '<span style="background:#f3f4f6;color:#6b7280;font-size:10px;padding:2px 8px;border-radius:20px">'+v+'</span>'; }).join('') +
        '</div>' 
      : '';
    return '<div class="item" id="item-'+idx+'">' +
      '<div class="item-body">' +
        (item._status ? '<span class="badge-'+(item._status==='ok'?'ok':'err')+'">'+(item._status==='ok'?'✓ Ok':'✗ Problema')+'</span> ' : '') +
        '<div class="item-p">"' + (item.p||'') + '"</div>' +
        '<div class="item-r">' + (item.r||'') + '</div>' +
        variacoes +
        '<div id="tr-'+idx+'" style="display:none;margin-top:8px;padding:8px;background:#e6f7f5;border-radius:8px;font-size:12px;color:#374151;line-height:1.5"></div>' +
      '</div>' +
      '<div class="item-actions">' +
        '<button class="btn" style="background:#e6f7f5;color:#00695c;border-color:#99d9d1;font-size:11px" onclick="testarItem('+idx+', this)">▶ Testar</button>' +
        '<button class="btn btn-edit" style="font-size:11px" onclick="abrirModal('+idx+')">✎ Editar</button>' +
        '<button class="btn btn-del" aria-label="Excluir" style="font-size:11px" onclick="deletar('+idx+')">🗑</button>' +
      '</div>' +
    '</div>';
  }).join('');

  const totalPags = Math.ceil(total / POR_PAG);
  let pags = '<span style="font-size:12px;color:#6b7280">' + (inicio+1) + '-' + fim + ' de ' + total + '</span>';
  if (pagAtual > 0) pags += '<button onclick="irPag('+(pagAtual-1)+')">← Anterior</button>';
  for (let p = Math.max(0,pagAtual-2); p <= Math.min(totalPags-1,pagAtual+2); p++) {
    pags += '<button class="'+(p===pagAtual?'ativo':'')+'" onclick="irPag('+p+')">'+(p+1)+'</button>';
  }
  if (pagAtual < totalPags-1) pags += '<button onclick="irPag('+(pagAtual+1)+')">Próximo →</button>';
  document.getElementById('paginacao').innerHTML = pags;
}
function irPag(p) { pagAtual = p; renderLista(); window.scrollTo(0,200); }

function marcar(idx, status) {
  filtrado[idx]._status = status;
  if (status === 'ok') revisados.ok++;
  else revisados.err++;
  atualizarStats();
  renderLista();
}

function atualizarStats() {
  const total = revisados.ok + revisados.err;
  document.getElementById('cnt-ok').textContent = revisados.ok;
  document.getElementById('cnt-err').textContent = revisados.err;
  document.getElementById('cnt-pct').textContent = total > 0 ? Math.round(revisados.ok/total*100)+'%' : '0%';
}

function abrirModal(idx) {
  const item = filtrado[idx];
  document.getElementById('edit-p').value = item.p || '';
  document.getElementById('edit-r').value = item.r || '';
  document.getElementById('edit-id-original').value = item.p || '';
  document.getElementById('modal').classList.add('open');
}

function fecharModal() { document.getElementById('modal').classList.remove('open'); }

async function testar(pergunta, btn) {
  const idx = btn.closest('.item').id.replace('item-','');
  const resultDiv = document.getElementById('teste-result-'+idx);
  btn.textContent = '⏳';
  btn.disabled = true;
  
  try {
    const res = await fetch('/admin/cerebro/testar', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ pergunta })
    });
    const json = await res.json();
    resultDiv.style.display = 'block';
    resultDiv.innerHTML = '<strong style="color:#00695c">Resposta do assistente:</strong><br>' + 
      (json.resposta || json.erro || 'Sem resposta').replace(/<[^>]+>/g,'').slice(0,300);
  } catch(e) {
    resultDiv.style.display = 'block';
    resultDiv.innerHTML = '<span style="color:#dc2626">Erro: ' + e.message + '</span>';
  }
  
  btn.textContent = '▶ Testar';
  btn.disabled = false;
}

async function testarItem(idx, btn) {
  const item = filtrado[idx];
  if (!item) return;
  const div = document.getElementById('tr-'+idx);
  btn.textContent = '⏳';
  btn.disabled = true;
  try {
    const res = await fetch('/admin/cerebro/testar', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ pergunta: item.p })
    });
    const json = await res.json();
    div.style.display = 'block';
    div.innerHTML = '<strong style="color:#00695c">Resposta:</strong> ' + 
      (json.resposta||json.erro||'Sem resposta').replace(/<[^>]+>/g,'').slice(0,300);
  } catch(e) {
    div.style.display = 'block';
    div.innerHTML = '<span style="color:red">Erro: ' + e.message + '</span>';
  }
  btn.textContent = '▶ Testar';
  btn.disabled = false;
}

async function salvarEdicao() {
  const idOriginal = document.getElementById('edit-id-original').value;
  const novoP = document.getElementById('edit-p').value.trim();
  const novoR = document.getElementById('edit-r').value.trim();
  if (!novoP || !novoR) return alert('Preencha os dois campos');
  
  const res = await fetch('/admin/cerebro/salvar', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ tipo:'base', id: idOriginal, dados: { p: novoP, r: novoR } })
  });
  const json = await res.json();
  if (json.ok) {
    const item = filtrado.find(i => i.p === idOriginal);
    if (item) { item.p = novoP; item.r = novoR; }
    fecharModal();
    renderLista();
  } else { alert('Erro: ' + json.erro); }
}

async function deletar(idx) {
  const item = filtrado[idx];
  if (!confirm('Deletar "' + item.p + '"?')) return;
  const res = await fetch('/admin/cerebro/salvar', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ tipo:'deletar_base', id: item.p })
  });
  const json = await res.json();
  if (json.ok) { filtrado.splice(idx,1); renderLista(); }
  else alert('Erro: ' + json.erro);
}

async function salvarNovo() {
  const p = document.getElementById('novo-p').value.trim();
  const r = document.getElementById('novo-r').value.trim();
  if (!p || !r) return alert('Preencha pergunta e resposta');
  const res = await fetch('/admin/cerebro/salvar', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ tipo:'base', id: p, dados: { p, r } })
  });
  const json = await res.json();
  if (json.ok) {
    BASE.push({ p, r });
    filtrado = [...BASE];
    document.getElementById('novo-p').value = '';
    document.getElementById('novo-r').value = '';
    document.getElementById('cnt-total').textContent = BASE.length;
    mudarAba('base');
    renderLista();
  } else alert('Erro: ' + json.erro);
}

document.getElementById('modal').addEventListener('click', function(e) {
  if (e.target === this) fecharModal();
});
document.getElementById('modal-revisao').addEventListener('click', function(e) {
  if (e.target === this) fecharRevisao();
});

renderLista();
</script>
</div>
</body>
</html>

<script>
// MODO REVISÃO
let modoRevisao = false;
let filaRevisao = [];
let idxRevisao = 0;
let resultadosRevisao = { ok:0, erro:0, correcoes:[] };

function iniciarRevisao(tipo) {
  modoRevisao = true;
  idxRevisao = 0;
  resultadosRevisao = { ok:0, erro:0, correcoes:[] };
  
  if (tipo === 'base') {
    filaRevisao = filtrado.map((item,i) => ({ tipo:'base', idx:i, p:item.p, r:item.r, cat:'Base de conhecimento' }));
  } else if (tipo === 'paginas') {
    filaRevisao = <%- JSON.stringify(modulos.paginas) %>.map(p => ({
      tipo:'pagina', p:'O que tem em: ' + p.titulo + ' (' + p.rota + ')',
      r: (p.oque_tem||[]).join(' • ') || '—',
      cat:'Página', id:p.id, dados:p
    }));
  } else if (tipo === 'fluxos') {
    filaRevisao = <%- JSON.stringify(modulos.fluxos) %>.map(f => ({
      tipo:'fluxo', p:'Fluxo: ' + f.titulo,
      r: (f.passos||[]).map((p,i)=>(i+1)+'. '+p).join('\n'),
      cat:'Fluxo', id:f.id, dados:f
    }));
  } else if (tipo === 'tudo') {
    const base = filtrado.map((item,i) => ({ tipo:'base', idx:i, p:item.p, r:item.r, cat:'Base' }));
    const pags = <%- JSON.stringify(modulos.paginas) %>.map(p => ({
      tipo:'pagina', p:'O que tem em: '+p.titulo+' ('+p.rota+')',
      r:(p.oque_tem||[]).join(' • ')||'—', cat:'Página', id:p.id
    }));
    const flux = <%- JSON.stringify(modulos.fluxos) %>.map(f => ({
      tipo:'fluxo', p:'Fluxo: '+f.titulo,
      r:(f.passos||[]).map((p,i)=>(i+1)+'. '+p).join('\n'), cat:'Fluxo', id:f.id
    }));
    filaRevisao = [...base, ...pags, ...flux];
  }
  
  // Embaralha
  filaRevisao.sort(() => Math.random() - 0.5);
  
  mostrarRevisao();
  document.getElementById('modal-revisao').classList.add('open');
}

function mostrarRevisao() {
  if (idxRevisao >= filaRevisao.length) {
    finalizarRevisao();
    return;
  }
  
  const item = filaRevisao[idxRevisao];
  const total = filaRevisao.length;
  const pct = Math.round(idxRevisao/total*100);
  
  document.getElementById('rev-cat').textContent = item.cat + ' · ' + (idxRevisao+1) + '/' + total;
  document.getElementById('rev-pergunta').textContent = item.p;
  document.getElementById('rev-resposta').textContent = item.r;
  document.getElementById('rev-edit').value = item.r;
  document.getElementById('rev-edit').style.display = 'none';
  document.getElementById('rev-progbar').style.width = pct + '%';
  document.getElementById('rev-stats').textContent = '✅ ' + resultadosRevisao.ok + '  ❌ ' + resultadosRevisao.erro;
  document.getElementById('rev-modo-edicao').style.display = 'none';
  document.getElementById('rev-modo-normal').style.display = 'block';
}

function avaliarRevisao(resultado) {
  const item = filaRevisao[idxRevisao];
  
  if (resultado === 'ok') {
    resultadosRevisao.ok++;
    idxRevisao++;
    mostrarRevisao();
  } else if (resultado === 'erro') {
    // Mostrar modo edição
    document.getElementById('rev-modo-normal').style.display = 'none';
    document.getElementById('rev-modo-edicao').style.display = 'block';
    document.getElementById('rev-edit').style.display = 'block';
    document.getElementById('rev-edit').focus();
  } else if (resultado === 'pular') {
    idxRevisao++;
    mostrarRevisao();
  }
}

async function salvarCorrecao() {
  const item = filaRevisao[idxRevisao];
  const novaResposta = document.getElementById('rev-edit').value.trim();
  
  if (!novaResposta) return;
  
  // Salvar no servidor
  if (item.tipo === 'base') {
    await fetch('/admin/cerebro/salvar', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ tipo:'base', id: item.p, dados: { p: item.p, r: novaResposta } })
    });
    if (item.idx !== undefined) filtrado[item.idx].r = novaResposta;
  }
  
  resultadosRevisao.erro++;
  resultadosRevisao.correcoes.push({ p: item.p, original: item.r, novo: novaResposta });
  idxRevisao++;
  mostrarRevisao();
}

function finalizarRevisao() {
  const total = resultadosRevisao.ok + resultadosRevisao.erro;
  const pct = total > 0 ? Math.round(resultadosRevisao.ok/total*100) : 0;
  
  document.getElementById('rev-resultado').innerHTML = 
    '<div style="text-align:center;padding:1rem">' +
    '<div style="font-size:48px;margin-bottom:12px">' + (pct>=90?'🎉':pct>=70?'👍':'⚠️') + '</div>' +
    '<div style="font-size:20px;font-weight:500;margin-bottom:8px">' + pct + '% aprovado</div>' +
    '<div style="font-size:13px;color:#6b7280;margin-bottom:16px">✅ ' + resultadosRevisao.ok + ' corretos · ❌ ' + resultadosRevisao.erro + ' corrigidos</div>' +
    (resultadosRevisao.correcoes.length ? 
      '<div style="text-align:left;max-height:200px;overflow-y:auto"><p style="font-size:12px;font-weight:500;margin-bottom:8px">Correções salvas:</p>' +
      resultadosRevisao.correcoes.map(c => '<div style="background:#fef2f2;border-radius:8px;padding:8px;margin-bottom:4px;font-size:12px"><strong>"'+c.p+'"</strong><br>→ '+c.novo+'</div>').join('') +
      '</div>' : '') +
    '<button onclick="fecharRevisao()" style="margin-top:16px;background:#111827;color:#fff;border:none;padding:10px 24px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer">Fechar</button>' +
    '</div>';
    
  document.getElementById('rev-conteudo').style.display = 'none';
  document.getElementById('rev-resultado').style.display = 'block';
}

async function testarRevisao() {
  const item = filaRevisao[idxRevisao];
  if (!item) return;
  const btn = document.getElementById('btn-testar-rev');
  const div = document.getElementById('rev-teste-result');
  btn.textContent = '⏳';
  btn.disabled = true;
  
  try {
    const res = await fetch('/admin/cerebro/testar', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ pergunta: item.p.replace('O que tem em: ','').replace('Fluxo: ','') })
    });
    const json = await res.json();
    div.style.display = 'block';
    div.innerHTML = '<strong style="color:#00695c">Resposta ao vivo:</strong><br>' + 
      (json.resposta||'').replace(/<[^>]+>/g,'').slice(0,400);
  } catch(e) {
    div.style.display = 'block';
    div.innerHTML = '<span style="color:#dc2626">Erro: ' + e.message + '</span>';
  }
  
  btn.textContent = '▶ Testar ao vivo';
  btn.disabled = false;
}

function fecharRevisao() {
  document.getElementById('modal-revisao').classList.remove('open');
  document.getElementById('rev-conteudo').style.display = 'block';
  document.getElementById('rev-resultado').style.display = 'none';
  renderLista();
}
</script>

<!-- MODAL REVISÃO -->
<div class="modal" id="modal-revisao">
  <div class="modal-box" style="width:640px">
    <div id="rev-conteudo">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
        <div style="font-size:11px;color:#6b7280" id="rev-cat"></div>
        <div style="font-size:12px;color:#6b7280" id="rev-stats"></div>
      </div>
      <div style="height:4px;background:#f0f0ee;border-radius:4px;margin-bottom:16px">
        <div id="rev-progbar" style="height:4px;background:#FF385C;border-radius:4px;transition:width .3s;width:0%"></div>
      </div>
      <div style="background:#f9f9f7;border-radius:10px;padding:14px;margin-bottom:12px">
        <div style="font-size:11px;color:#9ca3af;margin-bottom:6px">Pergunta / Tópico</div>
        <div style="font-size:15px;font-weight:500;color:#111827" id="rev-pergunta"></div>
      </div>
      <div style="background:#fff;border:1px solid #e5e5e3;border-radius:10px;padding:14px;margin-bottom:16px">
        <div style="font-size:11px;color:#9ca3af;margin-bottom:6px">Resposta / Conteúdo esperado</div>
        <div style="font-size:13px;color:#374151;line-height:1.6;white-space:pre-line" id="rev-resposta"></div>
      </div>
      <textarea id="rev-edit" style="width:100%;padding:10px;border:1px solid #FF385C;border-radius:8px;font-size:13px;min-height:80px;font-family:inherit;margin-bottom:12px;resize:vertical" placeholder="Edite a resposta correta aqui..."></textarea>
      
      <div style="display:flex;gap:8px;margin-bottom:12px;align-items:center"><button class="btn" onclick="if(idxRevisao>0){idxRevisao--;mostrarRevisao()}">← Anterior</button><button class="btn" onclick="idxRevisao++;mostrarRevisao()" style="background:#111827;color:#fff;border-color:#111827">Próximo →</button><button class="btn" style="background:#e6f7f5;color:#00695c;border-color:#99d9d1" onclick="testarRevisao()">▶ Testar</button><button class="btn" onclick="fecharRevisao()" style="margin-left:auto">✕ Fechar</button></div><div id="rev-modo-normal">
        <div style="display:flex;gap:8px">
          <button class="btn-ok" style="flex:1;padding:12px" onclick="avaliarRevisao('ok')">✅ Correto</button>
          <button class="btn-err" style="flex:1;padding:12px" onclick="avaliarRevisao('erro')">✏️ Editar</button>
          <button class="btn" onclick="avaliarRevisao('pular')">Pular</button>
        </div>
      </div>
      
      <div id="rev-modo-edicao" style="display:none">
        <div style="display:flex;gap:8px">
          <button class="btn-save" style="flex:1;padding:12px" onclick="salvarCorrecao()">💾 Salvar correção</button>
          <button class="btn" onclick="mostrarRevisao()">Cancelar</button>
        </div>
      </div>
    </div>
    <div id="rev-resultado" style="display:none"></div>
  </div>
</div>
