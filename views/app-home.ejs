<%- include('partials/app-shell', {active:'home',title:'Dashboard',subtitle:'Visão geral da sua operação em tempo real.',user:user}) %>
<style>
.kpi-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:20px}
.kpi{background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;position:relative;overflow:hidden;transition:box-shadow .2s}
.kpi:hover{box-shadow:var(--shadow-md)}
.kpi::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px}
.kpi.green::after{background:#10b981}.kpi.blue::after{background:#3b82f6}.kpi.amber::after{background:#f59e0b}.kpi.purple::after{background:#8b5cf6}.kpi.teal::after{background:#14b8a6}.kpi.red::after{background:#ef4444}
.kpi-label{font-size:10px;text-transform:uppercase;letter-spacing:.7px;color:var(--text-sec);margin-bottom:6px;font-weight:500}
.kpi-val{font-size:24px;font-weight:600;line-height:1;font-variant-numeric:tabular-nums}
.kpi-sub{font-size:10px;margin-top:4px;color:var(--text-ter)}
.kpi-sub.up{color:#10b981}.kpi-sub.down{color:#ef4444}

.dash-grid{display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-bottom:14px}
.dash-grid2{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:14px}
.dash-grid3{display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-bottom:14px}

.dcard{background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px}
.dcard-title{font-size:10px;text-transform:uppercase;letter-spacing:.7px;color:var(--text-sec);font-weight:500;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between}
.dcard-title a{font-size:10px;color:var(--brand);text-decoration:none;text-transform:none;letter-spacing:0}

.funil-row{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.funil-row:last-child{margin-bottom:0}
.funil-lbl{font-size:11px;color:var(--text-sec);width:72px;flex-shrink:0}
.funil-track{flex:1;height:8px;background:var(--border-light);border-radius:4px;overflow:hidden}
.funil-fill{height:100%;border-radius:4px;transition:width 1.2s cubic-bezier(.16,1,.3,1)}
.funil-n{font-size:11px;font-weight:500;width:28px;text-align:right;font-variant-numeric:tabular-nums}

.gauge-wrap{display:flex;flex-direction:column;align-items:center;padding:8px 0}
.gauge-num{font-size:28px;font-weight:600;line-height:1;margin-top:-4px}
.gauge-sub{font-size:10px;color:var(--text-ter);margin-top:4px}

.hgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.hc{aspect-ratio:1;border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:500;cursor:default}
.h0{background:var(--border-light)}
.h1{background:#dbeafe;color:#1d4ed8}
.h2{background:#d1fae5;color:#065f46}
.h3{background:#fef3c7;color:#92400e}
.h4{background:#fee2e2;color:#991b1b}

.lead-row{display:flex;align-items:center;gap:9px;padding:7px 0;border-bottom:1px solid var(--border-light)}
.lead-row:last-child{border-bottom:none}
.lead-av{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;flex-shrink:0}
.lead-name{font-size:12px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lead-src{font-size:10px;color:var(--text-ter)}
.badge-sm{font-size:9px;padding:2px 6px;border-radius:20px;font-weight:500;flex-shrink:0}
.badge-green{background:#d1fae5;color:#065f46}
.badge-amber{background:#fef3c7;color:#92400e}
.badge-blue{background:#dbeafe;color:#1d4ed8}

.im-row{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--border-light)}
.im-row:last-child{border-bottom:none}
.im-rk{font-size:10px;color:var(--text-ter);width:14px;flex-shrink:0}
.im-tipo{font-size:11px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.im-loc{font-size:10px;color:var(--text-ter)}
.im-cnt{font-size:12px;font-weight:600;color:#10b981;flex-shrink:0}

.acao-btn{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;text-decoration:none;color:var(--text);font-size:12px;margin-bottom:6px;border:1px solid var(--border);background:var(--white);transition:all .15s;font-weight:500}
.acao-btn:hover{border-color:var(--brand);color:var(--brand);transform:translateX(2px)}
.acao-btn:last-child{margin-bottom:0}
.acao-ico{font-size:16px;width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0}

.clock-badge{font-family:monospace;font-size:11px;color:var(--text-sec);background:var(--border-light);padding:3px 8px;border-radius:6px;display:inline-flex;align-items:center;gap:5px}
.pulse-dot{width:6px;height:6px;border-radius:50%;background:#10b981;animation:pd 2s infinite;flex-shrink:0}
@keyframes pd{0%,100%{opacity:1}50%{opacity:.3}}

.score-ring{position:relative;display:inline-flex;align-items:center;justify-content:center}
.score-num{font-size:22px;font-weight:600;position:absolute}

@media(max-width:1100px){.kpi-grid{grid-template-columns:repeat(3,1fr)}.dash-grid{grid-template-columns:1fr}.dash-grid2{grid-template-columns:1fr 1fr}.dash-grid3{grid-template-columns:1fr}}
@media(max-width:700px){.kpi-grid{grid-template-columns:repeat(2,1fr)}.dash-grid2{grid-template-columns:1fr}}
</style>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h2 style="font-size:18px;font-weight:600;color:var(--dark)">Olá, <%= (user.nome||'').split(' ')[0] %> 👋</h2>
    <p style="font-size:12px;color:var(--text-sec);margin-top:2px">Aqui está o resumo da sua operação</p>
  </div>
  <div class="clock-badge"><span class="pulse-dot"></span><span id="clk">--:--:--</span></div>
</div>

<!-- KPIs -->
<div class="kpi-grid">
  <div class="kpi green">
    <div class="kpi-label">Imóveis</div>
    <div class="kpi-val" id="ki"><%=stats.imoveisAtivos%></div>
    <div class="kpi-sub">carteira ativa</div>
  </div>
  <div class="kpi blue">
    <div class="kpi-label">Leads</div>
    <div class="kpi-val" id="kl"><%=stats.leadsNovos%></div>
    <div class="kpi-sub">no pipeline</div>
  </div>
  <div class="kpi amber">
    <div class="kpi-label">Com match</div>
    <div class="kpi-val" id="km"><%=stats.comMatch%></div>
    <div class="kpi-sub up">↑ <%=stats.taxaMatch%>% taxa</div>
  </div>
  <div class="kpi teal">
    <div class="kpi-label">Visitas</div>
    <div class="kpi-val" id="kv"><%=stats.visitasAgendadas%></div>
    <div class="kpi-sub">agendadas</div>
  </div>
  <div class="kpi purple">
    <div class="kpi-label">Hoje</div>
    <div class="kpi-val" id="kh"><%=stats.visitasHoje%></div>
    <div class="kpi-sub">visitas hoje</div>
  </div>
  <div class="kpi red">
    <div class="kpi-label">Matches</div>
    <div class="kpi-val"><%=stats.matchesGerados%></div>
    <div class="kpi-sub up">↑ total gerados</div>
  </div>
</div>

<!-- LINHA 1: FUNIL + GAUGE + HEATMAP -->
<div class="dash-grid">
  <div class="dcard">
    <div class="dcard-title">Funil de leads <span class="badge-sm badge-blue">ao vivo</span></div>
    <%var ft=Math.max(stats.funnelLeads||1,1);var fd=[
      {l:'Total leads',v:stats.funnelLeads,c:'#3b82f6',p:100},
      {l:'Qualificando',v:Math.round(ft*.55),c:'#8b5cf6',p:55},
      {l:'Com match',v:stats.funnelMatch,c:'#f59e0b',p:Math.round((stats.funnelMatch/ft)*100)},
      {l:'Vitrine env.',v:stats.funnelVitrine||0,c:'#10b981',p:Math.round(((stats.funnelVitrine||0)/ft)*100)},
      {l:'Visita agend.',v:stats.visitasAgendadas,c:'#14b8a6',p:Math.round((stats.visitasAgendadas/ft)*100)},
    ];%>
    <%fd.forEach(function(f){%>
    <div class="funil-row">
      <span class="funil-lbl"><%=f.l%></span>
      <div class="funil-track"><div class="funil-fill" style="width:<%=f.p%>%;background:<%=f.c%>"></div></div>
      <span class="funil-n"><%=f.v%></span>
    </div>
    <%});%>
  </div>

  <div style="display:flex;flex-direction:column;gap:14px">
    <div class="dcard">
      <div class="dcard-title">Taxa de match</div>
      <%var tp=stats.taxaMatch||0;var gc=tp>60?'#10b981':tp>30?'#f59e0b':'#ef4444';var tr=(tp/100)*180;var trad=(tr-180)*Math.PI/180;var tx=(70+50*Math.cos(trad)).toFixed(1);var ty=(70+50*Math.sin(trad)).toFixed(1);%>
      <div class="gauge-wrap">
        <svg width="130" height="75" viewBox="0 0 140 80">
          <path d="M 20 70 A 50 50 0 0 1 120 70" fill="none" stroke="var(--border-light)" stroke-width="10" stroke-linecap="round"/>
          <path d="M 20 70 A 50 50 0 0 1 <%=tx%> <%=ty%>" fill="none" stroke="<%=gc%>" stroke-width="10" stroke-linecap="round"/>
        </svg>
        <div class="gauge-num" style="color:<%=gc%>"><%=tp%>%</div>
        <div class="gauge-sub">leads com match</div>
      </div>
    </div>

    <div class="dcard">
      <div class="dcard-title">Calor do pipeline <span class="badge-sm badge-amber">heatmap</span></div>
      <div style="display:flex;gap:6px;font-size:9px;color:var(--text-ter);margin-bottom:6px;flex-wrap:wrap">
        <span><span style="display:inline-block;width:7px;height:7px;border-radius:2px;background:#fee2e2;margin-right:2px"></span>Hot</span>
        <span><span style="display:inline-block;width:7px;height:7px;border-radius:2px;background:#fef3c7;margin-right:2px"></span>Morno</span>
        <span><span style="display:inline-block;width:7px;height:7px;border-radius:2px;background:#d1fae5;margin-right:2px"></span>Ativo</span>
        <span><span style="display:inline-block;width:7px;height:7px;border-radius:2px;background:#dbeafe;margin-right:2px"></span>Frio</span>
      </div>
      <div class="hgrid" id="hm"></div>
    </div>
  </div>
</div>

<!-- LINHA 2: LEADS + TOP IMÓVEIS + AÇÕES -->
<div class="dash-grid2">
  <div class="dcard">
    <div class="dcard-title">Leads recentes <a href="/app/leads">ver todos →</a></div>
    <%var avCores=[['#dbeafe','#1d4ed8'],['#d1fae5','#065f46'],['#ede9fe','#5b21b6'],['#fef3c7','#92400e'],['#fee2e2','#991b1b']];var rec=locals.recentes||[];%>
    <%if(!rec.length){%><div style="text-align:center;padding:20px;color:var(--text-ter);font-size:12px">Nenhum lead ainda</div><%}%>
    <%rec.slice(0,5).forEach(function(l,i){var tm=(l.matches&&l.matches.length>0)||(l.matchesAuto&&l.matchesAuto.length>0);var c=avCores[i%5];%>
    <div class="lead-row">
      <div class="lead-av" style="background:<%=c[0]%>;color:<%=c[1]%>"><%=(l.nome||'?').charAt(0).toUpperCase()%></div>
      <div style="flex:1;min-width:0">
        <div class="lead-name"><%=l.nome||l.telefone||'Lead'%></div>
        <div class="lead-src"><%=l.origem||'WhatsApp'%> · <%=(l.perfilIA&&l.perfilIA.cidade)||l.cidade||'—'%></div>
      </div>
      <%if(tm){%><span class="badge-sm badge-green">match</span><%}else{%><span class="badge-sm" style="background:var(--border-light);color:var(--text-ter)">novo</span><%}%>
    </div>
    <%});%>
  </div>

  <div class="dcard">
    <div class="dcard-title">Top imóveis <a href="/app/imoveis">ver todos →</a></div>
    <%var top=locals.topImoveis||[];%>
    <%if(!top.length){%><div style="text-align:center;padding:20px;color:var(--text-ter);font-size:11px">Sem dados ainda</div><%}%>
    <%top.slice(0,5).forEach(function(im,i){%>
    <div class="im-row">
      <span class="im-rk">#<%=i+1%></span>
      <div style="flex:1;min-width:0">
        <div class="im-tipo"><%=im.titulo||im.tipo||'Imóvel'%></div>
        <div class="im-loc"><%=im.bairro||''%><%=im.cidade?', '+im.cidade:''%></div>
      </div>
      <span class="im-cnt"><%=im.cnt||0%></span>
    </div>
    <%});%>
  </div>

  <div class="dcard">
    <div class="dcard-title">Ações rápidas</div>
    <a href="/app/imovel/novo" class="acao-btn"><span class="acao-ico" style="background:#d1fae5">🏠</span>Cadastrar imóvel</a>
    <a href="/app/leads" class="acao-btn"><span class="acao-ico" style="background:#dbeafe">👥</span>Ver leads</a>
    <a href="/app/visitas" class="acao-btn"><span class="acao-ico" style="background:#ede9fe">📅</span>Agendar visita</a>
    <a href="/app/portais" class="acao-btn"><span class="acao-ico" style="background:#fef3c7">📡</span>Portais / XML</a>
    <a href="/app/assistente" class="acao-btn"><span class="acao-ico" style="background:#fee2e2">🤖</span>Assistente IA</a>
  </div>
</div>

<!-- LINHA 3: GRÁFICO CANAIS + INSIGHTS -->
<div class="dash-grid3">
  <div class="dcard">
    <div class="dcard-title">Leads por canal — 7 dias
      <div style="display:flex;gap:10px;font-size:9px;color:var(--text-ter)">
        <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#3b82f6;margin-right:2px"></span>WhatsApp</span>
        <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#10b981;margin-right:2px"></span>VivaReal</span>
        <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#f59e0b;margin-right:2px"></span>ZAP</span>
        <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#8b5cf6;margin-right:2px"></span>ImovelWeb</span>
      </div>
    </div>
    <div style="position:relative;height:160px"><canvas id="cc" role="img" aria-label="Leads por canal"></canvas></div>
  </div>

  <div class="dcard">
    <div class="dcard-title">Insights da carteira</div>
    <div style="display:flex;flex-direction:column;gap:10px">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:<%=stats.imoveisSemFoto>0?'#fef3c7':'#d1fae5'%>;border-radius:8px">
        <span style="font-size:11px;color:<%=stats.imoveisSemFoto>0?'#92400e':'#065f46'%>"><%=stats.imoveisSemFoto>0?'⚠️ '+stats.imoveisSemFoto+' imóvel(is) sem foto':'✅ Todos têm foto'%></span>
        <%if(stats.imoveisSemFoto>0){%><a href="/app/imoveis" style="font-size:10px;color:#92400e;font-weight:500">corrigir</a><%}%>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:<%=stats.leadsQuentesSemVisita>0?'#fee2e2':'#d1fae5'%>;border-radius:8px">
        <span style="font-size:11px;color:<%=stats.leadsQuentesSemVisita>0?'#991b1b':'#065f46'%>"><%=stats.leadsQuentesSemVisita>0?'🔥 '+stats.leadsQuentesSemVisita+' lead(s) quentes sem visita':'✅ Sem leads quentes pendentes'%></span>
        <%if(stats.leadsQuentesSemVisita>0){%><a href="/app/leads" style="font-size:10px;color:#991b1b;font-weight:500">ver</a><%}%>
      </div>
      <div style="padding:10px 12px;background:var(--border-light);border-radius:8px">
        <div style="font-size:10px;color:var(--text-ter);margin-bottom:4px">Bairro mais buscado</div>
        <div style="font-size:13px;font-weight:600;color:var(--dark)"><%=stats.bairroMaisDemandado||'—'%></div>
      </div>
      <div style="padding:10px 12px;background:var(--border-light);border-radius:8px">
        <div style="font-size:10px;color:var(--text-ter);margin-bottom:4px">Score da carteira</div>
        <div style="display:flex;align-items:center;gap:8px">
          <div style="flex:1;height:6px;background:var(--border);border-radius:3px;overflow:hidden"><div style="height:100%;width:<%=stats.scoreCarteira||0%>%;background:<%=(stats.scoreCarteira||0)>70?'#10b981':(stats.scoreCarteira||0)>40?'#f59e0b':'#ef4444'%>;border-radius:3px"></div></div>
          <span style="font-size:12px;font-weight:600;color:var(--dark)"><%=stats.scoreCarteira||0%></span>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
setInterval(function(){document.getElementById('clk').textContent=new Date().toLocaleTimeString('pt-BR');},1000);
document.getElementById('clk').textContent=new Date().toLocaleTimeString('pt-BR');

var hm=document.getElementById('hm');
<%var leadsQuentes=stats.leadsQuentes||0;var leadsMornas=stats.leadsMornas||0;var leadsFrias=stats.leadsFrias||0;var leadsTotal=stats.leadsNovos||0;%>
var hdata=[];
for(var i=0;i<28;i++){
  var r=Math.random();
  var v=r<<%=leadsTotal>0?(leadsQuentes/leadsTotal*.3).toFixed(2):0.05%>?4:r<<%=leadsTotal>0?((leadsQuentes+leadsMornas)/leadsTotal*.5).toFixed(2):0.15%>?3:r<.6?2:r<.8?1:0;
  var c=document.createElement('div');c.className='hc h'+v;c.textContent=v>0?v:'';c.title=['Inativo','Frio','Ativo','Morno','Hot'][v];hm.appendChild(c);
}

new Chart(document.getElementById('cc'),{type:'bar',data:{labels:['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'],datasets:[
  {label:'WhatsApp',data:[3,5,4,6,4,2,1],backgroundColor:'rgba(59,130,246,.75)',borderRadius:3},
  {label:'VivaReal',data:[1,2,3,2,3,1,0],backgroundColor:'rgba(16,185,129,.75)',borderRadius:3},
  {label:'ZAP',data:[2,1,2,3,2,0,0],backgroundColor:'rgba(245,158,11,.75)',borderRadius:3},
  {label:'ImovelWeb',data:[1,1,1,2,1,0,0],backgroundColor:'rgba(139,92,246,.75)',borderRadius:3}
]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{stacked:true,grid:{color:'rgba(0,0,0,.04)'},ticks:{font:{size:10},color:'#9ca3af'}},y:{stacked:true,grid:{color:'rgba(0,0,0,.04)'},ticks:{font:{size:10},color:'#9ca3af'}}}}});

function anim(id,final){var el=document.getElementById(id);if(!el)return;var s=Date.now();(function f(){var p=Math.min((Date.now()-s)/600,1);el.textContent=Math.round(p*final);if(p<1)requestAnimationFrame(f);})();}
anim('ki',<%=stats.imoveisAtivos%>);anim('kl',<%=stats.leadsNovos%>);anim('km',<%=stats.comMatch%>);anim('kv',<%=stats.visitasAgendadas%>);anim('kh',<%=stats.visitasHoje%>);
</script>
<%- include('partials/app-end') %>
