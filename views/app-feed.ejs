<%- include("partials/app-shell",{active:"feed",user:user,title:"Feed"}) %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
#feed-root{margin:-20px;overflow-y:auto;scroll-snap-type:y mandatory;height:calc(100vh - 60px);background:#fff;}
.feed-post{scroll-snap-align:start;border-bottom:.5px solid #f0f0f0;background:#fff;}
.post-hdr{padding:10px 14px;display:flex;align-items:center;gap:9px;}
.post-av{width:32px;height:32px;border-radius:50%;background:#E8404A;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;flex-shrink:0;}
.post-name{font-size:12px;font-weight:600;color:#111;}
.post-loc{font-size:10px;color:#aaa;display:flex;align-items:center;gap:3px;margin-top:1px;}
.post-more{margin-left:auto;font-size:18px;color:#ccc;cursor:pointer;letter-spacing:2px;line-height:1;}
.photos-wrap{position:relative;height:280px;overflow:hidden;touch-action:pan-y;}
.photos-track{display:flex;height:100%;transition:transform .28s cubic-bezier(.4,0,.2,1);}
.photo-slide{min-width:100%;height:100%;background:#f0f0f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;}
.photo-slide img{width:100%;height:100%;object-fit:cover;}
.p-dots{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);display:flex;gap:4px;pointer-events:none;}
.p-dot{width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.5);transition:all .25s;}
.p-dot.a{background:#fff;width:14px;border-radius:3px;}
.p-num{position:absolute;top:9px;right:10px;background:rgba(0,0,0,.45);color:#fff;font-size:9px;padding:2px 7px;border-radius:6px;}
.post-actions{padding:10px 14px 4px;display:flex;align-items:center;gap:16px;}
.act-btn{font-size:0;background:none;border:none;padding:0;cursor:pointer;display:flex;align-items:center;transition:transform .1s;}
.act-btn:active{transform:scale(1.2);}
.act-btn.liked svg{stroke:#E8404A;fill:#E8404A;}
.act-spacer{flex:1;}
.ia-row{padding:4px 14px;display:flex;align-items:center;gap:8px;}
.ia-lbl{font-size:9px;color:#ccc;display:flex;align-items:center;gap:3px;white-space:nowrap;}
.ia-bg{flex:1;height:4px;background:#f0f0f0;border-radius:2px;overflow:hidden;}
.ia-fill{height:100%;background:#1D9E75;border-radius:2px;width:0;}
.ia-pct{font-size:10px;font-weight:600;color:#1D9E75;min-width:28px;text-align:right;}
.minimap{margin:6px 14px;height:80px;border-radius:10px;overflow:hidden;border:.5px solid #ebebeb;}
.post-info{padding:6px 14px 16px;}
.post-price{font-size:22px;font-weight:700;color:#111;letter-spacing:-.4px;}
.post-desc{font-size:11px;color:#888;margin-top:3px;}
.post-addr{font-size:10px;color:#ccc;margin-top:3px;display:flex;align-items:center;gap:3px;}
.new-banner{position:fixed;top:70px;left:50%;transform:translateX(-50%);background:#E8404A;color:#fff;font-size:11px;font-weight:600;padding:7px 18px;border-radius:20px;z-index:100;display:none;align-items:center;gap:6px;cursor:pointer;white-space:nowrap;box-shadow:0 2px 12px rgba(232,64,74,.3);}
.nbdot{width:6px;height:6px;border-radius:50%;background:#fff;animation:blink 1s infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
</style>

<div class="new-banner" id="newBanner" onclick="loadNew()">
  <div class="nbdot"></div>
  <span id="newCount"></span>
</div>

<div id="feed-root"></div>

<script>
const _imoveis = <%- JSON.stringify(imoveis) %>;
const _uLat = <%= user.lat || 'null' %>;
const _uLng = <%= user.lng || 'null' %>;
const _myId = '<%= user.codigoUsuario || user.codigo %>';
let _newQueue = [];

function _initials(nome){
  if(!nome) return 'MI';
  return nome.split(' ').slice(0,2).map(w=>w[0]||'').join('').toUpperCase()||'MI';
}

function _renderPost(im, idx){
  const fotos = (im.fotos||[]).slice(0,8);
  const nSlides = fotos.length || 1;
  const uid = im.user_id||im.userId||im.codigoUsuario||'';
  const isParceiro = uid !== _myId;
  const nome = im._nomeUsuario || (isParceiro ? 'Parceiro' : 'Meu imóvel');
  const initials = _initials(nome);
  const avBg = isParceiro ? '#185FA5' : '#E8404A';
  const vl = im.valor_imovel||im.valor||im.preco||0;
  const preco = vl && Number(vl)>0 ? 'R$ '+Number(vl).toLocaleString('pt-BR') : 'Consulte';
  const area = im.area_m2||im.area||'';
  const desc = [im.tipo||'Imóvel', im.quartos?im.quartos+' qts':'', area?area+'m²':'', im.vagas?im.vagas+' vaga'+(im.vagas>1?'s':''):''].filter(Boolean).join(' · ');
  const addr = [im.bairro, im.cidade].filter(Boolean).join(', ');
  const compat = im.compatibilidade || (70 + (idx*7)%25);
  const iLat = im.latitude||im.lat||null;
  const iLng = im.longitude||im.lng||null;
  const mmId = 'mm'+idx;

  const slidesHtml = fotos.length
    ? fotos.map(f=>`<div class="photo-slide"><img src="${f}" loading="lazy" onerror="this.style.display='none'"></div>`).join('')
    : `<div class="photo-slide" style="background:#f5f5f5"><svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#ddd" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/></svg></div>`;

  const dotsHtml = nSlides>1 ? Array.from({length:nSlides},(_,i)=>`<div class="p-dot${i===0?' a':''}"></div>`).join('') : '';

  return `<div class="feed-post">
  <div class="post-hdr">
    <div class="post-av" style="background:${avBg}">${initials}</div>
    <div>
      <div class="post-name">${nome}</div>
      <div class="post-loc"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#E8404A" stroke-width="2.5" stroke-linecap="round"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>${addr||'–'}</div>
    </div>
    <div class="post-more">···</div>
  </div>
  <div class="photos-wrap" data-cur="0" data-total="${nSlides}">
    <div class="photos-track">${slidesHtml}</div>
    ${nSlides>1?`<div class="p-dots">${dotsHtml}</div><div class="p-num">1 / ${nSlides}</div>`:''}
  </div>
  <div class="post-actions">
    <button class="act-btn" onclick="this.classList.toggle('liked')" aria-label="Gostei">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </button>
    <button class="act-btn" aria-label="Compartilhar" onclick="compartilhar('${im.id||im.id_externo||idx}')">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
    <div class="act-spacer"></div>
    <button class="act-btn" aria-label="Salvar">
      <svg width="20" height="22" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
    </button>
  </div>
  <div class="ia-row">
    <span class="ia-lbl"><svg width="10" height="10" viewBox="0 0 24 24" fill="#1D9E75"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg> IA</span>
    <div class="ia-bg"><div class="ia-fill" data-target="${compat}"></div></div>
    <span class="ia-pct">0%</span>
  </div>
  <div class="minimap" id="${mmId}"></div>
  <div class="post-info">
    <div class="post-price">${preco}</div>
    <div class="post-desc">${desc}</div>
    <div class="post-addr"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#E8404A" stroke-width="2.5" stroke-linecap="round"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>${addr}</div>
  </div>
</div>`;
}

function renderFeed(list){
  document.getElementById('feed-root').innerHTML = list.map(_renderPost).join('');
  _initCarousels();
  _animateBars();
  _initMaps();
}

function _initCarousels(){
  document.querySelectorAll('.photos-wrap').forEach(wrap=>{
    let sx=0,dx=0,drag=false;
    const track=wrap.querySelector('.photos-track');
    const dots=wrap.querySelectorAll('.p-dot');
    const num=wrap.querySelector('.p-num');
    const total=parseInt(wrap.dataset.total)||1;
    let cur=0;
    function goTo(n){cur=Math.max(0,Math.min(n,total-1));track.style.transform=`translateX(-${cur*100}%)`;dots.forEach((d,i)=>d.classList.toggle('a',i===cur));if(num)num.textContent=`${cur+1} / ${total}`;}
    wrap.addEventListener('pointerdown',e=>{sx=e.clientX;drag=true;dx=0;wrap.setPointerCapture(e.pointerId);});
    wrap.addEventListener('pointermove',e=>{if(!drag)return;dx=e.clientX-sx;});
    wrap.addEventListener('pointerup',e=>{if(!drag)return;drag=false;if(Math.abs(dx)>40){dx<0?goTo(cur+1):goTo(cur-1);}dx=0;});
  });
}

function _animateBars(){
  document.querySelectorAll('.ia-fill').forEach(bar=>{
    const target=parseInt(bar.dataset.target)||0;
    const pctEl=bar.closest('.ia-row')?.querySelector('.ia-pct');
    let v=0;
    const t=setInterval(()=>{v=Math.min(v+2,target);bar.style.width=v+'%';if(pctEl)pctEl.textContent=v+'%';if(v>=target)clearInterval(t);},16);
  });
}

function _initMaps(){
  _imoveis.forEach((im,idx)=>{
    const el=document.getElementById('mm'+idx);
    if(!el) return;
    const iLat=im.latitude||im.lat||null;
    const iLng=im.longitude||im.lng||null;
    if(!iLat||!iLng){
      el.innerHTML='<div style="height:80px;display:flex;align-items:center;justify-content:center;font-size:10px;color:#ccc;">sem localização</div>';
      return;
    }
    const center = _uLat&&_uLng ? [(_uLat+iLat)/2,(_uLng+iLng)/2] : [iLat,iLng];
    const zoom = _uLat&&_uLng ? 13 : 14;
    const map=L.map(el,{zoomControl:false,attributionControl:false,dragging:false,scrollWheelZoom:false,doubleClickZoom:false,touchZoom:false}).setView(center,zoom);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18}).addTo(map);
    // pin imóvel verde
    L.marker([iLat,iLng],{icon:L.divIcon({className:'',html:'<div style="background:#1D9E75;border:2.5px solid #fff;border-radius:50%;width:14px;height:14px;box-shadow:0 1px 6px rgba(0,0,0,.25)"></div>',iconSize:[14,14],iconAnchor:[7,7]})}).addTo(map);
    // pin você vermelho + linha
    if(_uLat&&_uLng){
      L.marker([_uLat,_uLng],{icon:L.divIcon({className:'',html:'<div style="background:#E8404A;border:2.5px solid #fff;border-radius:50%;width:12px;height:12px;box-shadow:0 1px 6px rgba(0,0,0,.25)"></div>',iconSize:[12,12],iconAnchor:[6,6]})}).addTo(map);
      L.polyline([[_uLat,_uLng],[iLat,iLng]],{color:'#E8404A',weight:2,dashArray:'5,4',opacity:.7}).addTo(map);
      const R=6371,dL=(iLat-_uLat)*Math.PI/180,dN=(iLng-_uLng)*Math.PI/180;
      const a=Math.sin(dL/2)**2+Math.cos(_uLat*Math.PI/180)*Math.cos(iLat*Math.PI/180)*Math.sin(dN/2)**2;
      const km=(R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a))).toFixed(1);
      L.marker([((_uLat+iLat)/2),((_uLng+iLng)/2)],{icon:L.divIcon({className:'',html:'<div style="background:rgba(232,64,74,.85);color:#fff;font-size:9px;font-weight:600;padding:2px 7px;border-radius:6px;white-space:nowrap;box-shadow:0 1px 4px rgba(0,0,0,.2)">'+km+' km</div>',iconSize:[60,20],iconAnchor:[30,10]}),zIndexOffset:1000}).addTo(map);
    }
  });
}

function compartilhar(id){
  const url=window.location.origin+'/imovel/'+id;
  if(navigator.share){navigator.share({title:'MatchImóveis',url});}
  else{navigator.clipboard?.writeText(url).then(()=>alert('Link copiado!'));}
}

function loadNew(){
  document.getElementById('newBanner').style.display='none';
  if(_newQueue.length){renderFeed([..._newQueue,..._imoveis]);_newQueue=[];}
}

let _lastCheck=Date.now();
setInterval(async()=>{
  try{
    const r=await fetch(`/api/feed/novos?since=${_lastCheck}&lat=${_uLat||''}&lng=${_uLng||''}`);
    const d=await r.json();
    if(d.imoveis&&d.imoveis.length){
      _newQueue=d.imoveis;_lastCheck=Date.now();
      const b=document.getElementById('newBanner');
      document.getElementById('newCount').textContent=d.imoveis.length+' novo'+(d.imoveis.length>1?'s':'')+' na sua região';
      b.style.display='flex';
    }
  }catch(e){}
},30000);

renderFeed(_imoveis);
</script>
