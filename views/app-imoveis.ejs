<%- include('partials/app-shell',{active:'imoveis',title:'Meus Imóveis',subtitle:'Base indexada pela IA — pronta para match com leads.',user:user}) %>

<style>
.im-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:14px}
/* ── FILTRO NOTION ── */
.nf-wrap{margin-bottom:16px}
.nf-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:6px 0}
.nf-pill{display:inline-flex;align-items:center;gap:0;border-radius:8px;border:1.5px solid var(--border);background:#fff;font-size:12px;cursor:pointer;overflow:hidden;transition:border-color .12s}
.nf-pill:hover{border-color:#7c3aed}
.nf-pill-campo{padding:5px 10px;font-weight:600;color:var(--dark);background:#f9fafb;border-right:1.5px solid var(--border)}
.nf-pill-valor{padding:5px 8px;color:#7c3aed;font-weight:500}
.nf-pill-rm{padding:5px 8px;color:#9ca3af;font-weight:700;border-left:1.5px solid var(--border);line-height:1}
.nf-pill-rm:hover{background:#fef2f2;color:#ef4444}
.nf-add{display:inline-flex;align-items:center;gap:5px;padding:5px 12px;border-radius:8px;border:1.5px dashed var(--border);background:transparent;font-size:12px;font-weight:500;color:var(--text-sec);cursor:pointer;transition:all .12s}
.nf-add:hover{border-color:#7c3aed;color:#7c3aed;background:#f5f3ff}
.nf-clear{display:none;padding:5px 10px;border-radius:8px;border:none;background:none;font-size:11px;font-weight:600;color:#ef4444;cursor:pointer}
.nf-clear:hover{background:#fef2f2}
.nf-count{font-size:11px;color:var(--text-ter);padding:5px 0;margin-left:4px}
/* Dropdown */
.nf-dropdown{position:fixed;background:#fff;border:1.5px solid var(--border);border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,.12);z-index:9999;min-width:220px;overflow:hidden;display:none}
.nf-dropdown.open{display:block}
.nf-dd-search{width:100%;padding:10px 14px;border:none;border-bottom:1px solid var(--border);outline:none;font-size:12px;font-family:inherit}
.nf-dd-list{max-height:260px;overflow-y:auto}
.nf-dd-item{padding:9px 14px;font-size:12px;cursor:pointer;display:flex;align-items:center;gap:8px;transition:background .08s}
.nf-dd-item:hover{background:#f5f3ff;color:#7c3aed}
.nf-dd-item.on{background:#f5f3ff;color:#7c3aed;font-weight:600}
.nf-dd-sep{padding:6px 14px 2px;font-size:10px;font-weight:700;color:var(--text-ter);text-transform:uppercase;letter-spacing:.5px;background:#fafafa;border-top:1px solid var(--border)}
/* Input numérico no dropdown */
.nf-dd-input{padding:10px 14px;border-top:1px solid var(--border)}
.nf-dd-input input{width:100%;padding:7px 10px;border:1.5px solid var(--border);border-radius:8px;font-size:12px;outline:none;box-sizing:border-box}
.nf-dd-input input:focus{border-color:#7c3aed}
.nf-dd-input button{margin-top:6px;width:100%;padding:7px;border-radius:8px;border:none;background:#7c3aed;color:#fff;font-size:12px;font-weight:600;cursor:pointer}
/* Busca geral */
.nf-search-wrap{display:flex;align-items:center;gap:8px;background:#fff;border:1.5px solid var(--border);border-radius:12px;padding:9px 14px;margin-bottom:10px;transition:border-color .12s}
.nf-search-wrap:focus-within{border-color:#7c3aed;box-shadow:0 0 0 3px #7c3aed14}
.nf-search-wrap input{border:none;outline:none;font-size:13px;color:var(--dark);background:transparent;flex:1;font-family:inherit}
.nf-search-wrap input::placeholder{color:#b0b0b8}

.im-stats{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.im-stat{padding:4px 12px;border-radius:20px;font-size:11px;font-weight:600;background:var(--bg);border:1px solid var(--border);color:var(--text-sec)}
.im-stat.verde{background:#f0fdf4;color:#16a34a;border-color:#bbf7d0}
.im-stat.vermelho{background:#fef2f2;color:#dc2626;border-color:#fecaca}
.im-stat.azul{background:#eff6ff;color:#2563eb;border-color:#bfdbfe}

.barra-sel{display:none;position:sticky;top:0;z-index:50;background:var(--dark);color:#fff;padding:12px 16px;border-radius:10px;margin-bottom:14px;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
.barra-portais{display:flex;gap:6px;flex-wrap:wrap}
.portal-btn-sel{background:rgba(255,255,255,.12);border:none;color:#fff;padding:7px 12px;border-radius:7px;cursor:pointer;font-size:11px;font-weight:600;transition:background .1s}
.portal-btn-sel:hover{background:rgba(255,255,255,.2)}
.im-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.im-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column;cursor:pointer;transition:all .15s}
.im-card:hover{border-color:#c4b5fd;box-shadow:var(--shadow-md)}
.im-card.sel{border-color:#7c3aed;box-shadow:0 0 0 2px #7c3aed33}
.im-img{position:relative;width:100%;height:130px;background:var(--bg);display:flex;align-items:center;justify-content:center;overflow:hidden}
.im-img img{width:100%;height:100%;object-fit:cover}
.im-img-ic{font-size:28px;opacity:.25}
.im-check{position:absolute;top:8px;left:8px;width:20px;height:20px;border-radius:5px;border:2px solid rgba(255,255,255,.8);background:rgba(0,0,0,.25);display:flex;align-items:center;justify-content:center}
.im-check.on{background:#7c3aed;border-color:#7c3aed}
.im-badge-status{position:absolute;top:8px;right:8px;background:#ef4444;color:#fff;font-size:9px;font-weight:700;padding:2px 7px;border-radius:20px}
.im-body{padding:12px;display:flex;flex-direction:column;flex:1}
.im-tipo{display:inline-block;padding:2px 8px;border-radius:20px;font-size:10px;font-weight:600;background:var(--brand-light);color:var(--brand);margin-bottom:6px}
.im-valor{font-size:16px;font-weight:700;color:var(--dark);letter-spacing:-.3px;margin-bottom:3px}
.im-end{font-size:11px;color:var(--text-ter);margin-bottom:8px}
.im-prop{font-size:11px;color:var(--text-sec);background:var(--bg);border:1px solid var(--border-light);border-radius:7px;padding:6px 8px;margin-bottom:8px;line-height:1.4}
.im-tags{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:10px}
.im-tag{font-size:10px;color:var(--text-sec);background:var(--bg);border:1px solid var(--border-light);border-radius:5px;padding:2px 7px}
.im-actions{display:flex;gap:6px;margin-top:auto}
.im-btn{flex:1;text-align:center;font-size:11px;font-weight:600;padding:7px 8px;border-radius:7px;text-decoration:none;border:none;cursor:pointer;transition:all .1s}
.im-btn.ver{background:var(--bg);color:var(--text);border:1px solid var(--border)}
.im-btn.ver:hover{background:#f0f0ee}
.im-btn.edit{background:var(--brand);color:#fff}
.im-btn.edit:hover{background:var(--brand-dark)}
.im-empty{text-align:center;padding:60px 20px;color:var(--text-ter)}
.modal-xml{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:999;align-items:center;justify-content:center;padding:20px}
.modal-xml-box{background:#fff;border-radius:var(--radius-lg);padding:28px;max-width:480px;width:100%;text-align:center}
@keyframes spin{to{transform:rotate(360deg)}}
.spin{width:36px;height:36px;border:3px solid var(--border);border-top-color:var(--dark);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto}
@media(max-width:900px){.im-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.im-grid{grid-template-columns:1fr}}
</style>

<!-- Barra de seleção -->
<div class="barra-sel" id="barra-sel">
  <div style="display:flex;align-items:center;gap:10px">
    <span id="cnt-sel" style="font-size:13px;font-weight:600">0 selecionados</span>
    <button onclick="deselectAll()" style="background:rgba(255,255,255,.15);border:none;color:#fff;padding:4px 10px;border-radius:6px;cursor:pointer;font-size:11px">✕ Limpar</button>
  </div>

</div>

<!-- Toolbar -->
<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:12px">
  <div class="im-stats">
    <span class="im-stat"><%= typeof imoveis !== 'undefined' ? imoveis.length : 0 %> total</span>
    <span class="im-stat verde" id="count-ativos">—</span>
    <span class="im-stat vermelho" id="count-inativos">—</span>
    <span class="im-stat azul" id="count-sem-foto">—</span>
    <span class="im-stat" id="count-sem-prop">—</span>
  </div>
  <div style="display:flex;gap:8px;align-items:center">
    <label style="display:flex;align-items:center;gap:5px;font-size:11px;font-weight:500;color:var(--text-sec);cursor:pointer">
      <input type="checkbox" id="check-todos" onchange="toggleTodos(this)" style="width:13px;height:13px">
      Selecionar todos
    </label>
    <a href="/app/cadastro" class="btn btn-primary btn-sm">+ Cadastrar</a>
  </div>
</div>


<!-- Filtro Notion -->
<div class="nf-wrap">
  <!-- Busca geral -->
  <div class="nf-search-wrap">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input id="busca" placeholder="Busca rápida por bairro, cidade, tipo..." oninput="filtrar()">
  </div>
  <!-- Pills de filtro ativo -->
  <div class="nf-bar" id="nf-bar">
    <button class="nf-add" onclick="nfAbrirCampos(this)">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Adicionar filtro
    </button>
    <button class="nf-clear" id="nf-clear" onclick="limpar()">↺ Limpar tudo</button>
    <span class="nf-count" id="nf-count"></span>
  </div>
</div>

<!-- Dropdown -->
<div class="nf-dropdown" id="nf-dropdown">
  <input class="nf-dd-search" id="nf-dd-search" placeholder="Buscar campo..." oninput="nfFiltrarCampos(this.value)">
  <div class="nf-dd-list" id="nf-dd-list"></div>
  <div class="nf-dd-input" id="nf-dd-input" style="display:none">
    <input type="number" id="nf-dd-num" placeholder="Digite o valor">
    <button onclick="nfAplicarNum()">Aplicar</button>
  </div>
</div>

<!-- Inputs hidden para o filtrar() existente -->
<div style="display:none">
  <input id="f-tipo"><input id="f-bairro"><input id="f-cidade">
  <input id="f-operacao"><input id="f-status">
  <input id="f-valor-min" type="number"><input id="f-valor-max" type="number">
  <input id="f-area-min" type="number"><input id="f-quartos" type="number">
  <input id="f-suites" type="number"><input id="f-vagas" type="number">
  <input id="f-banheiros" type="number">
  <select id="f-fotos"><option value="">Todos</option><option value="sim">Com fotos</option><option value="nao">Sem fotos</option></select>
  <select id="f-proprietario"><option value="">Todos</option><option value="sim">Com proprietário</option><option value="nao">Sem proprietário</option></select>
</div>

<!-- Grid -->
<div id="im-grid" class="im-grid">
<% (typeof imoveis !== 'undefined' ? imoveis : []).forEach((item, idx) => { %>
  <div class="im-card"
    data-id="<%= item.id || item.idExterno || idx %>"
    data-tipo="<%= (item.tipo||'').toLowerCase() %>"
    data-bairro="<%= (item.bairro||'').toLowerCase() %>"
    data-cidade="<%= (item.cidade||'').toLowerCase() %>"
    data-valor="<%= item.valor_imovel || 0 %>"
    data-area="<%= item.area_m2 || 0 %>"
    data-quartos="<%= item.quartos || 0 %>"
    data-vagas="<%= item.vagas || 0 %>"
    data-suites="<%= item.suites || 0 %>"
    data-banheiros="<%= item.banheiros || 0 %>"
    data-status="<%= (item.status||'ativo').toLowerCase() %>"
    data-operacao="<%= (item.transacao||item.operacao||'').toLowerCase() %>"
    data-proprietario="<%= (item.proprietario && item.proprietario.nome) ? item.proprietario.nome.toLowerCase() : '' %>"
    data-fotos="<%= (item.fotos && item.fotos.length>0) ? item.fotos.length : '0' %>"
    onclick="toggleCard(this)">

    <!-- Imagem -->
    <div class="im-img">
      <% if(item.fotos && item.fotos.length > 0) { %>
        <img src="<%= item.fotos[0] %>" alt="foto" loading="lazy">
      <% } else { %>
        <div class="im-img-ic">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
      <% } %>
      <div class="im-check" id="chk-<%= item.id || idx %>"></div>
      <% if((item.status||'ativo').toLowerCase() !== 'ativo') { %>
        <div class="im-badge-status"><%= (item.status||'inativo').toUpperCase() %></div>
        <% if(item.condicao && item.condicao !== 'usado') { %>
        <div style="position:absolute;top:8px;left:8px;font-size:9px;font-weight:700;padding:2px 7px;border-radius:20px;<%=item.condicao==='lancamento'?'background:#7c3aed;color:#fff':item.condicao==='novo'?'background:#059669;color:#fff':''%>">
          <%=item.condicao==='lancamento'?'LANÇAMENTO':'NOVO'%>
        </div>
        <% } %>
      <% } %>
    </div>

    <!-- Body -->
    <div class="im-body" onclick="event.stopPropagation()">
      <span class="im-tipo"><%= item.tipo || 'Imóvel' %></span>
      <div class="im-valor">R$ <%= item.valor_imovel ? Number(item.valor_imovel).toLocaleString('pt-BR') : '—' %></div>
      <div class="im-end"><%= [item.bairro, item.cidade].filter(Boolean).join(', ') || '—' %></div>

      <% if(item.proprietario && item.proprietario.nome) { %>
      <div class="im-prop">
        <strong><%= item.proprietario.nome %></strong><br>
        <%= item.proprietario.telefone || item.proprietario.celular || '' %>
      </div>
      <% } %>

      <div class="im-tags">
        <% if(item.area_m2) { %><span class="im-tag"><%= item.area_m2 %>m²</span><% } %>
        <% if(item.quartos) { %><span class="im-tag"><%= item.quartos %>q</span><% } %>
        <% if(item.suites) { %><span class="im-tag"><%= item.suites %>s</span><% } %>
        <% if(item.vagas) { %><span class="im-tag"><%= item.vagas %>vg</span><% } %>
        <% if(item.banheiros) { %><span class="im-tag"><%= item.banheiros %>bnh</span><% } %>
        <% if(item.andar) { %><span class="im-tag"><%= item.andar %>º andar</span><% } %>
      </div>

      <div style="font-size:10px;color:var(--text-ter);margin-bottom:6px;display:flex;gap:8px;flex-wrap:wrap">
        <% if(item.dataCadastro||item.data_cadastro||item.criadoEm){ %><span>📅 <%= new Date(item.dataCadastro||item.data_cadastro||item.criadoEm).toLocaleDateString('pt-BR') %></span><% } %>
        <% if(item.dataAtualizacao||item.updatedAt){ %><span>🔄 <%= new Date(item.dataAtualizacao||item.updatedAt).toLocaleDateString('pt-BR') %></span><% } %>
      </div>
      <div class="im-actions">
        <a href="/app/imovel/<%= item.id || item.idExterno || item.idInterno || item.codigoImovel %>" class="im-btn ver" onclick="event.stopPropagation()">Ver</a>
        <a href="/app/imovel/<%= item.id || item.idExterno || item.idInterno || item.codigoImovel %>/editar" class="im-btn edit" onclick="event.stopPropagation()">Editar</a>
        <form method="POST" action="/app/imovel/<%= (item.idExterno && item.idExterno.trim()) ? item.idExterno : (item.idInterno || item.id) %>/excluir" style="display:inline" onsubmit="return confirm('Excluir este imóvel? Esta ação não pode ser desfeita.')"><button type="submit" class="im-btn" style="background:#fef2f2;color:#b91c1c;border-color:#fca5a5" onclick="event.stopPropagation()">Excluir</button></form>
      </div>
    </div>
  </div>
<% }) %>
</div>

<div id="im-empty" style="display:none" class="im-empty">
  <div style="font-size:36px;margin-bottom:12px;opacity:.3">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
  </div>
  <div style="font-size:14px;font-weight:500;color:var(--text-sec);margin-bottom:4px">Nenhum imóvel encontrado</div>
  <div style="font-size:12px">Tente ajustar os filtros</div>
</div>

<!-- Modal XML -->
<div class="modal-xml" id="modal-xml">
  <div class="modal-xml-box">
    <div style="font-size:13px;font-weight:600;color:var(--dark);margin-bottom:8px" id="modal-titulo">Gerando XML...</div>
    <div style="font-size:12px;color:var(--text-sec);margin-bottom:20px" id="modal-desc"></div>
    <div id="modal-loading"><div class="spin"></div></div>
    <div id="modal-link" style="display:none">
      <input id="modal-url" readonly style="margin-bottom:10px;font-size:11px">
      <div style="display:flex;gap:8px;justify-content:center">
        <button onclick="copiarURL()" class="btn btn-dark btn-sm">Copiar URL</button>
        <button onclick="document.getElementById('modal-xml').style.display='none'" class="btn btn-outline btn-sm">Fechar</button>
      </div>
    </div>
  </div>
</div>

<script>
const selecionados = new Set();

function toggleCard(card) {
  const id = card.dataset.id;
  const chk = document.getElementById('chk-' + id) || card.querySelector('.im-check');
  if (selecionados.has(id)) {
    selecionados.delete(id);
    card.classList.remove('sel');
    if (chk) chk.classList.remove('on');
  } else {
    selecionados.add(id);
    card.classList.add('sel');
    if (chk) chk.classList.add('on');
  }
  atualizarBarra();
}

function toggleTodos(chk) {
  document.querySelectorAll('.im-card').forEach(card => {
    if (card.style.display === 'none') return;
    const tem = selecionados.has(card.dataset.id);
    if (chk.checked && !tem) toggleCard(card);
    else if (!chk.checked && tem) toggleCard(card);
  });
}

function deselectAll() {
  document.querySelectorAll('.im-card').forEach(card => { if (selecionados.has(card.dataset.id)) toggleCard(card); });
  document.getElementById('check-todos').checked = false;
}

function atualizarBarra() {
  const barra = document.getElementById('barra-sel');
  document.getElementById('cnt-sel').textContent = selecionados.size + ' selecionado' + (selecionados.size !== 1 ? 's' : '');
  barra.style.display = selecionados.size > 0 ? 'flex' : 'none';
}

}

function copiarURL() { const u = document.getElementById('modal-url'); u.select(); document.execCommand('copy'); }


// ── FILTRO NOTION ──
const nfAtivos = {}; // { campo: { label, valor, labelValor } }

const nfCampos = [
  { grupo: 'Tipo de imóvel', campo: 'tipo', tipo: 'lista', opcoes: [
    { v:'apartamento', l:'Apartamento' }, { v:'casa', l:'Casa' }, { v:'cobertura', l:'Cobertura' },
    { v:'sobrado', l:'Sobrado' }, { v:'loft', l:'Loft' }, { v:'studio', l:'Studio' },
    { v:'kitnet', l:'Kitnet' }, { v:'duplex', l:'Duplex' }, { v:'mansao', l:'Mansão' },
    { v:'chacara', l:'Chácara' }, { v:'sitio', l:'Sítio' }, { v:'fazenda', l:'Fazenda' },
    { v:'sala', l:'Sala Comercial' }, { v:'loja', l:'Loja' }, { v:'galpao', l:'Galpão' },
    { v:'terreno', l:'Terreno' }, { v:'area rural', l:'Área Rural' }
  ]},
  { grupo: 'Transação', campo: 'operacao', tipo: 'lista', opcoes: [
    { v:'venda', l:'Venda' }, { v:'aluguel', l:'Aluguel' }, { v:'temporada', l:'Temporada' }, { v:'permuta', l:'Permuta' }
  ]},
  { grupo: 'Status', campo: 'status', tipo: 'lista', opcoes: [
    { v:'ativo', l:'Ativo' }, { v:'inativo', l:'Inativo' }, { v:'rascunho', l:'Rascunho' }
  ]},
  { grupo: 'Localização', campo: 'bairro', tipo: 'texto', label: 'Bairro' },
  { grupo: 'Localização', campo: 'cidade', tipo: 'texto', label: 'Cidade' },
  { grupo: 'Valores', campo: 'valor-min', tipo: 'numero', label: 'Valor mínimo (R$)' },
  { grupo: 'Valores', campo: 'valor-max', tipo: 'numero', label: 'Valor máximo (R$)' },
  { grupo: 'Características', campo: 'quartos', tipo: 'numero', label: 'Quartos mínimo' },
  { grupo: 'Características', campo: 'suites', tipo: 'numero', label: 'Suítes mínimo' },
  { grupo: 'Características', campo: 'vagas', tipo: 'numero', label: 'Vagas mínimo' },
  { grupo: 'Características', campo: 'banheiros', tipo: 'numero', label: 'Banheiros mínimo' },
  { grupo: 'Características', campo: 'area-min', tipo: 'numero', label: 'Área mínima (m²)' },
  { grupo: 'Mídia', campo: 'fotos', tipo: 'lista', opcoes: [
    { v:'sim', l:'Com fotos' }, { v:'nao', l:'Sem fotos' }
  ]},
  { grupo: 'Proprietário', campo: 'proprietario', tipo: 'lista', opcoes: [
    { v:'sim', l:'Com proprietário' }, { v:'nao', l:'Sem proprietário' }
  ]},
];

let nfCampoAtual = null;

function nfAbrirCampos(btn) {
  const dd = document.getElementById('nf-dropdown');
  const rect = btn.getBoundingClientRect();
  dd.style.top = (rect.bottom + window.scrollY + 4) + 'px';
  dd.style.left = rect.left + 'px';
  nfRenderCampos('');
  document.getElementById('nf-dd-search').value = '';
  document.getElementById('nf-dd-input').style.display = 'none';
  nfCampoAtual = null;
  dd.classList.add('open');
  setTimeout(() => document.getElementById('nf-dd-search').focus(), 50);
  document.addEventListener('click', nfFecharDropdown, { once: true });
}

function nfFecharDropdown(e) {
  const dd = document.getElementById('nf-dropdown');
  if (!dd.contains(e.target)) { dd.classList.remove('open'); nfCampoAtual = null; }
  else document.addEventListener('click', nfFecharDropdown, { once: true });
}

function nfFiltrarCampos(q) {
  nfRenderCampos(q.toLowerCase());
}

function nfRenderCampos(q) {
  const list = document.getElementById('nf-dd-list');
  list.innerHTML = '';
  let grupoAtual = '';
  nfCampos.filter(f => !q || f.campo.includes(q) || (f.label||'').toLowerCase().includes(q) || (f.grupo||'').toLowerCase().includes(q)).forEach(f => {
    if (f.grupo !== grupoAtual) {
      grupoAtual = f.grupo;
      const sep = document.createElement('div');
      sep.className = 'nf-dd-sep';
      sep.textContent = f.grupo;
      list.appendChild(sep);
    }
    const item = document.createElement('div');
    item.className = 'nf-dd-item' + (nfAtivos[f.campo] ? ' on' : '');
    item.textContent = f.label || f.campo;
    item.onclick = () => nfSelecionarCampo(f);
    list.appendChild(item);
  });
}

function nfSelecionarCampo(f) {
  nfCampoAtual = f;
  const list = document.getElementById('nf-dd-list');
  const input = document.getElementById('nf-dd-input');
  if (f.tipo === 'lista') {
    list.innerHTML = '';
    const back = document.createElement('div');
    back.className = 'nf-dd-item';
    back.innerHTML = '← Voltar';
    back.onclick = () => nfRenderCampos('');
    list.appendChild(back);
    f.opcoes.forEach(op => {
      const item = document.createElement('div');
      item.className = 'nf-dd-item' + (nfAtivos[f.campo]?.valor === op.v ? ' on' : '');
      item.textContent = op.l;
      item.onclick = () => { nfAplicar(f.campo, op.v, f.label||f.grupo, op.l); };
      list.appendChild(item);
    });
    input.style.display = 'none';
  } else if (f.tipo === 'numero') {
    list.innerHTML = '';
    const back = document.createElement('div');
    back.className = 'nf-dd-item';
    back.innerHTML = '← Voltar';
    back.onclick = () => nfRenderCampos('');
    list.appendChild(back);
    const num = document.getElementById('nf-dd-num');
    num.placeholder = 'Ex: ' + (f.campo.includes('valor') ? '500000' : f.campo.includes('area') ? '80' : '2');
    num.value = nfAtivos[f.campo]?.valor || '';
    input.style.display = 'block';
  } else if (f.tipo === 'texto') {
    list.innerHTML = '';
    const back = document.createElement('div');
    back.className = 'nf-dd-item';
    back.innerHTML = '← Voltar';
    back.onclick = () => nfRenderCampos('');
    list.appendChild(back);
    const num = document.getElementById('nf-dd-num');
    num.type = 'text';
    num.placeholder = 'Digite ' + (f.label||f.campo).toLowerCase() + '...';
    num.value = nfAtivos[f.campo]?.valor || '';
    input.style.display = 'block';
  }
}

function nfAplicarNum() {
  if (!nfCampoAtual) return;
  const val = document.getElementById('nf-dd-num').value.trim();
  if (!val) { nfRemover(nfCampoAtual.campo); document.getElementById('nf-dropdown').classList.remove('open'); return; }
  nfAplicar(nfCampoAtual.campo, val, nfCampoAtual.label||nfCampoAtual.grupo, val + (nfCampoAtual.campo.includes('valor') ? '' : nfCampoAtual.campo.includes('area') ? 'm²' : ''));
}

function nfAplicar(campo, valor, labelCampo, labelValor) {
  nfAtivos[campo] = { label: labelCampo, valor, labelValor };
  const el = document.getElementById('f-' + campo);
  if (el) el.value = valor;
  document.getElementById('nf-dropdown').classList.remove('open');
  nfCampoAtual = null;
  nfRenderPills();
  filtrar();
}

function nfRemover(campo) {
  delete nfAtivos[campo];
  const el = document.getElementById('f-' + campo);
  if (el) el.value = '';
  nfRenderPills();
  filtrar();
}

function nfRenderPills() {
  const bar = document.getElementById('nf-bar');
  const btnAdd = bar.querySelector('.nf-add');
  const btnClear = document.getElementById('nf-clear');
  // Remove pills antigas
  bar.querySelectorAll('.nf-pill').forEach(p => p.remove());
  const temFiltro = Object.keys(nfAtivos).length > 0;
  Object.entries(nfAtivos).forEach(([campo, { label, labelValor }]) => {
    const pill = document.createElement('div');
    pill.className = 'nf-pill';
    pill.innerHTML = '<span class="nf-pill-campo">' + label + '</span><span class="nf-pill-valor">' + labelValor + '</span><span class="nf-pill-rm" onclick="nfRemover(''+campo+'')">×</span>';
    bar.insertBefore(pill, btnAdd);
  });
  if (btnClear) btnClear.style.display = temFiltro ? 'inline-flex' : 'none';
}

function norm(v) { return (v||'').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,''); }

function filtrar() {
  const busca = norm(document.getElementById('busca').value);
  const tipo = norm(document.getElementById('f-tipo')?.value||'');
  const operacao = norm((nfAtivos['operacao']?.valor) || document.getElementById('f-operacao')?.value||'');
  const status = norm((nfAtivos['status']?.valor) || document.getElementById('f-status')?.value||'');
  const fotos = (nfAtivos['fotos']?.valor) || document.getElementById('f-fotos')?.value||'';
  const proprietario = (nfAtivos['proprietario']?.valor) || document.getElementById('f-proprietario')?.value||'';
  const bairro = norm(document.getElementById('f-bairro')?.value||'');
  const cidade = norm(document.getElementById('f-cidade')?.value||'');
  const valorMin = Number(document.getElementById('f-valor-min')?.value)||0;
  const valorMax = Number(document.getElementById('f-valor-max')?.value)||0;
  const areaMin = Number(document.getElementById('f-area-min')?.value)||0;
  const quartos = Number(document.getElementById('f-quartos')?.value)||0;
  const vagas = Number(document.getElementById('f-vagas')?.value)||0;
  const suites = Number(document.getElementById('f-suites')?.value)||0;

  let vis = 0;
  document.querySelectorAll('.im-card').forEach(card => {
    let ok = true;
    if (busca && !norm(card.dataset.tipo+card.dataset.bairro+card.dataset.cidade).includes(busca)) ok = false;
    if (tipo && !card.dataset.tipo.includes(tipo)) ok = false;
    if (bairro && !card.dataset.bairro.includes(bairro)) ok = false;
    if (cidade && !card.dataset.cidade.includes(cidade)) ok = false;
    if (valorMin && Number(card.dataset.valor) < valorMin) ok = false;
    if (valorMax && Number(card.dataset.valor) > valorMax) ok = false;
    if (areaMin && Number(card.dataset.area) < areaMin) ok = false;
    if (quartos && Number(card.dataset.quartos) < quartos) ok = false;
    if (vagas && Number(card.dataset.vagas) < vagas) ok = false;
    if (suites && Number(card.dataset.suites) < suites) ok = false;
    if (operacao && !norm(card.dataset.operacao||'').includes(operacao)) ok = false;
    if (status && norm(card.dataset.status||'') !== status) ok = false;
    if (proprietario === 'sim' && !card.dataset.proprietario) ok = false;
    if (proprietario === 'nao' && card.dataset.proprietario) ok = false;
    if (fotos === 'sim' && card.dataset.fotos === '0') ok = false;
    if (fotos === 'nao' && card.dataset.fotos !== '0') ok = false;
    card.style.display = ok ? '' : 'none';
    if (ok) vis++;
  });

  const el = document.getElementById('nf-count');
  const total = document.querySelectorAll('.im-card').length;
  if (el) el.textContent = vis < total ? vis + ' de ' + total + ' imóveis' : '';
  document.getElementById('im-empty').style.display = vis === 0 ? 'block' : 'none';
}

function limpar() {
  Object.keys(nfAtivos).forEach(k => delete nfAtivos[k]);
  ['f-tipo','f-bairro','f-cidade','f-valor-min','f-valor-max','f-area-min','f-quartos','f-vagas','f-suites','f-banheiros','f-operacao','f-status','f-proprietario','f-fotos'].forEach(id => { const el = document.getElementById(id); if(el) el.value = ''; });
  document.getElementById('busca').value = '';
  nfRenderPills();
  filtrar();
}

function atualizarStats() {
  const cards = document.querySelectorAll('.im-card');
  let ativos=0, inativos=0, semFoto=0, semProp=0;
  cards.forEach(c => {
    if (c.dataset.status === 'ativo') ativos++; else inativos++;
    if (!c.dataset.fotos || c.dataset.fotos === '0') semFoto++;
    if (!c.dataset.proprietario) semProp++;
  });
  document.getElementById('count-ativos').textContent = ativos + ' ativos';
  document.getElementById('count-inativos').textContent = inativos + ' inativos';
  document.getElementById('count-sem-foto').textContent = semFoto + ' sem foto';
  document.getElementById('count-sem-prop').textContent = semProp + ' sem prop.';
}

window.addEventListener('DOMContentLoaded', atualizarStats);
</script>

<%- include('partials/app-end') %>
