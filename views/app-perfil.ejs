<%- include('partials/app-shell',{active:'perfil',title:'Meu perfil',subtitle:'Dados da sua conta.',perfil:(user && user.tipo)||'corretor',user:user}) %>

<style>
.pf-card{
  background:#fff;
  border:0.5px solid rgba(0,0,0,.08);
  border-radius:16px;
  padding:20px;
  margin-bottom:12px;
}
.pf-card-title{
  font-size:15px;
  font-weight:500;
  color:#111827;
  margin:0 0 4px;
}
.pf-card-sub{
  font-size:13px;
  color:#9ca3af;
  margin:0 0 16px;
}
.pf-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}
@media(max-width:480px){.pf-grid{grid-template-columns:1fr}}
.pf-field label{
  display:block;
  font-size:11px;
  font-weight:500;
  color:#6b7280;
  text-transform:uppercase;
  letter-spacing:.03em;
  margin-bottom:4px;
}
.pf-field input{
  width:100%;
  padding:9px 12px;
  border:0.5px solid rgba(0,0,0,.12);
  border-radius:8px;
  font-size:14px;
  color:#111827;
  background:#fff;
  box-sizing:border-box;
  outline:none;
}
.pf-field input:focus{border-color:rgba(0,0,0,.3)}
.pf-field input[readonly]{background:#f9fafb;color:#9ca3af}
.pf-field input[readonly].strong{color:#111827;font-weight:500}
.pf-btn{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:9px 18px;
  border-radius:8px;
  font-size:13px;
  font-weight:500;
  cursor:pointer;
  border:0.5px solid rgba(0,0,0,.12);
  background:#111827;
  color:#fff;
  margin-top:14px;
}
.pf-btn:hover{background:#1f2937}
.pf-btn-outline{
  background:#fff;
  color:#374151;
  border-color:rgba(0,0,0,.12);
}
.pf-btn-outline:hover{background:#f9fafb}
.pf-btn-green{background:#22c55e;color:#fff;border-color:#16a34a}
.pf-btn-green:hover{background:#16a34a}
.pf-btn-red{background:#f9fafb;color:#6b7280;border-color:rgba(0,0,0,.1)}
.pf-btn-red:hover{background:#fee2e2;color:#b91c1c;border-color:#fca5a5}

.pf-loc-status{
  display:flex;
  align-items:center;
  gap:10px;
  padding:12px 14px;
  border-radius:8px;
  background:#f9fafb;
  border:0.5px solid rgba(0,0,0,.06);
  font-size:13px;
  color:#374151;
  margin-bottom:12px;
}

.wa-badge{
  display:inline-block;
  padding:4px 12px;
  border-radius:999px;
  font-size:12px;
  font-weight:500;
}
.wa-qr-wrap{
  display:none;
  text-align:center;
  padding:16px;
  background:#f9fafb;
  border-radius:8px;
  margin:12px 0;
}
.wa-qr-wrap p{font-size:12px;color:#6b7280;margin:0 0 10px}
.wa-qr-wrap img{width:180px;height:180px;border-radius:8px;border:0.5px solid rgba(0,0,0,.1)}
.wa-ok{
  display:none;
  padding:10px 14px;
  border-radius:8px;
  background:#f0fdf4;
  border:0.5px solid #86efac;
  font-size:13px;
  color:#15803d;
  font-weight:500;
  margin:12px 0;
}
</style>

<% if (locals.completarPerfil) {
  const _faltando = [];
  if (!user.nome || user.nome.trim() === (user.nomeImportado||'').trim()) _faltando.push('nome');
  if (!user.email) _faltando.push('e-mail');
  if (!user.lat || !user.lng) _faltando.push('localização');
%>
<div class="pf-card" style="background:#111827;color:#fff;border:none">
  <p class="pf-card-title" style="color:#fff">👋 <%= locals.bemvindo ? 'Bem-vindo(a) à MatchImóveis!' : 'Complete seu perfil pra continuar' %></p>
  <p class="pf-card-sub" style="color:#d1d5db">
    <% if (_faltando.length) { %>
      Falta preencher: <strong><%= _faltando.join(', ') %></strong>. Você só consegue usar o restante da plataforma depois de completar esses itens.
    <% } else { %>
      Quase lá — salve as alterações abaixo pra liberar o restante da plataforma.
    <% } %>
  </p>
  <% if (locals.senhaInicial) { %>
    <div style="background:rgba(255,255,255,.1);border:0.5px solid rgba(255,255,255,.2);border-radius:8px;padding:12px 14px;margin-top:8px">
      <p style="margin:0 0 4px;font-size:12px;color:#d1d5db">Sua senha inicial de acesso (anote ou troque abaixo):</p>
      <p style="margin:0;font-size:20px;font-weight:700;letter-spacing:.05em"><%= senhaInicial %></p>
    </div>
  <% } %>
</div>
<% } else if (locals.comprarPlano) { %>
<div class="pf-card" style="background:#111827;color:#fff;border:none">
  <p class="pf-card-title" style="color:#fff">🔒 Contrate um combo pra continuar</p>
  <p class="pf-card-sub" style="color:#d1d5db">Os 1.000 créditos de bônus são só pra você testar a plataforma — pra liberar o resto, escolha um dos combos de leads garantidos abaixo.</p>
</div>
<% } else if (!user.email) { %>
<div class="pf-card" style="background:#fffbeb;border-color:#fde68a">
  <p class="pf-card-title" style="color:#92400e">⚠️ Falta seu e-mail</p>
  <p class="pf-card-sub" style="color:#b45309">Complete seu e-mail abaixo pra receber notificações de leads e visitas.</p>
</div>
<% } %>

<% if (locals.planoSucesso) { %>
<div class="pf-card" style="background:#f0fdf4;border-color:#86efac">
  <p class="pf-card-title" style="color:#15803d">✅ Combo contratado com sucesso!</p>
  <p class="pf-card-sub" style="color:#166534">Seus créditos já foram adicionados à sua conta.</p>
</div>
<% } %>

<!-- Dados do usuário -->
<div class="pf-card">
  <p class="pf-card-title">Dados do usuário</p>
  <p class="pf-card-sub">Informações da sua conta no MatchImóveis.</p>
  <form method="POST" action="/app/perfil">
    <div class="pf-grid">
      <div class="pf-field">
        <label>Nome</label>
        <input name="nome" value="<%= user.nome||'' %>">
      </div>
      <div class="pf-field">
        <label>Celular</label>
        <input name="celular" value="<%= user.celular||user.telefone||'' %>">
      </div>
      <div class="pf-field">
        <label>E-mail</label>
        <input name="email" type="email" value="<%= user.email||'' %>" placeholder="seu@email.com">
      </div>
      <div class="pf-field">
        <label>CRECI</label>
        <input name="creci" value="<%= user.creci||'' %>">
      </div>
      <div class="pf-field">
        <label>CPF</label>
        <input name="cpf" value="<%= user.cpf||'' %>">
      </div>
      <div class="pf-field">
        <label>Tipo de conta</label>
        <input value="<%= user.tipo||'corretor' %>" readonly>
      </div>
      <div class="pf-field">
        <label>Código do usuário</label>
        <input value="<%= user.codigoUsuario||user.codigo||'-' %>" readonly class="strong">
      </div>
    </div>
    <button class="pf-btn" type="submit">Salvar perfil</button>
  </form>
</div>

<div class="pf-card">
  <p class="pf-card-title">📦 Combos de créditos — leads garantidos</p>
  <p class="pf-card-sub">Créditos com 35% de bônus, na faixa de cada combo de leads/mês.</p>
  <div class="pf-grid" style="grid-template-columns:repeat(3,1fr)">
    <div style="border:0.5px solid rgba(0,0,0,.1);border-radius:12px;padding:16px;text-align:center">
      <p style="margin:0 0 4px;font-size:13px;color:#6b7280">100 leads/mês</p>
      <p style="margin:0 0 4px;font-size:22px;font-weight:700;color:#111827">R$ 400</p>
      <p style="margin:0 0 12px;font-size:12px;color:#15803d">10.800 créditos (+35%)</p>
      <button class="pf-btn" style="width:100%;margin-top:0" onclick="contratarPlano('100')">Contratar</button>
    </div>
    <div style="border:0.5px solid rgba(0,0,0,.1);border-radius:12px;padding:16px;text-align:center">
      <p style="margin:0 0 4px;font-size:13px;color:#6b7280">200 leads/mês</p>
      <p style="margin:0 0 4px;font-size:22px;font-weight:700;color:#111827">R$ 700</p>
      <p style="margin:0 0 12px;font-size:12px;color:#15803d">18.900 créditos (+35%)</p>
      <button class="pf-btn" style="width:100%;margin-top:0" onclick="contratarPlano('200')">Contratar</button>
    </div>
    <div style="border:0.5px solid rgba(0,0,0,.1);border-radius:12px;padding:16px;text-align:center">
      <p style="margin:0 0 4px;font-size:13px;color:#6b7280">300 leads/mês</p>
      <p style="margin:0 0 4px;font-size:22px;font-weight:700;color:#111827">R$ 1.000</p>
      <p style="margin:0 0 12px;font-size:12px;color:#15803d">27.000 créditos (+35%)</p>
      <button class="pf-btn" style="width:100%;margin-top:0" onclick="contratarPlano('300')">Contratar</button>
    </div>
  </div>
  <p style="margin:14px 0 0;font-size:12px;color:#b45309;background:#fffbeb;border:0.5px solid #fde68a;border-radius:8px;padding:8px 12px">⚠️ Quando os créditos acabam, a plataforma bloqueia o acesso até uma nova recarga.</p>
  <% if (user.planoLeadsAtivo) { %>
    <p style="margin:14px 0 0;font-size:12px;color:#15803d">✅ Último combo contratado: <%= user.planoLeadsQtd %> leads/mês (<%= user.planoLeadsCreditos %> créditos)</p>
  <% } %>
</div>
<script>
async function contratarPlano(plano){
  try{
    const r = await fetch('/pagamento/criar-plano', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ plano })
    });
    const d = await r.json();
    if(d.ok && d.url){ window.location.href = d.url; }
    else{ alert(d.erro || 'Erro ao gerar pagamento. Tente novamente.'); }
  }catch(e){ alert('Erro ao gerar pagamento. Tente novamente.'); }
}
</script>

<div class="pf-card">
  <p class="pf-card-title">🔒 Alterar senha</p>
  <p class="pf-card-sub">Escolha uma nova senha.</p>
  <form method="POST" action="/app/perfil/senha">
    <div class="pf-field">
      <label>Nova senha</label>
      <input type="password" name="nova_senha" placeholder="Mínimo 6 caracteres" required minlength="6">
    </div>
    <div class="pf-field">
      <label>Confirmar nova senha</label>
      <input type="password" name="confirmar_senha" placeholder="Repita a nova senha" required minlength="6">
    </div>
    <% if(locals.senhaErro) { %><div style="color:#dc2626;font-size:12px;margin-bottom:12px">⚠️ <%= senhaErro %></div><% } %>
    <% if(locals.senhaSucesso) { %><div style="color:#16a34a;font-size:12px;margin-bottom:12px">✅ Senha alterada com sucesso!</div><% } %>
    <button class="pf-btn" type="submit">Alterar senha</button>
  </form>
</div>

<!-- Vitrine -->
<div class="pf-card">
  <p class="pf-card-title">🏠 Preferências de Vitrine</p>
  <p class="pf-card-sub">Escolha quais imóveis aparecem na vitrine enviada aos seus leads.</p>
  <form method="POST" action="/app/perfil/vitrine">
    <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:16px">
      <label style="display:flex;align-items:center;gap:12px;cursor:pointer;font-size:14px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:12px 16px">
        <input type="radio" name="vitrineApenasPropriosImoveis" value="false" style="width:18px;height:18px;flex-shrink:0"
          <%= (user.vitrineApenasPropriosImoveis===true) ? '' : 'checked' %>>
        <span>🌐 <strong>Meus imóveis + rede</strong> — inclui imóveis de parceiros na vitrine</span>
      </label>
      <label style="display:flex;align-items:center;gap:12px;cursor:pointer;font-size:14px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:12px 16px">
        <input type="radio" name="vitrineApenasPropriosImoveis" value="true" style="width:18px;height:18px;flex-shrink:0"
          <%= (user.vitrineApenasPropriosImoveis===true) ? 'checked' : '' %>>
        <span>🔒 <strong>Apenas meus imóveis</strong> — somente minha carteira na vitrine</span>
      </label>
    </div>
    <button class="pf-btn" type="submit">Salvar preferência</button>
  </form>
</div>
<!-- Localização -->
<div class="pf-card">
  <p class="pf-card-title">Localização</p>
  <p class="pf-card-sub">Usada para calcular distâncias até imóveis e leads.</p>
  <div id="loc-status">
    <% if(user.lat && user.lng){ %>
      <span style="color:#15803d">●</span> <span style="font-size:13px"><%= user.endereco||(user.lat+', '+user.lng) %></span>
    <% } else { %>
      <span style="color:#d97706">●</span> <span style="font-size:13px;color:#888">Localização não definida — informe o CEP abaixo.</span>
    <% } %>
  </div>
  <% const _ufs=[['AC','Acre'],['AL','Alagoas'],['AP','Amapá'],['AM','Amazonas'],['BA','Bahia'],['CE','Ceará'],['DF','Distrito Federal'],['ES','Espírito Santo'],['GO','Goiás'],['MA','Maranhão'],['MT','Mato Grosso'],['MS','Mato Grosso do Sul'],['MG','Minas Gerais'],['PA','Pará'],['PB','Paraíba'],['PR','Paraná'],['PE','Pernambuco'],['PI','Piauí'],['RJ','Rio de Janeiro'],['RN','Rio Grande do Norte'],['RS','Rio Grande do Sul'],['RO','Rondônia'],['RR','Roraima'],['SC','Santa Catarina'],['SP','São Paulo'],['SE','Sergipe'],['TO','Tocantins']]; %>
  <div style="margin-top:14px;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px">
    <div style="width:140px">
      <label style="font-size:12px;color:#6b7280;display:block;margin-bottom:4px">CEP</label>
      <input type="text" id="cep-input" placeholder="00000-000" maxlength="9" value="<%= user.cep||'' %>"
        oninput="fmtCEPPerfil(this)" style="width:100%;padding:9px 12px;border:1px solid #e5e7eb;border-radius:8px;font-size:14px">
    </div>
    <div style="grid-column:span 2">
      <label style="font-size:12px;color:#6b7280;display:block;margin-bottom:4px">Rua</label>
      <input type="text" id="rua-input" placeholder="Rua das Flores" value="<%= user.rua||'' %>"
        style="width:100%;padding:9px 12px;border:1px solid #e5e7eb;border-radius:8px;font-size:14px">
    </div>
    <div>
      <label style="font-size:12px;color:#6b7280;display:block;margin-bottom:4px">Número</label>
      <input type="text" id="numero-input" placeholder="123" value="<%= user.numero||'' %>"
        style="width:100%;padding:9px 12px;border:1px solid #e5e7eb;border-radius:8px;font-size:14px">
    </div>
    <div>
      <label style="font-size:12px;color:#6b7280;display:block;margin-bottom:4px">Bairro</label>
      <input type="text" id="bairro-input" placeholder="Centro" value="<%= user.bairro||'' %>"
        style="width:100%;padding:9px 12px;border:1px solid #e5e7eb;border-radius:8px;font-size:14px">
    </div>
    <div>
      <label style="font-size:12px;color:#6b7280;display:block;margin-bottom:4px">Cidade</label>
      <input type="text" id="cidade-input" placeholder="Cidade" value="<%= user.cidade||'' %>"
        style="width:100%;padding:9px 12px;border:1px solid #e5e7eb;border-radius:8px;font-size:14px">
    </div>
    <div>
      <label style="font-size:12px;color:#6b7280;display:block;margin-bottom:4px">Estado</label>
      <select id="estado-input" style="width:100%;padding:9px 12px;border:1px solid #e5e7eb;border-radius:8px;font-size:14px">
        <option value="">Selecione</option>
        <% _ufs.forEach(function(uf){ %>
          <option value="<%= uf[0] %>" <%= user.estado===uf[0]?'selected':'' %>><%= uf[1] %></option>
        <% }); %>
      </select>
    </div>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">
    <button type="button" id="btn-loc" class="pf-btn" style="margin-top:0;white-space:nowrap;background:#f3f4f6;color:#111827" onclick="pegarLocalizacao()">📍 Usar minha localização atual</button>
    <button type="button" class="pf-btn" style="margin-top:0;white-space:nowrap" onclick="salvarEnderecoCep()">Salvar endereço</button>
  </div>
  <div id="cep-resultado-perfil" style="display:none;margin-top:8px;font-size:12px;padding:8px 12px;border-radius:8px"></div>
  <form id="form-loc" method="POST" action="/app/perfil/localizacao" style="display:none">
    <input type="hidden" name="lat" id="inp-lat">
    <input type="hidden" name="lng" id="inp-lng">
    <input type="hidden" name="endereco" id="inp-endereco">
    <input type="hidden" name="cep" id="inp-cep">
    <input type="hidden" name="rua" id="inp-rua">
    <input type="hidden" name="numero" id="inp-numero">
    <input type="hidden" name="bairro" id="inp-bairro">
    <input type="hidden" name="cidade" id="inp-cidade">
    <input type="hidden" name="estado" id="inp-estado">
  </form>
</div>

<!-- WhatsApp -->
<div class="pf-card" id="secao-whatsapp">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px">
    <div>
      <p class="pf-card-title">WhatsApp</p>
      <p class="pf-card-sub" style="margin-bottom:0">Conecte seu número para receber leads automaticamente.</p>
      <div style="background:#fffbeb;border:1px solid #fcd34d;border-radius:10px;padding:10px 14px;margin-top:10px;font-size:12px;color:#92400e">
        ⚠️ <strong>Use um número exclusivo para o MatchImóveis</strong> — de preferência um chip profissional dedicado. Isso evita bloqueios e garante melhor entrega das mensagens.
      </div>
    </div>
    <span id="wa-badge" class="wa-badge" style="background:#f3f4f6;color:#6b7280">Verificando...</span>
  </div>

  <div class="wa-qr-wrap" id="wa-qr-wrap">
    <p>Abra WhatsApp → Dispositivos conectados → Conectar → Escaneie o QR:</p>
    <img id="wa-qr" alt="QR Code WhatsApp">
  </div>

  <div class="wa-ok" id="wa-ok">
    Conectado — <span id="wa-num"></span>
  </div>

  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <button id="btn-wa" onclick="conectarWA()" class="pf-btn pf-btn-green" style="margin-top:0">Conectar WhatsApp</button>
    <div id="wa-aviso" style="display:none;margin-top:10px;padding:10px 14px;background:#fef2f2;border-radius:8px;border:1px solid #fecaca;font-size:12px;color:#dc2626"></div>
    <button id="btn-wa-off" onclick="desconectarWA()" class="pf-btn pf-btn-red" style="display:none;margin-top:0">Desconectar</button>
  </div>
</div>

<!-- Instagram -->
<div class="pf-card" id="secao-instagram">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px">
    <div>
      <p class="pf-card-title">📸 Conectar Instagram</p>
      <p class="pf-card-sub" style="margin-bottom:0">Publique seus imóveis direto no feed ou nos stories da sua conta comercial.</p>
      <div style="background:#fef2f2;border:1px solid #fca5a5;border-radius:10px;padding:10px 14px;margin-top:10px;font-size:12px;color:#b91c1c">
        ⚠️ <strong>A conta do Instagram precisa ser Profissional (Empresa ou Criador de conteúdo)</strong> — conta pessoal comum não conecta. No app do Instagram: Perfil → menu ☰ → Configurações e privacidade → Tipo de conta e ferramentas → Mudar para conta profissional.
      </div>
    </div>
    <% if(user.instagramContaId){ %>
      <span class="wa-badge" style="background:#dcfce7;color:#15803d">Conectado</span>
    <% } else { %>
      <span class="wa-badge" style="background:#fee2e2;color:#b91c1c">Desconectado</span>
    <% } %>
  </div>

  <div id="ig-msg" style="display:none;margin-bottom:12px;padding:10px 14px;border-radius:8px;font-size:12px"></div>

  <% if(user.instagramContaId){ %>
    <p style="font-size:14px;color:#111827;margin-bottom:14px">@<%= user.instagramUsername || user.instagramContaId %></p>
    <form method="POST" action="/app/instagram/desconectar">
      <button type="submit" class="pf-btn pf-btn-red" style="margin-top:0">Desconectar</button>
    </form>
  <% } else { %>
    <a href="/app/instagram/conectar" class="pf-btn pf-btn-green" style="margin-top:0;text-decoration:none">Conectar Instagram</a>
  <% } %>
</div>

<script>
(function(){
  var p = new URLSearchParams(window.location.search);
  var msg = p.get('msg'), err = p.get('err');
  if (msg || err) {
    var box = document.getElementById('ig-msg');
    if (box) {
      box.style.display = 'block';
      box.style.background = err ? '#fef2f2' : '#f0fdf4';
      box.style.color = err ? '#dc2626' : '#16a34a';
      box.style.border = '1px solid ' + (err ? '#fecaca' : '#bbf7d0');
      box.textContent = (err ? '⚠️ ' : '✅ ') + (err || msg);
    }
  }
})();
</script>

<script>
let _cepPerfilLat = null, _cepPerfilLng = null;

function fmtCEPPerfil(input) {
  let v = input.value.replace(/\D/g,'');
  if (v.length > 5) v = v.slice(0,5) + '-' + v.slice(5,8);
  input.value = v;
  if (v.replace(/\D/g,'').length === 8) buscarCEPPerfil(v);
}

async function buscarCEPPerfil(cepFormatado) {
  const cep = cepFormatado.replace(/\D/g,'');
  const res = document.getElementById('cep-resultado-perfil');
  res.style.display = 'block';
  res.style.background = '#f9fafb'; res.style.color = '#6b7280';
  res.textContent = 'Buscando CEP...';
  try {
    const d = await (await fetch('https://viacep.com.br/ws/'+cep+'/json/')).json();
    if (d.erro) {
      res.style.background = '#fef2f2'; res.style.color = '#dc2626';
      res.textContent = 'CEP não encontrado';
      return;
    }
    document.getElementById('rua-input').value = d.logradouro || '';
    document.getElementById('bairro-input').value = d.bairro || '';
    document.getElementById('cidade-input').value = d.localidade || '';
    const sel = document.getElementById('estado-input');
    for (let i=0;i<sel.options.length;i++) if (sel.options[i].value === d.uf) { sel.selectedIndex = i; break; }
    res.style.background = '#f0fdf4'; res.style.color = '#16a34a';
    res.textContent = '✅ Endereço preenchido automaticamente';
    _cepPerfilLat = null; _cepPerfilLng = null;
    try {
      const enderecoBusca = [d.logradouro, d.bairro, d.localidade + (d.uf ? '/'+d.uf : '')].filter(Boolean).join(', ');
      const q = encodeURIComponent(enderecoBusca + ', Brasil');
      const geo = await (await fetch('https://nominatim.openstreetmap.org/search?format=json&q='+q+'&limit=1')).json();
      if (geo && geo[0]) {
        _cepPerfilLat = parseFloat(geo[0].lat);
        _cepPerfilLng = parseFloat(geo[0].lon);
      }
    } catch(e) {}
  } catch(e) {
    res.style.display = 'block';
    res.style.background = '#fef2f2'; res.style.color = '#dc2626';
    res.textContent = 'Erro ao buscar CEP';
  }
}

function salvarEnderecoCep() {
  const rua = document.getElementById('rua-input').value;
  const numero = document.getElementById('numero-input').value;
  const bairro = document.getElementById('bairro-input').value;
  const cidade = document.getElementById('cidade-input').value;
  const estado = document.getElementById('estado-input').value;
  const enderecoCompleto = [rua && numero ? rua+', '+numero : rua, bairro, cidade && estado ? cidade+'/'+estado : cidade].filter(Boolean).join(' - ');
  document.getElementById('inp-lat').value = _cepPerfilLat || '';
  document.getElementById('inp-lng').value = _cepPerfilLng || '';
  document.getElementById('inp-endereco').value = enderecoCompleto;
  document.getElementById('inp-cep').value = document.getElementById('cep-input').value;
  document.getElementById('inp-rua').value = rua;
  document.getElementById('inp-numero').value = numero;
  document.getElementById('inp-bairro').value = bairro;
  document.getElementById('inp-cidade').value = cidade;
  document.getElementById('inp-estado').value = estado;
  document.getElementById('form-loc').submit();
}

function pegarLocalizacao() {
  const btn = document.getElementById('btn-loc');
  const status = document.getElementById('loc-status');
  btn.textContent = 'Obtendo localização...';
  btn.disabled = true;

  if (!navigator.geolocation) {
    status.innerHTML = '<span style="color:#b91c1c">● Geolocalização não suportada neste navegador.</span>';
    btn.disabled = false;
    return;
  }

  navigator.geolocation.getCurrentPosition(async (pos) => {
    const lat = pos.coords.latitude;
    const lng = pos.coords.longitude;
    _cepPerfilLat = lat;
    _cepPerfilLng = lng;
    try {
      const r = await fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat='+lat+'&lon='+lng);
      const d = await r.json();
      const a = d.address || {};
      document.getElementById('rua-input').value = a.road || a.pedestrian || a.residential || '';
      document.getElementById('numero-input').value = a.house_number || '';
      document.getElementById('bairro-input').value = a.suburb || a.neighbourhood || a.city_district || '';
      document.getElementById('cidade-input').value = a.city || a.town || a.municipality || a.village || '';
      if (a.postcode) document.getElementById('cep-input').value = a.postcode;
      const sel = document.getElementById('estado-input');
      for (let i=0;i<sel.options.length;i++) if (sel.options[i].text === a.state) { sel.selectedIndex = i; break; }
      status.innerHTML = '<span style="color:#15803d">●</span> <span style="font-size:13px">Localização obtida — revise os campos e clique em Salvar</span>';
    } catch(e) {
      status.innerHTML = '<span style="color:#b91c1c">● Localização obtida, mas não foi possível identificar o endereço.</span>';
    }
    btn.textContent = '📍 Usar minha localização atual';
    btn.disabled = false;
  }, () => {
    status.innerHTML = '<span style="color:#b91c1c">● Não foi possível obter localização. Verifique as permissões do navegador.</span>';
    btn.textContent = '📍 Usar minha localização atual';
    btn.disabled = false;
  }, { enableHighAccuracy: true, timeout: 10000 });
}

// Primeiro acesso (via botão do disparo) — captura e salva a localização
// sozinho, sem esperar clique. Falha silenciosa (sem geolocalização, sem
// permissão etc): o botão manual "Usar minha localização atual" continua
// disponível pra tentar depois.
<% if ((locals.bemvindo || locals.completarPerfil) && !(user.lat && user.lng)) { %>
function _pegarLocalizacaoAutomatico() {
  if (!navigator.geolocation) return;
  navigator.geolocation.getCurrentPosition(async (pos) => {
    const lat = pos.coords.latitude;
    const lng = pos.coords.longitude;
    let a = {};
    try {
      const r = await fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat='+lat+'&lon='+lng);
      const d = await r.json();
      a = d.address || {};
    } catch(e) {}
    const rua = a.road || a.pedestrian || a.residential || '';
    const numero = a.house_number || '';
    const bairro = a.suburb || a.neighbourhood || a.city_district || '';
    const cidade = a.city || a.town || a.municipality || a.village || '';
    const cep = a.postcode || '';
    const sel = document.getElementById('estado-input');
    let estado = '';
    if (sel) for (let i=0;i<sel.options.length;i++) if (sel.options[i].text === a.state) { estado = sel.options[i].value; break; }
    const enderecoCompleto = [rua && numero ? rua+', '+numero : rua, bairro, cidade && estado ? cidade+'/'+estado : cidade].filter(Boolean).join(' - ');
    try {
      await fetch('/app/perfil/localizacao', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lat, lng, endereco: enderecoCompleto, cep, rua, numero, bairro, cidade, estado })
      });
      // Reflete na tela sem precisar recarregar (recarregar perderia o banner de boas-vindas)
      if (document.getElementById('cep-input')) document.getElementById('cep-input').value = cep;
      if (document.getElementById('rua-input')) document.getElementById('rua-input').value = rua;
      if (document.getElementById('numero-input')) document.getElementById('numero-input').value = numero;
      if (document.getElementById('bairro-input')) document.getElementById('bairro-input').value = bairro;
      if (document.getElementById('cidade-input')) document.getElementById('cidade-input').value = cidade;
      if (sel) sel.value = estado;
      const status = document.getElementById('loc-status');
      if (status) status.innerHTML = '<span style="color:#15803d">●</span> <span style="font-size:13px">'+(enderecoCompleto||(lat+', '+lng))+'</span>';
    } catch(e) {}
  }, () => {}, { enableHighAccuracy: true, timeout: 10000 });
}
_pegarLocalizacaoAutomatico();
<% } %>



let _waTimer = null;
async function checkWA() {
  try {
    const d = await (await fetch('/app/whatsapp/status')).json();
    const badge = document.getElementById('wa-badge');
    if (d.status === 'open') {
      badge.style.cssText = 'padding:4px 12px;border-radius:999px;font-size:12px;font-weight:500;background:#dcfce7;color:#15803d';
      badge.textContent = 'Conectado';
      document.getElementById('wa-ok').style.display = 'block';
      document.getElementById('wa-num').textContent = d.numero || '';
      document.getElementById('wa-qr-wrap').style.display = 'none';
      document.getElementById('btn-wa').style.display = 'none';
      document.getElementById('btn-wa-off').style.display = 'inline-flex';
      if (_waTimer) { clearInterval(_waTimer); _waTimer = null; }
    } else {
      badge.style.cssText = 'padding:4px 12px;border-radius:999px;font-size:12px;font-weight:500;background:#fee2e2;color:#b91c1c';
      badge.textContent = 'Desconectado';
      document.getElementById('wa-ok').style.display = 'none';
      document.getElementById('btn-wa').style.display = 'inline-flex';
      document.getElementById('btn-wa-off').style.display = 'none';
    }
  } catch(e) {}
}

let _waTentativas = 0;
async function conectarWA() {
  const btn = document.getElementById('btn-wa');
  const aviso = document.getElementById('wa-aviso');
  btn.textContent = 'Gerando QR...';
  btn.disabled = true;
  if (aviso) aviso.style.display = 'none';
  _waTentativas++;
  try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 15000);
    const resp = await fetch('/app/whatsapp/qrcode', { signal: controller.signal });
    clearTimeout(timeout);
    const d = await resp.json();
    _waTentativas = 0;
    if (d.base64) {
      const qrVal = d.base64;
      if (qrVal.startsWith('data:image')) {
        document.getElementById('wa-qr').src = qrVal;
      } else {
        document.getElementById('wa-qr').src = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(qrVal);
      }
      document.getElementById('wa-qr-wrap').style.display = 'block';
      btn.textContent = 'Gerar novo QR';
      btn.disabled = false;
      _waTimer = setInterval(checkWA, 3000);
    } else {
      btn.textContent = 'Tentar novamente';
      btn.disabled = false;
      if (aviso) { aviso.textContent = 'Não foi possível gerar o QR code. Clique em "Gerar novo QR" para tentar novamente.'; aviso.style.display = 'block'; }
    }
  } catch(e) {
    btn.textContent = 'Gerar novo QR';
    btn.disabled = false;
    if (aviso) { aviso.textContent = 'Conexão falhou. Clique em "Gerar novo QR" para tentar novamente.'; aviso.style.display = 'block'; }
  }
}

async function desconectarWA() {
  await fetch('/app/whatsapp/desconectar', { method: 'POST' });
  checkWA();
}

checkWA();
</script>

