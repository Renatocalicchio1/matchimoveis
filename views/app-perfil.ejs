        Aparecer no ranking público da minha região (opcional)
      </label>
      <input type="hidden" name="rankingOptIn" id="pfRankingOptInHidden" value="<%= user.rankingOptIn ? '1' : '0' %>">
    </div>
    <div style="margin:6px 0 4px">
      <button type="button" id="pfAtivarPush" class="pf-btn" style="width:auto;background:#111827">🔔 Ativar notificações urgentes</button>
      <div id="pfPushStatus" style="font-size:12px;color:var(--text-ter);margin-top:6px"></div>
    </div>
    <button class="pf-btn<%= _mostrarPopupPresente ? ' pf-btn-full' : '' %>" type="submit" id="pf-btn-salvar-perfil"><%= _mostrarPopupPresente ? '🎁 Receber meu presente' : 'Salvar perfil' %></button>
  </form>
</div>
<% if (_mostrarPopupPresente) { %></div><% } %>
<% if (!_afiliadoSimples) { %><script src="/area-atuacao-widget.js"></script><% } %>
<script>
(function(){
  const form = document.getElementById('formDadosUsuario');
  const status = document.getElementById('pf-autosave-status');
  const _perfilCompletoAntes = <%- JSON.stringify(!locals.completarPerfil) %>;
  const _nomeImportado = <%- JSON.stringify(user.nomeImportado||'') %>;
  const _temLocalizacao = <%- JSON.stringify(!!(user.lat && user.lng)) %>;

  // Ranking (Motor de Retenção, Fase 6, ver CLAUDE.md) — checkbox visível
  // só sincroniza o hidden real que vai no POST; privado por padrão.
  const _rankingCheck = document.getElementById('pfRankingOptInCheck');
  const _rankingHidden = document.getElementById('pfRankingOptInHidden');
  if (_rankingCheck && _rankingHidden) {
    _rankingCheck.addEventListener('change', function(){
      _rankingHidden.value = _rankingCheck.checked ? '1' : '0';
      _rankingHidden.dispatchEvent(new Event('input', { bubbles: true }));
    });
  }

  // Push (Motor de Retenção, Fase 7, ver CLAUDE.md) — pedido de permissão
  // só por clique explícito aqui, nunca no carregamento da página.
  function _base64ParaUint8(base64){
    const padding = '='.repeat((4 - base64.length % 4) % 4);
    const base64Seguro = (base64 + padding).replace(/-/g, '+').replace(/_/g, '/');
    const raw = atob(base64Seguro);
    return Uint8Array.from([...raw].map(function(c){ return c.charCodeAt(0); }));
  }
  const _btnPush = document.getElementById('pfAtivarPush');
  const _statusPush = document.getElementById('pfPushStatus');
  if (_btnPush) {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      _btnPush.disabled = true;
      _statusPush.textContent = 'Seu navegador não suporta notificações push.';
    } else {
      navigator.serviceWorker.ready.then(function(reg){
        return reg.pushManager.getSubscription();
      }).then(function(sub){
        if (sub) { _btnPush.textContent = '🔔 Notificações ativadas'; _btnPush.disabled = true; }
      }).catch(function(){});

      _btnPush.addEventListener('click', function(){
        _statusPush.textContent = 'Pedindo permissão...';
        Notification.requestPermission().then(function(permissao){
          if (permissao !== 'granted') { _statusPush.textContent = 'Permissão negada.'; return; }
          return fetch('/api/push/vapid-public-key').then(function(r){ return r.json(); }).then(function(d){
            return navigator.serviceWorker.ready.then(function(reg){
              return reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: _base64ParaUint8(d.chave) });
            });
          }).then(function(sub){
            return fetch('/api/push/subscribe', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ subscription: sub }) });
          }).then(function(r){ return r.json(); }).then(function(d){
            if (d.ok) { _btnPush.textContent = '🔔 Notificações ativadas'; _btnPush.disabled = true; _statusPush.textContent = 'Pronto! Só urgentes chegam por aqui.'; }
            else { _statusPush.textContent = 'Não deu pra ativar agora, tenta de novo.'; }
          });
        }).catch(function(e){ _statusPush.textContent = 'Erro: ' + e.message; });
      });
    }
  }

  <% if (!_afiliadoSimples) { %>
  // Cidades + bairros de atuação — estruturado (estado -> múltiplas cidades
  // -> múltiplos bairros reais, via /api/localidades/*, widget de chips em
  // public/area-atuacao-widget.js), pra depois dar pra rotear lead batendo
  // o bairro. Mesmo mecanismo do cadastro (landing.ejs / /demanda). Dispara
  // 'input' nos hidden pra cair no mesmo autosave abaixo.
  const UFS_BR = ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'];
  const pfSelEstado = document.getElementById('pfAreaEstadoInput');
  UFS_BR.forEach(uf => { const o = document.createElement('option'); o.value = uf; o.textContent = uf; pfSelEstado.appendChild(o); });
  const _estadoAtual = <%- JSON.stringify(user.areaAtuacaoEstado||'') %>;
  // Compatibilidade com contas que salvaram no formato antigo (1 cidade só
  // em areaAtuacaoCidade, bairros como array de string) antes da mudança
  // pra multi-cidade (ago/2026) — se não tiver o campo novo ainda, deriva
  // do antigo em vez de mostrar o perfil vazio.
  const _cidadesAtual = <%- JSON.stringify(Array.isArray(user.areaAtuacaoCidades) && user.areaAtuacaoCidades.length ? user.areaAtuacaoCidades : (user.areaAtuacaoCidade ? [user.areaAtuacaoCidade] : [])) %>;
  const _bairrosAtualRaw = <%- JSON.stringify(user.areaAtuacaoBairros||[]) %>;
  const _bairrosAtual = (_bairrosAtualRaw.length && typeof _bairrosAtualRaw[0] === 'object')
    ? _bairrosAtualRaw
    : _bairrosAtualRaw.map(b => ({ cidade: _cidadesAtual[0] || '', bairro: b })).filter(p => p.cidade && p.bairro);
  const _pfAreaSel = criarSeletorAreaAtuacao('pfArea', { onChange: () => {} });
  if (_estadoAtual) _pfAreaSel.preencher(_estadoAtual, _cidadesAtual, _bairrosAtual);
  <% } %>

  let timer;
  // Salva automaticamente enquanto o usuário preenche — sem precisar clicar
  // em "Salvar perfil". Se isso completar os requisitos obrigatórios (nome
  // trocado + e-mail + localização) de uma conta ainda em onboarding, recarrega
  // a página pra liberar o próximo passo (contratar combo).
  const _mostrarPopupPresente = <%- JSON.stringify(!!_mostrarPopupPresente) %>;
  // Popup bloqueante: trava o scroll da página por trás enquanto ele não
  // preenche e clica "Receber meu presente" (o backdrop já cobre a tela
  // inteira via CSS, isso só evita o body rolar atrás dele).
  if (_mostrarPopupPresente && document.getElementById('pf-gift-backdrop')) {
    document.body.style.overflow = 'hidden';
  }
  form.querySelectorAll('input:not([readonly])').forEach(inp => {
    inp.addEventListener('input', () => {
      clearTimeout(timer);
      status.textContent = '';
      timer = setTimeout(async () => {
        status.textContent = 'Salvando...';
        status.style.color = '#6b7280';
        try {
          const params = new URLSearchParams(new FormData(form));
          await fetch('/app/perfil', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() });
          status.textContent = '✓ Salvo automaticamente';
          status.style.color = '#15803d';
          // No fluxo do presente (campanha com afiliado), NÃO recarrega
          // sozinho aqui — quem dispara a celebração + recarrega é o clique
          // em "🎁 Receber meu presente" (listener de submit abaixo), pra
          // bexiga só subir depois que a pessoa clicar, não no meio de digitar.
          if (!_perfilCompletoAntes && !_mostrarPopupPresente) {
            const nomeAgora = form.querySelector('[name="nome"]').value.trim();
            const emailAgora = form.querySelector('[name="email"]').value.trim();
            if (nomeAgora && nomeAgora !== _nomeImportado && nomeAgora.length >= 3 && emailAgora && _temLocalizacao) {
              location.reload();
            }
          }
        } catch(e) {
          status.textContent = '';
        }
      }, 900);
    });
  });

  // Botão "🎁 Receber meu presente" — salva, mostra a celebração (bexiga
  // subindo + mensagem completa parabenizando pelo Dia do Corretor + revela
  // os créditos de boas-vindas) segurando tempo suficiente pra dar pra ler, e só
  // DEPOIS recarrega a página, revelando o formulário/fluxo normal por
  // baixo já liberado. Pedido explícito do Renato: "tem que dar tempo de o
  // usuário ler a mensagem, aí sim vai pra tela do sistema" — mensagem
  // maior (ago/2026, 2ª mudança) pediu mais tempo: segura 7s com a
  // mensagem no ar antes de começar a sumir (fade de 0.5s), reload só
  // depois disso (7.5s no total).
  if (_mostrarPopupPresente) {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      // Área de atuação (onde ele quer RECEBER lead) é diferente da
      // localização atual (capturada sozinha em segundo plano, pro mapa) —
      // sem a área preenchida o job de distribuição de lead por região não
      // tem pra onde mandar, e ele não começa a receber lead automática.
      // Obrigatória só nesse fluxo do presente (perfil comum continua sem
      // travar por isso).
      const _areaEstado = document.getElementById('pfAreaAtuacaoEstadoHidden')?.value || '';
      const _areaCidades = document.getElementById('pfAreaAtuacaoCidadesHidden')?.value || '[]';
      let _temCidade = false;
      try { _temCidade = JSON.parse(_areaCidades).length > 0; } catch(e) {}
      if (!_areaEstado || !_temCidade) {
        alert('Antes de receber seu presente, escolhe pelo menos o estado e 1 cidade onde você quer receber os leads.');
        document.getElementById('pfAreaEstadoInput')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      const btn = document.getElementById('pf-btn-salvar-perfil');
      btn.disabled = true;
      try {
        const params = new URLSearchParams(new FormData(form));
        // Marca conclusão do fluxo do presente — servidor libera o perfil
        // (precisaCompletarPerfil=false) sem esperar a localização (lat/lng),
        // que é capturada à parte em segundo plano e pode nunca terminar a
        // tempo (ver comentário em POST /app/perfil, server.js).
        params.set('presenteConcluido', '1');
        await fetch('/app/perfil', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() });
      } catch(e) {}
      const overlay = document.getElementById('pf-celebra-overlay');
      if (overlay) {
        overlay.classList.add('pf-celebra-ativo');
        setTimeout(() => overlay.classList.add('pf-celebra-sumindo'), 7000);
      }
      // Depois da celebração, some o popup e cai direto no dashboard (pedido
      // explícito do Renato) — não só recarrega o próprio /app/perfil.
      setTimeout(() => { location.href = '/app-home'; }, overlay ? 7500 : 0);
    });
  }
})();
</script>

