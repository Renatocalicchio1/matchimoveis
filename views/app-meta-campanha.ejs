          <div class="mc-field">
            <label class="mc-label">Onde anunciar</label>
            <div class="mc-plataformas">
              <label class="mc-plataforma-item"><input type="checkbox" class="mc-plataforma-edit" data-campanha="<%= c.id %>" value="facebook" <%= (!c.publico.plataformas || c.publico.plataformas.includes('facebook')) ? 'checked':'' %>> Facebook</label>
              <label class="mc-plataforma-item"><input type="checkbox" class="mc-plataforma-edit" data-campanha="<%= c.id %>" value="instagram" <%= (!c.publico.plataformas || c.publico.plataformas.includes('instagram')) ? 'checked':'' %>> Instagram</label>
              <label class="mc-plataforma-item"><input type="checkbox" class="mc-plataforma-edit" data-campanha="<%= c.id %>" value="outros" <%= (c.publico.plataformas && (c.publico.plataformas.includes('audience_network')||c.publico.plataformas.includes('messenger'))) ? 'checked':'' %>> Outros locais (Rede de Audiência e Messenger)</label>
            </div>
          </div>
          <div class="mc-field" style="margin-bottom:0">
            <label class="mc-label">Público Advantage</label>
            <select class="mc-select" id="mc-editar-advantage-<%= c.id %>" style="max-width:320px">
              <option value="0" <%= c.publico.advantageAudience===1?'':'selected' %>>Desativado — usa só o público configurado acima</option>
              <option value="1" <%= c.publico.advantageAudience===1?'selected':'' %>>Ativado — Meta pode expandir o público automaticamente</option>
            </select>
          </div>
        </div>

        <button type="button" class="mc-btn" style="margin-top:12px;font-size:12px;padding:8px 16px" onclick="salvarEdicaoCampanha(<%= c.id %>)">Salvar alterações</button>
        <span id="mc-editar-msg-<%= c.id %>" style="font-size:12px;margin-left:10px"></span>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<script>
<% var _imoveisFotos = {}; imoveis.forEach(function(i){ _imoveisFotos[i.id] = (i.fotos && i.fotos.length ? i.fotos : (i.foto ? [i.foto] : [])); }); %>
var IMOVEIS_FOTOS = <%- JSON.stringify(_imoveisFotos) %>;
var LIMITE_TITULO = 27;
var LIMITE_SECUNDARIO = 30;
var _imovelEscolhido = null;
var _objetivoEscolhido = null;
var _previewFotos = [];
var _previewFotoIdx = 0;

function atualizarContador(inputId, countId){
  var el = document.getElementById(inputId);
  var cEl = document.getElementById(countId);
  if(!el || !cEl) return;
  var max = Number(el.getAttribute('maxlength')) || 0;
  cEl.textContent = el.value.length + '/' + max;
  cEl.classList.toggle('perto', max && el.value.length >= max);
}

function carregarFotosPreview(btn){
  var id = btn.dataset.id;
  _previewFotos = (IMOVEIS_FOTOS[id] && IMOVEIS_FOTOS[id].length) ? IMOVEIS_FOTOS[id] : (btn.dataset.foto ? [btn.dataset.foto] : []);
  _previewFotoIdx = 0;
  renderPreviewFoto();
}
function previewFoto(delta){
  if(!_previewFotos.length) return;
  _previewFotoIdx = (_previewFotoIdx + delta + _previewFotos.length) % _previewFotos.length;
  renderPreviewFoto();
}
function renderPreviewFoto(){
  document.getElementById('mc-preview-img').src = _previewFotos[_previewFotoIdx] || '';
  var multi = _previewFotos.length > 1;
  document.getElementById('mc-preview-seta-prev').style.display = multi ? 'flex' : 'none';
  document.getElementById('mc-preview-seta-next').style.display = multi ? 'flex' : 'none';
  var dotsEl = document.getElementById('mc-preview-dots');
  dotsEl.innerHTML = multi ? _previewFotos.map(function(_,i){ return '<span class="mc-preview-dot'+(i===_previewFotoIdx?' on':'')+'"></span>'; }).join('') : '';
}

function escolherImovel(btn){
  document.querySelectorAll('.mc-imovel-card').forEach(function(el){ el.classList.remove('on'); });
  btn.classList.add('on');
  _imovelEscolhido = btn.dataset.id;
  carregarFotosPreview(btn);
  // Troca de imóvel reseta título/descrição pro padrão desse imóvel (texto
  // customizado do imóvel anterior não faz sentido pra um imóvel diferente).
  // Título principal e secundário partem do título do imóvel, cada um
  // truncado no limite recomendado pelo Meta pra não ficar cortado no feed
  // (27 caracteres no título, 30 no texto secundário). Descrição usa a
  // mesma legenda já gerada pra compartilhar no Instagram (GET
  // /app/instagram/preview) — mesmo texto, mesmo padrão em todo canal.
  document.getElementById('mc-titulo-principal').value = (btn.dataset.titulo||'').slice(0, LIMITE_TITULO);
  document.getElementById('mc-titulo-secundario').value = (btn.dataset.titulo||'').slice(0, LIMITE_SECUNDARIO);
  document.getElementById('mc-descricao').value = 'Carregando...';
  atualizarContador('mc-titulo-principal','mc-titulo-principal-count');
  atualizarContador('mc-titulo-secundario','mc-titulo-secundario-count');
  atualizarPreview();
  fetch('/app/instagram/preview/' + encodeURIComponent(_imovelEscolhido))
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(_imovelEscolhido !== btn.dataset.id) return; // usuário já trocou de imóvel de novo
      document.getElementById('mc-descricao').value = d.ok ? d.legenda : '';
      atualizarPreview();
    }).catch(function(){
      if(_imovelEscolhido !== btn.dataset.id) return;
      document.getElementById('mc-descricao').value = '';
      atualizarPreview();
    });
}
function escolherObjetivo(el){
  document.querySelectorAll('.mc-obj-card').forEach(function(c){ c.classList.remove('on'); });
  el.classList.add('on');
  _objetivoEscolhido = el.dataset.obj;
  document.getElementById('mc-campo-whatsapp').style.display = (_objetivoEscolhido === 'whatsapp') ? 'block' : 'none';
  document.getElementById('mc-campo-cta').style.display = (_objetivoEscolhido === 'lead_form') ? 'block' : 'none';
  atualizarPreview();
}

// campo: 'descricao' | 'titulo' | 'secundario' — cada botão fica embaixo do
// seu próprio campo e só atualiza aquele campo (os outros dois ficam como
// o corretor deixou, sem sobrescrever à toa)
function gerarTextoIA(campo, btn){
  if(!_imovelEscolhido){ alert('Escolhe um imóvel primeiro.'); return; }
  var textoOriginal = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Gerando...';
  fetch('/app/meta-ads/gerar-texto', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ imovelId: _imovelEscolhido }) })
    .then(function(r){ return r.json(); })
    .then(function(d){
      btn.disabled = false;
      btn.textContent = textoOriginal;
      if(!d.ok){ alert(d.erro || 'Erro ao gerar com IA.'); return; }
      if(campo === 'descricao'){
        document.getElementById('mc-descricao').value = d.descricao || '';
      } else if(campo === 'titulo'){
        document.getElementById('mc-titulo-principal').value = (d.titulo||'').slice(0, LIMITE_TITULO);
        atualizarContador('mc-titulo-principal','mc-titulo-principal-count');
      } else if(campo === 'secundario'){
        document.getElementById('mc-titulo-secundario').value = (d.titulo||'').slice(0, LIMITE_SECUNDARIO);
        atualizarContador('mc-titulo-secundario','mc-titulo-secundario-count');
      }
      atualizarPreview();
    }).catch(function(){
      btn.disabled = false;
      btn.textContent = textoOriginal;
      alert('Erro de conexão.');
    });
}

// Prévia do anúncio — lê direto dos campos editáveis (título/descrição),
// que o corretor pode ajustar à mão ou gerar com IA
function atualizarPreview(){
  var previewEl = document.getElementById('mc-preview');
  var vazioEl = document.getElementById('mc-preview-vazio');
  var btnImovel = document.querySelector('.mc-imovel-card.on');
  // Só o imóvel já é suficiente pra mostrar a prévia — objetivo/página, quando
  // ainda não escolhidos, entram com um valor padrão só na prévia (não afeta
  // o que de fato é criado, que exige os dois antes de "Criar campanha")
  if(!btnImovel){ previewEl.style.display = 'none'; vazioEl.style.display = 'block'; return; }

  var titulo = document.getElementById('mc-titulo-principal').value || btnImovel.dataset.titulo.slice(0, LIMITE_TITULO);
  var descricao = document.getElementById('mc-descricao').value;
  var tituloSecundario = document.getElementById('mc-titulo-secundario').value;

  var CTA_LABELS = { SIGN_UP:'Cadastre-se', LEARN_MORE:'Saiba mais', CONTACT_US:'Fale conosco', GET_QUOTE:'Peça um orçamento', APPLY_NOW:'Candidate-se', REGISTER_NOW:'Registre-se', MAKE_AN_APPOINTMENT:'Marque uma consulta', GET_IN_TOUCH:'Entre em contato' };
  var ctaLabel;
  if(_objetivoEscolhido === 'lead_form'){
    var selCta = document.getElementById('mc-cta');
    ctaLabel = CTA_LABELS[selCta.value] || 'Cadastre-se';
  } else if(_objetivoEscolhido === 'whatsapp'){
    ctaLabel = 'Enviar mensagem';
  } else {
    ctaLabel = 'Saiba mais';
  }
  var selPagina = document.getElementById('mc-pagina');
  var nomePagina = (selPagina && selPagina.selectedIndex >= 0 && selPagina.options[selPagina.selectedIndex]) ? selPagina.options[selPagina.selectedIndex].text : 'Sua Página';

  document.getElementById('mc-preview-pagina').textContent = nomePagina;
  document.getElementById('mc-preview-cta-label').textContent = ctaLabel;
  document.getElementById('mc-preview-texto').textContent = descricao;
  document.getElementById('mc-preview-titulo').textContent = titulo;
  document.getElementById('mc-preview-cta').textContent = ctaLabel;

  var secWrap = document.getElementById('mc-preview-secundario-wrap');
  if(tituloSecundario){
    document.getElementById('mc-preview-secundario').textContent = tituloSecundario;
    secWrap.style.display = 'flex';
  } else {
    secWrap.style.display = 'none';
  }

  previewEl.style.display = 'block';
  vazioEl.style.display = 'none';
}

// Editar/excluir campanhas já criadas — botões ficam sempre visíveis na
// lista de "Campanhas criadas" (mesmo se a conta do Meta foi desconectada
// depois; nesse caso a rota do servidor retorna erro pedindo pra reconectar).
// O painel de edição só carrega a prévia/públicos salvos na 1ª vez que abre
// (data-loaded), pra não disparar fetch à toa em toda campanha da lista.
var CTA_LABELS_EDICAO = { SIGN_UP:'Cadastre-se', LEARN_MORE:'Saiba mais', CONTACT_US:'Fale conosco', GET_QUOTE:'Peça um orçamento', APPLY_NOW:'Candidate-se', REGISTER_NOW:'Registre-se', MAKE_AN_APPOINTMENT:'Marque uma consulta', GET_IN_TOUCH:'Entre em contato' };
var _previewFotosEdicao = {};
var _previewFotoIdxEdicao = {};

function toggleEditarCampanha(id){
  var el = document.getElementById('mc-editar-'+id);
  var abrir = (el.style.display === 'none');
  el.style.display = abrir ? 'block' : 'none';
  if(abrir && el.dataset.loaded !== '1'){
    el.dataset.loaded = '1';
    carregarFotosPreviewEdicao(id);
    carregarPublicosSalvosEdicao(id);
    atualizarPreviewEdicao(id);
  }
}

function carregarFotosPreviewEdicao(id){
  var imovelId = document.getElementById('mc-editar-'+id).dataset.imovel;
  _previewFotosEdicao[id] = IMOVEIS_FOTOS[imovelId] || [];
  _previewFotoIdxEdicao[id] = 0;
  renderPreviewFotoEdicao(id);
}
function previewFotoEdicao(id, delta){
  var fotos = _previewFotosEdicao[id] || [];
  if(!fotos.length) return;
  _previewFotoIdxEdicao[id] = ((_previewFotoIdxEdicao[id]||0) + delta + fotos.length) % fotos.length;
  renderPreviewFotoEdicao(id);
}
function renderPreviewFotoEdicao(id){
  var fotos = _previewFotosEdicao[id] || [];
  var idx = _previewFotoIdxEdicao[id] || 0;
  var previewEl = document.getElementById('mc-editar-preview-'+id);
  var vazioEl = document.getElementById('mc-editar-preview-vazio-'+id);
  if(!fotos.length){ previewEl.style.display = 'none'; vazioEl.style.display = 'block'; return; }
  previewEl.style.display = 'block';
  vazioEl.style.display = 'none';
  document.getElementById('mc-editar-preview-img-'+id).src = fotos[idx] || '';
  var multi = fotos.length > 1;
  document.getElementById('mc-editar-preview-seta-prev-'+id).style.display = multi ? 'flex' : 'none';
  document.getElementById('mc-editar-preview-seta-next-'+id).style.display = multi ? 'flex' : 'none';
  var dotsEl = document.getElementById('mc-editar-preview-dots-'+id);
  dotsEl.innerHTML = multi ? fotos.map(function(_,i){ return '<span class="mc-preview-dot'+(i===idx?' on':'')+'"></span>'; }).join('') : '';
}

function gerarTextoIAEdicao(id, campo, btn){
  var imovelId = document.getElementById('mc-editar-'+id).dataset.imovel;
  var textoOriginal = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Gerando...';
  fetch('/app/meta-ads/gerar-texto', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ imovelId: imovelId }) })
    .then(function(r){ return r.json(); })
    .then(function(d){
      btn.disabled = false;
      btn.textContent = textoOriginal;
      if(!d.ok){ alert(d.erro || 'Erro ao gerar com IA.'); return; }
      if(campo === 'descricao'){
        document.getElementById('mc-editar-descricao-'+id).value = d.descricao || '';
      } else if(campo === 'titulo'){
        document.getElementById('mc-editar-titulo-'+id).value = (d.titulo||'').slice(0, LIMITE_TITULO);
        atualizarContador('mc-editar-titulo-'+id, 'mc-editar-titulo-count-'+id);
      } else if(campo === 'secundario'){
        document.getElementById('mc-editar-secundario-'+id).value = (d.titulo||'').slice(0, LIMITE_SECUNDARIO);
        atualizarContador('mc-editar-secundario-'+id, 'mc-editar-secundario-count-'+id);
      }
      atualizarPreviewEdicao(id);
    }).catch(function(){
      btn.disabled = false;
      btn.textContent = textoOriginal;
      alert('Erro de conexão.');
    });
}

function atualizarPreviewEdicao(id){
  var titulo = document.getElementById('mc-editar-titulo-'+id).value;
  var descricao = document.getElementById('mc-editar-descricao-'+id).value;
  var secundario = document.getElementById('mc-editar-secundario-'+id).value;
  var ctaEl = document.getElementById('mc-editar-cta-'+id);
  var ctaLabel = ctaEl ? (CTA_LABELS_EDICAO[ctaEl.value] || 'Cadastre-se') : 'Saiba mais';
  document.getElementById('mc-editar-preview-cta-label-'+id).textContent = ctaLabel;
  document.getElementById('mc-editar-preview-texto-'+id).textContent = descricao;
  document.getElementById('mc-editar-preview-titulo-'+id).textContent = titulo;
  document.getElementById('mc-editar-preview-cta-'+id).textContent = ctaLabel;
  var secWrap = document.getElementById('mc-editar-preview-secundario-wrap-'+id);
  if(secundario){
    document.getElementById('mc-editar-preview-secundario-'+id).textContent = secundario;
    secWrap.style.display = 'flex';
  } else {
    secWrap.style.display = 'none';
  }
}

function carregarPublicosSalvosEdicao(id){
  var contaAnuncioId = document.getElementById('mc-editar-'+id).dataset.conta;
  var sel = document.getElementById('mc-editar-publico-salvo-'+id);
  var atual = sel.dataset.atual || '';
  if(!contaAnuncioId){ return; }
  sel.innerHTML = '<option value="">Carregando...</option>';
  fetch('/app/meta-ads/publicos-salvos?contaAnuncioId=' + encodeURIComponent(contaAnuncioId))
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(!d.ok || !d.publicos.length){ sel.innerHTML = '<option value="">Personalizar abaixo</option>'; return; }
      sel.innerHTML = '<option value="">Personalizar abaixo</option>' + d.publicos.map(function(p){ return '<option value="'+p.id+'"'+(p.id===atual?' selected':'')+'>'+p.name+'</option>'; }).join('');
    }).catch(function(){ sel.innerHTML = '<option value="">Personalizar abaixo</option>'; });
}
function alternarCamposPublicoEdicao(id){
  var salvo = document.getElementById('mc-editar-publico-salvo-'+id).value;
  document.getElementById('mc-editar-publico-manual-'+id).style.display = salvo ? 'none' : 'block';
}

function salvarEdicaoCampanha(id){
  var msgEl = document.getElementById('mc-editar-msg-'+id);
  msgEl.textContent = 'Salvando...';
  msgEl.style.color = '#9ca3af';

  var publicoSalvoId = document.getElementById('mc-editar-publico-salvo-'+id).value;
  var publico = {
    raioKm: Number(document.getElementById('mc-editar-raio-'+id).value) || 10,
    idadeMin: Number(document.getElementById('mc-editar-idade-min-'+id).value) || 18,
    idadeMax: Number(document.getElementById('mc-editar-idade-max-'+id).value) || 65,
    genero: document.getElementById('mc-editar-genero-'+id).value
  };
  if(!publicoSalvoId){
    var plataformas = Array.prototype.slice.call(document.querySelectorAll('.mc-plataforma-edit[data-campanha="'+id+'"]:checked')).map(function(el){ return el.value; });
    if(!plataformas.length){ msgEl.textContent = 'Escolha ao menos um local pra anunciar.'; msgEl.style.color = '#dc2626'; return; }
    publico.plataformas = plataformas;
    publico.advantageAudience = Number(document.getElementById('mc-editar-advantage-'+id).value) || 0;
  }

  var ctaEl = document.getElementById('mc-editar-cta-'+id);
  var body = {
    orcamentoDiario: document.getElementById('mc-editar-orcamento-'+id).value,
    status: document.getElementById('mc-editar-status-'+id).value,
    tituloAnuncio: document.getElementById('mc-editar-titulo-'+id).value,
    descricaoAnuncio: document.getElementById('mc-editar-descricao-'+id).value,
    tituloSecundario: document.getElementById('mc-editar-secundario-'+id).value,
    ctaLeadForm: ctaEl ? ctaEl.value : '',
    publicoSalvoId: publicoSalvoId,
    publico: publico
  };

  fetch('/app/meta-ads/campanha/'+id+'/editar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) })
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(d.ok){ location.reload(); }
      else { msgEl.textContent = d.erro || 'Erro ao salvar.'; msgEl.style.color = '#dc2626'; }
    }).catch(function(){ msgEl.textContent = 'Erro de conexão.'; msgEl.style.color = '#dc2626'; });
}
function excluirCampanha(id){
  if(!confirm('Excluir esta campanha? Ela é removida do Meta também (não só daqui).')) return;
  fetch('/app/meta-ads/campanha/'+id+'/excluir', { method:'POST' })
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(d.ok){ location.reload(); }
      else { alert(d.erro || 'Erro ao excluir.'); }
    }).catch(function(){ alert('Erro de conexão.'); });
}

<% if(user.metaAdsToken){ %>
(function carregarContas(){
  fetch('/app/meta-ads/contas').then(function(r){ return r.json(); }).then(function(d){
    var selConta = document.getElementById('mc-conta');
    var selPagina = document.getElementById('mc-pagina');
    if(!d.ok){
      selConta.innerHTML = '<option value="">Erro ao carregar</option>';
      selPagina.innerHTML = '<option value="">Erro ao carregar</option>';
      return;
    }
    selConta.innerHTML = d.contas.length ? d.contas.map(function(c){ return '<option value="'+c.id+'">'+c.name+'</option>'; }).join('') : '<option value="">Nenhuma conta encontrada</option>';
    selPagina.innerHTML = d.paginas.length ? d.paginas.map(function(p){ return '<option value="'+p.id+'">'+p.name+'</option>'; }).join('') : '<option value="">Nenhuma página encontrada</option>';
    atualizarPreview();
    carregarPublicosSalvos();
  }).catch(function(){
    document.getElementById('mc-conta').innerHTML = '<option value="">Erro ao carregar</option>';
    document.getElementById('mc-pagina').innerHTML = '<option value="">Erro ao carregar</option>';
  });
})();

// Públicos salvos dependem da Conta de Anúncios escolhida — recarrega
// sempre que ela muda (inclusive na 1ª carga, disparado por carregarContas)
function carregarPublicosSalvos(){
  var contaAnuncioId = document.getElementById('mc-conta').value;
  var sel = document.getElementById('mc-publico-salvo');
  if(!contaAnuncioId){ sel.innerHTML = '<option value="">Personalizar abaixo</option>'; alternarCamposPublico(); return; }
  sel.innerHTML = '<option value="">Carregando...</option>';
  fetch('/app/meta-ads/publicos-salvos?contaAnuncioId=' + encodeURIComponent(contaAnuncioId))
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(!d.ok || !d.publicos.length){ sel.innerHTML = '<option value="">Personalizar abaixo</option>'; alternarCamposPublico(); return; }
      sel.innerHTML = '<option value="">Personalizar abaixo</option>' + d.publicos.map(function(p){ return '<option value="'+p.id+'">'+p.name+'</option>'; }).join('');
      alternarCamposPublico();
    }).catch(function(){ sel.innerHTML = '<option value="">Personalizar abaixo</option>'; alternarCamposPublico(); });
}
function alternarCamposPublico(){
  var salvo = document.getElementById('mc-publico-salvo').value;
  document.getElementById('mc-publico-manual').style.display = salvo ? 'none' : 'block';
}

function criarCampanha(){
  var msgEl = document.getElementById('mc-msg-criar');
  msgEl.style.display = 'none';
  if(!_imovelEscolhido){ msgEl.className='mc-msg err'; msgEl.textContent='Escolha um imóvel.'; msgEl.style.display='block'; return; }
  if(!_objetivoEscolhido){ msgEl.className='mc-msg err'; msgEl.textContent='Escolha o objetivo da campanha.'; msgEl.style.display='block'; return; }
  var contaAnuncioId = document.getElementById('mc-conta').value;
  var pageId = document.getElementById('mc-pagina').value;
  var orcamento = document.getElementById('mc-orcamento').value;
  if(!contaAnuncioId || !pageId){ msgEl.className='mc-msg err'; msgEl.textContent='Escolha a Conta de Anúncios e a Página.'; msgEl.style.display='block'; return; }
  if(!orcamento || Number(orcamento) < 1){ msgEl.className='mc-msg err'; msgEl.textContent='Informe o orçamento diário.'; msgEl.style.display='block'; return; }

  var publicoSalvoId = document.getElementById('mc-publico-salvo').value;
  var genero = document.getElementById('mc-genero').value;
  var publico = { raioKm: Number(document.getElementById('mc-raio').value) || 10, idadeMin: Number(document.getElementById('mc-idade-min').value) || 18, idadeMax: Number(document.getElementById('mc-idade-max').value) || 65, genero: genero };
  if(!publicoSalvoId){
    var plataformas = Array.prototype.slice.call(document.querySelectorAll('.mc-plataforma:checked')).map(function(el){ return el.value; });
    if(!plataformas.length){ msgEl.className='mc-msg err'; msgEl.textContent='Escolha ao menos um local pra anunciar.'; msgEl.style.display='block'; return; }
    publico.plataformas = plataformas;
    publico.advantageAudience = Number(document.getElementById('mc-advantage-audience').value) || 0;
  }

  var body = {
    imovelId: _imovelEscolhido,
    objetivo: _objetivoEscolhido,
    contaAnuncioId: contaAnuncioId,
    pageId: pageId,
    orcamentoDiario: orcamento,
    tituloAnuncio: document.getElementById('mc-titulo-principal').value,
    descricaoAnuncio: document.getElementById('mc-descricao').value,
    tituloSecundario: document.getElementById('mc-titulo-secundario').value,
    ctaLeadForm: document.getElementById('mc-cta') ? document.getElementById('mc-cta').value : '',
    whatsappNumero: document.getElementById('mc-whatsapp') ? document.getElementById('mc-whatsapp').value.replace(/\D/g,'') : '',
    publicoSalvoId: publicoSalvoId,
    publico: publico
  };

  var btn = document.getElementById('mc-btn-criar');
  btn.disabled = true;
  btn.textContent = 'Criando...';
  fetch('/app/meta-ads/campanha', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) })
    .then(function(r){ return r.json(); })
    .then(function(d){
      btn.disabled = false;
      btn.textContent = 'Criar campanha (fica pausada — você revisa e ativa no Gerenciador de Anúncios)';
      if(d.ok){
        location.reload();
      } else {
        msgEl.className='mc-msg err'; msgEl.textContent = d.erro || 'Erro ao criar campanha.'; msgEl.style.display='block';
      }
    }).catch(function(){
      btn.disabled = false;
      btn.textContent = 'Criar campanha (fica pausada — você revisa e ativa no Gerenciador de Anúncios)';
      msgEl.className='mc-msg err'; msgEl.textContent='Erro de conexão.'; msgEl.style.display='block';
    });
}
<% } %>
</script>

