<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Página não encontrada<% if(typeof siteConfig !== 'undefined' && siteConfig && siteConfig.rodapeNome){ %> · <%= siteConfig.rodapeNome %><% } %></title>
  <meta name="robots" content="noindex">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{ --brand:<%= (typeof siteConfig !== 'undefined' && siteConfig && siteConfig.corPrimaria) || '#FF385C' %>; --ink:#16181A; --paper:#FBF9F6; --muted:#716C61; }
    body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--paper);color:var(--ink);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;-webkit-font-smoothing:antialiased}
    .box{text-align:center;max-width:420px}
    .ico{font-size:44px;margin-bottom:16px}
    h1{font-size:22px;font-weight:800;letter-spacing:-.4px;margin-bottom:8px}
    p{color:var(--muted);font-size:14.5px;line-height:1.6;margin-bottom:24px}
    a.btn{display:inline-flex;align-items:center;gap:8px;background:var(--brand);color:#fff;text-decoration:none;padding:12px 24px;border-radius:10px;font-weight:700;font-size:14px}
    a.btn:hover{filter:brightness(.94)}
  </style>
</head>
<body>
  <div class="box">
    <div class="ico">🏠</div>
    <h1><%= typeof titulo !== 'undefined' ? titulo : 'Página não encontrada' %></h1>
    <p><%= typeof mensagem !== 'undefined' ? mensagem : 'O link que você acessou não existe ou não está mais disponível.' %></p>
    <% if(typeof siteBasePath !== 'undefined' && siteBasePath !== null){ %>
    <a href="<%= siteBasePath || '/' %>" class="btn">← Ver todos os imóveis</a>
    <% } %>
  </div>
</body>
</html>
