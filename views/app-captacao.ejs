<%- include("partials/app-shell",{active:"captacao",user:user}) %>
<style>
/* Cards — mesmo padrão visual de app-leads.ejs (mesmas classes/valores), pra
   não confundir o corretor: cada lead vira um bloco visual próprio, igual
   ao kanban de leads, em vez da tabela corrida de antes. */
.lead-card{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:14px 16px;margin-bottom:10px;transition:box-shadow .15s;position:relative}
.lead-card:hover{box-shadow:0 2px 12px rgba(0,0,0,.06)}
.lead-card.lc-captado{border-left:2px solid #16a34a}
.lead-card.lc-pendente{border-left:2px solid #f59e0b}
.lc-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:9px}
.acao-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:999px;font-size:10.5px;font-weight:600;border:none}
.lead-nome{font-size:14.5px;font-weight:600;color:#111827;text-decoration:none;display:block;margin-bottom:1px}
.lead-nome:hover{color:#FC642D}
.lead-tel{font-size:12px;color:#6b7280;margin-bottom:10px}
.lc-chips{display:flex;flex-wrap:wrap;align-items:center;gap:5px;margin-bottom:10px}
.lc-chip{font-size:10.5px;font-weight:600;padding:3px 9px;border-radius:999px;border:none;text-decoration:none;display:inline-flex;align-items:center;gap:3px}
.lc-chip.origem{background:#f3f4f6;color:#6b7280}
.lc-chip.temimovel{background:#f0fdf4;color:#166534}
.lc-divider{height:1px;background:#f0f0ee;margin:10px 0}
.lead-btns{display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding-top:10px;border-top:1px solid #f0f0ee;margin-top:2px}
.lb{font-size:12px;padding:0;border-radius:0;text-decoration:none;font-weight:600;border:none;color:#6b7280;background:none;cursor:pointer;transition:color .1s;display:inline-flex;align-items:center;gap:5px}
.lb:hover{color:#111827}
.lb.wa{color:#0E7268}
.lb.prim{color:#FF385C}
.lb.danger{color:#FF385C;margin-left:auto}
.lc-imoveis-titulo{font-size:11px;font-weight:600;color:#374151;margin-bottom:6px}
.lc-imovel-row{display:flex;align-items:center;gap:8px;padding:8px 10px;background:#f9fafb;border-radius:8px;margin-bottom:6px;font-size:12px;flex-wrap:wrap}
.pct-badge{padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap;display:inline-block}
.pct-low{background:#fef2f2;color:#dc2626}
.pct-mid{background:#fffbeb;color:#92400e}
.pct-high{background:#f0fdf4;color:#16a34a}
@media(max-width:640px){
  .cap-linkbox{flex-wrap:wrap}
  .cap-linkbox-actions{align-items:stretch;width:100%}
  .cap-linkbox-btns{width:100%}
  .cap-linkbox-btns button{flex:1}
  .cap-linkbox-actions span{white-space:normal;text-align:right}
}
</style>
<div style="max-width:1200px;margin:0 auto;padding:24px 16px">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
    <h1 style="font-size:20px;font-weight:700;margin:0">📋 Captação de Imóveis</h1>
    <span style="font-size:13px;color:#6b7280"><%= leads.length %> lead(s) com imóvel para captar</span>
  </div>
<script>
function pctClasseJS(p){ return p>=67 ? 'pct-high' : p>=34 ? 'pct-mid' : 'pct-low'; }
async function marcarCaptado(leadId, tel, nomeEnc){
  const nome = decodeURIComponent(nomeEnc);
  const r = await fetch('/app/captacao/marcar/'+leadId, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({})});
  const d = await r.json();
  const div = document.getElementById('imoveis-'+leadId);
  if(!div) return location.reload();
  if(!d.imoveis || !d.imoveis.length){
    div.innerHTML = '<p style="font-size:12px;color:#6b7280;padding:8px">Nenhum imóvel encontrado para este contato.</p>';
  } else {
    div.innerHTML = '<div style="padding:8px;background:#f9fafb;border-radius:8px;margin-top:6px"><p style="font-size:11px;font-weight:600;color:#374151;margin-bottom:6px">Imóveis encontrados:</p>' +
    d.imoveis.map(i => {
      const link = 'https://matchimoveis.ia.br/imovel/'+(i.id_interno||i.id);
      const msgWA = encodeURIComponent('Olá '+nome+'! Segue o link do seu imóvel cadastrado: '+link);
      const wa = 'https://wa.me/55'+tel.replace(/\D/g,'').replace(/^55/,'')+'?text='+msgWA;
      return '<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:12px">' +
        '<span>🏠 '+i.titulo+'</span>' +
        '<span class="pct-badge '+pctClasseJS(i.percentual)+'">'+i.percentual+'%</span>' +
        '<a href="'+wa+'" target="_blank" style="background:#25D366;color:#fff;padding:3px 8px;border-radius:5px;font-size:11px;font-weight:600;text-decoration:none">📲 Enviar</a>' +
        '</div>';
    }).join('') + '</div>';
  }
  div.style.display='block';
}
// 1 botão só, pergunta em 2 passos: primeiro confirma a exclusão do imóvel,
// depois pergunta se a lead sai junto (Cancelar = só o imóvel, lead continua).
async function excluirImovelCap(imovelId, leadId){
  if(!confirm('Excluir este imóvel?')) return;
  const comLead = confirm('Excluir a lead também?\n\nOK = imóvel + lead (não dá pra desfazer)\nCancelar = só o imóvel, a lead continua');
  await fetch('/app/captacao/imovel/'+imovelId+'/excluir', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify(comLead ? {leadId} : {})
  });
  location.reload();
}
async function excluirLeadCap(leadId, nomeEnc){
  const nome = decodeURIComponent(nomeEnc);
  if(!confirm('Excluir a lead "'+nome+'"?\n\nOs imóveis já cadastrados por ela continuam na sua carteira — só a lead sai do funil. Não dá pra desfazer.')) return;
  const r = await fetch('/app/lead/'+leadId, { method:'DELETE' });
  const d = await r.json();
  if(d.ok) location.reload(); else alert('Erro ao excluir: '+(d.erro||''));
}
</script>
  <div class="cap-linkbox" style="background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:16px;margin-bottom:20px;display:flex;align-items:center;gap:12px">
    <div style="flex:1;min-width:0">
      <p style="font-size:13px;font-weight:600;margin-bottom:4px">🔗 Link de captação para enviar aos seus leads</p>
      <p style="font-size:12px;color:#6b7280">Envie este link para leads que possam ter imóvel para vender ou alugar</p>
      <p style="font-size:11px;color:#9ca3af;margin-top:4px">💡 Leads que tiverem email cadastrado já recebem este link automaticamente por email assim que entram no sistema, seja qual for o canal (WhatsApp, planilha, portal ou manual) — não precisa reenviar pra elas.</p>
    </div>
    <div class="cap-linkbox-actions" style="display:flex;flex-direction:column;align-items:flex-end;gap:6px">
      <div class="cap-linkbox-btns" style="display:flex;gap:8px">
        <button onclick="copiarLink()" style="background:#fff;color:#374151;border:1px solid #e5e7eb;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap">📋 Copiar link</button>
        <button onclick="compartilharLink()" style="background:#FF385C;color:#fff;border:none;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap">📤 Compartilhar link</button>
      </div>
      <span style="font-size:11px;color:#9ca3af;white-space:nowrap">Compartilhe com possíveis proprietários</span>
    </div>
  </div>
  <script>
  function copiarLink(){
    const link = 'https://matchimoveis.ia.br/captar/<%= user.id||user.codigoUsuario %>';
    navigator.clipboard.writeText(link);
    alert('Link copiado!');
  }
  function compartilharLink(){
    const link = 'https://matchimoveis.ia.br/captar/<%= user.id||user.codigoUsuario %>';
    const msg = 'Você tem um imóvel para vender ou alugar? 🏠 Cadastre em poucos minutos e deixe seu imóvel disponível pra quem está procurando: ' + link;
    window.open('https://wa.me/?text=' + encodeURIComponent(msg), '_blank');
  }
  </script>
  <% if(leads.length === 0) { %>
    <div style="text-align:center;padding:60px;color:#9ca3af">
      <div style="font-size:40px;margin-bottom:12px">📋</div>
      <p>Nenhuma lead sinalizou imóvel para captar ainda.</p>
      <p style="font-size:12px">Quando um lead informar que tem imóvel para vender ou alugar, aparecerá aqui.</p>
    </div>
  <% } else { %>
  <div>
    <% function pctClasse(p){ return p>=67 ? 'pct-high' : p>=34 ? 'pct-mid' : 'pct-low'; } %>
    <% leads.forEach(function(l){
      const dados = l.dados || {};
      const perfil = l.perfil_ia || {};
      const _primeiroVinculado = (l.imoveisRelacionados && l.imoveisRelacionados[0]) || null;
      const imovelCaptado = dados.imovelCaptadoId || (_primeiroVinculado && (_primeiroVinculado.id_interno||_primeiroVinculado.id));
      const _tipoImovel = dados.tipoImovelCaptar||perfil.tipo||(_primeiroVinculado&&_primeiroVinculado.tipo)||'';
    %>
    <% const _telCel = (l.telefone||l.whatsapp||'').replace(/\D/g,'').replace(/^55/,''); %>
    <% const _linkContato = 'https://matchimoveis.ia.br/captar/'+(user.codigoUsuario||user.id)+(_primeiroVinculado ? ('?imovelId='+(_primeiroVinculado.id_interno||_primeiroVinculado.id)) : ''); %>
    <% const _msgContato = encodeURIComponent('Oi ' + (l.nome||'') + '! Veja como está ficando o cadastro do seu imóvel: ' + _linkContato); %>
    <div class="lead-card <%= imovelCaptado ? 'lc-captado' : 'lc-pendente' %>">
      <div class="lc-head">
        <% if(imovelCaptado) { %>
          <span class="acao-badge" style="background:#f0fdf4;color:#16a34a">✅ Captado</span>
        <% } else { %>
          <span class="acao-badge" style="background:#fffbeb;color:#92400e">⏳ Pendente</span>
        <% } %>
      </div>

      <a href="/app/lead/<%= l.id %>" class="lead-nome"><%= l.nome||'Sem nome' %></a>
      <div class="lead-tel"><%= l.email||'sem e-mail' %><% if(_telCel){ %> · <%= _telCel %><% } %></div>

      <% if(_tipoImovel || dados.transacaoCaptar || _primeiroVinculado) { %>
      <div class="lc-chips">
        <% if(_tipoImovel){ %><span class="lc-chip origem">🏠 <%= _tipoImovel %></span><% } %>
        <% if(dados.transacaoCaptar){ %><span class="lc-chip temimovel"><%= dados.transacaoCaptar %></span><% } %>
        <% if(_primeiroVinculado){ %><span class="pct-badge <%= pctClasse(_primeiroVinculado.percentual) %>"><%= _primeiroVinculado.percentual %>% preenchido</span><% } %>
      </div>
      <% } %>

      <div class="lc-divider"></div>

      <div class="lead-btns">
        <% if(_telCel){ %><a href="https://wa.me/55<%= _telCel %>?text=<%= _msgContato %>" target="_blank" class="lb wa">💬 Falar no WhatsApp</a><% } %>
        <% if(!_primeiroVinculado) { %>
          <a href="https://matchimoveis.onrender.com/app/cadastro" class="lb prim">+ Cadastrar imóvel</a>
        <% } %>
        <button onclick="excluirLeadCap('<%= l.id %>', '<%= encodeURIComponent(l.nome||'essa lead') %>')" class="lb danger">🗑️ Excluir lead</button>
      </div>

      <% if(l.imoveisRelacionados && l.imoveisRelacionados.length > 0) { %>
      <div class="lc-divider"></div>
      <p class="lc-imoveis-titulo">🏠 Imóveis vinculados</p>
      <% l.imoveisRelacionados.forEach(function(im){ %>
      <% const _tel2 = (l.telefone||l.whatsapp||'').replace(/\D/g,'').replace(/^55/,''); %>
      <% const _semFoto = !im.fotos || !im.fotos.length; %>
      <% const _linkCadastro = 'https://matchimoveis.ia.br/captar/'+(user.codigoUsuario||user.id)+'?imovelId='+(im.id_interno||im.id); %>
      <% const _msgCadastro = encodeURIComponent('Oi '+(l.nome||'')+'! Veja como está ficando o cadastro do seu imóvel: '+_linkCadastro); %>
      <% const _dataEntradaObj = im.criado_em ? new Date(im.criado_em) : null; %>
      <% const _dataEntrada = _dataEntradaObj ? _dataEntradaObj.toLocaleDateString('pt-BR', {timeZone:'America/Sao_Paulo'}) + ' às ' + _dataEntradaObj.toLocaleTimeString('pt-BR', {timeZone:'America/Sao_Paulo', hour:'2-digit', minute:'2-digit'}) : null; %>
      <div class="lc-imovel-row">
        <span style="flex:1">🏠 <%= im.titulo||im.tipo %> · <%= im.bairro||'' %> · R$ <%= im.valor_imovel?Number(im.valor_imovel).toLocaleString('pt-BR'):'—' %><% if(_dataEntrada) { %> · <span style="color:#9ca3af">entrou em <%= _dataEntrada %></span><% } %></span>
        <% if(_semFoto) { %><span style="background:#fef3c7;color:#92400e;padding:3px 8px;border-radius:5px;font-size:11px;font-weight:600;white-space:nowrap">⚠️ Sem foto</span><% } %>
        <span class="pct-badge <%= pctClasse(im.percentual) %>"><%= im.percentual %>%</span>
        <% if(_tel2) { %><a href="https://wa.me/55<%= _tel2 %>?text=<%= _msgCadastro %>" target="_blank" style="background:#25D366;color:#fff;padding:3px 8px;border-radius:5px;font-size:11px;font-weight:600;text-decoration:none;white-space:nowrap">💬 Falar no WhatsApp</a><% } %>
        <a href="https://matchimoveis.onrender.com/app/imovel/<%= im.id_interno||im.id %>/editar" style="background:#00A699;color:#fff;padding:3px 8px;border-radius:5px;font-size:11px;font-weight:700;text-decoration:none;white-space:nowrap">✏️ Editar para completar</a>
        <a href="https://www.matchimoveis.ia.br/imovel/<%= im.id_interno||im.id %>?userId=<%= user.codigoUsuario||user.id %>&preview=1" target="_blank" style="color:#16a34a;font-size:11px;font-weight:600;white-space:nowrap">🔗 Link público</a>
        <button onclick="excluirImovelCap('<%= im.id_interno||im.id %>', '<%= l.id %>')" style="background:#fef2f2;color:#dc2626;padding:3px 8px;border-radius:5px;font-size:11px;font-weight:600;border:1px solid #fca5a5;cursor:pointer;white-space:nowrap">🗑️ Excluir</button>
      </div>
      <% }); %>
      <% } %>

      <div id="imoveis-<%= l.id %>" style="display:none"></div>
    </div>
    <% }); %>
  </div>
  <% } %>
</div>
