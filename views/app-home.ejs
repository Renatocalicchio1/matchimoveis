<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard · MatchImóveis</title>
<link rel="stylesheet" href="/styles.css">
<style>
:root{--dg:#0a0c10;--dc:#111318;--db:rgba(255,255,255,0.07);--dt:#e8eaf0;--dm:#6b7280;--gr:#10d98a;--gr2:#0f9e64;--rd:#f04f4f;--bl:#3b8bff;--am:#f5a623;--pu:#a78bfa;--tl:#2dd4bf}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--dg);color:var(--dt);font-family:'Inter',system-ui,sans-serif;min-height:100vh}
.wrap{padding:20px 24px;max-width:1400px;margin:0 auto}
.hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
.logo{font-size:18px;font-weight:600;letter-spacing:-.5px}.logo span{color:var(--gr)}
.clock{font-family:monospace;font-size:12px;color:var(--dm);background:var(--dc);border:1px solid var(--db);padding:4px 10px;border-radius:8px}
.pulse{width:7px;height:7px;border-radius:50%;background:var(--gr);display:inline-block;margin-right:5px;animation:p 2s infinite}
@keyframes p{0%,100%{opacity:1}50%{opacity:.3}}
.tickers{display:flex;gap:8px;margin-bottom:20px;overflow-x:auto;padding-bottom:4px}
.tk{background:var(--dc);border:1px solid var(--db);border-radius:10px;padding:10px 14px;min-width:140px;flex-shrink:0;position:relative;overflow:hidden}
.tk::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px}
.tk.g::after{background:var(--gr)}.tk.b::after{background:var(--bl)}.tk.a::after{background:var(--am)}.tk.t::after{background:var(--tl)}.tk.p::after{background:var(--pu)}.tk.r::after{background:var(--rd)}
.tl{font-size:10px;color:var(--dm);text-transform:uppercase;letter-spacing:.7px;margin-bottom:3px}
.tv{font-family:monospace;font-size:20px;font-weight:500}
.td{font-size:10px;margin-top:3px}.td.up{color:var(--gr)}.td.n{color:var(--dm)}
.grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}
.card{background:var(--dc);border:1px solid var(--db);border-radius:14px;padding:16px 18px;animation:si .4s ease both}
@keyframes si{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.card:nth-child(1){animation-delay:.05s}.card:nth-child(2){animation-delay:.1s}.card:nth-child(3){animation-delay:.15s}.card:nth-child(4){animation-delay:.2s}.card:nth-child(5){animation-delay:.25s}.card:nth-child(6){animation-delay:.3s}.card:nth-child(7){animation-delay:.35s}.card:nth-child(8){animation-delay:.4s}
.ch{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.ct{font-size:10px;text-transform:uppercase;letter-spacing:.7px;color:var(--dm);font-weight:500}
.badge{font-size:10px;padding:2px 7px;border-radius:20px;font-weight:500}
.bg{background:rgba(16,217,138,.12);color:var(--gr)}.bb{background:rgba(59,139,255,.12);color:var(--bl)}.ba{background:rgba(245,166,35,.12);color:var(--am)}.br{background:rgba(240,79,79,.12);color:var(--rd)}
.fbar{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.fl{font-size:11px;color:var(--dm);width:70px;flex-shrink:0}
.ftrack{flex:1;height:7px;background:rgba(255,255,255,.06);border-radius:4px;overflow:hidden}
.ffill{height:100%;border-radius:4px}
.fnum{font-family:monospace;font-size:11px;width:30px;text-align:right}
.hgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-top:6px}
.hc{aspect-ratio:1;border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:500}
.h0{background:rgba(255,255,255,.04)}.h1{background:rgba(59,139,255,.25);color:var(--bl)}.h2{background:rgba(16,217,138,.25);color:var(--gr)}.h3{background:rgba(245,166,35,.35);color:var(--am)}.h4{background:rgba(240,79,79,.4);color:var(--rd)}
.li{display:flex;align-items:center;gap:9px;padding:7px 0;border-bottom:1px solid var(--db)}
.li:last-child{border-bottom:none}
.av{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;flex-shrink:0}
.ln{font-size:12px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lo{font-size:10px;color:var(--dm)}
.dot{width:5px;height:5px;border-radius:50%;flex-shrink:0}
.ir{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--db)}
.ir:last-child{border-bottom:none}
.irk{font-family:monospace;font-size:10px;color:var(--dm);width:14px}
.iti{font-size:11px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ilo{font-size:10px;color:var(--dm)}
.imc{font-family:monospace;font-size:12px;color:var(--gr);flex-shrink:0}
.gw{display:flex;flex-direction:column;align-items:center}
.s2{grid-column:span 2}.s3{grid-column:span 3}
.acao{display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:9px;text-decoration:none;color:var(--dt);font-size:12px;margin-bottom:6px;transition:opacity .15s}
.acao:hover{opacity:.8}
@media(max-width:900px){.grid{grid-template-columns:1fr 1fr}.s2{grid-column:span 2}.s3{grid-column:span 2}}
@media(max-width:600px){.wrap{padding:12px}.grid{grid-template-columns:1fr}.s2,.s3{grid-column:span 1}.tickers{gap:5px}}
.bnav{position:fixed;bottom:0;left:0;right:0;background:rgba(10,12,16,.95);border-top:1px solid var(--db);display:flex;justify-content:space-around;padding:8px 0 14px;backdrop-filter:blur(12px)}
.ni{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:10px;color:var(--dm);text-decoration:none;padding:0 12px}
.ni.active,.ni:hover{color:var(--gr)}
.ni span{font-size:18px}
</style>
</head>
<body>
<div class="wrap">
<div class="hdr">
  <div style="display:flex;align-items:center;gap:12px">
    <div class="logo">Match<span>Imóveis</span></div>
    <div class="clock"><span class="pulse"></span><span id="clk">--:--:--</span></div>
  </div>
  <div style="display:flex;align-items:center;gap:10px">
    <a href="/app/notificacoes" style="color:var(--dm);text-decoration:none;font-size:18px;position:relative">🔔<% if(locals.naoLidas&&naoLidas.length>0){%><span style="position:absolute;top:-3px;right:-3px;background:var(--rd);color:#fff;font-size:9px;padding:1px 3px;border-radius:8px"><%=naoLidas.length%></span><%}%></a>
    <a href="/app/perfil" style="width:32px;height:32px;border-radius:50%;background:rgba(16,217,138,.15);border:1px solid var(--gr2);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:var(--gr);text-decoration:none"><%=(user.nome||'?').charAt(0).toUpperCase()%></a>
  </div>
</div>

<div class="tickers">
  <div class="tk g"><div class="tl">Imóveis</div><div class="tv" id="ti"><%=stats.imoveisAtivos%></div><div class="td up">↑ carteira</div></div>
  <div class="tk b"><div class="tl">Leads</div><div class="tv" id="tl"><%=stats.leadsNovos%></div><div class="td n">pipeline</div></div>
  <div class="tk a"><div class="tl">Com match</div><div class="tv" id="tm"><%=stats.comMatch%></div><div class="td up">↑ <%=stats.taxaMatch%>% taxa</div></div>
  <div class="tk t"><div class="tl">Visitas</div><div class="tv" id="tv"><%=stats.visitasAgendadas%></div><div class="td n">agendadas</div></div>
  <div class="tk p"><div class="tl">Hoje</div><div class="tv" id="th"><%=stats.visitasHoje%></div><div class="td n">visitas hoje</div></div>
  <div class="tk r"><div class="tl">Matches</div><div class="tv"><%=stats.matchesGerados%></div><div class="td up">↑ total</div></div>
</div>

<div class="grid">

<div class="card s2">
  <div class="ch"><span class="ct">Funil de leads</span><span class="badge bb">ao vivo</span></div>
  <%var ft=Math.max(stats.funnelLeads||1,1);var fd=[
    {l:'Total',v:stats.funnelLeads,c:'var(--bl)',p:100},
    {l:'Qualific.',v:Math.round(ft*.55),c:'var(--pu)',p:55},
    {l:'Match',v:stats.funnelMatch,c:'var(--am)',p:Math.round((stats.funnelMatch/ft)*100)},
    {l:'Vitrine',v:stats.funnelVitrine||0,c:'var(--gr)',p:Math.round(((stats.funnelVitrine||0)/ft)*100)},
    {l:'Visita',v:stats.visitasAgendadas,c:'var(--tl)',p:Math.round((stats.visitasAgendadas/ft)*100)},
  ];%>
  <%fd.forEach(function(f){%>
  <div class="fbar"><span class="fl"><%=f.l%></span><div class="ftrack"><div class="ffill" style="width:<%=f.p%>%;background:<%=f.c%>"></div></div><span class="fnum"><%=f.v%></span></div>
  <%});%>
</div>

<div class="card">
  <div class="ch"><span class="ct">Taxa de match</span><span class="badge bg">LIVE</span></div>
  <div class="gw">
    <%var tp=stats.taxaMatch||0;var tr=(tp/100)*180;var trad=(tr-180)*Math.PI/180;var tx=(70+50*Math.cos(trad)).toFixed(1);var ty=(70+50*Math.sin(trad)).toFixed(1);var gc=tp>60?'var(--gr)':tp>30?'var(--am)':'var(--rd)';%>
    <svg width="140" height="80" viewBox="0 0 140 80">
      <path d="M 20 70 A 50 50 0 0 1 120 70" fill="none" stroke="rgba(255,255,255,.08)" stroke-width="10" stroke-linecap="round"/>
      <path d="M 20 70 A 50 50 0 0 1 <%=tx%> <%=ty%>" fill="none" stroke="<%=gc%>" stroke-width="10" stroke-linecap="round"/>
    </svg>
    <div style="font-family:monospace;font-size:26px;font-weight:500;color:<%=gc%>;margin-top:-6px"><%=tp%>%</div>
    <div style="font-size:10px;color:var(--dm);margin-top:3px">leads com match</div>
  </div>
</div>

<div class="card">
  <div class="ch"><span class="ct">Calor do pipeline</span><span class="badge ba">heatmap</span></div>
  <div style="display:flex;gap:6px;font-size:9px;color:var(--dm);margin-bottom:6px">
    <span><span style="display:inline-block;width:7px;height:7px;border-radius:2px;background:rgba(240,79,79,.4);margin-right:3px"></span>Hot</span>
    <span><span style="display:inline-block;width:7px;height:7px;border-radius:2px;background:rgba(245,166,35,.35);margin-right:3px"></span>Morno</span>
    <span><span style="display:inline-block;width:7px;height:7px;border-radius:2px;background:rgba(16,217,138,.25);margin-right:3px"></span>Ativo</span>
    <span><span style="display:inline-block;width:7px;height:7px;border-radius:2px;background:rgba(59,139,255,.25);margin-right:3px"></span>Frio</span>
  </div>
  <div class="hgrid" id="hm"></div>
</div>

<div class="card s2">
  <div class="ch"><span class="ct">Leads recentes</span><a href="/app/leads" style="font-size:10px;color:var(--bl);text-decoration:none">ver todos →</a></div>
  <%var cores=['rgba(16,217,138,.15)','rgba(59,139,255,.15)','rgba(167,139,250,.15)','rgba(245,166,35,.15)','rgba(240,79,79,.15)'];var coresT=['var(--gr)','var(--bl)','var(--pu)','var(--am)','var(--rd)'];var rec=locals.recentes||[];%>
  <%if(!rec.length){%><div style="text-align:center;padding:20px;color:var(--dm);font-size:12px">Nenhum lead ainda</div><%}%>
  <%rec.slice(0,5).forEach(function(l,i){var tm=(l.matches&&l.matches.length>0)||(l.matchesAuto&&l.matchesAuto.length>0);%>
  <div class="li">
    <div class="av" style="background:<%=cores[i%5]%>;color:<%=coresT[i%5]%>"><%=(l.nome||'?').charAt(0).toUpperCase()%></div>
    <div style="flex:1;min-width:0"><div class="ln"><%=l.nome||l.telefone||'Lead'%></div><div class="lo"><%=l.origem||'WhatsApp'%> · <%=(l.perfilIA&&l.perfilIA.cidade)||l.cidade||'—'%></div></div>
    <%if(tm){%><span class="badge bg">match</span><%}%>
    <div class="dot" style="background:<%=tm?'var(--gr)':'var(--dm)'%>"></div>
  </div>
  <%});%>
</div>

<div class="card">
  <div class="ch"><span class="ct">Top imóveis</span><a href="/app/imoveis" style="font-size:10px;color:var(--bl);text-decoration:none">ver todos →</a></div>
  <%var top=locals.topImoveis||[];%>
  <%if(!top.length){%><div style="text-align:center;padding:16px;color:var(--dm);font-size:11px">Sem dados</div><%}%>
  <%top.slice(0,5).forEach(function(im,i){%>
  <div class="ir">
    <span class="irk">#<%=i+1%></span>
    <div style="flex:1;min-width:0"><div class="iti"><%=im.titulo||im.tipo||'Imóvel'%></div><div class="ilo"><%=im.bairro||''%><%=im.cidade?', '+im.cidade:''%></div></div>
    <span class="imc"><%=im.cnt||0%></span>
  </div>
  <%});%>
</div>

<div class="card s2">
  <div class="ch"><span class="ct">Leads por canal — 7 dias</span><span class="badge bb">gráfico</span></div>
  <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:8px;font-size:10px;color:var(--dm)">
    <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#3b8bff;margin-right:3px"></span>WhatsApp</span>
    <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#10d98a;margin-right:3px"></span>VivaReal</span>
    <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#f5a623;margin-right:3px"></span>ZAP</span>
    <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#a78bfa;margin-right:3px"></span>ImovelWeb</span>
  </div>
  <div style="position:relative;height:160px"><canvas id="cc" role="img" aria-label="Leads por canal"></canvas></div>
</div>

<div class="card">
  <div class="ch"><span class="ct">Ações rápidas</span></div>
  <a href="/app/imovel/novo" class="acao" style="background:rgba(16,217,138,.08);border:1px solid rgba(16,217,138,.2)">🏠 Cadastrar imóvel</a>
  <a href="/app/leads" class="acao" style="background:rgba(59,139,255,.08);border:1px solid rgba(59,139,255,.2)">👥 Ver leads</a>
  <a href="/app/visitas" class="acao" style="background:rgba(167,139,250,.08);border:1px solid rgba(167,139,250,.2)">📅 Agendar visita</a>
  <a href="/app/portais" class="acao" style="background:rgba(245,166,35,.08);border:1px solid rgba(245,166,35,.2)">📡 Portais / XML</a>
</div>

</div>
<div style="height:75px"></div>
</div>

<nav class="bnav">
  <a href="/app-home" class="ni active"><span>📊</span>Dashboard</a>
  <a href="/app/imoveis" class="ni"><span>🏠</span>Imóveis</a>
  <a href="/app/leads" class="ni"><span>👥</span>Leads</a>
  <a href="/app/visitas" class="ni"><span>📅</span>Visitas</a>
  <a href="/app/perfil" class="ni"><span>👤</span>Perfil</a>
</nav>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
setInterval(function(){var d=new Date();document.getElementById('clk').textContent=d.toLocaleTimeString('pt-BR');},1000);
document.getElementById('clk').textContent=new Date().toLocaleTimeString('pt-BR');

var hm=document.getElementById('hm');
for(var i=0;i<28;i++){var c=document.createElement('div');var v=Math.floor(Math.random()*5);c.className='hc h'+v;c.textContent=v>0?v:'';c.title=['Inativo','Frio','Ativo','Morno','Hot'][v];hm.appendChild(c);}

new Chart(document.getElementById('cc'),{type:'bar',data:{labels:['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'],datasets:[
  {label:'WhatsApp',data:[3,5,4,6,4,2,1],backgroundColor:'rgba(59,139,255,.7)',borderRadius:3},
  {label:'VivaReal',data:[1,2,3,2,3,1,0],backgroundColor:'rgba(16,217,138,.7)',borderRadius:3},
  {label:'ZAP',data:[2,1,2,3,2,0,0],backgroundColor:'rgba(245,166,35,.7)',borderRadius:3},
  {label:'ImovelWeb',data:[1,1,1,2,1,0,0],backgroundColor:'rgba(167,139,250,.7)',borderRadius:3}
]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{stacked:true,grid:{color:'rgba(255,255,255,.04)'},ticks:{color:'#6b7280',font:{size:10}}},y:{stacked:true,grid:{color:'rgba(255,255,255,.04)'},ticks:{color:'#6b7280',font:{size:10}}}}}});

function anim(id,final){var el=document.getElementById(id);if(!el)return;var s=Date.now();function f(){var p=Math.min((Date.now()-s)/700,1);el.textContent=Math.round(p*final);if(p<1)requestAnimationFrame(f);}requestAnimationFrame(f);}
anim('ti',<%=stats.imoveisAtivos%>);anim('tl',<%=stats.leadsNovos%>);anim('tm',<%=stats.comMatch%>);anim('tv',<%=stats.visitasAgendadas%>);anim('th',<%=stats.visitasHoje%>);
</script>
</body>
</html>
