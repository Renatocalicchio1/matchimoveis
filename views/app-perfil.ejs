  <% if (user.planoLeadsAtivo) { %>
    <p style="margin:14px 0 0;font-size:12px;color:#15803d">✅ Último combo contratado: R$ <%= user.planoLeadsValor %> (<%= user.planoLeadsCreditos %> créditos)</p>
  <% } %>
</div>
<script>
async function contratarPlano(plano){
  try{
    const r = await fetch('/pagamento/criar-plano', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ plano })
    });
    const d = await r.json();
    if(d.ok && d.url){ window.location.href = d.url; }
    else{ alert(d.erro || 'Erro ao gerar pagamento. Tente novamente.'); }
  }catch(e){ alert('Erro ao gerar pagamento. Tente novamente.'); }
}
// Veio direto do link "Recarregar agora" do e-mail de saldo baixo
// (?combo=100/200/300/r200/ilimitado, ver services/jobCreditos.js) — já
// dispara a compra sozinho, sem precisar procurar o combo na tela.
<% if (typeof comboAuto !== 'undefined' && comboAuto) { %>
contratarPlano(<%- JSON.stringify(comboAuto) %>);
<% } %>
</script>
