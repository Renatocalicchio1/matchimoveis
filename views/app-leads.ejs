    '<button data-action="excluir" data-id="' + id + '" style="padding:10px;border-radius:8px;border:0.5px solid #fca5a5;background:#fee2e2;color:#991b1b;font-size:12px;font-weight:600;cursor:pointer">🗑 Excluir lead</button>' +
    '<button data-action="bloquear" data-id="' + id + '" style="padding:10px;border-radius:8px;border:0.5px solid #e5e7eb;background:#f9fafb;color:#374151;font-size:12px;font-weight:600;cursor:pointer">🚫 Excluir e bloquear</button>' +
    '<button data-action="fechar" style="padding:10px;border-radius:8px;border:0.5px solid #e5e7eb;background:#fff;color:#9ca3af;font-size:12px;cursor:pointer">Cancelar</button>' +
    '</div>';
  document.getElementById('mini-modal-acoes').style.display = 'flex';
}

function fecharMiniModal() {
  document.getElementById('mini-modal-acoes').style.display = 'none';
}
document.addEventListener('DOMContentLoaded', function() {
  const _miniModalAcoes = document.getElementById('mini-modal-body');
  if (!_miniModalAcoes) return;
  _miniModalAcoes.addEventListener('click', function(e) {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    const action = btn.dataset.action;
    const id = btn.dataset.id;
    const tipo = btn.dataset.tipo;
    if (action === 'classificar') classificarLead(id, tipo);
    else if (action === 'excluir') excluirLead(id);
    else if (action === 'bloquear') bloquearLead(id);
    else if (action === 'fechar') fecharMiniModal();
  });
});
</script>


