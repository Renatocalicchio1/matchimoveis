<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tenho imóvel para captar — MatchImóveis</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f9fafb;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.card{background:#fff;border-radius:16px;padding:32px;max-width:480px;width:100%;box-shadow:0 4px 24px rgba(0,0,0,.08)}
.top-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}
.logo{color:#FF385C;font-size:22px;font-weight:800}
.dots{display:flex;gap:6px}
.dots span{width:7px;height:7px;border-radius:50%;background:#e5e7eb}
.dots span.on{background:#FF385C}
.dots span.done{background:#00A699}
h2{font-size:18px;font-weight:700;margin-bottom:8px}
p.sub{font-size:14px;color:#6b7280;margin-bottom:24px}
.btn-group{display:flex;flex-direction:column;gap:12px;margin-bottom:8px}
.btn-op{padding:16px;border-radius:10px;border:2px solid #e5e7eb;background:#fff;font-size:15px;font-weight:600;cursor:pointer;text-align:left;transition:all .15s}
.btn-op:hover{border-color:#FF385C;background:#fff5f6}
.btn-op.selected{border-color:#FF385C;background:#fff5f6}
.btn-op[disabled]{opacity:.45;cursor:not-allowed}
.form-group{margin-bottom:16px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form-row.cep-row{grid-template-columns:1fr auto}
label{font-size:13px;font-weight:600;color:#374151;display:block;margin-bottom:6px}
input,select{width:100%;padding:10px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:14px;font-family:inherit}
input:focus,select:focus{outline:none;border-color:#FF385C}
.btn-cep{padding:0 16px;border-radius:8px;border:1.5px solid #e5e7eb;background:#f9fafb;font-size:13px;font-weight:700;color:#374151;cursor:pointer;white-space:nowrap}
.btn-cep:hover{border-color:#FF385C;color:#FF385C}
.btn-cep[disabled]{opacity:.5;cursor:not-allowed}
.cep-msg{font-size:12px;margin-top:-10px;margin-bottom:14px}
.cep-msg.err{color:#dc2626}
.cep-msg.ok{color:#00847a}
.hint{font-size:12px;color:#9ca3af;margin-top:-10px;margin-bottom:16px}
.btn-submit{width:100%;padding:14px;background:#FF385C;color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:700;cursor:pointer;margin-top:8px}
.btn-submit[disabled]{opacity:.5;cursor:not-allowed}
.btn-voltar{width:100%;padding:10px;background:transparent;color:#6b7280;border:none;font-size:13px;font-weight:600;cursor:pointer;margin-top:10px}
.sucesso{text-align:center;padding:40px 0}
.sucesso .icon{font-size:48px;margin-bottom:16px}
</style>
</head>
<body>
<div class="card">

  <!-- Barra fixa "veja como está ficando" — só aparece quando já existe um
       imóvel em andamento (chegou aqui pelo link com ?imovelId= ou já
       começou o cadastro nessa sessão), pra dono acompanhar o anúncio indo
       e voltando quantas vezes quiser, mesmo sem foto ainda (?preview=1 em
       /imovel/:id ignora a checagem normal de "sem foto"/valor mínimo). -->
  <div id="preview-bar" style="display:none;margin-bottom:16px;padding:10px 14px;background:#f0fdfa;border:1px solid #99f6e4;border-radius:10px;font-size:13px;color:#0f766e;align-items:center;justify-content:space-between;gap:10px">
    <span>👀 Veja como seu anúncio está ficando</span>
    <a id="preview-link" href="#" target="_blank" style="background:#00A699;color:#fff;padding:6px 12px;border-radius:8px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap">Ver anúncio →</a>
  </div>

  <!-- TELA 1 — identificação + intenção -->
  <div id="step1">
    <div class="top-row"><div class="logo">MatchImóveis</div></div>
    <h2>Você tem imóvel para vender ou alugar?</h2>
    <p class="sub">Conta pra gente quem é você e o que você tem — seu corretor recebe na hora.</p>
    <div class="form-group">
      <label>Seu nome</label>
      <input type="text" id="s1-nome" placeholder="Nome completo">
    </div>
    <div class="form-row">
      <div class="form-group"><label>Seu celular</label><input type="text" id="s1-celular" placeholder="Ex: 11999999999" value="<%= telPreenchido %>"></div>
      <div class="form-group"><label>Email (opcional)</label><input type="email" id="s1-email" placeholder="voce@email.com"></div>
    </div>
    <div class="btn-group">
      <button class="btn-op" id="btn-venda" onclick="selecionar('venda')">🏠 Tenho imóvel para <strong>vender</strong></button>
      <button class="btn-op" id="btn-aluguel" onclick="selecionar('aluguel')">🔑 Tenho imóvel para <strong>alugar</strong></button>
      <button class="btn-op" id="btn-nao" onclick="selecionar('nao')">❌ Não tenho imóvel para oferecer</button>
    </div>
    <div id="step1-msg" class="cep-msg err"></div>
  </div>

  <!-- TELA 2 — tipo + endereço via CEP -->
  <div id="step2" style="display:none">
    <div class="top-row"><div class="logo">MatchImóveis</div><div class="dots"><span class="done"></span><span class="on"></span><span></span><span></span><span></span></div></div>
    <h2>Onde fica o imóvel?</h2>
    <p class="sub">Preenchemos o endereço automático a partir do CEP.</p>
    <div class="form-group">
      <label>Tipo de imóvel</label>
      <select id="s2-tipo">
        <option value="">Selecione...</option>
        <optgroup label="Residencial">
          <option value="Apartamento">Apartamento</option>
          <option value="Casa">Casa</option>
          <option value="Cobertura">Cobertura</option>
          <option value="Sobrado">Sobrado</option>
          <option value="Loft">Loft</option>
          <option value="Studio">Studio / Flat</option>
          <option value="Kitnet">Kitnet / Conjugado</option>
          <option value="Duplex">Duplex</option>
          <option value="Mansão">Mansão</option>
          <option value="Chácara">Chácara</option>
          <option value="Sítio">Sítio</option>
          <option value="Fazenda">Fazenda</option>
          <option value="Casa de Condomínio">Casa de Condomínio</option>
          <option value="Flat">Flat / Apart Hotel</option>
        </optgroup>
        <optgroup label="Comercial">
          <option value="Sala Comercial">Sala Comercial</option>
          <option value="Loja">Loja</option>
          <option value="Conjunto Comercial">Conjunto Comercial</option>
          <option value="Galpão">Galpão / Depósito</option>
          <option value="Prédio Comercial">Prédio Comercial</option>
          <option value="Hotel">Hotel / Pousada</option>
          <option value="Consultório">Consultório</option>
          <option value="Restaurante">Restaurante / Bar</option>
        </optgroup>
        <optgroup label="Terrenos">
          <option value="Terreno">Terreno / Lote</option>
          <option value="Terreno Comercial">Terreno Comercial</option>
          <option value="Área Rural">Área Rural</option>
        </optgroup>
      </select>
    </div>
    <div class="form-row cep-row">
      <div class="form-group"><label>CEP</label><input type="text" id="s2-cep" placeholder="00000-000" maxlength="9"></div>
      <button type="button" class="btn-cep" id="btn-buscar-cep" onclick="buscarCep()" style="margin-top:22px">🔍 Buscar</button>
    </div>
    <p class="cep-msg" style="margin:4px 0 0"><a href="#" onclick="naoSeiCep();return false" style="color:#00A699;text-decoration:underline">Não sei o CEP — quero preencher o endereço na mão</a></p>
    <div id="cep-msg" class="cep-msg" style="margin-top:4px"></div>
    <div id="cep-resultado" style="display:none">
      <div class="form-group"><label>Rua</label><input type="text" id="s2-rua"></div>
      <div class="form-row">
        <div class="form-group"><label>Bairro</label><input type="text" id="s2-bairro"></div>
        <div class="form-group"><label>Cidade / UF</label><input type="text" id="s2-cidade-uf"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Número</label><input type="text" id="s2-numero" placeholder="Ex: 123"></div>
        <div class="form-group"><label>Complemento</label><input type="text" id="s2-complemento" placeholder="Opcional"></div>
      </div>
    </div>
    <button class="btn-submit" id="btn-step2-continuar" onclick="continuarStep2()" disabled>Continuar →</button>
  </div>

  <!-- TELA 3 — cômodos e área -->
  <div id="step3" style="display:none">
    <div class="top-row"><div class="logo">MatchImóveis</div><div class="dots"><span class="done"></span><span class="done"></span><span class="on"></span><span></span><span></span></div></div>
    <h2 id="step3-titulo">Um pouco mais sobre o imóvel</h2>
    <p class="sub">Se não souber algum número exato, pode deixar em branco.</p>
    <div id="campos-comodos">
    <div class="form-row">
      <div class="form-group"><label>Quartos</label><input type="number" id="s3-quartos" min="0" placeholder="0"></div>
      <div class="form-group"><label>Suítes</label><input type="number" id="s3-suites" min="0" placeholder="0"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>Banheiros</label><input type="number" id="s3-banheiros" min="0" placeholder="0"></div>
      <div class="form-group"><label>Vagas</label><input type="number" id="s3-vagas" min="0" placeholder="0"></div>
    </div>
    </div>
    <div class="form-group"><label>Área (m²)</label><input type="number" id="s3-area" min="0" placeholder="Ex: 80"></div>
    <button class="btn-submit" onclick="continuarStep3()">Continuar →</button>
  </div>

  <!-- TELA 4 — valor -->
  <div id="step4" style="display:none">
    <div class="top-row"><div class="logo">MatchImóveis</div><div class="dots"><span class="done"></span><span class="done"></span><span class="done"></span><span class="on"></span><span></span></div></div>
    <h2>Qual o valor pretendido?</h2>
    <p class="sub">Falta só uma etapa.</p>
    <div class="form-group"><label>Valor pretendido (R$)</label><input type="text" id="s4-valor" placeholder="Ex: 350000"></div>
    <button class="btn-submit" onclick="continuarStep4()">Continuar →</button>
  </div>

  <!-- TELA 5 — fotos -->
  <div id="step5" style="display:none">
    <div class="top-row"><div class="logo">MatchImóveis</div><div class="dots"><span class="done"></span><span class="done"></span><span class="done"></span><span class="done"></span><span class="on"></span></div></div>
    <h2>Tem foto do imóvel?</h2>
    <p class="sub">Última etapa — imóvel com foto recebe muito mais interesse. Se não tiver agora, pode enviar depois pro seu corretor.</p>
    <div class="form-group">
      <label>Fotos do imóvel</label>
      <input type="file" id="s5-fotos" accept="image/*" multiple>
    </div>
    <div id="s5-msg" class="cep-msg err"></div>
    <button class="btn-submit" id="btn-step5-enviar" onclick="enviarFotos()">Enviar fotos e concluir →</button>
    <button class="btn-voltar" onclick="pularFotos()">Não tenho fotos agora, pular esta etapa</button>
  </div>

  <!-- TELA 6 — sucesso -->
  <div id="step6" style="display:none" class="sucesso">
    <div class="icon">✅</div>
    <h2>Recebemos suas informações!</h2>
    <p style="margin-top:8px;color:#6b7280">Seu corretor já recebeu seu imóvel e entrará em contato em breve pra completar o cadastro.</p>
  </div>

</div>
<script>
const userId = '<%= userId %>';
const leadIdInicial = '<%= leadId %>';
const _destino = leadIdInicial && leadIdInicial !== userId ? leadIdInicial : userId;
const _campanhaEnvioId = '<%= campanhaEnvioId || "" %>';
const _refSubAdmin = '<%= (typeof refSubAdmin !== "undefined" && refSubAdmin) || "" %>';
const _imovelExistente = <%- imovelExistente ? JSON.stringify(imovelExistente).replace(/</g, '\\u003c') : 'null' %>;
const _irDireto = '<%= (typeof irDireto !== "undefined" && irDireto) || "" %>';

let _transacao = '';
let _leadId = '';
let _imovelId = '';

function mostrar(id){
  ['step1','step2','step3','step4','step5','step6'].forEach(s => document.getElementById(s).style.display = (s===id ? 'block' : 'none'));
}

function _atualizarPreviewBar(){
  if(!_imovelId) return;
  document.getElementById('preview-link').href = 'https://matchimoveis.ia.br/imovel/' + _imovelId + '?preview=1';
  document.getElementById('preview-bar').style.display = 'flex';
}

// Pula direto pra 1ª etapa com dado faltando, em vez de sempre reiniciar em
// step2 — assim o proprietário que já preencheu endereço mas não chegou na
// foto, por exemplo, cai direto na etapa de foto ao reabrir o link.
function _primeiroStepIncompleto(im){
  if(!im.tipo || !im.endereco || !im.numero || !im.bairro || !im.cidade || !im.estado) return 'step2';
  if(!im.valor_imovel) return 'step4';
  if(!im.fotos || !im.fotos.length) return 'step5';
  return 'step2'; // tudo preenchido — deixa revisar do início mesmo assim
}

// Veio do email "seu anúncio está pronto, revise" — já sabemos quem é e o que
// já foi respondido, então pula a tela 1 e pré-preenche o resto: o
// proprietário só completa o que ainda está faltando, não digita tudo de novo.
if (_imovelExistente) {
  _leadId = _imovelExistente.leadOrigemId || '';
  _imovelId = _imovelExistente.id || '';
  _transacao = _imovelExistente.transacao || '';

  const _propExist = _imovelExistente.proprietario || {};
  document.getElementById('s1-nome').value = _propExist.nome || '';
  if (_propExist.celular || _propExist.telefone) document.getElementById('s1-celular').value = _propExist.celular || _propExist.telefone;
  document.getElementById('s1-email').value = _propExist.email || '';

  document.getElementById('s2-tipo').value = _imovelExistente.tipo || '';
  document.getElementById('s2-cep').value = _imovelExistente.cep || '';
  document.getElementById('s2-rua').value = _imovelExistente.endereco || '';
  document.getElementById('s2-bairro').value = _imovelExistente.bairro || '';
  document.getElementById('s2-cidade-uf').value = [_imovelExistente.cidade, _imovelExistente.estado].filter(Boolean).join(' / ');
  document.getElementById('s2-numero').value = _imovelExistente.numero || '';
  document.getElementById('s2-complemento').value = _imovelExistente.complemento || '';
  if (_imovelExistente.bairro || _imovelExistente.endereco) {
    document.getElementById('cep-resultado').style.display = 'block';
    document.getElementById('btn-step2-continuar').removeAttribute('disabled');
  }

  const _tipoExist = (_imovelExistente.tipo || '').toLowerCase();
  const _isTerrenoExist = _tipoExist.includes('terreno') || _tipoExist.includes('área rural') || _tipoExist.includes('area rural');
  document.getElementById('campos-comodos').style.display = _isTerrenoExist ? 'none' : 'block';
  document.getElementById('step3-titulo').textContent = _isTerrenoExist ? 'Só falta a área do terreno' : 'Um pouco mais sobre o imóvel';
  document.getElementById('s3-quartos').value = _imovelExistente.quartos || '';
  document.getElementById('s3-suites').value = _imovelExistente.suites || '';
  document.getElementById('s3-banheiros').value = _imovelExistente.banheiros || '';
  document.getElementById('s3-vagas').value = _imovelExistente.vagas || '';
  document.getElementById('s3-area').value = _imovelExistente.area_m2 || '';

  document.getElementById('s4-valor').value = _imovelExistente.valor_imovel || '';

  _atualizarPreviewBar();
  mostrar(_irDireto === 'fotos' ? 'step5' : _primeiroStepIncompleto(_imovelExistente));
}

async function selecionar(op){
  const nome = document.getElementById('s1-nome').value.trim();
  const celular = document.getElementById('s1-celular').value.trim();
  const email = document.getElementById('s1-email').value.trim();
  const celularLimpo = celular.replace(/\D/g,'');
  const msg = document.getElementById('step1-msg');
  msg.textContent = '';

  if(op === 'nao'){
    fetch('/captar/nao/'+_destino, {method:'POST'}).catch(()=>{});
    mostrar('step6');
    document.querySelector('#step6 h2').textContent = 'Tudo bem!';
    document.querySelector('#step6 p').textContent = 'Obrigado por avisar. Se mudar de ideia, é só voltar nesse link.';
    return;
  }

  if(!nome || nome.length < 3){ msg.textContent = 'Digite seu nome completo'; return; }
  if(!celular || celularLimpo.length < 10 || celularLimpo.length > 11){ msg.textContent = 'Celular inválido. Use o formato: 11999999999'; return; }

  _transacao = op;
  document.querySelectorAll('.btn-op').forEach(b=>b.setAttribute('disabled','disabled'));

  try {
    const r = await fetch('/captar/iniciar/'+_destino, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ transacao: op, nome, celular, email, campanhaEnvioId: _campanhaEnvioId, refSubAdmin: _refSubAdmin })
    });
    const d = await r.json();
    if(!d.ok){ msg.textContent = 'Erro ao enviar, tenta de novo.'; document.querySelectorAll('.btn-op').forEach(b=>b.removeAttribute('disabled')); return; }
    _leadId = d.leadId;
    _imovelId = d.imovelId;
    mostrar('step2');
  } catch(e) {
    msg.textContent = 'Erro ao enviar, tenta de novo.';
    document.querySelectorAll('.btn-op').forEach(b=>b.removeAttribute('disabled'));
  }
}

document.getElementById('s2-cep').addEventListener('input', function(){
  this.value = this.value.replace(/\D/g,'').replace(/^(\d{5})(\d)/,'$1-$2').slice(0,9);
  if(this.value.replace(/\D/g,'').length === 8) buscarCep();
});

function naoSeiCep(){
  document.getElementById('cep-resultado').style.display = 'block';
  const cepMsg = document.getElementById('cep-msg');
  cepMsg.className = 'cep-msg';
  cepMsg.textContent = '';
  document.getElementById('btn-step2-continuar').removeAttribute('disabled');
  document.getElementById('s2-rua').focus();
}

async function buscarCep(){
  const cepLimpo = document.getElementById('s2-cep').value.replace(/\D/g,'');
  const cepMsg = document.getElementById('cep-msg');
  const btn = document.getElementById('btn-buscar-cep');
  cepMsg.className = 'cep-msg';
  cepMsg.textContent = '';
  if(cepLimpo.length !== 8){ cepMsg.className = 'cep-msg err'; cepMsg.textContent = 'CEP inválido'; return; }
  btn.setAttribute('disabled','disabled');
  btn.textContent = 'Buscando...';
  try {
    const r = await fetch('https://viacep.com.br/ws/'+cepLimpo+'/json/');
    const d = await r.json();
    if(d.erro){ cepMsg.className = 'cep-msg err'; cepMsg.textContent = 'CEP não encontrado — confira e tente de novo.'; return; }
    document.getElementById('s2-rua').value = d.logradouro || '';
    document.getElementById('s2-bairro').value = d.bairro || '';
    document.getElementById('s2-cidade-uf').value = (d.localidade||'') + (d.uf ? ' / '+d.uf : '');
    document.getElementById('cep-resultado').style.display = 'block';
    cepMsg.className = 'cep-msg ok';
    cepMsg.textContent = '✓ Endereço encontrado — confira e complete o número.';
    document.getElementById('btn-step2-continuar').removeAttribute('disabled');
  } catch(e) {
    cepMsg.className = 'cep-msg err';
    cepMsg.textContent = 'Não conseguimos buscar o CEP agora. Tente de novo.';
  } finally {
    btn.removeAttribute('disabled');
    btn.textContent = '🔍 Buscar';
  }
}

async function continuarStep2(){
  const tipo = document.getElementById('s2-tipo').value;
  const cep = document.getElementById('s2-cep').value.replace(/\D/g,'');
  const endereco = document.getElementById('s2-rua').value.trim();
  const bairro = document.getElementById('s2-bairro').value.trim();
  const cidadeUf = document.getElementById('s2-cidade-uf').value.split('/');
  const cidade = (cidadeUf[0]||'').trim();
  const estado = (cidadeUf[1]||'').trim();
  const numero = document.getElementById('s2-numero').value.trim();
  const complemento = document.getElementById('s2-complemento').value.trim();

  if(!tipo){ alert('Selecione o tipo de imóvel'); return; }
  if(!numero){ alert('Preencha o número'); return; }

  // Mesma regra do cadastro manual (toggleCampos em app-cadastro.ejs): terreno não tem cômodos.
  const isTerreno = tipo.toLowerCase().includes('terreno') || tipo.toLowerCase().includes('área rural');
  document.getElementById('campos-comodos').style.display = isTerreno ? 'none' : 'block';
  document.getElementById('step3-titulo').textContent = isTerreno ? 'Só falta a área do terreno' : 'Um pouco mais sobre o imóvel';

  await fetch('/captar/imovel/'+_imovelId, {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ userId, tipo, cep, endereco, numero, complemento, bairro, cidade, estado })
  }).catch(()=>{});
  _atualizarPreviewBar();
  mostrar('step3');
}

async function continuarStep3(){
  const quartos = document.getElementById('s3-quartos').value;
  const suites = document.getElementById('s3-suites').value;
  const banheiros = document.getElementById('s3-banheiros').value;
  const vagas = document.getElementById('s3-vagas').value;
  const area_m2 = document.getElementById('s3-area').value;

  await fetch('/captar/imovel/'+_imovelId, {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ userId, quartos, suites, banheiros, vagas, area_m2 })
  }).catch(()=>{});
  mostrar('step4');
}

async function continuarStep4(){
  const valor_imovel = document.getElementById('s4-valor').value.replace(/\D/g,'');
  await fetch('/captar/imovel/'+_imovelId, {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ userId, valor_imovel })
  }).catch(()=>{});
  mostrar('step5');
}

async function _finalizarCaptacao(){
  await fetch('/captar/imovel/'+_imovelId, {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ userId, finalizar: true })
  }).catch(()=>{});
  mostrar('step6');
}

async function enviarFotos(){
  const input = document.getElementById('s5-fotos');
  const msg = document.getElementById('s5-msg');
  msg.textContent = '';
  const arquivos = input.files;
  if(!arquivos || !arquivos.length){ return pularFotos(); }
  const btn = document.getElementById('btn-step5-enviar');
  btn.setAttribute('disabled','disabled');
  btn.textContent = 'Enviando fotos...';
  try {
    const fd = new FormData();
    for(const f of arquivos) fd.append('fotos', f);
    const r = await fetch('/captar/foto/'+_imovelId, { method:'POST', body: fd });
    const d = await r.json();
    if(!d.ok){ msg.textContent = d.erro || 'Erro ao enviar fotos.'; btn.removeAttribute('disabled'); btn.textContent = 'Enviar fotos e concluir →'; return; }
  } catch(e) {
    msg.textContent = 'Erro ao enviar fotos, tenta de novo.';
    btn.removeAttribute('disabled');
    btn.textContent = 'Enviar fotos e concluir →';
    return;
  }
  await _finalizarCaptacao();
}

async function pularFotos(){
  await _finalizarCaptacao();
}
</script>
</body>
</html>
