<script>
async function contratarCombo(plano){
  try{
    const r = await fetch('/pagamento/criar-plano', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ plano })
    });
    const d = await r.json();
    if(d.ok && d.url){ window.location.href = d.url; }
    else if(d.cpfNecessario){ abrirCpfModal(() => contratarCombo(plano)); }
    else{ alert(d.erro || 'Erro ao gerar pagamento. Tente novamente.'); }
  }catch(e){ alert('Erro ao gerar pagamento. Tente novamente.'); }
}
</script>

<script>
// Modal de CPF: aberto sob demanda quando /pagamento/criar ou
// /pagamento/criar-plano avisam que falta CPF pra gerar o Pix. Guarda a
// ação que estava sendo tentada (avulso ou combo) pra repetir sozinho
// assim que o CPF for salvo, sem o corretor ter que clicar de novo.
let _acaoPendenteCpf = null;
function abrirCpfModal(acaoParaRepetir){
  _acaoPendenteCpf = acaoParaRepetir;
  document.getElementById('cpfModalErro').style.display = 'none';
  document.getElementById('cpfModalInput').value = '';
  document.getElementById('cpfModal').style.display = 'flex';
  setTimeout(() => document.getElementById('cpfModalInput').focus(), 100);
}
function fecharCpfModal(){
  document.getElementById('cpfModal').style.display = 'none';
  _acaoPendenteCpf = null;
}
function _formatarCpfModal(input){
  let v = input.value.replace(/\D/g,'').slice(0,11);
  if(v.length > 9) v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, '$1.$2.$3-$4');
  else if(v.length > 6) v = v.replace(/(\d{3})(\d{3})(\d{1,3})/, '$1.$2.$3');
  else if(v.length > 3) v = v.replace(/(\d{3})(\d{1,3})/, '$1.$2');
  input.value = v;
}
async function confirmarCpfModal(){
  const cpf = document.getElementById('cpfModalInput').value.replace(/\D/g,'');
  const erroEl = document.getElementById('cpfModalErro');
  if(cpf.length !== 11){ erroEl.style.display = 'block'; return; }
  const btn = document.getElementById('cpfModalBtn');
  btn.disabled = true; btn.textContent = 'Salvando...';
  try{
    const r = await fetch('/app/perfil/cpf', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ cpf }) });
    const d = await r.json();
    if(!d.ok){ erroEl.textContent = d.erro || 'CPF inválido. Confira os números.'; erroEl.style.display = 'block'; btn.disabled = false; btn.textContent = 'Confirmar e continuar'; return; }
    const acao = _acaoPendenteCpf;
    document.getElementById('cpfModal').style.display = 'none';
    _acaoPendenteCpf = null;
    if(acao) acao();
  }catch(e){
    erroEl.textContent = 'Erro de conexão. Tente novamente.'; erroEl.style.display = 'block';
  }
  btn.disabled = false; btn.textContent = 'Confirmar e continuar';
}
</script>

