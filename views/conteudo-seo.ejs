<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <title><%= pagina.titulo %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
  <meta name="description" content="<%= pagina.metaDescricao %>">
  <meta property="og:title" content="<%= pagina.ogTitulo || pagina.titulo %>">
  <meta property="og:description" content="<%= pagina.metaDescricao %>">
  <meta property="og:image" content="https://www.matchimoveis.ia.br/og-image.png">
  <meta property="og:url" content="https://www.matchimoveis.ia.br/<%= pagina.slug %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="MatchImóveis">
  <link rel="canonical" href="https://www.matchimoveis.ia.br/<%= pagina.slug %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pagina.ogTitulo || pagina.titulo %>">
  <meta name="twitter:description" content="<%= pagina.metaDescricao %>">
  <meta name="twitter:image" content="https://www.matchimoveis.ia.br/og-image.png">
  <script type="application/ld+json"><%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "MatchImóveis",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    description: pagina.metaDescricao,
    url: "https://www.matchimoveis.ia.br/" + pagina.slug,
    offers: { "@type": "Offer", price: "0", priceCurrency: "BRL", description: "Cadastro grátis com 1.000 créditos de bônus" }
  }).replace(/</g, '\\u003c') %></script>
  <% if (pagina.faq && pagina.faq.length) { %>
  <script type="application/ld+json"><%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: pagina.faq.map(function(f){ return { "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } }; })
  }).replace(/</g, '\\u003c') %></script>
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{--rosa:#FF385C;--dark:#0f0f0f;--text:#1a1a1a;--muted:#6b7280;--light:#f5f5f4;--border:#e8e8e6;--babu:#00A699}
    body{font-family:'Inter',sans-serif;background:#fff;color:var(--text);-webkit-font-smoothing:antialiased;line-height:1.6}
    a{text-decoration:none;color:inherit}
    nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.97);border-bottom:1px solid var(--border);padding:0 24px;display:flex;align-items:center;justify-content:space-between;height:58px}
    .logo{font-size:17px;font-weight:600;color:var(--dark);letter-spacing:-.3px}
    .logo span{color:var(--rosa)}
    .nav-ctas{display:flex;align-items:center;gap:10px}
    .btn-entrar{background:#fff;color:var(--dark);padding:7px 16px;border-radius:7px;font-size:13px;font-weight:500;border:1px solid var(--border)}
    .btn-cadastro-nav{background:var(--dark);color:#fff;padding:7px 16px;border-radius:7px;font-size:13px;font-weight:500;border:none}
    main{max-width:760px;margin:0 auto;padding:0 24px}
    .breadcrumb{font-size:12px;color:var(--muted);padding:20px 0 0}
    .breadcrumb a{color:var(--muted)}
    .breadcrumb a:hover{color:var(--rosa)}
    .hero{padding:36px 0 44px;text-align:center}
    .hero-tag{display:inline-flex;align-items:center;gap:6px;background:var(--light);color:var(--muted);padding:5px 14px;border-radius:999px;font-size:12px;font-weight:500;margin-bottom:22px}
    .hero-tag::before{content:'';width:6px;height:6px;background:var(--rosa);border-radius:50%}
    h1{font-size:38px;font-weight:700;line-height:1.15;letter-spacing:-1px;color:var(--dark);margin-bottom:16px}
    h1 em{font-style:normal;color:var(--rosa)}
    .hero-sub{font-size:17px;color:var(--muted);line-height:1.7;margin-bottom:28px}
    .btn-main{display:inline-block;background:var(--rosa);color:#fff;padding:13px 30px;border-radius:8px;font-size:14px;font-weight:600;border:none;cursor:pointer}
    .hero-note{font-size:12px;color:var(--muted);margin-top:12px}
    section{padding:36px 0;border-top:1px solid var(--border)}
    .sec-title{font-size:22px;font-weight:700;color:var(--dark);letter-spacing:-.4px;margin-bottom:8px}
    .sec-sub{font-size:14.5px;color:var(--muted);line-height:1.7;margin-bottom:28px;max-width:640px}
    .dores{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:12px;overflow:hidden}
    .dor{background:#fff;padding:20px 18px}
    .dor-num{font-size:11px;font-weight:600;color:var(--rosa);margin-bottom:10px}
    .dor-title{font-size:14.5px;font-weight:600;color:var(--dark);margin-bottom:6px}
    .dor-desc{font-size:12.5px;color:var(--muted);line-height:1.6}
    .recursos{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .recurso{background:var(--light);border-radius:12px;padding:18px}
    .recurso-icone{font-size:20px;margin-bottom:8px}
    .recurso-titulo{font-size:14.5px;font-weight:600;color:var(--dark);margin-bottom:5px}
    .recurso-desc{font-size:12.5px;color:var(--muted);line-height:1.6}
    .faq details{border-bottom:1px solid var(--border);padding:16px 0}
    .faq summary{font-size:15px;font-weight:600;color:var(--dark);cursor:pointer;list-style:none}
    .faq summary::-webkit-details-marker{display:none}
    .faq summary::after{content:'+';float:right;color:var(--rosa);font-weight:700}
    .faq details[open] summary::after{content:'−'}
    .faq p{font-size:13.5px;color:var(--muted);line-height:1.7;margin-top:10px}
    .cta-final{text-align:center;background:var(--dark);border-radius:16px;padding:40px 28px;margin:44px 0}
    .cta-final h2{color:#fff;font-size:24px;margin-bottom:10px;letter-spacing:-.5px}
    .cta-final p{color:rgba(255,255,255,.65);font-size:14px;margin-bottom:22px}
    .links-relacionados{padding:0 0 40px;font-size:12.5px;color:var(--muted)}
    .links-relacionados a{color:var(--rosa)}
    footer{border-top:1px solid var(--border);padding:28px 24px;text-align:center}
    .footer-note{font-size:11.5px;color:var(--muted)}
    @media(max-width:680px){
      h1{font-size:28px}
      .dores{grid-template-columns:1fr}
      .recursos{grid-template-columns:1fr}
      nav{padding:0 16px}
    }
  </style>
</head>
<body>
<nav>
  <a href="/" class="logo">Match<span>Imóveis</span></a>
  <div class="nav-ctas">
    <a href="/" class="btn-entrar">Entrar</a>
    <a href="/?cadastro=1" class="btn-cadastro-nav">Cadastre-se grátis</a>
  </div>
</nav>

<main>
  <div class="breadcrumb"><a href="/">Início</a> / <%= pagina.h1 %></div>

  <div class="hero">
    <div class="hero-tag"><%= pagina.tag %></div>
    <h1><%- pagina.h1 %></h1>
    <p class="hero-sub"><%= pagina.heroSub %></p>
    <a href="/?cadastro=1" class="btn-main">Criar conta grátis — 1.000 créditos</a>
    <div class="hero-note">Sem cartão de crédito · Cadastro em menos de 1 minuto</div>
  </div>

  <% if (pagina.dores && pagina.dores.length) { %>
  <section>
    <div class="sec-title"><%= pagina.doresTitulo || 'O problema que resolvemos' %></div>
    <p class="sec-sub"><%= pagina.doresSub || '' %></p>
    <div class="dores">
      <% pagina.dores.forEach(function(d, i){ %>
      <div class="dor">
        <div class="dor-num">0<%= i+1 %></div>
        <div class="dor-title"><%= d.titulo %></div>
        <div class="dor-desc"><%= d.desc %></div>
      </div>
      <% }); %>
    </div>
  </section>
  <% } %>

  <% if (pagina.recursos && pagina.recursos.length) { %>
  <section>
    <div class="sec-title"><%= pagina.recursosTitulo || 'Como funciona na prática' %></div>
    <p class="sec-sub"><%= pagina.recursosSub || '' %></p>
    <div class="recursos">
      <% pagina.recursos.forEach(function(r){ %>
      <div class="recurso">
        <div class="recurso-icone"><%= r.icone %></div>
        <div class="recurso-titulo"><%= r.titulo %></div>
        <div class="recurso-desc"><%= r.desc %></div>
      </div>
      <% }); %>
    </div>
  </section>
  <% } %>

  <% if (pagina.faq && pagina.faq.length) { %>
  <section>
    <div class="sec-title">Perguntas frequentes</div>
    <div class="faq">
      <% pagina.faq.forEach(function(f, i){ %>
      <details<% if(i===0){ %> open<% } %>>
        <summary><%= f.q %></summary>
        <p><%= f.a %></p>
      </details>
      <% }); %>
    </div>
  </section>
  <% } %>

  <div class="cta-final">
    <h2>Pronto pra testar?</h2>
    <p>Crie sua conta agora e comece com 1.000 créditos grátis — sem precisar de cartão.</p>
    <a href="/?cadastro=1" class="btn-main">Cadastre-se grátis</a>
  </div>

  <% if (pagina.relacionados && pagina.relacionados.length) { %>
  <div class="links-relacionados">
    Veja também:
    <% pagina.relacionados.forEach(function(r, i){ %><a href="/<%= r.slug %>"><%= r.texto %></a><%= i < pagina.relacionados.length-1 ? ' · ' : '' %><% }); %>
  </div>
  <% } %>
</main>

<footer>
  <div class="footer-note">Match Imóveis é uma plataforma do Grupo Rankim. © 2026 Match Imóveis — Todos os direitos reservados. <a href="/politica-privacidade">Política de Privacidade</a> · <a href="/termos-de-uso">Termos de Uso</a></div>
</footer>
</body>
</html>
