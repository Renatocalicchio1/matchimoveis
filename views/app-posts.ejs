<%- include('partials/app-shell',{active:'posts',title:'Posts',subtitle:'Gere publicações para Instagram a partir do conteúdo de qualquer site.',perfil:(user && user.tipo)||'corretor',user:user}) %>

<style>
.pf-card{background:#fff;border:0.5px solid rgba(0,0,0,.08);border-radius:16px;padding:20px;margin-bottom:12px}
.pf-card-title{font-size:15px;font-weight:500;color:#111827;margin:0 0 4px}
.pf-card-sub{font-size:13px;color:#9ca3af;margin:0 0 16px}
.pt-form{display:flex;gap:8px;flex-wrap:wrap}
.pt-form input{flex:1;min-width:220px;padding:10px 14px;border:0.5px solid rgba(0,0,0,.12);border-radius:8px;font-size:14px}
.pt-btn{padding:10px 20px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:none;background:#FF385C;color:#fff}
.pt-btn:hover{background:#e31c46}
.pt-btn:disabled{opacity:.5;cursor:not-allowed}
.pt-msg{font-size:12.5px;margin-top:10px}
.pt-msg.err{color:#dc2626}
.pt-msg.ok{color:#16a34a}
.pt-loading{display:flex;align-items:center;gap:8px;font-size:13px;color:#6b7280;padding:20px 0}
.pt-spin{width:16px;height:16px;border:2px solid #e5e7eb;border-top-color:#FF385C;border-radius:50%;animation:pt-spin .7s linear infinite}
@keyframes pt-spin{to{transform:rotate(360deg)}}

.pt-wrap{display:flex;flex-direction:column;align-items:center}
.ig-card{width:100%;max-width:280px;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;background:#fff}
.ig-head{display:flex;align-items:center;gap:7px;padding:8px 10px}
.ig-avatar{width:24px;height:24px;border-radius:50%;background:linear-gradient(45deg,#FF385C,#FC642D);flex-shrink:0}
.ig-username{font-size:12px;font-weight:600;color:#111827}
.ig-img-wrap{width:100%;aspect-ratio:1;background:#f3f4f6;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative}
.ig-img-wrap img{width:100%;height:100%;object-fit:cover}
.ig-img-empty{font-size:11px;color:#9ca3af;text-align:center;padding:16px}
.ig-img-nav{position:absolute;top:50%;transform:translateY(-50%);width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,.85);border:none;font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#111827}
.ig-img-nav.prev{left:6px}
.ig-img-nav.next{right:6px}
.ig-img-dots{position:absolute;bottom:6px;left:0;right:0;display:flex;justify-content:center;gap:3px}
.ig-img-dots span{width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,.6)}
.ig-img-dots span.on{background:#fff}
.ig-caption{padding:8px 10px 0;font-size:11.5px;color:#111827;line-height:1.45;white-space:pre-wrap}
.ig-caption b{font-weight:600;margin-right:4px}
.ig-toolbar{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#e5e7eb;margin-top:10px;border-top:1px solid #e5e7eb}
.ig-toolbar button{background:#fff;border:none;padding:9px 4px;font-size:10.5px;font-weight:600;color:#374151;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;line-height:1.2}
.ig-toolbar button:hover{background:#f9fafb}
.ig-toolbar button:disabled{opacity:.4;cursor:not-allowed}
.ig-toolbar button.publicar{color:#FF385C}

.pt-detalhes-chips{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:14px;max-width:280px}
.pt-chip{background:#f9fafb;border:0.5px solid rgba(0,0,0,.08);border-radius:20px;padding:4px 10px;font-size:11px;color:#374151}
.pt-chip b{color:#111827;font-weight:600;margin-right:3px}
.pt-msg-resultado{margin-top:10px;text-align:center}
</style>

<div class="pf-card">
  <div class="pf-card-title">🌐 Analisar site</div>
  <div class="pf-card-sub">Cole a URL de um site (imobiliária, concessionária, prestador de serviço etc) — a IA lê o conteúdo e monta uma sugestão de post pronta pro Instagram.</div>
  <div class="pt-form">
    <input type="url" id="pt-url" placeholder="https://www.exemplo.com.br" required>
    <button type="button" class="pt-btn" id="pt-btn-analisar" onclick="analisarSite()">Analisar Site</button>
  </div>
  <div id="pt-msg-inicial" class="pt-msg"></div>
</div>

<div id="pt-loading" class="pf-card pt-loading" style="display:none">
  <div class="pt-spin"></div>
  <span>Lendo o site e gerando a legenda...</span>
</div>

<div id="pt-resultado" class="pf-card" style="display:none">
  <div class="pt-wrap">
    <div class="ig-card">
      <div class="ig-head">
        <div class="ig-avatar"></div>
        <span class="ig-username"><%= (user && user.instagramUsername) ? '@'+user.instagramUsername : 'sua_conta' %></span>
      </div>
      <div class="ig-img-wrap" id="pt-img-wrap">
        <div class="ig-img-empty">Nenhuma imagem encontrada nesse site.</div>
      </div>
      <div class="ig-caption"><b><%= (user && user.instagramUsername) ? user.instagramUsername : 'sua_conta' %></b><span id="pt-legenda-preview"></span></div>
      <div class="ig-toolbar">
        <button type="button" class="publicar" onclick="publicar()" id="pt-btn-publicar">✅<span>Publicar</span></button>
        <button type="button" onclick="novaLegenda()" id="pt-btn-legenda">✏️<span>Nova legenda</span></button>
        <button type="button" onclick="novaImagem()" id="pt-btn-imagem">🖼️<span>Nova imagem</span></button>
        <button type="button" onclick="ignorar()">🗑️<span>Ignorar</span></button>
      </div>
    </div>
    <div class="pt-detalhes-chips" id="pt-detalhes-chips"></div>
    <div id="pt-msg-resultado" class="pt-msg pt-msg-resultado"></div>
  </div>
</div>

<script>
let _estado = { titulo:'', descricao:'', valor:'', textoBruto:'', imagens:[], indiceImagem:0, legenda:'', detalhes:[] };

function _msg(id, texto, tipo){
  const el = document.getElementById(id);
  el.className = 'pt-msg' + (tipo ? ' '+tipo : '') + (id==='pt-msg-resultado' ? ' pt-msg-resultado' : '');
  el.textContent = texto || '';
}

function _atualizarPreview(){
  document.getElementById('pt-legenda-preview').textContent = ' ' + (_estado.legenda || '');

  const chips = document.getElementById('pt-detalhes-chips');
  chips.innerHTML = _estado.detalhes.map(d => '<span class="pt-chip"><b>'+d.label+':</b>'+d.valor+'</span>').join('');

  const wrap = document.getElementById('pt-img-wrap');
  const total = _estado.imagens.length;
  const imgUrl = _estado.imagens[_estado.indiceImagem];
  if(!imgUrl){ wrap.innerHTML = '<div class="ig-img-empty">Nenhuma imagem encontrada nesse site.</div>'; return; }
  let html = '<img src="'+imgUrl+'" alt="">';
  if(total > 1){
    html += '<button type="button" class="ig-img-nav prev" onclick="trocarImagem(-1)">‹</button>';
    html += '<button type="button" class="ig-img-nav next" onclick="trocarImagem(1)">›</button>';
    html += '<div class="ig-img-dots">' + _estado.imagens.map((_,i)=>'<span class="'+(i===_estado.indiceImagem?'on':'')+'"></span>').join('') + '</div>';
  }
  wrap.innerHTML = html;
}

function trocarImagem(dir){
  const total = _estado.imagens.length;
  if(!total) return;
  _estado.indiceImagem = (_estado.indiceImagem + dir + total) % total;
  _atualizarPreview();
}

async function analisarSite(){
  const url = document.getElementById('pt-url').value.trim();
  if(!url){ _msg('pt-msg-inicial','Informe a URL do site.','err'); return; }
  _msg('pt-msg-inicial','');
  document.getElementById('pt-resultado').style.display = 'none';
  document.getElementById('pt-loading').style.display = 'flex';
  document.getElementById('pt-btn-analisar').disabled = true;
  try {
    const r = await fetch('/app/posts/analisar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ url }) });
    const d = await r.json();
    if(!d.ok){ _msg('pt-msg-inicial', d.erro || 'Não foi possível analisar esse site.', 'err'); return; }
    _estado = { titulo:d.titulo||'', descricao:d.descricao||'', valor:d.valor||'', textoBruto:d.textoBruto||'', imagens:d.imagens||[], indiceImagem:0, legenda:d.legenda||'', detalhes:d.detalhes||[] };
    _atualizarPreview();
    document.getElementById('pt-resultado').style.display = 'block';
  } catch(e) {
    _msg('pt-msg-inicial','Erro ao analisar o site. Tente novamente.','err');
  } finally {
    document.getElementById('pt-loading').style.display = 'none';
    document.getElementById('pt-btn-analisar').disabled = false;
  }
}

async function novaLegenda(){
  _msg('pt-msg-resultado','');
  document.getElementById('pt-btn-legenda').disabled = true;
  try {
    const r = await fetch('/app/posts/legenda', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ titulo:_estado.titulo, descricao:_estado.descricao, valor:_estado.valor, textoBruto:_estado.textoBruto }) });
    const d = await r.json();
    if(!d.ok){ _msg('pt-msg-resultado', d.erro || 'Não foi possível gerar nova legenda.', 'err'); return; }
    _estado.legenda = d.legenda;
    _estado.detalhes = d.detalhes || [];
    _atualizarPreview();
  } catch(e) {
    _msg('pt-msg-resultado','Erro ao gerar nova legenda.','err');
  } finally {
    document.getElementById('pt-btn-legenda').disabled = false;
  }
}

function novaImagem(){
  if(_estado.imagens.length < 2) { _msg('pt-msg-resultado','Nenhuma outra imagem encontrada nesse site.','err'); return; }
  trocarImagem(1);
}

async function publicar(){
  const imagemUrl = _estado.imagens[_estado.indiceImagem];
  if(!imagemUrl){ _msg('pt-msg-resultado','Esse post não tem imagem — não é possível publicar no Instagram.','err'); return; }
  if(!confirm('Publicar esse post no seu Instagram agora?')) return;
  _msg('pt-msg-resultado','');
  document.getElementById('pt-btn-publicar').disabled = true;
  try {
    const r = await fetch('/app/posts/publicar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ imagemUrl, legenda:_estado.legenda }) });
    const d = await r.json();
    if(!d.ok){ _msg('pt-msg-resultado', d.erro || 'Não foi possível publicar.', 'err'); return; }
    _msg('pt-msg-resultado','✅ Publicado no Instagram!','ok');
  } catch(e) {
    _msg('pt-msg-resultado','Erro ao publicar no Instagram.','err');
  } finally {
    document.getElementById('pt-btn-publicar').disabled = false;
  }
}

function ignorar(){
  document.getElementById('pt-resultado').style.display = 'none';
  document.getElementById('pt-url').value = '';
  _estado = { titulo:'', descricao:'', valor:'', textoBruto:'', imagens:[], indiceImagem:0, legenda:'', detalhes:[] };
}
</script>

<%- include('partials/app-end') %>
