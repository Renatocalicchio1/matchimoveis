          <div class="mc-field" style="margin-bottom:0">
            <label class="mc-label">Status</label>
            <select class="mc-select" id="mc-editar-status-<%= c.id %>">
              <option value="pausada" <%= c.status==='pausada'?'selected':'' %>>Pausada</option>
              <option value="ativa" <%= c.status==='ativa'?'selected':'' %>>Ativa</option>
            </select>
          </div>
        </div>

        <div class="mc-field" style="margin-top:12px">
          <label class="mc-label">Público salvo (opcional)</label>
          <select class="mc-select" id="mc-editar-publico-salvo-<%= c.id %>" onchange="alternarCamposPublicoEdicao(<%= c.id %>)" data-atual="<%= c.publico.publicoSalvoId || '' %>"><option value="">Personalizar abaixo</option></select>
        </div>
        <div id="mc-editar-publico-manual-<%= c.id %>" <%- c.publico.publicoSalvoId ? 'style="display:none"' : '' %>>
          <div class="mc-row">
            <div class="mc-field">
              <label class="mc-label">Raio a partir do imóvel (km)</label>
              <input type="number" class="mc-input" id="mc-editar-raio-<%= c.id %>" min="1" step="1" value="<%= c.publico.raioKm || 10 %>">
            </div>
            <div class="mc-field">
              <label class="mc-label">Idade mínima</label>
              <input type="number" class="mc-input" id="mc-editar-idade-min-<%= c.id %>" min="18" max="65" value="<%= c.publico.idadeMin || 25 %>">
            </div>
            <div class="mc-field">
              <label class="mc-label">Idade máxima</label>
              <input type="number" class="mc-input" id="mc-editar-idade-max-<%= c.id %>" min="18" max="65" value="<%= c.publico.idadeMax || 55 %>">
            </div>
            <div class="mc-field">
              <label class="mc-label">Gênero</label>
              <select class="mc-select" id="mc-editar-genero-<%= c.id %>">
                <option value="todos" <%= (!c.publico.genero || c.publico.genero==='todos')?'selected':'' %>>Todos</option>
                <option value="homens" <%= c.publico.genero==='homens'?'selected':'' %>>Homens</option>
                <option value="mulheres" <%= c.publico.genero==='mulheres'?'selected':'' %>>Mulheres</option>
              </select>
