<%- include('partials/app-shell',{active:'posts',title:'Posts',subtitle:'Gere publicações para Instagram a partir do conteúdo de qualquer site.',perfil:(user && user.tipo)||'corretor',user:user}) %>

<style>
.pf-card{background:#fff;border:0.5px solid rgba(0,0,0,.08);border-radius:16px;padding:20px;margin-bottom:12px}
.pf-card-title{font-size:15px;font-weight:500;color:#111827;margin:0 0 4px}
.pf-card-sub{font-size:13px;color:#9ca3af;margin:0 0 16px}
.pt-form{display:flex;gap:8px;flex-wrap:wrap}
.pt-form input{flex:1;min-width:220px;padding:10px 14px;border:0.5px solid rgba(0,0,0,.12);border-radius:8px;font-size:14px}
.pt-btn{padding:10px 20px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:none;background:#FF385C;color:#fff}
.pt-btn:hover{background:#e31c46}
.pt-btn:disabled{opacity:.5;cursor:not-allowed}
.pt-msg{font-size:12.5px;margin-top:10px}
.pt-msg.err{color:#dc2626}
.pt-msg.ok{color:#16a34a}
.pt-loading{display:flex;align-items:center;gap:8px;font-size:13px;color:#6b7280;padding:20px 0}
.pt-spin{width:16px;height:16px;border:2px solid #e5e7eb;border-top-color:#FF385C;border-radius:50%;animation:pt-spin .7s linear infinite}
@keyframes pt-spin{to{transform:rotate(360deg)}}

.pt-tabs{display:flex;gap:4px;margin-bottom:16px;border-bottom:1px solid #e5e7eb;overflow-x:auto}
.pt-tab{padding:10px 14px;font-size:13px;font-weight:600;color:#6b7280;background:none;border:none;cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent}
.pt-tab.on{color:#FF385C;border-bottom-color:#FF385C}
.pt-tabpane{display:none}
.pt-tabpane.on{display:block}

.pt-wrap{display:flex;flex-direction:column;align-items:center}
.ig-card{width:100%;max-width:280px;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;background:#fff}
.ig-head{display:flex;align-items:center;gap:7px;padding:8px 10px}
.ig-avatar{width:24px;height:24px;border-radius:50%;background:linear-gradient(45deg,#FF385C,#FC642D);flex-shrink:0}
.ig-username{font-size:12px;font-weight:600;color:#111827}
.ig-img-wrap{width:100%;aspect-ratio:1;background:#f3f4f6;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative}
.ig-img-wrap img{width:100%;height:100%;object-fit:cover}
.ig-img-empty{font-size:11px;color:#9ca3af;text-align:center;padding:16px}
.ig-img-nav{position:absolute;top:50%;transform:translateY(-50%);width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,.85);border:none;font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#111827}
.ig-img-nav.prev{left:6px}
.ig-img-nav.next{right:6px}
.ig-img-dots{position:absolute;bottom:6px;left:0;right:0;display:flex;justify-content:center;gap:3px}
.ig-img-dots span{width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,.6)}
.ig-img-dots span.on{background:#fff}
.ig-caption{padding:8px 10px 0;font-size:11.5px;color:#111827;line-height:1.45;white-space:pre-wrap}
.ig-caption b{font-weight:600;margin-right:4px}
.ig-toolbar{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:#e5e7eb;margin-top:10px;border-top:1px solid #e5e7eb}
.ig-toolbar button{background:#fff;border:none;padding:9px 3px;font-size:9.5px;font-weight:600;color:#374151;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;line-height:1.2}
.ig-toolbar button:hover{background:#f9fafb}
.ig-toolbar button:disabled{opacity:.4;cursor:not-allowed}
.ig-toolbar button.publicar{color:#FF385C}

.pt-msg-resultado{margin-top:10px;text-align:center}
.pt-agendar-box{width:100%;max-width:280px;margin-top:8px;padding:12px;background:#f9fafb;border-radius:10px;display:none}
.pt-agendar-box.on{display:block}
.pt-agendar-box input{width:100%;padding:8px 10px;border:0.5px solid rgba(0,0,0,.12);border-radius:8px;font-size:13px;margin-bottom:8px}
.pt-agendar-box .row{display:flex;gap:8px}
.pt-agendar-box button{flex:1;padding:8px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;border:none}
.pt-agendar-box .confirmar{background:#FF385C;color:#fff}
.pt-agendar-box .cancelar{background:#fff;border:1px solid #e5e7eb;color:#6b7280}

.pt-lista{display:flex;flex-direction:column;gap:10px}
.pt-item{display:flex;gap:10px;padding:10px;border:1px solid #f0f0ef;border-radius:10px;align-items:center;flex-wrap:wrap}
.pt-item-img{width:52px;height:52px;border-radius:8px;object-fit:cover;background:#f3f4f6;flex-shrink:0}
.pt-item-info{flex:1;min-width:120px}
.pt-item-legenda{font-size:12.5px;color:#111827;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.pt-item-datas{font-size:11px;color:#9ca3af;margin-top:3px}
.pt-item-acoes{display:flex;gap:6px;flex-shrink:0}
.pt-item-acoes button{padding:6px 10px;border-radius:7px;font-size:11px;font-weight:600;cursor:pointer;border:1px solid #e5e7eb;background:#fff;color:#374151;white-space:nowrap}
.pt-item-acoes button:hover{background:#f9fafb}
.pt-vazio{font-size:13px;color:#9ca3af;text-align:center;padding:24px 0}
</style>

<div class="pt-tabs">
  <button type="button" class="pt-tab on" id="pt-tab-novo" onclick="mudarAba('novo',this)">Novo post</button>
  <button type="button" class="pt-tab" onclick="mudarAba('agendados',this)">Agendados (<%= agendados.length %>)</button>
  <button type="button" class="pt-tab" onclick="mudarAba('postados',this)">Postados (<%= postados.length %>)</button>
  <button type="button" class="pt-tab" onclick="mudarAba('ignorados',this)">Ignorados (<%= ignorados.length %>)</button>
</div>

<div id="aba-novo" class="pt-tabpane on">
  <div class="pf-card">
    <div class="pf-card-title">🌐 Analisar site</div>
    <div class="pf-card-sub">Cole a URL de um site (imobiliária, concessionária, prestador de serviço etc) — a IA lê o conteúdo e monta uma sugestão de post pronta pro Instagram.</div>
    <div class="pt-form">
      <input type="url" id="pt-url" placeholder="https://www.exemplo.com.br" required>
      <button type="button" class="pt-btn" id="pt-btn-analisar" onclick="analisarSite()">Analisar Site</button>
    </div>
    <div id="pt-msg-inicial" class="pt-msg"></div>
  </div>

  <div id="pt-loading" class="pf-card pt-loading" style="display:none">
    <div class="pt-spin"></div>
    <span>Lendo o site e gerando a legenda...</span>
  </div>

  <div id="pt-resultado" class="pf-card" style="display:none">
    <div class="pt-wrap">
      <div class="ig-card">
        <div class="ig-head">
          <div class="ig-avatar"></div>
          <span class="ig-username"><%= (user && user.instagramUsername) ? '@'+user.instagramUsername : 'sua_conta' %></span>
        </div>
        <div class="ig-img-wrap" id="pt-img-wrap">
          <div class="ig-img-empty">Nenhuma imagem encontrada nesse site.</div>
        </div>
        <div class="ig-caption"><b><%= (user && user.instagramUsername) ? user.instagramUsername : 'sua_conta' %></b><span id="pt-legenda-preview"></span></div>
        <div class="ig-toolbar">
          <button type="button" class="publicar" onclick="publicar()" id="pt-btn-publicar">✅<span>Publicar</span></button>
          <button type="button" onclick="abrirAgendar()" id="pt-btn-agendar">🕒<span>Agendar</span></button>
          <button type="button" onclick="novaLegenda()" id="pt-btn-legenda">✏️<span>Legenda</span></button>
          <button type="button" onclick="novaImagem()" id="pt-btn-imagem">🖼️<span>Imagem</span></button>
          <button type="button" onclick="ignorar()">🗑️<span>Ignorar</span></button>
        </div>
      </div>
      <div id="pt-agendar-box" class="pt-agendar-box">
        <input type="datetime-local" id="pt-data-agendada">
        <div class="row">
          <button type="button" class="cancelar" onclick="fecharAgendar()">Cancelar</button>
          <button type="button" class="confirmar" onclick="confirmarAgendar()" id="pt-btn-confirmar-agendar">Confirmar agendamento</button>
        </div>
      </div>
      <div id="pt-msg-resultado" class="pt-msg pt-msg-resultado"></div>
    </div>
  </div>
</div>

<div id="aba-agendados" class="pt-tabpane">
  <div class="pf-card">
    <div class="pf-card-title">🕒 Agendados</div>
    <% if(!agendados.length){ %>
      <div class="pt-vazio">Nenhum post agendado.</div>
    <% } else { %>
      <div class="pt-lista">
        <% agendados.forEach(function(p){ %>
          <div class="pt-item">
            <% if(p.imagemEscolhida){ %><img class="pt-item-img" src="<%= p.imagemEscolhida %>" alt=""><% } %>
            <div class="pt-item-info">
              <div class="pt-item-legenda"><%= (p.legenda||'').slice(0,120) %></div>
              <div class="pt-item-datas">Gerado em <%= new Date(p.dataGerado).toLocaleString('pt-BR') %> · Agendado para <%= new Date(p.dataAgendada).toLocaleString('pt-BR') %></div>
            </div>
            <div class="pt-item-acoes">
              <button type="button" onclick="abrirPost('<%= p.id %>')">✏️ Abrir</button>
              <button type="button" onclick="excluirPost('<%= p.id %>')">🗑️ Excluir</button>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<div id="aba-postados" class="pt-tabpane">
  <div class="pf-card">
    <div class="pf-card-title">✅ Postados</div>
    <% if(!postados.length){ %>
      <div class="pt-vazio">Nenhum post publicado ainda.</div>
    <% } else { %>
      <div class="pt-lista">
        <% postados.forEach(function(p){ %>
          <div class="pt-item">
            <% if(p.imagemEscolhida){ %><img class="pt-item-img" src="<%= p.imagemEscolhida %>" alt=""><% } %>
            <div class="pt-item-info">
              <div class="pt-item-legenda"><%= (p.legenda||'').slice(0,120) %></div>
              <div class="pt-item-datas">Gerado em <%= new Date(p.dataGerado).toLocaleString('pt-BR') %> · Postado em <%= new Date(p.dataPublicado).toLocaleString('pt-BR') %></div>
            </div>
            <div class="pt-item-acoes">
              <button type="button" onclick="abrirPost('<%= p.id %>')">✏️ Abrir</button>
              <button type="button" onclick="excluirPost('<%= p.id %>')">🗑️ Excluir</button>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<div id="aba-ignorados" class="pt-tabpane">
  <div class="pf-card">
    <div class="pf-card-title">🗑️ Ignorados</div>
    <% if(!ignorados.length){ %>
      <div class="pt-vazio">Nenhum post ignorado.</div>
    <% } else { %>
      <div class="pt-lista">
        <% ignorados.forEach(function(p){ %>
          <div class="pt-item">
            <% if(p.imagemEscolhida || (p.imagens&&p.imagens[0])){ %><img class="pt-item-img" src="<%= p.imagemEscolhida||p.imagens[0] %>" alt=""><% } %>
            <div class="pt-item-info">
              <div class="pt-item-legenda"><%= (p.legenda||'').slice(0,120) %></div>
              <div class="pt-item-datas">Gerado em <%= new Date(p.dataGerado).toLocaleString('pt-BR') %> · Ignorado em <%= new Date(p.dataIgnorado).toLocaleString('pt-BR') %></div>
            </div>
            <div class="pt-item-acoes">
              <button type="button" onclick="abrirPost('<%= p.id %>')">✏️ Abrir</button>
              <button type="button" onclick="excluirPost('<%= p.id %>')">🗑️ Excluir</button>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<script>
let _estado = { postId:null, titulo:'', descricao:'', valor:'', textoBruto:'', imagens:[], indiceImagem:0, legenda:'' };

function mudarAba(nome, btn){
  document.querySelectorAll('.pt-tabpane').forEach(function(el){ el.classList.remove('on'); });
  document.querySelectorAll('.pt-tab').forEach(function(el){ el.classList.remove('on'); });
  document.getElementById('aba-'+nome).classList.add('on');
  btn.classList.add('on');
}

function _msg(id, texto, tipo){
  const el = document.getElementById(id);
  el.className = 'pt-msg' + (tipo ? ' '+tipo : '') + (id==='pt-msg-resultado' ? ' pt-msg-resultado' : '');
  el.textContent = texto || '';
}

function _atualizarPreview(){
  document.getElementById('pt-legenda-preview').textContent = ' ' + (_estado.legenda || '');

  const wrap = document.getElementById('pt-img-wrap');
  const total = _estado.imagens.length;
  const imgUrl = _estado.imagens[_estado.indiceImagem];
  if(!imgUrl){ wrap.innerHTML = '<div class="ig-img-empty">Nenhuma imagem encontrada nesse site.</div>'; return; }
  let html = '<img src="'+imgUrl+'" alt="">';
  if(total > 1){
    html += '<button type="button" class="ig-img-nav prev" onclick="trocarImagem(-1)">‹</button>';
    html += '<button type="button" class="ig-img-nav next" onclick="trocarImagem(1)">›</button>';
    html += '<div class="ig-img-dots">' + _estado.imagens.map((_,i)=>'<span class="'+(i===_estado.indiceImagem?'on':'')+'"></span>').join('') + '</div>';
  }
  wrap.innerHTML = html;
}

function trocarImagem(dir){
  const total = _estado.imagens.length;
  if(!total) return;
  _estado.indiceImagem = (_estado.indiceImagem + dir + total) % total;
  _atualizarPreview();
}

async function analisarSite(){
  const url = document.getElementById('pt-url').value.trim();
  if(!url){ _msg('pt-msg-inicial','Informe a URL do site.','err'); return; }
  _msg('pt-msg-inicial','');
  document.getElementById('pt-resultado').style.display = 'none';
  document.getElementById('pt-loading').style.display = 'flex';
  document.getElementById('pt-btn-analisar').disabled = true;
  try {
    const r = await fetch('/app/posts/analisar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ url }) });
    const d = await r.json();
    if(!d.ok){ _msg('pt-msg-inicial', d.erro || 'Não foi possível analisar esse site.', 'err'); return; }
    _estado = { postId:d.postId||null, titulo:d.titulo||'', descricao:d.descricao||'', valor:d.valor||'', textoBruto:d.textoBruto||'', imagens:d.imagens||[], indiceImagem:0, legenda:d.legenda||'' };
    _atualizarPreview();
    fecharAgendar();
    document.getElementById('pt-resultado').style.display = 'block';
  } catch(e) {
    _msg('pt-msg-inicial','Erro ao analisar o site. Tente novamente.','err');
  } finally {
    document.getElementById('pt-loading').style.display = 'none';
    document.getElementById('pt-btn-analisar').disabled = false;
  }
}

async function novaLegenda(){
  _msg('pt-msg-resultado','');
  document.getElementById('pt-btn-legenda').disabled = true;
  try {
    const r = await fetch('/app/posts/legenda', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ postId:_estado.postId, titulo:_estado.titulo, descricao:_estado.descricao, valor:_estado.valor, textoBruto:_estado.textoBruto }) });
    const d = await r.json();
    if(!d.ok){ _msg('pt-msg-resultado', d.erro || 'Não foi possível gerar nova legenda.', 'err'); return; }
    _estado.legenda = d.legenda;
    _atualizarPreview();
  } catch(e) {
    _msg('pt-msg-resultado','Erro ao gerar nova legenda.','err');
  } finally {
    document.getElementById('pt-btn-legenda').disabled = false;
  }
}

function novaImagem(){
  if(_estado.imagens.length < 2) { _msg('pt-msg-resultado','Nenhuma outra imagem encontrada nesse site.','err'); return; }
  trocarImagem(1);
}

async function publicar(){
  const imagemUrl = _estado.imagens[_estado.indiceImagem];
  if(!imagemUrl){ _msg('pt-msg-resultado','Esse post não tem imagem — não é possível publicar no Instagram.','err'); return; }
  if(!confirm('Publicar esse post no seu Instagram agora?')) return;
  _msg('pt-msg-resultado','');
  document.getElementById('pt-btn-publicar').disabled = true;
  try {
    const r = await fetch('/app/posts/publicar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ postId:_estado.postId, imagemUrl, legenda:_estado.legenda }) });
    const d = await r.json();
    if(!d.ok){ _msg('pt-msg-resultado', d.erro || 'Não foi possível publicar.', 'err'); return; }
    _msg('pt-msg-resultado','✅ Publicado no Instagram!','ok');
    setTimeout(function(){ location.reload(); }, 1200);
  } catch(e) {
    _msg('pt-msg-resultado','Erro ao publicar no Instagram.','err');
  } finally {
    document.getElementById('pt-btn-publicar').disabled = false;
  }
}

function abrirAgendar(){
  const imagemUrl = _estado.imagens[_estado.indiceImagem];
  if(!imagemUrl){ _msg('pt-msg-resultado','Esse post não tem imagem — não é possível agendar.','err'); return; }
  document.getElementById('pt-agendar-box').classList.add('on');
}

function fecharAgendar(){
  document.getElementById('pt-agendar-box').classList.remove('on');
  document.getElementById('pt-data-agendada').value = '';
}

async function confirmarAgendar(){
  const imagemUrl = _estado.imagens[_estado.indiceImagem];
  const dataAgendada = document.getElementById('pt-data-agendada').value;
  if(!dataAgendada){ _msg('pt-msg-resultado','Escolha data e hora do agendamento.','err'); return; }
  _msg('pt-msg-resultado','');
  document.getElementById('pt-btn-confirmar-agendar').disabled = true;
  try {
    const r = await fetch('/app/posts/agendar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ postId:_estado.postId, imagemUrl, legenda:_estado.legenda, dataAgendada }) });
    const d = await r.json();
    if(!d.ok){ _msg('pt-msg-resultado', d.erro || 'Não foi possível agendar.', 'err'); return; }
    _msg('pt-msg-resultado','✅ Post agendado!','ok');
    setTimeout(function(){ location.reload(); }, 1200);
  } catch(e) {
    _msg('pt-msg-resultado','Erro ao agendar o post.','err');
  } finally {
    document.getElementById('pt-btn-confirmar-agendar').disabled = false;
  }
}

async function ignorar(){
  if(_estado.postId){
    try { await fetch('/app/posts/ignorar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ postId:_estado.postId }) }); } catch(e) {}
  }
  document.getElementById('pt-resultado').style.display = 'none';
  document.getElementById('pt-url').value = '';
  fecharAgendar();
  _estado = { postId:null, titulo:'', descricao:'', valor:'', textoBruto:'', imagens:[], indiceImagem:0, legenda:'' };
  location.reload();
}

// Reabre um post de qualquer aba (Agendados/Postados/Ignorados) no card
// editável, com todas as opções (legenda, imagem, agendar, publicar, excluir)
async function abrirPost(id){
  try {
    const r = await fetch('/app/posts/'+id);
    const d = await r.json();
    if(!d.ok || !d.post){ alert('Não foi possível abrir esse post.'); return; }
    const p = d.post;
    const imagens = (p.imagens && p.imagens.length) ? p.imagens : (p.imagemEscolhida ? [p.imagemEscolhida] : []);
    let indice = 0;
    if(p.imagemEscolhida){ const i = imagens.indexOf(p.imagemEscolhida); if(i >= 0) indice = i; }
    _estado = { postId:p.id, titulo:p.titulo||'', descricao:p.descricao||'', valor:p.valor||'', textoBruto:p.textoBruto||'', imagens, indiceImagem:indice, legenda:p.legenda||'' };
    mudarAba('novo', document.getElementById('pt-tab-novo'));
    _atualizarPreview();
    fecharAgendar();
    document.getElementById('pt-resultado').style.display = 'block';
    _msg('pt-msg-resultado','');
    window.scrollTo({ top:0, behavior:'smooth' });
  } catch(e) {
    alert('Erro ao abrir o post.');
  }
}

async function excluirPost(id){
  if(!confirm('Excluir esse post do histórico? Essa ação não pode ser desfeita.')) return;
  try {
    const r = await fetch('/app/posts/excluir', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ postId:id }) });
    const d = await r.json();
    if(!d.ok){ alert(d.erro || 'Não foi possível excluir.'); return; }
    location.reload();
  } catch(e) {
    alert('Erro ao excluir o post.');
  }
}
</script>

<%- include('partials/app-end') %>
