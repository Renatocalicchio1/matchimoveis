<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Admin — Campanha de Captação</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f5f5f3;color:#111827;font-size:14px}
header{background:#111827;color:#fff;padding:16px 24px;display:flex;align-items:center;gap:16px;position:sticky;top:0;z-index:100;margin-left:var(--sidebar-w)}
header h1{font-size:16px;font-weight:500}
header .badge{background:#FF385C;color:#fff;font-size:11px;padding:2px 8px;border-radius:20px}
@media(max-width:900px){ header{margin-left:0} }
.content{padding:24px;max-width:900px;margin:0 auto 0 calc(var(--sidebar-w) + 24px)}
@media(max-width:900px){ .content{margin-left:auto} }
.status-box{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:20px;margin-bottom:20px;display:flex;align-items:center;gap:14px}
.status-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.status-dot.rodando{background:#16a34a;animation:pulso 1.4s ease-in-out infinite}
.status-dot.parada{background:#9ca3af}
.status-dot.concluida{background:#2563eb}
@keyframes pulso{0%,100%{opacity:1}50%{opacity:.4}}
.status-txt{font-weight:600;font-size:14px}
.status-sub{font-size:12px;color:#6b7280;margin-top:2px}
.actions{margin-left:auto;display:flex;gap:8px}
.btn{padding:9px 18px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:none}
.btn-iniciar{background:#16a34a;color:#fff}
.btn-pausar{background:#dc2626;color:#fff}
.btn:disabled{opacity:.5;cursor:not-allowed}
.funil{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:20px}
.funil-card{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:16px;text-align:center}
.funil-n{font-size:26px;font-weight:700;color:#111827}
.funil-l{font-size:11.5px;color:#6b7280;margin-top:4px}
.funil-pct{font-size:12px;color:#00A699;font-weight:600;margin-top:2px}
.barra-box{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:20px;margin-bottom:20px}
.barra-titulo{font-size:12px;color:#6b7280;margin-bottom:10px;display:flex;justify-content:space-between}
.barra{height:10px;background:#f0f0ee;border-radius:999px;overflow:hidden}
.barra-fill{height:100%;background:linear-gradient(90deg,#FF385C,#FC642D);transition:width .3s}
.aviso{background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:10px;padding:12px 16px;font-size:12.5px;margin-bottom:20px}
@media(max-width:700px){ .funil{grid-template-columns:repeat(2,1fr)} table{min-width:700px} }
.tabela-box{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:16px;overflow-x:auto}
.tabela-titulo{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.tabela-titulo h2{font-size:14px;font-weight:600}
table{width:100%;border-collapse:collapse;font-size:12px;min-width:820px}
th{text-align:left;padding:8px;background:#f9f9f7;font-size:10.5px;text-transform:uppercase;color:#6b7280;white-space:nowrap;border-bottom:1px solid #e5e5e3}
td{padding:8px;border-bottom:1px solid #f0f0ee;white-space:nowrap}
.tag{display:inline-block;padding:2px 8px;border-radius:20px;font-size:10.5px;font-weight:600}
.tag-sim{background:#f0fdf4;color:#16a34a}
.tag-nao{background:#f3f4f6;color:#9ca3af}
.tag-erro{background:#fef2f2;color:#dc2626}
.link-preview{color:#FF385C;font-weight:600;text-decoration:none}
<%- adminShellCss %>
</style>
</head>
<body>
<div class="admin-app">
<%- adminSidebar %>

<header>
  <div><h1>Campanha de Captação <span class="badge">Admin</span></h1></div>
</header>

<div class="content">
  <% if(!status){ %>
    <div class="aviso">⚠️ Erro ao carregar status da campanha.</div>
  <% } else { %>
    <div class="aviso">
      Dispara e-mails com intervalo aleatório de 1 a 3 minutos (nunca fixo, pra não parecer robô pros provedores de email) pra leads sem imóvel captado ainda — busca em <strong>duas fontes</strong>: leads que já buscaram imóvel na plataforma (tabela leads) e a base de Interessados de Portal que você importou, sempre convidando a cadastrar via <strong>matchimoveis.ia.br/captar/REN-G9K6</strong>. Título e corpo também alternam entre várias variações pra não cair em spam. Não mexe no e-mail individual que já dispara quando uma lead nova entra (esse continua igual, com o link do corretor dono dela).
    </div>

    <% if (isSuper) { %>
    <div class="status-box">
      <span class="status-dot <%= status.ativo ? 'rodando' : (status.pendentes===0 ? 'concluida' : 'parada') %>" id="statusDot"></span>
      <div>
        <div class="status-txt" id="statusTxt"><%= status.ativo ? '🟢 Rodando' : (status.pendentes===0 && status.enviados>0 ? '✓ Concluída' : '⏸ Parada') %></div>
        <div class="status-sub" id="statusSub"><%= status.pendentes %> pendente<%= status.pendentes===1?'':'s' %> — estimativa de <strong>~<%= status.minutosRestantes %></strong> min restantes (intervalo de 1 a 3 min por envio)</div>
      </div>
      <div class="actions">
        <button class="btn btn-iniciar" id="btnIniciar" onclick="iniciarCampanha()" <%= status.ativo || status.pendentes===0 ? 'disabled' : '' %>>▶ Iniciar</button>
        <button class="btn btn-pausar" id="btnPausar" onclick="pausarCampanha()" <%= !status.ativo ? 'disabled' : '' %>>⏸ Pausar</button>
      </div>
    </div>
    <% } %>

    <div class="barra-box">
      <div class="barra-titulo"><span>Progresso do envio</span><span id="barraTxt"><%= status.enviados %> / <%= status.elegiveis %></span></div>
      <div class="barra"><div class="barra-fill" id="barraFill" style="width:<%= status.elegiveis ? Math.round(status.enviados/status.elegiveis*100) : 0 %>%"></div></div>
    </div>

    <div class="funil">
      <div class="funil-card"><div class="funil-n" id="fElegiveis"><%= status.elegiveis %></div><div class="funil-l">Elegíveis</div></div>
      <div class="funil-card"><div class="funil-n" id="fEnviados"><%= status.enviados %></div><div class="funil-l">Enviados</div></div>
      <div class="funil-card"><div class="funil-n" id="fAbertos"><%= status.abertos %></div><div class="funil-l">Abriram</div><div class="funil-pct" id="fPctAbertura"><%= status.pctAbertura %>%</div></div>
      <div class="funil-card"><div class="funil-n" id="fClicados"><%= status.clicados %></div><div class="funil-l">Clicaram no link</div><div class="funil-pct" id="fPctClique"><%= status.pctClique %>%</div></div>
      <div class="funil-card"><div class="funil-n" id="fIniciaram"><%= status.iniciaram %></div><div class="funil-l">Iniciaram cadastro</div><div class="funil-pct" id="fPctIniciaram"><%= status.pctIniciaram %>%</div></div>
    </div>

    <div class="tabela-box">
      <div class="tabela-titulo">
        <h2>Envios recentes</h2>
      </div>
      <div style="margin-bottom:12px">
        <input type="text" id="busca" placeholder="Buscar por nome ou email..." style="width:260px;display:inline-block;padding:8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px" oninput="buscar()">
        <select id="filtro" onchange="buscar()" style="width:180px;display:inline-block;margin-left:8px;padding:8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px">
          <option value="">Todos</option>
          <option value="abriu">Quem abriu</option>
          <option value="clicou">Quem clicou</option>
          <option value="cadastrou">Quem cadastrou</option>
          <option value="erro">Erros</option>
        </select>
      </div>
      <table>
        <thead><tr><th>Nome</th><th>Email</th><th>Celular</th><th>Data enviado</th><th>Abriu</th><th>Clicou</th><th>Iniciou cadastro</th><th>E-mail</th></tr></thead>
        <tbody id="tabelaEnvios"><tr><td colspan="8" style="text-align:center;color:#9ca3af">Carregando...</td></tr></tbody>
      </table>
      <div id="paginacao" style="margin-top:10px;font-size:12.5px;color:#6b7280"></div>
    </div>
  <% } %>
</div>
</div>

<script>
async function _post(url){
  const r = await fetch(url, { method:'POST' });
  return r.json();
}
function escHtml(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function _setTxt(id, val){ const el = document.getElementById(id); if(el) el.textContent = val; }
// status-box (dot/texto/botões Iniciar-Pausar) some da tela pra conta admin
// secundária (ver isSuper no server) — os ids dela podem não existir no DOM,
// por isso os _setTxt/checks abaixo em vez de document.getElementById direto
// (sem isso, o primeiro elemento ausente travava o resto da função e o funil/
// tabela, que a conta secundária PODE ver, parava de atualizar sozinho).
function _atualizarTela(s){
  _setTxt('fElegiveis', s.elegiveis);
  _setTxt('fEnviados', s.enviados);
  _setTxt('fAbertos', s.abertos);
  _setTxt('fPctAbertura', s.pctAbertura + '%');
  _setTxt('fClicados', s.clicados);
  _setTxt('fPctClique', s.pctClique + '%');
  _setTxt('fIniciaram', s.iniciaram);
  _setTxt('fPctIniciaram', s.pctIniciaram + '%');
  _setTxt('barraTxt', s.enviados + ' / ' + s.elegiveis);
  const barraFill = document.getElementById('barraFill');
  if(barraFill) barraFill.style.width = (s.elegiveis ? Math.round(s.enviados/s.elegiveis*100) : 0) + '%';
  const dot = document.getElementById('statusDot');
  const txt = document.getElementById('statusTxt');
  const sub = document.getElementById('statusSub');
  const concluida = s.pendentes === 0 && s.enviados > 0;
  if(dot) dot.className = 'status-dot ' + (s.ativo ? 'rodando' : (concluida ? 'concluida' : 'parada'));
  if(txt) txt.textContent = s.ativo ? '🟢 Rodando' : (concluida ? '✓ Concluída' : '⏸ Parada');
  if(sub) sub.innerHTML = s.pendentes + ' pendente' + (s.pendentes===1?'':'s') + ' — estimativa de <strong>~' + s.minutosRestantes + '</strong> min restantes (intervalo de 1 a 3 min por envio)';
  const btnIniciar = document.getElementById('btnIniciar');
  if(btnIniciar) btnIniciar.disabled = s.ativo || s.pendentes === 0;
  const btnPausar = document.getElementById('btnPausar');
  if(btnPausar) btnPausar.disabled = !s.ativo;
}
async function iniciarCampanha(){
  if(!confirm('Iniciar o disparo? Vai mandar os emails com intervalo aleatório de 1 a 3 minutos até esgotar as leads elegíveis.')) return;
  const d = await _post('/admin/captacao-campanha/iniciar');
  if(d.ok) _atualizarTela(d.status);
}
async function pausarCampanha(){
  const d = await _post('/admin/captacao-campanha/pausar');
  if(d.ok) _atualizarTela(d.status);
}
function _tag(cond){ return cond ? '<span class="tag tag-sim">Sim</span>' : '<span class="tag tag-nao">Não</span>'; }
function _dataFmt(iso){ return iso ? new Date(iso).toLocaleString('pt-BR', { timeZone:'America/Sao_Paulo' }) : ''; }
let _paginaEnvios = 1;
function buscar(){ _paginaEnvios = 1; carregarTabela(); }
async function carregarTabela(pagina){
  if(pagina) _paginaEnvios = pagina;
  try {
    const q = document.getElementById('busca').value;
    const filtro = document.getElementById('filtro').value;
    const r = await fetch('/admin/captacao-campanha/lista?pagina='+_paginaEnvios+'&q='+encodeURIComponent(q)+'&filtro='+encodeURIComponent(filtro));
    const d = await r.json();
    const tbody = document.getElementById('tabelaEnvios');
    if(!tbody) return;
    if(!d.ok || !d.envios.length){ tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;color:#9ca3af">Nenhum envio encontrado.</td></tr>'; document.getElementById('paginacao').innerHTML = ''; return; }
    tbody.innerHTML = d.envios.map(function(e){
      if(e.erro) return '<tr><td>'+escHtml(e.nome)+'</td><td>'+escHtml(e.email)+'</td><td>'+escHtml(e.telefone||'')+'</td><td>'+_dataFmt(e.enviado_em)+'</td><td colspan="3"><span class="tag tag-erro">Erro: '+escHtml(e.erro)+'</span></td><td>—</td></tr>';
      return '<tr><td>'+escHtml(e.nome)+'</td><td>'+escHtml(e.email)+'</td><td>'+escHtml(e.telefone||'')+'</td><td>'+_dataFmt(e.enviado_em)+'</td><td>'+_tag(e.aberto_em)+'</td><td>'+_tag(e.clicado_em)+'</td><td>'+_tag(e.iniciou_cadastro_em)+'</td><td><a class="link-preview" href="/admin/captacao-campanha/preview/'+e.id+'" target="_blank">Ver e-mail →</a></td></tr>';
    }).join('');
    let pag = '';
    if(_paginaEnvios > 1) pag += '<button class="btn" style="background:#6b7280;color:#fff" onclick="carregarTabela('+(_paginaEnvios-1)+')">← Anterior</button> ';
    pag += '<span>Página '+_paginaEnvios+' — '+d.total+' envio'+(d.total===1?'':'s')+'</span> ';
    if(d.envios.length === 50) pag += ' <button class="btn" style="background:#6b7280;color:#fff" onclick="carregarTabela('+(_paginaEnvios+1)+')">Próximo →</button>';
    document.getElementById('paginacao').innerHTML = pag;
  } catch(e){}
}
setInterval(async function(){
  try {
    const r = await fetch('/admin/captacao-campanha/status');
    const d = await r.json();
    if(d.ok) _atualizarTela(d.status);
  } catch(e){}
  carregarTabela();
}, 15000);
carregarTabela();
</script>
</body>
</html>
