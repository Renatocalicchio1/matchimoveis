<%- include('partials/app-shell', {active:'home',title:'Dashboard',subtitle:'',user:user}) %>
<style>
/* Paleta Airbnb — vermelho Rausch (marca), teal Babu, laranja Arches.
   3 cores categóricas fixas (nunca cicladas) + cinza neutro pra "Outros". */
:root{
  --air-red:#FF385C; --air-red-dark:#C1284A; --air-red-bg:#fff1f3; --air-red-text:#c81e4a;
  --air-teal:#00A699; --air-teal-dark:#00655c; --air-teal-bg:#e6f7f5; --air-teal-text:#00695c;
  --air-orange:#FC642D; --air-orange-dark:#b8460e; --air-orange-bg:#fff1e8; --air-orange-text:#b8460e;
  --air-gray:#B0B0B0;
  --air-good:#16a34a; --air-warn:#d97706; --air-crit:#dc2626;
}
.ticker-bar{display:flex;gap:8px;margin-bottom:18px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none}
.ticker-bar::-webkit-scrollbar{display:none}
.tkr{background:var(--white);border:1px solid var(--border);border-radius:10px;padding:12px 15px;min-width:130px;flex-shrink:0;position:relative;overflow:hidden;cursor:default;transition:box-shadow .2s}
.tkr:hover{box-shadow:var(--shadow-md)}
.tkr::before{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.tkr.red::before{background:var(--air-red)}.tkr.teal::before{background:var(--air-teal)}.tkr.orange::before{background:var(--air-orange)}.tkr.good::before{background:var(--air-good)}.tkr.crit::before{background:var(--air-crit)}
.tkr-lbl{font-size:9px;text-transform:uppercase;letter-spacing:.8px;color:var(--text-ter);margin-bottom:5px}
.tkr-val{font-size:22px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums;letter-spacing:-1px;color:var(--dark)}
.tkr-delta{font-size:10px;margin-top:3px}
.tkr-delta.up{color:var(--air-good)}.tkr-delta.dn{color:var(--air-crit)}.tkr-delta.n{color:var(--text-ter)}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px}
.dc{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:16px 18px}
.dc-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.dc-t{font-size:10px;text-transform:uppercase;letter-spacing:.7px;color:var(--text-sec);font-weight:600}
.dc-t a{font-size:10px;color:var(--air-red);text-decoration:none;font-weight:400;text-transform:none;letter-spacing:0}
.badge-xs{font-size:9px;padding:2px 6px;border-radius:20px;font-weight:600}
.bx-red{background:var(--air-red-bg);color:var(--air-red-text)}.bx-teal{background:var(--air-teal-bg);color:var(--air-teal-text)}.bx-orange{background:var(--air-orange-bg);color:var(--air-orange-text)}
.funil-vis{display:flex;flex-direction:column;gap:6px}
.fv-row{display:flex;align-items:center;gap:8px}
.fv-lbl{font-size:10px;color:var(--text-sec);width:76px;flex-shrink:0;text-align:right}
.fv-bar{flex:1;position:relative;height:28px;border-radius:6px;overflow:hidden;background:rgba(0,0,0,.04)}
.fv-bar-inner{position:absolute;left:0;top:0;bottom:0;border-radius:6px;transition:width 1.4s cubic-bezier(.16,1,.3,1)}
.fv-num{font-size:11px;font-weight:600;position:relative;z-index:1;color:#fff;padding:0 8px;line-height:28px}
.fv-pct{font-size:9px;color:var(--text-ter);width:32px;text-align:right;flex-shrink:0}
.bar-row{display:flex;align-items:center;gap:8px;margin-bottom:6px}
.bar-row:last-child{margin-bottom:0}
.bar-nome{font-size:11px;color:var(--text-sec);width:90px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bar-track{flex:1;height:10px;background:var(--border-light);border-radius:3px;overflow:hidden;position:relative;display:flex;gap:1px}
.bar-fill{height:100%;border-radius:3px}
.bar-cnt{font-size:10px;font-weight:600;width:20px;text-align:right;flex-shrink:0;color:var(--text-sec)}
.lead-row{display:flex;align-items:center;gap:9px;padding:7px 0;border-bottom:1px solid var(--border-light)}
.lead-row:last-child{border-bottom:none}
.av{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;flex-shrink:0}
.ln{font-size:11px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ls{font-size:10px;color:var(--text-ter)}
.top-im{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--border-light)}
.top-im:last-child{border-bottom:none}
.top-rk{font-size:10px;color:var(--text-ter);width:14px;flex-shrink:0}
.top-thumb{width:32px;height:32px;border-radius:7px;object-fit:cover;flex-shrink:0;background:var(--border-light)}
.top-tipo{font-size:11px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.top-loc{font-size:9px;color:var(--text-ter)}
.top-cnt{font-size:12px;font-weight:700;color:var(--air-teal);flex-shrink:0}
.gauge-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:4px 0}
.gauge-big{font-size:30px;font-weight:700;line-height:1;margin-top:-6px;letter-spacing:-1px}
.gauge-sub{font-size:10px;color:var(--text-ter);margin-top:3px}
.ins{display:flex;align-items:center;justify-content:space-between;padding:9px 11px;border-radius:8px;margin-bottom:6px}
.ins:last-child{margin-bottom:0}
.ins-txt{font-size:11px;font-weight:500}
.ins-lnk{font-size:10px;font-weight:500;text-decoration:none}
.score-wrap{padding:10px 12px;background:var(--border-light);border-radius:8px;margin-bottom:6px}
.score-lbl{font-size:10px;color:var(--text-ter);margin-bottom:6px}
.score-bar{height:8px;background:var(--border);border-radius:4px;overflow:hidden}
.score-fill{height:100%;border-radius:4px;transition:width 1.5s cubic-bezier(.16,1,.3,1)}
.clk-badge{font-size:10px;color:var(--text-ter);background:var(--border-light);padding:3px 8px;border-radius:6px;display:inline-flex;align-items:center;gap:4px}
.pdot{width:5px;height:5px;border-radius:50%;background:var(--air-good);animation:pd 2s infinite}
@keyframes pd{0%,100%{opacity:1}50%{opacity:.2}}
.trend-tile{padding:12px;border-radius:10px;text-align:center}
.trend-num{font-size:20px;font-weight:700;line-height:1}
.trend-lbl{font-size:9px;text-transform:uppercase;letter-spacing:.4px;margin-top:4px;color:var(--text-ter)}
.trend-delta{font-size:10px;font-weight:600;margin-top:3px}
.visita-row{display:flex;align-items:center;gap:9px;padding:7px 0;border-bottom:1px solid var(--border-light)}
.visita-row:last-child{border-bottom:none}
.visita-dia{width:34px;height:34px;border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;font-weight:700}
.visita-dia .d{font-size:12px;line-height:1}
.visita-dia .m{font-size:7px;text-transform:uppercase;letter-spacing:.3px}
@media(max-width:1100px){.g3{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.g2,.g3{grid-template-columns:1fr}}
</style>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
  <div>
    <h2 style="font-size:17px;font-weight:700;color:var(--dark);letter-spacing:-.3px">Olá, <%= (user.nome||'').split(' ')[0] %> 👋</h2>
    <p style="font-size:11px;color:var(--text-ter);margin-top:1px">Resumo da operação em tempo real</p>
  </div>
  <div class="clk-badge"><span class="pdot"></span><span id="clk"></span></div>
</div>

<% if (typeof radar !== 'undefined' && radar) { %>
<div style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);padding:14px 18px;margin-bottom:16px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;box-shadow:var(--shadow)">
  <div style="display:flex;align-items:center;gap:6px;font-size:11px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--text-ter)">🎯 Radar Match</div>
  <% if (radar.streak && radar.streak.atual > 0) { %>
  <span style="display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:700;background:#FFF1E8;color:#b8460e;padding:4px 10px;border-radius:999px">🔥 <%= radar.streak.atual %> dias</span>
  <% } %>
  <% if (radar.total > 0) { %>
    <span style="font-size:13px;color:var(--text-sec);flex:1;min-width:200px">
      <b style="color:var(--text)"><%= radar.total %></b> oportunidade<%= radar.total===1?'':'s' %> aberta<%= radar.total===1?'':'s' %>
      <% if (radar.urgente && radar.urgente.horas >= 4) { %>
        · <span style="color:#b3212f;font-weight:600">⚡ uma aguardando há <%= radar.urgente.horas %>h</span>
      <% } %>
    </span>
    <a href="/app/resumo" style="font-size:12.5px;font-weight:700;color:#fff;background:var(--brand);padding:7px 14px;border-radius:10px;text-decoration:none;white-space:nowrap">Ver oportunidades</a>
  <% } else { %>
    <span style="font-size:13px;color:var(--text-ter);flex:1">Nada novo desde sua última visita — sua sequência continua.</span>
  <% } %>
</div>
<% } %>

<div class="ticker-bar">
  <div class="tkr red"><div class="tkr-lbl">Imóveis</div><div class="tkr-val" id="ki"><%= stats.imoveisAtivos %></div><div class="tkr-delta n">carteira ativa</div></div>
  <div class="tkr red"><div class="tkr-lbl">Leads</div><div class="tkr-val" id="kl"><%= stats.leadsNovos %></div><div class="tkr-delta n">pipeline</div></div>
  <div class="tkr teal"><div class="tkr-lbl">Com match</div><div class="tkr-val" id="km"><%= stats.comMatch %></div><div class="tkr-delta up">↑ <%= stats.taxaMatch %>% taxa</div></div>
  <div class="tkr orange"><div class="tkr-lbl">Visitas</div><div class="tkr-val" id="kv"><%= stats.visitasAgendadas %></div><div class="tkr-delta n">agendadas</div></div>
  <div class="tkr orange"><div class="tkr-lbl">Hoje</div><div class="tkr-val" id="kh"><%= stats.visitasHoje %></div><div class="tkr-delta n">visitas hoje</div></div>
  <div class="tkr crit"><div class="tkr-lbl">Pendentes</div><div class="tkr-val"><%= Math.max(stats.leadsNovos - stats.comMatch, 0) %></div><div class="tkr-delta dn">⚠ sem match</div></div>
  <div class="tkr good"><div class="tkr-lbl">Score</div><div class="tkr-val"><%= stats.scoreCarteira||0 %></div><div class="tkr-delta n">saúde carteira</div></div>
</div>

<div class="g3">
  <div class="dc">
    <div class="dc-hd"><span class="dc-t">Funil de conversão</span><span class="badge-xs bx-red">ao vivo</span></div>
    <% var ft=Math.max(stats.funnelLeads||1,1);
       var funnelRows=[
         {l:'Leads',v:stats.funnelLeads||0,c:'#ffd7de',p:100},
         {l:'Match',v:stats.funnelMatch||0,c:'#ff8fa3',p:stats.funnelPctMatch||0},
         {l:'Visita',v:stats.funnelVisitaAgendada||0,p:Math.round(((stats.funnelVisitaAgendada||0)/ft)*100),c:'#ff5c7a'},
         {l:'Confirmada',v:stats.funnelVisitaConfirmada||0,p:Math.round(((stats.funnelVisitaConfirmada||0)/ft)*100),c:'var(--air-red)'}
       ]; %>
    <div class="funil-vis">
    <% funnelRows.forEach(function(f){ %>
    <div class="fv-row"><span class="fv-lbl"><%= f.l %></span><div class="fv-bar"><div class="fv-bar-inner" style="width:<%= f.p %>%;background:<%= f.c %>"></div><span class="fv-num" style="color:<%= f.l==='Leads'?'#7a1230':'#fff' %>"><%= f.v %></span></div><span class="fv-pct"><%= f.p %>%</span></div>
    <% }); %>
    </div>
  </div>

  <div class="dc">
    <div class="dc-hd"><span class="dc-t">Evolução semanal de leads</span><span class="badge-xs bx-red">4 semanas</span></div>
    <% var evol=JSON.parse(stats.evolucaoSemanal||'[0,0,0,0]');var semLabels=['Sem -3','Sem -2','Sem -1','Esta sem']; %>
    <div style="position:relative;height:150px"><canvas id="cevol" role="img" aria-label="Evolução de leads"></canvas></div>
  </div>

  <div class="dc">
    <div class="dc-hd"><span class="dc-t">Temperatura das leads</span></div>
    <div style="position:relative;height:110px"><canvas id="ctemp" role="img" aria-label="Temperatura das leads"></canvas></div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:5px;margin-top:10px">
      <div style="padding:7px;background:var(--air-teal-bg);border-radius:7px;text-align:center"><div style="font-size:14px;font-weight:700;color:var(--air-teal-text)"><%= stats.leadsFrias||0 %></div><div style="font-size:9px;color:var(--air-teal-text)">Frias</div></div>
      <div style="padding:7px;background:var(--air-orange-bg);border-radius:7px;text-align:center"><div style="font-size:14px;font-weight:700;color:var(--air-orange-text)"><%= stats.leadsMornas||0 %></div><div style="font-size:9px;color:var(--air-orange-text)">Mornas</div></div>
      <div style="padding:7px;background:var(--air-red-bg);border-radius:7px;text-align:center"><div style="font-size:14px;font-weight:700;color:var(--air-red-text)"><%= stats.leadsQuentes||0 %></div><div style="font-size:9px;color:var(--air-red-text)">Quentes</div></div>
    </div>
  </div>
</div>

<div class="g3">
  <div class="dc">
    <div class="dc-hd"><span class="dc-t">Demanda × Oferta por bairro</span><span class="badge-xs bx-red">leads vs imóveis</span></div>
    <div style="position:relative;height:190px"><canvas id="cdemanda" role="img" aria-label="Demanda e oferta por bairro"></canvas></div>
  </div>

  <div class="dc">
    <div class="dc-hd"><span class="dc-t">Tipos de imóvel</span><span class="badge-xs bx-teal">oferta real</span></div>
    <div style="position:relative;height:120px"><canvas id="ctipo" role="img" aria-label="Tipos de imóvel"></canvas></div>
    <div id="tipo-pills" style="margin-top:8px;display:flex;flex-wrap:wrap;gap:3px"></div>
  </div>

  <div class="dc">
    <div class="dc-hd"><span class="dc-t">Leads por origem</span><span class="badge-xs bx-orange">canal</span></div>
    <div style="position:relative;height:120px"><canvas id="corigem" role="img" aria-label="Leads por origem"></canvas></div>
    <div id="origem-pills" style="margin-top:8px;display:flex;flex-wrap:wrap;gap:3px"></div>
  </div>
</div>

<%
  // Home dinâmica (Fase 10, ver CLAUDE.md): entre os cards desta fileira, só
  // "Confirmação & tendência mensal" tem uma comparação real de período já
  // calculada (mês atual vs mês passado). Regra de quietude — sem desvio
  // notável (>=20%), a ordem fica a de sempre; nenhum destaque inventado.
  var _mesAtualPre = stats.visitasRealizadasMes||0, _mesPassadoPre = stats.visitasRealizadasMesPassado||0;
  var _deltaPre = _mesPassadoPre>0 ? Math.abs(Math.round(((_mesAtualPre-_mesPassadoPre)/_mesPassadoPre)*100)) : (_mesAtualPre>0?100:0);
  var _confirmacaoPrimeiro = _deltaPre >= 20;
%>
<div class="g3">
  <div class="dc">
    <div class="dc-hd"><span class="dc-t">Visitas por status</span></div>
    <div style="position:relative;height:150px"><canvas id="cvisitas" role="img" aria-label="Visitas por status"></canvas></div>
  </div>

  <div class="dc"<% if(_confirmacaoPrimeiro){ %> style="order:-1"<% } %>>
    <div class="dc-hd"><span class="dc-t">Confirmação & tendência mensal</span><% if(_confirmacaoPrimeiro){ %><span class="badge-xs bx-orange">maior desvio do mês</span><% } %></div>
    <div class="gauge-wrap" style="margin-bottom:10px">
      <% var vtc=stats.visitasTaxaConfirmacao||0;var gc=vtc>60?'var(--air-good)':vtc>30?'var(--air-warn)':'var(--air-crit)'; %>
      <div class="gauge-big" style="color:<%= gc %>"><%= vtc %>%</div>
      <div class="gauge-sub">taxa de confirmação de visitas</div>
    </div>
    <% var mesAtual=stats.visitasRealizadasMes||0, mesPassado=stats.visitasRealizadasMesPassado||0;
       var deltaM = mesPassado>0 ? Math.round(((mesAtual-mesPassado)/mesPassado)*100) : (mesAtual>0?100:0);
       var deltaUp = mesAtual >= mesPassado; %>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px">
      <div class="trend-tile" style="background:var(--border-light)"><div class="trend-num" style="color:var(--dark)"><%= mesAtual %></div><div class="trend-lbl">Realizadas este mês</div></div>
      <div class="trend-tile" style="background:var(--border-light)">
        <div class="trend-num" style="color:var(--dark)"><%= mesPassado %></div>
        <div class="trend-lbl">Mês passado</div>
        <div class="trend-delta" style="color:<%= deltaUp?'var(--air-good)':'var(--air-crit)' %>"><%= deltaUp?'↑':'↓' %> <%= Math.abs(deltaM) %>%</div>
      </div>
    </div>
  </div>

  <div class="dc">
    <div class="dc-hd"><span class="dc-t">Saúde da carteira</span></div>
    <div class="score-wrap">
      <div class="score-lbl">Score — <strong><%= stats.scoreCarteira||0 %>/100</strong></div>
      <div class="score-bar"><div class="score-fill" id="score-fill" style="width:0%;background:<%= (stats.scoreCarteira||0)>70?'var(--air-good)':(stats.scoreCarteira||0)>40?'var(--air-warn)':'var(--air-crit)' %>"></div></div>
    </div>
    <div class="ins" style="background:<%= stats.imoveisSemFoto>0?'var(--air-orange-bg)':'var(--air-teal-bg)' %>">
      <span class="ins-txt" style="color:<%= stats.imoveisSemFoto>0?'var(--air-orange-text)':'var(--air-teal-text)' %>"><%= stats.imoveisSemFoto>0?'⚠️ '+stats.imoveisSemFoto+' sem foto':'✅ Fotos ok' %></span>
      <% if(stats.imoveisSemFoto>0){ %><a href="/app/imoveis" class="ins-lnk" style="color:var(--air-orange-text)">corrigir</a><% } %>
    </div>
    <div class="ins" style="background:<%= stats.leadsQuentesSemVisita>0?'var(--air-red-bg)':'var(--air-teal-bg)' %>">
      <span class="ins-txt" style="color:<%= stats.leadsQuentesSemVisita>0?'var(--air-red-text)':'var(--air-teal-text)' %>"><%= stats.leadsQuentesSemVisita>0?'🔥 '+stats.leadsQuentesSemVisita+' quentes s/ visita':'✅ Sem pendências' %></span>
      <% if(stats.leadsQuentesSemVisita>0){ %><a href="/app/leads" class="ins-lnk" style="color:var(--air-red-text)">ver</a><% } %>
    </div>
    <% if(stats.imovelMaisVisitado){ %>
    <div class="ins" style="background:var(--border-light)">
      <span class="ins-txt" style="color:var(--dark)">🏆 + visitado: <%= stats.imovelMaisVisitado.titulo %> (<%= stats.imovelMaisVisitado.cnt %>x)</span>
    </div>
    <% } %>
    <% if(stats.leadMaisAntigaSemVisita){ %>
    <div class="ins" style="background:var(--air-orange-bg)">
      <span class="ins-txt" style="color:var(--air-orange-text)">⏳ <%= stats.leadMaisAntigaSemVisita.nome %> — <%= stats.leadMaisAntigaSemVisita.dias %>d sem visita</span>
    </div>
    <% } %>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:6px">
      <div style="padding:8px 10px;background:var(--border-light);border-radius:7px"><div style="font-size:9px;color:var(--text-ter);margin-bottom:2px">+ buscado</div><div style="font-size:12px;font-weight:600;color:var(--dark);overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= stats.bairroMaisDemandado||'—' %></div></div>
      <div style="padding:8px 10px;background:var(--border-light);border-radius:7px"><div style="font-size:9px;color:var(--text-ter);margin-bottom:2px">+ oferta</div><div style="font-size:12px;font-weight:600;color:var(--dark);overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= stats.bairroMaisOferta||'—' %></div></div>
    </div>
  </div>
</div>

<div class="g3">
  <div class="dc">
    <div class="dc-hd"><span class="dc-t">Leads recentes</span><a href="/app/leads">ver todos →</a></div>
    <% var avCores=[['var(--air-red-bg)','var(--air-red-text)'],['var(--air-teal-bg)','var(--air-teal-text)'],['var(--air-orange-bg)','var(--air-orange-text)']];var rec=locals.recentes||[]; %>
    <% if(!rec.length){ %><div style="text-align:center;padding:20px;color:var(--text-ter);font-size:11px">Nenhum lead ainda</div><% } %>
    <% rec.slice(0,5).forEach(function(l,i){var tm=(l.matches&&l.matches.length>0)||(l.matchesAuto&&l.matchesAuto.length>0);var c=avCores[i%3]; %>
    <div class="lead-row">
      <div class="av" style="background:<%= c[0] %>;color:<%= c[1] %>"><%= (l.nome||'?').charAt(0).toUpperCase() %></div>
      <div style="flex:1;min-width:0"><div class="ln"><%= l.nome||l.telefone||'Lead' %></div><div class="ls"><%= l.origem||'WhatsApp' %> · <%= (l.perfilIA&&l.perfilIA.cidade)||l.cidade||'—' %></div></div>
      <% if(tm){ %><span class="badge-xs bx-teal">match</span><% }else{ %><span class="badge-xs" style="background:var(--border-light);color:var(--text-ter)">novo</span><% } %>
    </div>
    <% }); %>
  </div>

  <div class="dc">
    <div class="dc-hd"><span class="dc-t">Top imóveis mais matcheados</span><a href="/app/imoveis">ver todos →</a></div>
    <% var rank=stats.rankingImoveis||[]; %>
    <% if(!rank.length){ %><div style="text-align:center;padding:20px;color:var(--text-ter);font-size:11px">Sem dados ainda</div><% } %>
    <% rank.forEach(function(im,i){ %>
    <div class="top-im">
      <span class="top-rk">#<%= i+1 %></span>
      <% if(im.foto){ %><img class="top-thumb" src="<%= im.foto %>" alt="<%= im.titulo||'Imóvel' %>" onerror="this.style.display='none'"><% } %>
      <div style="flex:1;min-width:0"><div class="top-tipo"><%= im.titulo||'Imóvel' %></div><div class="top-loc"><%= im.bairro||'' %><%= im.valor?' · R$ '+Number(im.valor).toLocaleString('pt-BR'):'' %></div></div>
      <span class="top-cnt"><%= im.cnt||0 %>×</span>
    </div>
    <% }); %>
  </div>

  <div class="dc">
    <div class="dc-hd"><span class="dc-t">Próximas visitas</span><a href="/app/visitas">ver todas →</a></div>
    <% var prox=stats.proximasVisitas||[]; %>
    <% if(!prox.length){ %><div style="text-align:center;padding:20px;color:var(--text-ter);font-size:11px">Nenhuma visita agendada</div><% } %>
    <% prox.forEach(function(v){ var dt=v.data?new Date(v.data):null; %>
    <div class="visita-row">
      <div class="visita-dia" style="background:<%= v.hoje?'var(--air-red-bg)':'var(--border-light)' %>;color:<%= v.hoje?'var(--air-red-text)':'var(--text-sec)' %>">
        <div class="d"><%= dt?dt.getDate():'-' %></div>
        <div class="m"><%= dt?dt.toLocaleDateString('pt-BR',{month:'short'}).replace('.',''):'' %></div>
      </div>
      <div style="flex:1;min-width:0"><div class="ln"><%= v.nome %></div><div class="ls"><%= v.titulo %><%= v.bairro?' · '+v.bairro:'' %><%= v.hora?' · '+v.hora:'' %></div></div>
      <% if(v.hoje){ %><span class="badge-xs bx-red">hoje</span><% } %>
    </div>
    <% }); %>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
(function tick(){document.getElementById('clk').textContent=new Date().toLocaleTimeString('pt-BR');setTimeout(tick,1000);})();
function anim(id,final){var el=document.getElementById(id);if(!el)return;var s=Date.now();(function f(){var p=Math.min((Date.now()-s)/700,1);el.textContent=Math.round(p*final);if(p<1)requestAnimationFrame(f);})();}
anim('ki',<%=stats.imoveisAtivos%>);anim('kl',<%=stats.leadsNovos%>);anim('km',<%=stats.comMatch%>);anim('kv',<%=stats.visitasAgendadas%>);anim('kh',<%=stats.visitasHoje%>);
setTimeout(function(){var el=document.getElementById('score-fill');if(el)el.style.width='<%=stats.scoreCarteira||0%>%';},300);

Chart.defaults.font.family="'Inter',sans-serif";
Chart.defaults.color='#9ca3af';

// Evolução semanal — série única (vermelho da marca)
new Chart(document.getElementById('cevol'),{
  type:'bar',
  data:{labels:['S-3','S-2','S-1','Atual'],datasets:[{data:<%- stats.evolucaoSemanal||'[0,0,0,0]' %>,backgroundColor:'#FF385C',borderRadius:4,maxBarThickness:36}]},
  options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{title:function(){return '';}}}},scales:{x:{grid:{display:false},ticks:{font:{size:9}}},y:{grid:{color:'rgba(0,0,0,.04)'},ticks:{font:{size:9},precision:0},beginAtZero:true}}}
});

// Temperatura das leads — quente(vermelho) / morno(laranja) / frio(teal)
new Chart(document.getElementById('ctemp'),{
  type:'doughnut',
  data:{labels:['Quentes','Mornas','Frias'],datasets:[{data:[<%=stats.leadsQuentes||0%>,<%=stats.leadsMornas||0%>,<%=stats.leadsFrias||0%>],backgroundColor:['#FF385C','#FC642D','#00A699'],borderWidth:2,borderColor:'#fff',hoverOffset:4}]},
  options:{responsive:true,maintainAspectRatio:false,cutout:'68%',plugins:{legend:{display:false}}}
});

// Demanda (leads) x Oferta (imóveis) por bairro
var demandaMap=<%- locals.graficoLeadsBairro||'{}' %>;
var ofertaMap=<%- locals.graficoImoveisBairro||'{}' %>;
var bairrosSet=Object.keys(demandaMap).slice(0,6);
Object.keys(ofertaMap).forEach(function(b){ if(bairrosSet.indexOf(b)===-1 && bairrosSet.length<6) bairrosSet.push(b); });
new Chart(document.getElementById('cdemanda'),{
  type:'bar',
  data:{labels:bairrosSet,datasets:[
    {label:'Leads (demanda)',data:bairrosSet.map(function(b){return demandaMap[b]||0;}),backgroundColor:'#FF385C',borderRadius:3,maxBarThickness:18},
    {label:'Imóveis (oferta)',data:bairrosSet.map(function(b){return ofertaMap[b]||0;}),backgroundColor:'#00A699',borderRadius:3,maxBarThickness:18}
  ]},
  options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:bairrosSet.length>0,position:'bottom',labels:{boxWidth:8,font:{size:9}}}},scales:{x:{grid:{display:false},ticks:{font:{size:8}}},y:{grid:{color:'rgba(0,0,0,.04)'},ticks:{font:{size:9},precision:0},beginAtZero:true}}}
});

// Tipos de imóvel — dado real (graficoImoveisTipo), sem inventar número
var tipoMap=<%- locals.graficoImoveisTipo||'{}' %>;
var tipoLabels=Object.keys(tipoMap);
var tipoData=Object.values(tipoMap);
var tipoCores=['#FF385C','#00A699','#FC642D','#C1284A','#00655C','#B0B0B0'];
if(tipoLabels.length){
  new Chart(document.getElementById('ctipo'),{type:'doughnut',data:{labels:tipoLabels,datasets:[{data:tipoData,backgroundColor:tipoCores,borderWidth:2,borderColor:'#fff',hoverOffset:4}]},options:{responsive:true,maintainAspectRatio:false,cutout:'70%',plugins:{legend:{display:false}}}});
  var pp=document.getElementById('tipo-pills');
  tipoLabels.forEach(function(l,i){pp.innerHTML+='<span class="badge-xs" style="background:'+tipoCores[i%6]+'18;color:'+tipoCores[i%6]+'"><span style="width:5px;height:5px;border-radius:50%;background:'+tipoCores[i%6]+';display:inline-block;margin-right:4px"></span>'+l+' ('+tipoData[i]+')</span>';});
} else {
  document.getElementById('ctipo').parentElement.innerHTML='<div style="text-align:center;padding:30px 0;color:var(--text-ter);font-size:11px">Sem imóveis cadastrados ainda</div>';
}

// Leads por origem — dado real (graficoLeadsOrigem)
var origemMap=<%- locals.graficoLeadsOrigem||'{}' %>;
var origemLabels=Object.keys(origemMap);
var origemData=Object.values(origemMap);
var origemCores=['#FC642D','#FF385C','#00A699','#C1284A','#00655C','#B0B0B0'];
if(origemLabels.length){
  new Chart(document.getElementById('corigem'),{type:'doughnut',data:{labels:origemLabels,datasets:[{data:origemData,backgroundColor:origemCores,borderWidth:2,borderColor:'#fff',hoverOffset:4}]},options:{responsive:true,maintainAspectRatio:false,cutout:'70%',plugins:{legend:{display:false}}}});
  var po=document.getElementById('origem-pills');
  origemLabels.forEach(function(l,i){po.innerHTML+='<span class="badge-xs" style="background:'+origemCores[i%6]+'18;color:'+origemCores[i%6]+'"><span style="width:5px;height:5px;border-radius:50%;background:'+origemCores[i%6]+';display:inline-block;margin-right:4px"></span>'+l+' ('+origemData[i]+')</span>';});
} else {
  document.getElementById('corigem').parentElement.innerHTML='<div style="text-align:center;padding:30px 0;color:var(--text-ter);font-size:11px">Sem leads ainda</div>';
}

// Visitas por status — paleta de estado (não categórica)
var visitasMap=<%- stats.visitasPorStatus||'{}' %>;
var visitasOrdem=['solicitada','confirmada','realizada','cancelada'];
var visitasLabels={solicitada:'Solicitada',confirmada:'Confirmada',realizada:'Realizada',cancelada:'Cancelada'};
var visitasCores={solicitada:'#d97706',confirmada:'#00A699',realizada:'#16a34a',cancelada:'#dc2626'};
new Chart(document.getElementById('cvisitas'),{
  type:'bar',
  data:{labels:visitasOrdem.map(function(k){return visitasLabels[k];}),datasets:[{data:visitasOrdem.map(function(k){return visitasMap[k]||0;}),backgroundColor:visitasOrdem.map(function(k){return visitasCores[k];}),borderRadius:4,maxBarThickness:40}]},
  options:{responsive:true,maintainAspectRatio:false,indexAxis:'y',plugins:{legend:{display:false}},scales:{x:{grid:{color:'rgba(0,0,0,.04)'},ticks:{font:{size:9},precision:0},beginAtZero:true},y:{grid:{display:false},ticks:{font:{size:10}}}}}
});
</script>
<%- include('partials/app-end') %>
