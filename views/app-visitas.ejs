<%- include("partials/app-shell",{active:"visitas",title:"Visitas",subtitle:"Solicitações de visita dos seus clientes.",user:user}) %>

<style>
main{overflow-x:hidden!important}
.kpi-row{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:16px}
.kpi-sm{background:#fff;border:0.5px solid rgba(0,0,0,.08);border-radius:12px;padding:12px 14px;position:relative;overflow:hidden}
.kpi-bar{position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:12px 0 0 12px}
.kpi-label{font-size:10px;font-weight:500;color:#9ca3af;text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px}
.kpi-val{font-size:22px;font-weight:600;color:#111827;letter-spacing:-1px}
@media(max-width:640px){.kpi-row{grid-template-columns:repeat(2,1fr)}}
.fi-bar{background:#fff;border:0.5px solid rgba(0,0,0,.08);border-radius:14px;padding:14px;margin-bottom:14px}
.fi-input{flex:1;padding:8px 12px;border:0.5px solid rgba(0,0,0,.12);border-radius:8px;font-size:13px;background:#fff;outline:none;color:#111827}
.fi-btn{padding:8px 14px;border:0.5px solid rgba(0,0,0,.12);border-radius:8px;font-size:12px;font-weight:500;cursor:pointer;background:#fff;color:#374151;white-space:nowrap}
.chips-row{display:flex;gap:5px;flex-wrap:wrap;align-items:center;margin-bottom:6px}
.chips-lbl{font-size:10px;font-weight:500;color:#9ca3af;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;min-width:50px}
.fchip{padding:4px 12px;border-radius:999px;font-size:12px;font-weight:500;border:0.5px solid rgba(0,0,0,.1);background:#fff;cursor:pointer;color:#374151;transition:all .1s}
.fchip.on{background:#111827;color:#fff;border-color:#111827}
.kanban-hint{display:flex;align-items:center;gap:8px;margin-bottom:10px;padding:8px 14px;background:#f9fafb;border:0.5px solid rgba(0,0,0,.08);border-radius:8px;font-size:12px;color:#6b7280}
.kanban-wrap{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding-bottom:16px;align-items:flex-start}@media(max-width:768px){.kanban-wrap{grid-template-columns:1fr!important}.kanban-col{min-height:unset!important;max-height:unset!important}}
.kanban-wrap::-webkit-scrollbar{height:5px}
.kanban-wrap::-webkit-scrollbar-thumb{background:#e5e7eb;border-radius:4px}
.kanban-col{background:#f9fafb;border:0.5px solid rgba(0,0,0,.06);border-radius:14px;padding:14px;min-height:400px;max-height:calc(100vh - 240px);overflow-y:auto}
.kanban-col-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;padding-bottom:8px;border-bottom:0.5px solid rgba(0,0,0,.06);position:sticky;top:0;background:#f9fafb;z-index:1}
.kanban-col-title{font-size:12px;font-weight:500;color:#374151}
.kanban-col-count{font-size:11px;font-weight:500;color:#9ca3af;background:#fff;border:0.5px solid rgba(0,0,0,.08);border-radius:999px;padding:2px 8px}
.kanban-col-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.empty-col{text-align:center;padding:24px 12px;color:#d1d5db;font-size:12px}
.vi-card{background:#fff;border:0.5px solid rgba(0,0,0,.08);border-radius:12px;padding:12px;margin-bottom:8px;transition:box-shadow .15s}
.vi-card:hover{box-shadow:0 2px 12px rgba(0,0,0,.08)}
.vi-card-urgente{border-left:2px solid #ef4444;background:#fffafa}
.vi-card-atencao{border-left:2px solid #fcd34d;background:#fffef0}
.vi-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:10px;font-weight:500;margin-bottom:8px;border:0.5px solid transparent}
.vi-info{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:8px}
.vi-label{font-size:10px;color:#9ca3af;font-weight:500;text-transform:uppercase;letter-spacing:.03em;margin-bottom:1px}
.vi-val{font-size:12px;color:#111827;font-weight:500}
.vi-guia{padding:7px 10px;border-radius:7px;background:#f9fafb;border-left:2px solid #d1d5db;font-size:11px;font-weight:500;margin-bottom:8px;color:#374151}
.vi-actions{display:flex;gap:5px;flex-wrap:wrap;padding-top:8px;border-top:0.5px solid rgba(0,0,0,.06)}
.vi-btn{display:inline-flex;align-items:center;gap:4px;padding:6px 10px;border-radius:7px;font-size:11px;font-weight:500;text-decoration:none;cursor:pointer;border:0.5px solid rgba(0,0,0,.1);background:#fff;color:#374151;transition:background .12s}
.vi-btn:hover{background:#f9fafb}
.vi-btn-green{background:#16a34a;color:#fff;border-color:#15803d}
.vi-btn-red{background:#ef4444;color:#fff;border-color:#dc2626}
.vi-btn-zap{background:#22c55e;color:#fff;border-color:#16a34a}
.vi-btn-zap-dark{background:#15803d;color:#fff;border-color:#166534}
.vi-btn-purple{background:#FC642D;color:#fff;border-color:#b8460e}
.vi-btn-gray{background:#f9fafb;color:#6b7280;border-color:rgba(0,0,0,.1)}
</style>

<%
var statusLabel={
  solicitada:{cls:'st-solicitada',txt:'Pendente'},
  confirmada:{cls:'st-confirmada',txt:'Confirmada'},
  CONFIRMADA:{cls:'st-confirmada',txt:'Confirmada'},
  lead_confirmou:{cls:'st-confirmada',txt:'Cliente confirmou'},
  pendente_remarcar:{cls:'st-remarcar',txt:'Aguardando remarcação'},
  remarcado:{cls:'st-remarcar',txt:'Remarcado'},
  imovel_indisponivel:{cls:'st-cancelada',txt:'Imóvel indisponível'},
  lead_recusou:{cls:'st-cancelada',txt:'Cliente recusou'},
  cancelada:{cls:'st-cancelada',txt:'Cancelada'},
  CANCELADA:{cls:'st-cancelada',txt:'Cancelada'},
  realizada:{cls:'st-realizada',txt:'Realizada'},
  CONCLUIDA:{cls:'st-realizada',txt:'Realizada'},
  no_show:{cls:'st-no_show',txt:'No-show'},
  NO_SHOW:{cls:'st-no_show',txt:'No-show'},
  AGUARDANDO:{cls:'st-solicitada',txt:'Pendente'},
  prop_confirmou:{cls:'st-confirmada',txt:'Prop. confirmou'},
  prop_remarcou:{cls:'st-solicitada',txt:'Prop. remarcou'},
  cliente_nao_vai:{cls:'st-cancelada',txt:'Cliente nao vai'},
  nao_realizada:{cls:'st-cancelada',txt:'Não realizada'},
  nao_gostou:{cls:'st-cancelada',txt:'Não gostou do imóvel'},
  proposta:{cls:'st-realizada',txt:'Proposta'},
  cliente_nova_data:{cls:'st-solicitada',txt:'Nova data'},
  remarcada:{cls:'st-solicitada',txt:'Remarcada'},
  parceiro_confirmou:{cls:'st-confirmada',txt:'Parceiro confirmou'}
};
var corretorNome=user&&user.nome?user.nome:'Corretor';
var corretorTel=(user&&(user.celular||user.telefone)||'').replace(/[^0-9]/g,'');
var colunas=[
  {key:'solicitada',label:'Solicitada',cor:'#f59e0b',dot:'#fcd34d'},
  {key:'remarcacao',label:'Remarcação',cor:'#f97316',dot:'#fed7aa'},
  {key:'aguard_prop',label:'Aguard. Proprietario',cor:'#fd8659',dot:'#ffcbb5'},
  {key:'aguard_cliente',label:'Aguardando Cliente',cor:'#00A699',dot:'#99d9d1'},
  {key:'confirmada',label:'Confirmada',cor:'#22c55e',dot:'#86efac'},
  {key:'realizada',label:'Realizada',cor:'#FC642D',dot:'#fff1e8'},
  {key:'cancelada',label:'Cancelada',cor:'#9ca3af',dot:'#e5e7eb'}
];
function getColuna(v){
  var st=(v.status||'solicitada').toLowerCase();
  if(st==='realizada'||st==='concluida') return 'realizada';
  if(st==='cancelada'||st==='cliente_nao_vai'||st==='no_show'||st==='imovel_indisponivel'||st==='lead_recusou'||st==='nao_realizada'||st==='nao_gostou') return 'cancelada';
  if(st==='proposta') return 'realizada';
  if(st==='lead_confirmou') return 'confirmada';
  if(st==='remarcado') return 'remarcacao';
  if(st==='confirmada'||st==='pendente_remarcar'||st==='prop_confirmou'||st==='parceiro_confirmou') return 'aguard_cliente';
  return 'solicitada';
}
var visitasPorColuna={};
colunas.forEach(function(c){ visitasPorColuna[c.key]=[]; });
visitas.forEach(function(v){
  var col=getColuna(v);
  visitasPorColuna[col].push(v);
});
var totalV=visitas.length;
var pendentesV=visitas.filter(function(v){return v.status==='solicitada'||v.status==='AGUARDANDO';}).length;
var confirmadasV=visitas.filter(function(v){return v.status==='confirmada'||v.status==='CONFIRMADA'||v.status==='lead_confirmou';}).length;
var realizadasV=visitas.filter(function(v){return v.status==='realizada'||v.status==='CONCLUIDA';}).length;
var hoje=new Date(); hoje.setHours(0,0,0,0);
var hojeV=visitas.filter(function(v){
  if(!v.dataVisita || v.dataVisita.indexOf('-')===-1) return false;
  // parse manual (evita new Date('YYYY-MM-DD') cair em UTC e desalinhar com "hoje" local)
  var _p=v.dataVisita.split('-');
  var d=new Date(Number(_p[0]),Number(_p[1])-1,Number(_p[2])); d.setHours(0,0,0,0);
  return d.getTime()===hoje.getTime();
}).length;
%>

<div class="kpi-row">
  <div class="kpi-sm"><div class="kpi-bar" style="background:#FC642D"></div><div class="kpi-label">Total</div><div class="kpi-val"><%=totalV%></div></div>
  <div class="kpi-sm"><div class="kpi-bar" style="background:#f59e0b"></div><div class="kpi-label">Pendentes</div><div class="kpi-val" style="color:#d97706"><%=pendentesV%></div></div>
  <div class="kpi-sm"><div class="kpi-bar" style="background:#22c55e"></div><div class="kpi-label">Confirmadas</div><div class="kpi-val" style="color:#15803d"><%=confirmadasV%></div></div>
  <div class="kpi-sm"><div class="kpi-bar" style="background:#ef4444"></div><div class="kpi-label">Hoje</div><div class="kpi-val" style="color:#dc2626"><%=hojeV%></div></div>
  <div class="kpi-sm"><div class="kpi-bar" style="background:#fd8659"></div><div class="kpi-label">Realizadas</div><div class="kpi-val" style="color:#FC642D"><%=realizadasV%></div></div>
</div>

<div class="fi-bar">
  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
    <input class="fi-input" id="vf-busca" placeholder="Buscar..." oninput="filtrarVisitas()" style="flex:1;min-width:160px">
    <button class="fchip on" onclick="setChipV('periodo','',this)">Todos</button>
    <button class="fchip" onclick="setChipV('periodo','atrasada',this)">Atrasadas</button>
    <button class="fchip" onclick="setChipV('periodo','hoje',this)">Hoje</button>
    <button class="fchip" onclick="setChipV('periodo','amanha',this)">Amanhã</button>
    <button class="fchip" onclick="setChipV('periodo','semana',this)">Semana</button>
    <button class="fi-btn" onclick="toggleFAdv()">Filtros</button>
    <button class="fi-btn" onclick="location.reload()">Atualizar</button>
  </div>
  <div id="fadv-v" style="display:none;margin-top:10px;padding-top:10px;border-top:0.5px solid rgba(0,0,0,.06)">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
      <div><label style="font-size:11px;color:#6b7280;display:block;margin-bottom:3px">Data</label><input type="date" id="vf-data" oninput="filtrarVisitas()" style="width:100%;padding:7px;border:0.5px solid rgba(0,0,0,.12);border-radius:7px;font-size:12px"></div>
      <div><label style="font-size:11px;color:#6b7280;display:block;margin-bottom:3px">Bairro</label><input id="vf-bairro" placeholder="Meia Praia" oninput="filtrarVisitas()" style="width:100%;padding:7px;border:0.5px solid rgba(0,0,0,.12);border-radius:7px;font-size:12px"></div>
    </div>
    <button onclick="limparFiltrosV()" class="fi-btn" style="margin-top:10px;font-size:12px">Limpar filtros</button>
  </div>
  <div id="vf-counter" style="font-size:11px;color:#9ca3af;margin-top:8px"></div>
</div>

<div class="kanban-hint" id="kanban-hint" style="display:none">
  <span style="font-size:16px">👆</span>
  <div style="display:flex;gap:4px;margin-left:auto">
    <button onclick="scrollKanban(-1)" style="width:28px;height:28px;border:0.5px solid rgba(0,0,0,.1);border-radius:6px;background:#fff;cursor:pointer;font-size:14px">&#8249;</button>
    <button onclick="scrollKanban(1)" style="width:28px;height:28px;border:0.5px solid rgba(0,0,0,.1);border-radius:6px;background:#fff;cursor:pointer;font-size:14px">&#8250;</button>
  </div>
</div>

<div class="kanban-wrap" id="kanban-board">
<% colunas.forEach(function(col){ %>
<div class="kanban-col" data-col="<%=col.key%>">
  <div class="kanban-col-header">
    <div style="display:flex;align-items:center;gap:6px">
      <div class="kanban-col-dot" style="background:<%=col.cor%>"></div>
      <span class="kanban-col-title"><%=col.label%></span>
    </div>
    <span class="kanban-col-count" id="count-<%=col.key%>"><%=visitasPorColuna[col.key].length%></span>
  </div>
  <% if(visitasPorColuna[col.key].length===0){ %>
  <div class="empty-col">Nenhuma visita</div>
  <% } %>
  <% visitasPorColuna[col.key].forEach(function(v){ %>
  <%
    var nome=v.nome||v.clienteNome||'-';
    var iniciais=(nome||'?').split(' ').map(function(n){return n[0]||'';}).slice(0,2).join('').toUpperCase();
    var telefone=(v.telefone||v.contato||v.clienteTelefone||'').replace(/[^0-9]/g,'');
    var imovelTit=v.imovelTitulo||v.titulo_interesse||'Imovel';
    var imovelBairro=v.imovelBairro||v.bairro||'';
    var dataVisitaRaw=v.dataVisita||v.dataPreferida||'';
    var dataVisita='-';
    if(dataVisitaRaw){
      if(dataVisitaRaw.indexOf('-')>-1&&dataVisitaRaw.length===10){
        var p=dataVisitaRaw.split('-');
        dataVisita=p[2]+'/'+p[1]+'/'+p[0];
      } else { dataVisita=dataVisitaRaw; }
    }
    var horaVisita=v.horaVisita||v.horarioPreferido||'-';
    var st=v.status||'solicitada';
    var propTel=(v.proprietarioTelefone||'').replace(/[^0-9]/g,'');
    var clienteConfirmou=v.clienteConfirmou||v.confirmacaoClienteStatus==='CONFIRMADO'||v.confirmacao_cliente_status==='confirmado';
    var corretorConfirmou=v.confirmacaoCorretorStatus==='confirmado'||v.confirmacao_corretor_status==='confirmado';
    var propConfirmou=v.respostaProprietario==='confirmar'||v.proprietarioConfirmou===true||v.confirmacaoProprietarioStatus==='CONFIRMADO';
    var propRespondeu=propConfirmou||v.confirmacaoProprietarioStatus==='RECUSADO'||v.proprietarioRecusou||v.respostaProprietario==='recusar';
    var mostrarBtnCliente=!propTel||propRespondeu;
    var _hoje2=new Date(); _hoje2.setHours(0,0,0,0);
    var _dataV=v.dataVisita||'';
    var _diffDias=999;
    if(_dataV && _dataV.indexOf('-')>-1){
      var _dp=_dataV.split('-');
      var _dn=new Date(Number(_dp[0]),Number(_dp[1])-1,Number(_dp[2]));
      _dn.setHours(0,0,0,0);
      _diffDias=Math.round((_dn-_hoje2)/86400000);
    }
    var _atrasada=_diffDias<0&&(st==='solicitada'||st==='confirmada'||st==='prop_confirmou');
    var _hojeV2=_diffDias===0;
    var _amanha2=_diffDias===1;
    var _badge='',_badgeCor='',_cardClass='';
    if(_atrasada){_badge='Atrasada';_badgeCor='background:#fee2e2;color:#991b1b;border-color:#fca5a5';_cardClass='vi-card-urgente';}
    else if(_hojeV2&&st!=='realizada'&&st!=='cancelada'){_badge='Visita HOJE';_badgeCor='background:#fee2e2;color:#991b1b;border-color:#fca5a5';_cardClass='vi-card-urgente';}
    else if(_amanha2&&st!=='realizada'&&st!=='cancelada'){_badge='Visita amanha';_badgeCor='background:#fff7ed;color:#9a3412;border-color:#fdba74';_cardClass='vi-card-atencao';}
    var guia='',guiaCor='#6b7280';
    if(col.key==='solicitada'){guia='Confirme com o responsavel pelo imovel';guiaCor='#d97706';}
    else if(col.key==='aguard_prop'){guia='Aguardando resposta do proprietario';guiaCor='#fd8659';}
    else if(col.key==='aguard_cliente'){guia='Avise o cliente — visita confirmada!';guiaCor='#00A699';}
    else if(col.key==='remarcacao'){guia='Cliente remarcou — confirme a nova data';guiaCor='#f97316';}
    else if(col.key==='aguard_cliente'){guia='Aguardando confirmação do cliente';guiaCor='#00A699';}
    else if(col.key==='confirmada'){guia='Cliente confirmou — visita agendada!';guiaCor='#15803d';}
    else if(col.key==='realizada'){guia='Pergunte se gostou do imovel';guiaCor='#FC642D';}
    else if(col.key==='cancelada'){guia='Oferea outra opcao ao cliente';guiaCor='#9ca3af';}
    var linkCliente=baseUrl+'/cliente/visita/'+v.id+'/confirmar';
    var linkProprietario=baseUrl+'/proprietario/visita/'+v.id;
    var msgCliente='Ola '+nome+'! Sua visita foi confirmada!%0A%0AImovel: '+imovelTit+(imovelBairro?' - '+imovelBairro:'')+'%0AData: '+dataVisita+(horaVisita&&horaVisita!=='-'?'%0AHorario: '+horaVisita:'')+'%0A%0AConfirme sua presenca:%0A'+linkCliente;
    var msgProp='Ola! Sou corretor da MatchImoveis.%0ATenho cliente interessado no imovel '+imovelTit+(imovelBairro?' - '+imovelBairro:'')+'%0AVisita para '+dataVisita+(horaVisita&&horaVisita!=='-'?' as '+horaVisita:'')+'%0A%0AConfirme disponibilidade:%0A'+linkProprietario;
    var waPropEnviado=v.waProprietarioEnviadoEm?new Date(v.waProprietarioEnviadoEm).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}):'';
    var waClienteEnviado=v.waClienteEnviadoEm?new Date(v.waClienteEnviadoEm).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}):'';
    var waParceiroEnviado=v.waParceiroEnviadoEm?new Date(v.waParceiroEnviadoEm).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}):'';
  %>
  <div class="vi-card <%=_cardClass%>"
    data-visita-id="<%=v.id%>"
    data-col="<%=col.key%>"
    data-data-visita="<%=v.dataVisita||''%>"
    data-bairro="<%=imovelBairro%>"
    data-search="<%=(nome+' '+telefone+' '+imovelTit+' '+imovelBairro).toLowerCase()%>">

    <% if(_badge){ %><div class="vi-badge" style="<%=_badgeCor%>"><%=_badge%></div><% } %>

    <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
      <div style="width:34px;height:34px;border-radius:50%;background:#fff1e8;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:500;color:#b8460e;flex-shrink:0"><%=iniciais%></div>
      <div style="flex:1;min-width:0">
        <div style="font-size:13px;font-weight:500;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%=nome%></div>
        <div style="font-size:11px;color:#9ca3af"><%=telefone||'---'%></div>
      </div>
    </div>

    <% if(guia){ %><div class="vi-guia" style="border-left-color:<%=guiaCor%>;color:<%=guiaCor%>"><%=guia%></div><% } %>

    <div class="vi-info">
      <div style="grid-column:span 2">
        <div class="vi-label">Imovel</div>
        <% var _imovelLink = (v.imovelId) ? '/imovel/' + v.imovelId + '?userId=' + (v.userId||v.corretorId||'') : ''; %>
        <% if(_imovelLink){ %>
        <a href="<%=_imovelLink%>" target="_blank" style="font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#FC642D;text-decoration:none;display:block"><%=imovelTit%><%=imovelBairro?' — '+imovelBairro:''%> ↗</a>
        <% } else { %>
        <div class="vi-val" style="font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%=imovelTit%><%=imovelBairro?' — '+imovelBairro:''%></div>
        <% } %>
      </div>
      <div><div class="vi-label">Data</div><div class="vi-val"><%=dataVisita%></div></div>
      <div><div class="vi-label">Horario</div><div class="vi-val"><%=horaVisita&&horaVisita!=='-'?horaVisita:'---'%></div></div>

      <div><div class="vi-label">Cliente</div><div class="vi-val" style="color:<%=clienteConfirmou?'#15803d':'#d97706'%>"><%=clienteConfirmou?'✅ Confirmou':'⏳ Aguardando'%></div></div>
      <div><div class="vi-label">Corretor</div><div class="vi-val" style="color:<%=corretorConfirmou?'#15803d':'#d97706'%>"><%=corretorConfirmou?'✅ Confirmou':'⏳ Aguardando'%></div></div>
    </div>

    <div class="vi-actions">
      
      <% if(telefone&&mostrarBtnCliente){ %>
        <% if(waClienteEnviado){ %>
        <a href="https://wa.me/55<%=telefone%>?text=<%=msgCliente%>" target="_blank" class="vi-btn vi-btn-gray" title="Sistema enviou — clique para reenviar">✓ WA Cliente <%=waClienteEnviado%></a>
        <% } else { %>
        <a href="https://wa.me/55<%=telefone%>?text=<%=msgCliente%>" target="_blank" class="vi-btn vi-btn-zap">WA Cliente</a>
        <% } %>
      <% } %>

      <% if(col.key==='aguard_cliente'&&v.parceiroNome){ %>
        <% if(waParceiroEnviado&&!v.parceiroConfirmou){ %>
        <span class="vi-btn vi-btn-gray" title="WA enviado ao parceiro">✓ WA Parceiro <%=waParceiroEnviado%></span>
        <% } %>
        <% if(!v.parceiroConfirmou){ %>
        <form method="POST" action="/app/visitas/parceiro-confirmou/<%=v.id%>" style="margin:0">
          <button type="submit" class="vi-btn vi-btn-green">Parceiro OK</button>
        </form>
        <% } else { %>
        <span class="vi-btn" style="background:#f0fdf4;color:#15803d;border-color:#86efac">✓ Parceiro confirmou</span>
        <% } %>
      <% } %>
      <% if(v.leadId){ %>
        <a href="/app/lead/<%=v.leadId%>" class="vi-btn vi-btn-gray">👤 Ver detalhes da lead</a>
      <% } %>

      <% if(st!=='cancelada'&&st!=='CANCELADA'&&st!=='realizada'&&st!=='CONCLUIDA'){ %>
      <form method="POST" action="/app/visitas/cancelar/<%=v.id%>" style="margin:0">
        <button type="submit" class="vi-btn vi-btn-red" onclick="return confirm('Cancelar esta visita?')">X</button>
      </form>
      <% } %>

    </div>
  </div>
  <% }); %>
</div>
<% }); %>
</div>

<script>
const _fv={periodo:''};
function setChipV(campo,valor,btn){_fv[campo]=valor;btn.parentElement.querySelectorAll('.fchip').forEach(function(b){b.classList.remove('on');});btn.classList.add('on');filtrarVisitas();}
function toggleFAdv(){var el=document.getElementById('fadv-v');el.style.display=el.style.display==='block'?'none':'block';}
function limparFiltrosV(){_fv.periodo='';document.getElementById('vf-busca').value='';document.getElementById('vf-data').value='';document.getElementById('vf-bairro').value='';document.querySelectorAll('.fchip').forEach(function(b){b.classList.remove('on');if(b.textContent.trim()==='Todos')b.classList.add('on');});filtrarVisitas();}
function filtrarVisitas(){
  var busca=document.getElementById('vf-busca').value.toLowerCase();
  var dataFiltro=document.getElementById('vf-data').value;
  var bairroFiltro=document.getElementById('vf-bairro').value.toLowerCase();
  var hoje=new Date();hoje.setHours(0,0,0,0);
  var amanha=new Date(hoje);amanha.setDate(amanha.getDate()+1);
  var semana=new Date(hoje);semana.setDate(semana.getDate()+7);
  var cards=document.querySelectorAll('.vi-card[data-visita-id]');
  var total=0;var counts={};
  cards.forEach(function(card){
    // new Date('YYYY-MM-DD') interpreta como UTC meia-noite — em fuso negativo
    // (Brasil) isso vira o dia anterior às 21h, e o setHours(0,0,0,0) local
    // subsequente jogava a visita pro dia errado. Parse manual evita o bug.
    var dataVisita=null;
    if(card.dataset.dataVisita){
      var _dvp=card.dataset.dataVisita.split('-');
      dataVisita=_dvp.length===3?new Date(parseInt(_dvp[0]),parseInt(_dvp[1])-1,parseInt(_dvp[2])):new Date(card.dataset.dataVisita);
    }
    var searchStr=(card.dataset.search||'').toLowerCase();
    var bairroCard=(card.dataset.bairro||'').toLowerCase();
    var ok=true;
    if(_fv.periodo&&dataVisita){
      var dv=new Date(dataVisita);dv.setHours(0,0,0,0);
      if(_fv.periodo==='hoje'&&dv.getTime()!==hoje.getTime())ok=false;
      if(_fv.periodo==='amanha'&&dv.getTime()!==amanha.getTime())ok=false;
      if(_fv.periodo==='semana'&&(dv<hoje||dv>semana))ok=false;
      if(_fv.periodo==='atrasada'&&dv>=hoje)ok=false;
    }
    if(busca&&!searchStr.includes(busca))ok=false;
    if(bairroFiltro&&!bairroCard.includes(bairroFiltro))ok=false;
    if(dataFiltro&&dataVisita){var dvStr=dataVisita.toISOString().split('T')[0];if(dvStr!==dataFiltro)ok=false;}
    card.style.display=ok?'':'none';
    if(ok){total++;var col=card.dataset.col;counts[col]=(counts[col]||0)+1;}
  });
  document.querySelectorAll('.kanban-col-count').forEach(function(el){var col=el.id.replace('count-','');el.textContent=counts[col]||0;});
  document.querySelectorAll('.kanban-col').forEach(function(col){
    var visCards=Array.from(col.querySelectorAll('.vi-card')).filter(function(c){return c.style.display!=='none';});
    var empty=col.querySelector('.empty-col');
    if(!empty){empty=document.createElement('div');empty.className='empty-col';empty.textContent='Nenhuma visita';col.appendChild(empty);}
    empty.style.display=visCards.length===0?'block':'none';
  });
  document.getElementById('vf-counter').textContent=total+' visita'+(total!==1?'s':'')+' exibida'+(total!==1?'s':'');
}
function scrollKanban(dir){var board=document.getElementById('kanban-board');board.scrollBy({left:dir*290,behavior:'smooth'});}
document.addEventListener('DOMContentLoaded',function(){
  filtrarVisitas();
  var board=document.getElementById('kanban-board');
  var hint=document.getElementById('kanban-hint');
  if(board)board.addEventListener('scroll',function(){if(hint)hint.style.opacity='0.4';},{once:true});
});
</script>

<!-- Modal Confirmar Visita Caso 2 -->
<div id="modal-confirmar-visita" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;align-items:center;justify-content:center;padding:20px;overflow-y:auto">
  <div style="background:var(--white);border-radius:12px;padding:24px;width:100%;max-width:360px;max-height:calc(100vh - 40px);overflow-y:auto">
    <div style="font-size:15px;font-weight:600;color:var(--dark);margin-bottom:8px">Confirmar visita</div>
    <div style="font-size:13px;color:var(--text-sec);margin-bottom:20px">Tem certeza que a visita está confirmada? O cliente receberá uma mensagem pelo WhatsApp para confirmar, remarcar ou cancelar a presença.</div>
    <div style="display:flex;gap:8px">
      <button onclick="confirmarVisitaCaso2()" style="flex:1;padding:10px;border-radius:8px;background:#FC642D;color:#fff;border:none;font-size:13px;font-weight:600;cursor:pointer">Sim, confirmar</button>
      <button onclick="fecharModalConfirmarVisita()" style="padding:10px 16px;border-radius:8px;background:#f9fafb;color:#6b7280;border:1px solid #e5e5e3;font-size:13px;cursor:pointer">Não</button>
    </div>
  </div>
</div>

<script>
let _vcId='',_vcNome='',_vcTel='';
function abrirModalConfirmarVisita(id,nome,tel){
  _vcId=id; _vcNome=nome; _vcTel=tel;
  document.getElementById('modal-confirmar-visita').style.display='flex';
}
function fecharModalConfirmarVisita(){
  document.getElementById('modal-confirmar-visita').style.display='none';
}
async function confirmarVisitaCaso2(){
  const r = await fetch('/app/visita/'+_vcId+'/confirmar-caso2',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({nome:_vcNome,telefone:_vcTel})
  });
  const d = await r.json();
  if(d.ok){ fecharModalConfirmarVisita(); location.reload(); }
  else alert('Erro: '+(d.erro||'tente novamente'));
}
</script>

<%- include("partials/app-end") %>
