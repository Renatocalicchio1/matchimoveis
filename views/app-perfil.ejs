<%- include('partials/app-shell',{active:'perfil',title:'Meu perfil',subtitle:'Dados da sua conta.',perfil:(user && user.tipo)||'corretor',user:user}) %>

<style>
/* ── Base do card ────────────────────────────────────────────────────── */
.pf-card{
  background:#fff;
  border:0.5px solid rgba(0,0,0,.08);
  border-radius:16px;
  padding:22px;
  margin-bottom:16px;
  max-width:100%;
  box-sizing:border-box;
  overflow-x:hidden;
}
/* Reforço: qualquer texto sem espaço (endereço geocodificado, URL solta
   etc) que não coubesse na largura do card quebra no meio da palavra em
   vez de forçar a página a ficar mais larga. Regra perigosa em elementos
   flex sem white-space:nowrap explícito — por isso todo título/badge que
   fica lado a lado (.pf-card-head) declara nowrap nos próprios itens
   curtos, só o texto livre (parágrafos) herda a quebra daqui. */
.pf-card, .pf-card *{
  overflow-wrap:break-word;
  word-break:break-word;
  min-width:0;
}

/* ── Cabeçalho de card: título + badge de status na mesma linha ────────
   Padrão único reaproveitado em WhatsApp/Instagram/Combos — antes cada
   seção tinha sua própria combinação de flex/div inline, e badge sem
   white-space:nowrap dentro de container espremido é o bug clássico desse
   arquivo (texto quebrando letra por letra). Título e badge NUNCA quebram
   entre si; se não couberem lado a lado, o badge desce pra própria linha
   inteiro (flex-wrap no container), nunca quebra palavra. */
.pf-card-head{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:4px}
.pf-card-head .pf-card-title{margin-bottom:0;white-space:nowrap}
.pf-card-title{
  font-size:15px;
  font-weight:600;
  color:#111827;
  margin:0 0 4px;
  display:flex;
  align-items:center;
  gap:8px;
}
.pf-card-sub{
  font-size:13px;
  color:#9ca3af;
  margin:4px 0 16px;
  line-height:1.5;
}
.pf-card-head + .pf-card-sub{margin-top:4px}

/* ── Caixa de aviso (âmbar/vermelha) — WhatsApp e Instagram ───────────── */
.pf-aviso{border-radius:10px;padding:10px 14px;margin-top:10px;font-size:12px;line-height:1.5}
.pf-aviso-amber{background:#fffbeb;border:1px solid #fcd34d;color:#92400e}
.pf-aviso-red{background:#fef2f2;border:1px solid #fca5a5;color:#b91c1c}

/* ── Badge de status (pill) ─────────────────────────────────────────── */
.pf-badge{display:inline-flex;align-items:center;white-space:nowrap;flex-shrink:0;padding:4px 12px;border-radius:999px;font-size:12px;font-weight:500}
.pf-badge-gray{background:#f3f4f6;color:#6b7280}
.pf-badge-green{background:#dcfce7;color:#15803d}
.pf-badge-red{background:#fee2e2;color:#b91c1c}

/* ── Grid de campos (formulário de dados do usuário) ───────────────────── */
.pf-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}
@media(max-width:480px){.pf-grid{grid-template-columns:1fr}}

/* ── Grid de combos de crédito ──────────────────────────────────────── */
.pf-grid-combos{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
@media(max-width:900px){.pf-grid-combos{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.pf-grid-combos{grid-template-columns:1fr}}
.pf-combo-card{border:0.5px solid rgba(0,0,0,.1);border-radius:12px;padding:16px;text-align:center;display:flex;flex-direction:column}
.pf-combo-val{margin:0 0 4px;font-size:22px;font-weight:700;color:#111827}
.pf-combo-cred{margin:0 0 8px;font-size:12px;color:#15803d}
.pf-combo-imoveis{margin:0 0 10px;font-size:11px;color:#6b7280;font-weight:600}
.pf-combo-feats{list-style:none;margin:0 0 12px;padding:10px 0 0;border-top:1px solid rgba(0,0,0,.08);text-align:left;display:flex;flex-direction:column;gap:5px;flex:1}
.pf-combo-feats li{font-size:11px;color:#374151;display:flex;align-items:flex-start;gap:6px}
.pf-combo-feats li span{color:#00A699;font-weight:bold;flex-shrink:0}

/* ── Campo de formulário ────────────────────────────────────────────── */
.pf-field > label{
  display:block;
  font-size:11px;
  font-weight:500;
  color:#6b7280;
  text-transform:uppercase;
  letter-spacing:.03em;
  margin-bottom:4px;
}
.pf-field > input, .pf-field > select{
  width:100%;
  padding:9px 12px;
  border:0.5px solid rgba(0,0,0,.12);
  border-radius:8px;
  font-size:14px;
  color:#111827;
  background:#fff;
  box-sizing:border-box;
  outline:none;
}
.pf-field > input:focus, .pf-field > select:focus{border-color:rgba(0,0,0,.3)}
.pf-field > input[readonly]{background:#f9fafb;color:#9ca3af}
.pf-field > input[readonly].strong{color:#111827;font-weight:500}

/* ── Grid de localização (CEP/Rua/Número/Bairro/Cidade/Estado) ─────────
   Flexbox, não CSS Grid — Grid com auto-fit + item de span:2 (Rua) deixava
   buraco vazio ao lado do CEP em telas médias (Grid não recua pra
   preencher célula anterior). Flex nunca cria esse buraco: cada linha
   preenche o espaço disponível e sobra vira quebra de linha normal. */
.pf-loc-grid{margin-top:14px;display:flex;flex-wrap:wrap;gap:10px}
.pf-loc-field{flex:1 1 110px}
.pf-loc-field.pf-loc-wide{flex:2 1 220px}
.pf-loc-field label{font-size:12px;color:#6b7280;display:block;margin-bottom:4px}
.pf-loc-field input, .pf-loc-field select{width:100%;padding:9px 12px;border:1px solid #e5e7eb;border-radius:8px;font-size:14px;box-sizing:border-box}

/* ── Botões ──────────────────────────────────────────────────────────── */
.pf-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  padding:9px 18px;
  border-radius:8px;
  font-size:13px;
  font-weight:500;
  cursor:pointer;
  border:0.5px solid rgba(0,0,0,.12);
  background:#111827;
  color:#fff;
  margin-top:14px;
  box-sizing:border-box;
  max-width:100%;
  text-decoration:none;
}
.pf-btn:hover{background:#1f2937}
.pf-btn-full{width:100%;margin-top:0}
.pf-btn-flush{margin-top:0}
.pf-btn-outline{background:#fff;color:#374151;border-color:rgba(0,0,0,.12)}
.pf-btn-outline:hover{background:#f9fafb}
.pf-btn-green{background:#22c55e;color:#fff;border-color:#16a34a}
.pf-btn-green:hover{background:#16a34a}
.pf-btn-red{background:#f9fafb;color:#6b7280;border-color:rgba(0,0,0,.1)}
.pf-btn-red:hover{background:#fee2e2;color:#b91c1c;border-color:#fca5a5}
.pf-btn-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.pf-btn-row .pf-btn{margin-top:0}

/* ── Preferências de vitrine (radio cards) ──────────────────────────── */
.pf-radio-list{display:flex;flex-direction:column;gap:14px;margin-bottom:16px}
.pf-radio-card{display:flex;align-items:center;gap:12px;cursor:pointer;font-size:14px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:12px 16px}
.pf-radio-card input{width:18px;height:18px;flex-shrink:0}

.pf-loc-status{
  display:flex;
  align-items:center;
  gap:10px;
  padding:12px 14px;
  border-radius:8px;
  background:#f9fafb;
  border:0.5px solid rgba(0,0,0,.06);
  font-size:13px;
  color:#374151;
  margin-bottom:12px;
}

.wa-qr-wrap{
  display:none;
  text-align:center;
  padding:16px;
  background:#f9fafb;
  border-radius:8px;
  margin:12px 0;
}
.wa-qr-wrap p{font-size:12px;color:#6b7280;margin:0 0 10px}
.wa-qr-wrap img{width:180px;height:180px;border-radius:8px;border:0.5px solid rgba(0,0,0,.1)}
.wa-ok{
  display:none;
  padding:10px 14px;
  border-radius:8px;
  background:#f0fdf4;
  border:0.5px solid #86efac;
  font-size:13px;
  color:#15803d;
  font-weight:500;
  margin:12px 0;
}
/* Conectar por código (pareamento por número), alternativa ao QR — set/2026 */
.wa-toggle{display:flex;gap:8px;margin:12px 0 4px}
.wa-toggle button{flex:1;padding:8px 10px;border-radius:8px;border:1px solid #e5e7eb;background:#fff;font-size:12px;font-weight:600;color:#6b7280;cursor:pointer}
.wa-toggle button.on{background:#111827;color:#fff;border-color:#111827}
.wa-code-wrap{display:none;text-align:center;padding:16px;background:#f9fafb;border-radius:8px;margin:12px 0}
.wa-code-wrap p{font-size:12px;color:#6b7280;margin:0 0 10px}
.wa-code-wrap input{width:100%;max-width:220px;padding:10px 12px;border-radius:8px;border:1px solid #e5e7eb;font-size:14px;text-align:center;margin-bottom:6px;box-sizing:border-box}
.wa-code-big{display:inline-block;font-family:monospace;font-size:26px;font-weight:800;letter-spacing:4px;color:#111827;background:#fff;border-radius:8px;padding:14px 18px;border:1.5px dashed #9ca3af;margin-top:10px}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.chip{display:inline-flex;align-items:center;gap:6px;background:#fff1f2;color:#111827;border:1px solid #fecdd3;border-radius:999px;padding:4px 6px 4px 12px;font-size:12px}
.chip button{all:unset;cursor:pointer;color:#6b7280;font-weight:bold;padding:0 6px;line-height:1}
.chip button:hover{color:#FF385C}
.sugestoes-dropdown{position:absolute;top:100%;left:0;right:0;z-index:10;background:#fff;border:1px solid #d1d5db;border-top:none;max-height:220px;overflow-y:auto;border-radius:0 0 6px 6px;box-shadow:0 4px 10px rgba(0,0,0,.08)}
.sugestao-item{padding:8px 10px;cursor:pointer;font-size:13px}
.sugestao-item:hover{background:#f3f4f6}
.sugestao-item.gray{color:#9ca3af;cursor:default}
.sugestao-item.gray:hover{background:none}

/* Popup bloqueante "Receber meu presente" (campanha Dia do Corretor,
   ago/2026) — cobre a tela inteira (menu incluso), sem X pra fechar, sem
   clique-fora pra fechar; só some quando o form é enviado (ver JS). */
.pf-gift-backdrop{position:fixed;inset:0;z-index:10000;background:rgba(15,17,21,.72);display:flex;align-items:center;justify-content:center;padding:16px;overflow-y:auto}
.pf-gift-modal{max-width:440px;width:100%;margin:auto;box-shadow:0 20px 60px rgba(0,0,0,.35)}
</style>

<%
// Conta de afiliado restrito (/cadastro-afiliado, ver _menuRestrito em
// app-shell.ejs) não trabalha com imóvel/lead — perfil dela mostra só
// nome/telefone/email/senha, sem CRECI/CPF/área de atuação/combos/vitrine/
// localização/WhatsApp/Instagram (tudo isso é específico de quem atende lead).
const _afiliadoSimples = !!(user && user.afiliadoRestrito === true);
// Boas-vindas de campanha com afiliado dono (ex: "Dia do Corretor",
// Bruno/BRU-8MPC, ago/2026) — mesma conta que já pulou a trava de
// precisaComprarPlano (ver POST /entrar/:contatoId), então o "presente" é
// literal: plataforma liberada + leads normais desde já, sem pagar nada.
// Campanha "leads garantidos" sem afiliado continua com o texto genérico.
// Escopo de módulo (fora de qualquer if) porque tanto o popup quanto o
// botão "Receber meu presente" mais abaixo precisam dele.
const _bemvindoPresenteAfiliado = locals.bemvindo && user.precisaComprarPlano === false;
// ago/2026 (2ª mudança, pedido explícito do Renato): virou popup bloqueante
// em vez de banner solto na página — aparece por cima de tudo (menu incluso),
// sem X pra fechar, só sai depois que a pessoa preenche os dados e clica
// "Receber meu presente". O popup NUNCA diz o que é o presente — só a
// celebração de balões (depois do clique) revela, com uma mensagem maior
// parabenizando pelo Dia do Corretor (ago/2026, 2ª mudança, pedido
// explícito do Renato: "mensagem mais completa"), os créditos de boas-vindas
// (BONUS_CADASTRO, services/creditos.js — 2.500) — texto sobre receber leads
// automaticamente removido a pedido do Renato (3ª mudança), fica só o
// crédito. Só mostra enquanto o cadastro ainda está incompleto
// (locals.completarPerfil) — depois de completar, a página volta ao normal
// (formulário de perfil comum, sem popup, sem texto de presente).
const _mostrarPopupPresente = _bemvindoPresenteAfiliado && !!locals.completarPerfil;
%>
<% if (!_afiliadoSimples) { %>
<% if (locals.completarPerfil) {
  const _faltando = [];
  if (!user.nome || user.nome.trim() === (user.nomeImportado||'').trim()) _faltando.push('nome');
  if (!user.email) _faltando.push('e-mail');
  if (!user.lat || !user.lng) _faltando.push('localização');
%>
<% if (_mostrarPopupPresente) { %>
<!-- CELEBRAÇÃO DE BOAS-VINDAS (campanha "Dia do Corretor", ago/2026) —
     ordem pedida: primeiro preenche os dados no popup bloqueante (mais
     abaixo), DEPOIS clica "Receber meu presente" — só então aparece esse
     overlay com bexiga subindo + parabéns, e SÓ AQUI o presente é revelado
     (o popup de preenchimento nunca diz o que é). Fica escondido por
     padrão (display:none), o JS do submit (mais abaixo, junto do
     autosave) que mostra na hora certa e segura tempo suficiente pra dar
     pra ler antes de seguir pro sistema. CSS puro (sem lib externa), leve
     o bastante pra rodar liso até em celular fraco. -->
<style>
  #pf-celebra-overlay{display:none;position:fixed;inset:0;background:linear-gradient(160deg,#FF385C,#FC642D);z-index:10001;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;text-align:center;padding:24px}
  #pf-celebra-overlay.pf-celebra-ativo{display:flex}
  #pf-celebra-overlay.pf-celebra-sumindo{animation:pf-celebra-sumir .5s ease forwards}
  #pf-celebra-overlay .pf-baloes{position:absolute;inset:0;pointer-events:none}
  #pf-celebra-overlay .pf-balao{position:absolute;bottom:-80px;font-size:40px;animation:pf-balao-subir 3.6s ease-in forwards}
  #pf-celebra-overlay .pf-conteudo{position:relative;z-index:2;color:#fff;animation:pf-conteudo-entra .5s ease;max-height:calc(100vh - 48px);overflow-y:auto}
  #pf-celebra-overlay h2{font-size:26px;margin:0 0 14px;font-weight:800}
  #pf-celebra-overlay p{font-size:15px;line-height:1.55;margin:0 0 14px;opacity:.95;max-width:420px}
  #pf-celebra-overlay p:last-child{margin-bottom:0}
  #pf-celebra-overlay p.pf-celebra-destaque{font-size:19px;font-weight:800;opacity:1;background:rgba(255,255,255,.18);border-radius:10px;padding:12px 18px;margin:16px auto}
  @keyframes pf-balao-subir{0%{transform:translateY(0) rotate(0deg);opacity:0}8%{opacity:1}100%{transform:translateY(-115vh) rotate(12deg);opacity:1}}
  @keyframes pf-conteudo-entra{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
  @keyframes pf-celebra-sumir{to{opacity:0;visibility:hidden}}
  @media (prefers-reduced-motion: reduce){
    #pf-celebra-overlay .pf-balao,#pf-celebra-overlay .pf-conteudo{animation-duration:.01s !important}
  }
</style>
<div id="pf-celebra-overlay">
  <div class="pf-baloes">
    <% const _baloesEmoji=['🎈','🎈','🎈','🎈','🎈','🎉']; %>
    <% for(let i=0;i<14;i++){ %>
    <span class="pf-balao" style="left:<%= Math.round(Math.random()*94) %>%;animation-delay:<%= (Math.random()*1.2).toFixed(2) %>s;font-size:<%= 28+Math.round(Math.random()*26) %>px"><%= _baloesEmoji[i % _baloesEmoji.length] %></span>
    <% } %>
  </div>
  <div class="pf-conteudo">
    <h2>🎉 Feliz Dia do Corretor de Imóveis!</h2>
    <p>Hoje, 27 de agosto, é a data que celebra oficialmente a sua profissão desde 1962. Corretor é quem transforma sonho em endereço — é a ponte entre uma família e a casa onde ela vai construir suas memórias, entrega depois de entrega, chave depois de chave. Hoje o dia é seu, e a MatchImóveis quer comemorar junto.</p>
    <p class="pf-celebra-destaque">Você acabou de receber <strong>2.500 créditos</strong> na plataforma 🪙</p>
  </div>
</div>
<% } %>
<% if (!_mostrarPopupPresente) { %>
<div class="pf-card" style="background:#111827;color:#fff;border:none">
  <p class="pf-card-title" style="color:#fff">👋 <%= locals.bemvindo ? 'Bem-vindo(a) à MatchImóveis!' : 'Complete seu perfil pra continuar' %></p>
  <p class="pf-card-sub" style="color:#d1d5db">
    <% if (_faltando.length) { %>
      Falta preencher: <strong><%= _faltando.join(', ') %></strong>. Você só consegue usar o restante da plataforma depois de completar esses itens.
    <% } else { %>
      Quase lá — salve as alterações abaixo pra liberar o restante da plataforma.
    <% } %>
  </p>
  <% if (locals.senhaInicial) { %>
    <div style="background:rgba(255,255,255,.1);border:0.5px solid rgba(255,255,255,.2);border-radius:8px;padding:12px 14px;margin-top:8px">
      <p style="margin:0 0 4px;font-size:12px;color:#d1d5db">Sua senha inicial de acesso (anote ou troque abaixo):</p>
      <p style="margin:0;font-size:20px;font-weight:700;letter-spacing:.05em"><%= senhaInicial %></p>
    </div>
  <% } %>
</div>
<% } %>
<% } else if (locals.comprarPlano) { %>
<div class="pf-card" style="background:#111827;color:#fff;border:none">
  <p class="pf-card-title" style="color:#fff">🚀 Contrate um combo e comece a vender</p>
  <p class="pf-card-sub" style="color:#d1d5db">Escolha um dos combos abaixo pra liberar sua conta: cadastre seus imóveis, conecte seu WhatsApp e comece a receber leads qualificados automaticamente hoje mesmo.</p>
  <p class="pf-card-sub" style="color:#fff;font-weight:700;margin-top:8px">👇 Role a página pra baixo e contrate agora seu plano</p>
</div>
<% } else if (!user.email) { %>
<div class="pf-card" style="background:#fffbeb;border-color:#fde68a">
  <p class="pf-card-title" style="color:#92400e">⚠️ Falta seu e-mail</p>
  <p class="pf-card-sub" style="color:#b45309">Complete seu e-mail abaixo pra receber notificações de leads e visitas.</p>
</div>
<% } %>

<% if (locals.planoSucesso) { %>
<div class="pf-card" style="background:#f0fdf4;border-color:#86efac">
  <p class="pf-card-title" style="color:#15803d">✅ Combo contratado com sucesso!</p>
  <p class="pf-card-sub" style="color:#166534">Seus créditos já foram adicionados à sua conta.</p>
</div>
<% } %>
<% } %>

<!-- Dados do usuário (ou, no fluxo do presente, popup bloqueante com o
     mesmo form — ver _mostrarPopupPresente no topo do arquivo) -->
<% if (_mostrarPopupPresente) { %><div id="pf-gift-backdrop" class="pf-gift-backdrop"><% } %>
<div class="pf-card<%= _mostrarPopupPresente ? ' pf-gift-modal' : '' %>">
  <% if (_mostrarPopupPresente) { %>
  <p class="pf-card-title">🎉 Feliz Dia do Corretor!</p>
  <p class="pf-card-sub">Preparamos um presente especial pra você — preenche rapidinho os dados abaixo pra desbloquear. <span id="pf-autosave-status" style="color:#15803d;font-weight:600"></span></p>
  <% if (locals.senhaInicial) { %>
    <div style="background:#f9fafb;border:0.5px solid rgba(0,0,0,.08);border-radius:8px;padding:10px 14px;margin-bottom:14px">
      <p style="margin:0 0 4px;font-size:11px;color:#6b7280;text-transform:uppercase;letter-spacing:.03em">Senha de acesso (anote ou troque depois)</p>
      <p style="margin:0;font-size:18px;font-weight:700;letter-spacing:.05em;color:#111827"><%= senhaInicial %></p>
    </div>
  <% } %>
  <% } else { %>
  <p class="pf-card-title">👤 Dados do usuário</p>
  <p class="pf-card-sub">Informações da sua conta no MatchImóveis. <span id="pf-autosave-status" style="color:#15803d;font-weight:600"></span></p>
  <% } %>
  <form method="POST" action="/app/perfil" id="formDadosUsuario">
    <div class="pf-grid">
      <div class="pf-field">
        <label>Nome</label>
        <input name="nome" value="<%= user.nome||'' %>">
      </div>
      <div class="pf-field">
        <label>Celular</label>
        <input name="celular" value="<%= user.celular||user.telefone||'' %>">
      </div>
      <div class="pf-field">
        <label>E-mail</label>
        <input name="email" type="email" value="<%= user.email||'' %>" placeholder="seu@email.com">
      </div>
      <% if (!_afiliadoSimples) { %>
      <% if (!_mostrarPopupPresente) { %>
      <div class="pf-field">
        <label>CRECI</label>
        <input name="creci" value="<%= user.creci||'' %>">
      </div>
      <div class="pf-field">
        <label>CPF</label>
        <input name="cpf" value="<%= user.cpf||'' %>">
      </div>
      <div class="pf-field">
        <label>Tipo de conta</label>
        <input value="<%= user.tipo||'corretor' %>" readonly>
      </div>
      <div class="pf-field">
        <label>Código do usuário</label>
        <input value="<%= user.codigoUsuario||user.codigo||'-' %>" readonly class="strong">
      </div>
      <% } %>
      <div class="pf-field">
        <label>Estado de atuação</label>
        <select id="pfAreaEstadoInput"><option value="">Selecione...</option></select>
      </div>
