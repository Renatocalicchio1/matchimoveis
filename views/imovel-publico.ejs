<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= imovel.titulo || imovel.tipo + ' em ' + imovel.bairro %> • MatchImóveis</title>
  <% const _ogTitulo = imovel.titulo || (imovel.tipo + ' em ' + imovel.bairro); %>
  <% const _ogDescricao = [[imovel.quartos?imovel.quartos+' quartos':'', imovel.area_m2?imovel.area_m2+'m²':''].filter(Boolean).join(' · '), [imovel.bairro, imovel.cidade].filter(Boolean).join(', ')].filter(Boolean).join(' — ') + ' · R$ ' + Number(imovel.valor_imovel||0).toLocaleString('pt-BR'); %>
  <% const _ogImagem = (imovel.fotos && imovel.fotos[0]) || ''; %>
  <% const _ogUrl = (typeof siteOrigin !== 'undefined' && siteOrigin) ? siteOrigin + (typeof siteVoltarUrl !== 'undefined' && siteVoltarUrl !== '/' ? siteVoltarUrl + '/imovel/' : '/imovel/') + (imovel.idExterno||imovel.idInterno||imovel.id||'') : ''; %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= _ogTitulo %>">
  <meta property="og:description" content="<%= _ogDescricao %>">
  <% if(_ogImagem){ %><meta property="og:image" content="<%= _ogImagem %>"><% } %>
  <% if(_ogUrl){ %><meta property="og:url" content="<%= _ogUrl %>"><% } %>
  <meta name="twitter:card" content="<%= _ogImagem ? 'summary_large_image' : 'summary' %>">
  <% if(typeof siteConfig !== 'undefined' && siteConfig && siteConfig.logoUrl){ %><link rel="icon" href="<%= siteConfig.logoUrl %>"><% } %>
  <% if(typeof siteConfig !== 'undefined' && siteConfig && siteConfig.googleAnalyticsId){ %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= siteConfig.googleAnalyticsId %>"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',<%- JSON.stringify(siteConfig.googleAnalyticsId) %>);</script>
  <% } %>
  <% if(typeof siteConfig !== 'undefined' && siteConfig && siteConfig.metaPixelId){ %>
  <script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init',<%- JSON.stringify(siteConfig.metaPixelId) %>);fbq('track','PageView');</script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=<%= siteConfig.metaPixelId %>&ev=PageView&noscript=1"/></noscript>
  <% } %>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{
      --brand:#FF385C; --brand-ink:#C22C46;
      --teal:#00A699; --teal-ink:#0E7268;
      --ink:#16181A; --paper:#FBF9F6;
      --sand:#F1EBE1; --line:#E2DBCC;
      --muted:#716C61; --muted-2:#948E80;
      --white:#FFFFFF;
      --shadow:0 1px 2px rgba(22,20,14,.04), 0 12px 32px -12px rgba(22,20,14,.18);
      --radius:18px;
    }
    body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--paper);color:var(--ink);-webkit-font-smoothing:antialiased}
    a{color:inherit}

    <% const _corCabecalho = (typeof siteConfig !== 'undefined' && siteConfig && siteConfig.corCabecalho) || ''; %>
    header{background:<%= _corCabecalho ? _corCabecalho : 'color-mix(in srgb, var(--paper) 90%, transparent)' %>;<% if(!_corCabecalho){ %>backdrop-filter:blur(10px);<% } %>border-bottom:1px solid var(--line);padding:16px 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
    .logo{display:flex;align-items:center;gap:8px;font-weight:800;font-size:18px;letter-spacing:-.4px}
    .logo .dot{width:8px;height:8px;border-radius:50%;background:var(--brand)}
    .logo em{font-style:normal;color:var(--brand)}
    .ref{font-size:12.5px;color:var(--muted);font-variant-numeric:tabular-nums}

    .container{max-width:1080px;margin:0 auto;padding:28px 24px 60px}

    .detalhe-hero{display:grid;grid-template-columns:1.6fr 1fr 1fr;grid-template-rows:190px 190px;gap:5px;border-radius:var(--radius);overflow:hidden;margin-bottom:28px;background:var(--sand)}
    .detalhe-hero img{width:100%;height:100%;object-fit:cover;transition:opacity .2s;cursor:pointer;display:block}
    .detalhe-hero img:hover{opacity:.92}
    .detalhe-hero img:first-child{grid-row:1/3}
    .hero-mais{position:relative;cursor:pointer}
    .hero-mais img{width:100%;height:100%;object-fit:cover}
    .hero-mais-overlay{position:absolute;inset:0;background:rgba(20,18,14,.55);display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px;font-weight:700}
    .hero-vazio{border-radius:var(--radius);height:340px;margin-bottom:28px;background:linear-gradient(135deg, var(--sand), var(--line));display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:14px;font-weight:500}

    .hero-carousel-wrap{display:none;position:relative;margin-bottom:28px}
    .hero-carousel{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;border-radius:var(--radius);background:var(--sand)}
    .hero-carousel::-webkit-scrollbar{display:none}
    .hero-carousel img{flex:0 0 100%;scroll-snap-align:start;height:280px;object-fit:cover;cursor:pointer;display:block}
    .hc-counter{position:absolute;bottom:12px;right:12px;background:rgba(20,18,14,.65);color:#fff;font-size:12px;font-weight:600;padding:5px 11px;border-radius:999px;backdrop-filter:blur(4px);z-index:2;font-variant-numeric:tabular-nums}

    .layout{display:grid;grid-template-columns:1fr 340px;gap:28px;align-items:start}
    .card{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);padding:24px;margin-bottom:16px;box-shadow:var(--shadow)}
    .card h3.card-h{margin:0 0 14px;font-size:13.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}

    .badge-tipo{display:inline-flex;align-items:center;background:var(--sand);color:var(--muted);font-size:11px;font-weight:700;padding:4px 12px;border-radius:999px;margin-right:6px;margin-bottom:10px}
    .badge-trans{display:inline-flex;align-items:center;color:#fff;font-size:10.5px;font-weight:700;padding:4px 12px;border-radius:999px;margin-right:6px;margin-bottom:10px;letter-spacing:.03em}
    .badge-fase{display:inline-flex;align-items:center;background:var(--teal);color:#fff;font-size:11px;font-weight:700;padding:4px 12px;border-radius:999px;margin-bottom:10px}

    .pd-title{font-size:24px;font-weight:800;letter-spacing:-.6px;margin:0 0 6px;line-height:1.25}
    .pd-addr{color:var(--muted);font-size:14px;margin:0}
    .pd-price-top{font-size:27px;font-weight:800;letter-spacing:-.6px;color:var(--brand);font-variant-numeric:tabular-nums;white-space:nowrap}

    .pd-specs{display:flex;flex-wrap:wrap;gap:26px;padding-top:2px}
    .pd-spec{min-width:64px}
    .pd-spec b{display:block;font-size:19px;font-weight:800;font-variant-numeric:tabular-nums;line-height:1.2}
    .pd-spec span{font-size:11.5px;color:var(--muted)}

    .tag-chip{background:var(--paper);border:1px solid var(--line);border-radius:999px;padding:6px 13px;font-size:12px;color:var(--ink);font-weight:500}

    .info-row{display:flex;justify-content:space-between;align-items:baseline;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px}
    .info-row:last-child{border:none;padding-bottom:0}
    .info-row:first-child{padding-top:0}
    .info-lbl{color:var(--muted)}
    .info-val{font-weight:600;color:var(--ink);text-align:right}

    .cta-card{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);padding:24px;position:sticky;top:88px;box-shadow:var(--shadow)}
    .cta-price{font-size:25px;font-weight:800;letter-spacing:-.5px;color:var(--ink);font-variant-numeric:tabular-nums}
    .cta-price small{display:block;font-size:11.5px;font-weight:500;color:var(--muted);margin-top:2px}

    .corretor-row{display:flex;align-items:center;gap:11px;padding:16px 0;margin:16px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .corretor-av{width:40px;height:40px;border-radius:50%;background:var(--teal);color:#fff;font-weight:800;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .corretor-nome{font-weight:700;font-size:13.5px}
    .corretor-role{font-size:11.5px;color:var(--muted)}

    .btn-cta{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:13px;border-radius:12px;font-weight:700;font-size:14.5px;text-align:center;text-decoration:none;margin-bottom:10px;border:none;cursor:pointer;transition:filter .15s, background .15s}
    .btn-cta:hover{filter:brightness(.94)}
    .btn-wpp{background:#25D366;color:#fff}
    .btn-visita{background:var(--brand);color:#fff}
    .btn-gostei{background:var(--sand);color:var(--ink)}

    .interesse-box{margin-top:4px}
    .interesse-label{font-size:11.5px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:18px 0 10px;display:flex;align-items:center;gap:8px}
    .interesse-label::after{content:'';flex:1;height:1px;background:var(--line)}
    .formf{margin-bottom:9px}
    .formf input{width:100%;border:1px solid var(--line);border-radius:10px;padding:10px 12px;font-size:13.5px;font-family:inherit;background:var(--paper);color:var(--ink);outline:none;transition:border-color .12s}
    .formf input:focus{border-color:var(--brand)}
    #interesse-msg{font-size:12px;margin-top:8px;display:none}

    .footer-note{font-size:11px;color:var(--muted-2);text-align:center;margin-top:10px}

    /* Lightbox */
    #lightbox{display:none;position:fixed;inset:0;background:rgba(14,12,9,.94);z-index:9999;align-items:center;justify-content:center}
    #lightbox.open{display:flex}
    #lb-img{max-width:90vw;max-height:88vh;object-fit:contain;border-radius:10px}
    .lb-btn{position:absolute;background:rgba(255,255,255,.14);border:none;color:#fff;font-size:26px;width:46px;height:46px;border-radius:50%;cursor:pointer;transition:background .2s}
    .lb-btn:hover{background:rgba(255,255,255,.26)}

    .wa-float{display:none;position:fixed;bottom:20px;right:20px;width:56px;height:56px;border-radius:50%;background:#25D366;color:#fff;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(0,0,0,.25);z-index:500;border:none;cursor:pointer}
    @media(max-width:760px){ .wa-float{display:flex} }

    .fav-btn{background:var(--white);border:1px solid var(--line);border-radius:50%;width:38px;height:38px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:18px;flex-shrink:0;transition:transform .12s}
    .fav-btn:active{transform:scale(.88)}
    .fav-btn.ativo{color:var(--brand)}

    .card-parecidos{display:grid;grid-template-columns:repeat(auto-fill, minmax(190px, 1fr));gap:14px}
    .pc-card{text-decoration:none;color:inherit;background:var(--white);border:1px solid var(--line);border-radius:14px;overflow:hidden;box-shadow:var(--shadow);display:flex;flex-direction:column;transition:transform .15s, box-shadow .15s}
    .pc-card:hover{transform:translateY(-2px);box-shadow:0 4px 10px rgba(22,20,14,.08), 0 16px 36px -12px rgba(22,20,14,.22)}
    .pc-img{position:relative;height:130px;background:var(--sand)}
    .pc-img img{width:100%;height:100%;object-fit:cover;display:block}
    .pc-badge{position:absolute;top:8px;left:8px;color:#fff;font-size:9.5px;font-weight:700;padding:3px 9px;border-radius:999px;letter-spacing:.03em}
    .pc-body{padding:10px 12px 12px;display:flex;flex-direction:column;gap:4px}
    .pc-price{font-size:14.5px;font-weight:800;letter-spacing:-.3px;color:var(--brand);font-variant-numeric:tabular-nums}
    .pc-title{font-size:12px;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .pc-loc{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .pc-specs{display:flex;gap:9px;margin-top:4px;padding-top:8px;border-top:1px solid var(--line);font-size:10.5px;color:var(--muted)}
    .pc-specs b{color:var(--ink);font-weight:700}

    /* Modal */
    .modal-bg{display:none;position:fixed;inset:0;background:rgba(14,12,9,.6);z-index:9998;align-items:center;justify-content:center;padding:16px}
    .modal-box{background:var(--white);border-radius:20px;padding:30px;max-width:400px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.3)}
    .modal-box h3{font-size:19px;font-weight:800;margin-bottom:6px}
    .modal-box p.sub{color:var(--muted);font-size:13.5px;margin-bottom:20px}
    .modal-box label{font-size:12.5px;font-weight:600;color:var(--ink);display:block;margin-bottom:6px}
    .modal-box input, .modal-box select{width:100%;padding:11px 13px;border:1.5px solid var(--line);border-radius:10px;font-size:14px;outline:none;font-family:inherit;margin-bottom:14px;background:var(--paper);color:var(--ink)}
    .modal-box input:focus, .modal-box select:focus{border-color:var(--brand)}
    .modal-btn-primary{width:100%;padding:13px;background:var(--brand);color:#fff;border:none;border-radius:12px;font-size:14.5px;font-weight:700;cursor:pointer;margin-bottom:9px}
    .modal-btn-sec{width:100%;padding:10px;background:var(--sand);color:var(--muted);border:none;border-radius:12px;font-size:13.5px;cursor:pointer}

    @media(max-width:760px){
      .layout{grid-template-columns:1fr}
      .detalhe-hero{display:none}
      .hero-carousel-wrap{display:block}
      .cta-card{position:static}
      header{padding:14px 18px}
      .container{padding:20px 16px 40px}
    }

    <% const _corRodape = (typeof siteConfig !== 'undefined' && siteConfig && siteConfig.corRodape) || ''; %>
    .site-footer{background:<%= _corRodape ? _corRodape : 'transparent' %>;border-top:1px solid var(--line);margin-top:20px;padding:28px 24px;text-align:center;color:var(--muted);font-size:12.5px;line-height:1.9}
    .site-footer b{color:var(--ink);display:block;font-size:13.5px;margin-bottom:4px}
    .site-footer a{color:var(--muted);text-decoration:none}
    .site-footer a:hover{color:var(--brand)}
  </style>
</head>
<body>

<% const _siteCfg = (typeof siteConfig !== 'undefined' && siteConfig) ? siteConfig : null; %>
<% if(_siteCfg){ %>
<style>:root{--brand:<%= _siteCfg.corPrimaria || '#FF385C' %>;}</style>
<% } %>

<header>
  <% if(_siteCfg && typeof siteVoltarUrl !== 'undefined'){ %>
  <a href="<%= siteVoltarUrl %>" class="logo" style="text-decoration:none">
    <% if(_siteCfg.logoUrl){ %><img src="<%= _siteCfg.logoUrl %>" alt="<%= _siteCfg.rodapeNome %>" style="height:28px;max-width:180px;object-fit:contain">
    <% } else { %><span class="dot"></span><%= _siteCfg.rodapeNome || 'Imóveis' %><% } %>
  </a>
  <% } else { %>
  <div class="logo"><span class="dot"></span>Match<em>Imóveis</em></div>
  <% } %>
  <div class="ref">Ref. #<%= imovel.idExterno %></div>
</header>

<div class="container">

<% if(imovel.fotos && imovel.fotos.length > 0) { %>
<div class="detalhe-hero" id="hero-fotos">
  <img src="<%= imovel.fotos[0] %>" onclick="abrirGaleria(0)">
  <% if(imovel.fotos[1]) { %><img src="<%= imovel.fotos[1] %>" onclick="abrirGaleria(1)"><% } %>
  <% if(imovel.fotos[2]) { %><img src="<%= imovel.fotos[2] %>" onclick="abrirGaleria(2)"><% } %>
  <% if(imovel.fotos[3]) { %><img src="<%= imovel.fotos[3] %>" onclick="abrirGaleria(3)"><% } %>
  <% if(imovel.fotos[4]) { %>
  <div class="hero-mais" onclick="abrirGaleria(4)">
    <img src="<%= imovel.fotos[4] %>">
    <% if(imovel.fotos.length > 5) { %>
    <div class="hero-mais-overlay">+<%= imovel.fotos.length - 5 %> fotos</div>
    <% } %>
  </div>
  <% } %>
</div>

<div class="hero-carousel-wrap">
  <div class="hero-carousel" id="hero-carousel">
    <% imovel.fotos.forEach(function(foto, i){ %>
    <img src="<%= foto %>" onclick="abrirGaleria(<%= i %>)">
    <% }) %>
  </div>
  <% if(imovel.fotos.length > 1) { %>
  <div class="hc-counter" id="hc-counter">1 / <%= imovel.fotos.length %></div>
  <% } %>
</div>
<% } else { %>
<div class="hero-vazio">📷 Sem fotos cadastradas</div>
<% } %>

<!-- LIGHTBOX -->
<div id="lightbox">
  <button class="lb-btn" onclick="fecharLightbox()" style="top:16px;right:20px;font-size:20px">✕</button>
  <button class="lb-btn" onclick="navFoto(-1)" style="left:16px">‹</button>
  <img id="lb-img">
  <button class="lb-btn" onclick="navFoto(1)" style="right:16px">›</button>
  <div id="lb-counter" style="position:absolute;bottom:16px;color:#fff;font-size:14px;opacity:.7"></div>
</div>

<div class="layout">

  <%# COLUNA PRINCIPAL %>
  <div>
    <div class="card">
      <div>
        <span class="badge-tipo"><%= imovel.tipo %></span>
        <% const _trans = (imovel.transacao||imovel.operacao||'').toLowerCase(); if(_trans==='aluguel'||_trans==='venda'){ %><span class="badge-trans" style="background:<%= _trans==='aluguel'?'var(--teal)':'var(--brand)' %>"><%= _trans==='aluguel'?'ALUGUEL':'VENDA' %></span><% } %>
        <% const _faseMapP = {pronto:'✅ Pronto',lancamento:'🚀 Lançamento',na_planta:'📐 Na planta',em_construcao:'🏗 Em construção',planta:'📐 Na planta',construcao:'🏗 Em construção'}; const _faseLabelP = _faseMapP[(imovel.fase||'').toLowerCase().replace(/\s/g,'_')]; %>
        <% if(_faseLabelP){ %><span class="badge-fase"><%=_faseLabelP%></span><% } %>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:start;gap:16px;margin-top:6px">
        <div>
          <h1 class="pd-title"><%= imovel.titulo || (imovel.tipo + ' em ' + imovel.bairro) %></h1>
          <p class="pd-addr"><% if(imovel.endereco) { %><%= imovel.endereco %> · <% } %><%= imovel.bairro %><% if(imovel.cidade) { %>, <%= imovel.cidade %><% } %></p>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
          <button type="button" id="btn-favoritar" class="fav-btn" onclick="toggleFavoritoDetalhe()" aria-label="Favoritar">♡</button>
          <div class="pd-price-top">R$ <%= Number(imovel.valor_imovel||0).toLocaleString('pt-BR') %></div>
        </div>
      </div>
      <div class="pd-specs" style="margin-top:20px;padding-top:20px;border-top:1px solid var(--line)">
        <% if(imovel.area_m2) { %><div class="pd-spec"><b><%= imovel.area_m2 %>m²</b><span>Área</span></div><% } %>
        <% if(imovel.quartos) { %><div class="pd-spec"><b><%= imovel.quartos %></b><span>Quartos</span></div><% } %>
        <% if(imovel.suites) { %><div class="pd-spec"><b><%= imovel.suites %></b><span>Suítes</span></div><% } %>
        <% if(imovel.banheiros) { %><div class="pd-spec"><b><%= imovel.banheiros %></b><span>Banheiros</span></div><% } %>
        <% if(imovel.vagas) { %><div class="pd-spec"><b><%= imovel.vagas %></b><span>Vagas</span></div><% } %>
      </div>
    </div>

    <% const _difsP = Array.isArray(imovel.diferenciais) ? imovel.diferenciais : (imovel.dados&&imovel.dados.diferenciais ? imovel.dados.diferenciais : Object.keys(imovel.diferenciais||{}).filter(k=>imovel.diferenciais[k])); %>
    <% if(_difsP && _difsP.length > 0){ %>
    <div class="card">
      <h3 class="card-h">Diferenciais</h3>
      <div style="display:flex;flex-wrap:wrap;gap:8px">
        <% _difsP.forEach(k=>{ %>
        <span class="tag-chip"><%= k.replace(/_/g,' ') %></span>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if(imovel.descricao) { %>
    <div class="card">
      <h3 class="card-h">Descrição</h3>
      <p style="color:var(--ink);line-height:1.8;font-size:14.5px;white-space:pre-line;margin:0;max-width:64ch"><%= imovel.descricao %></p>
    </div>
    <% } %>

    <% if(imovel.latitude && imovel.longitude) { %>
    <div class="card">
      <h3 class="card-h">📍 Localização</h3>
      <div style="border-radius:14px;overflow:hidden;height:280px">
        <iframe width="100%" height="280" frameborder="0" style="border:0" src="https://www.openstreetmap.org/export/embed.html?bbox=<%= imovel.longitude-0.01 %>,<%= imovel.latitude-0.01 %>,<%= imovel.longitude+0.01 %>,<%= imovel.latitude+0.01 %>&layer=mapnik&marker=<%= imovel.latitude %>,<%= imovel.longitude %>" allowfullscreen loading="lazy"></iframe>
      </div>
      <div style="font-size:13px;color:var(--muted);margin-top:10px"><%= [imovel.endereco, imovel.bairro, imovel.cidade].filter(Boolean).join(', ') %></div>
