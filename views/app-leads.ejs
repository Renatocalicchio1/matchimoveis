<script>
// Auto-refresh: atualiza status das leads a cada 30s sem recarregar a página
(function() {
  let _ultimoHash = '';
  async function checkAtualizacoes() {
    try {
      const r = await fetch('/api/leads/status-hash');
      const d = await r.json();
      if (d.hash && d.hash !== _ultimoHash) {
        if (_ultimoHash !== '') {
          // Nao recarrega se algum modal estiver aberto (evita fechar formulario no meio do preenchimento)
          const _modalNovaLead = document.getElementById('modal-nova-lead');
          const _modalAberto = (_modalNovaLead && _modalNovaLead.style.display === 'flex')
            || (document.getElementById('mini-modal-acoes')?.style.display === 'flex');
          if (!_modalAberto) {
            window.location.reload();
          } else {
            return; // adia a atualizacao do hash, tenta de novo no proximo ciclo
          }
        }
        _ultimoHash = d.hash;
      }
    } catch(e) {}
  }
  // Verifica imediatamente e depois a cada 30s
  checkAtualizacoes();
  setInterval(checkAtualizacoes, 30000);
})();
</script>

