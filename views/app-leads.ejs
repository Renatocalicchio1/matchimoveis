<%- include('partials/app-shell', {active:'leads',title:'Leads',subtitle:'Gerencie e acompanhe seus clientes em busca de imóveis.',user:user}) %>
<style>main{overflow-x:hidden!important} .page-content{overflow-x:hidden!important}</style>

<style>
/* ── KPIs ── */
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px}
.kpi-sm{background:#fff;border:0.5px solid rgba(0,0,0,.08);border-radius:12px;padding:14px 16px;position:relative;overflow:hidden}
.kpi-bar{position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:12px 0 0 12px}
.kpi-label{font-size:10px;font-weight:500;color:#9ca3af;text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px}
.kpi-val{font-size:24px;font-weight:600;color:#111827;letter-spacing:-1px}

/* ── Filtros ── */
.fi-bar{background:#fff;border:0.5px solid rgba(0,0,0,.08);border-radius:14px;padding:14px;margin-bottom:14px}
.fi-search-row{display:flex;gap:8px;margin-bottom:10px}
.fi-input{flex:1;padding:8px 12px;border:0.5px solid rgba(0,0,0,.12);border-radius:8px;font-size:13px;outline:none;color:#111827}
.fi-input:focus{border-color:rgba(0,0,0,.3)}
.fi-btn{padding:8px 14px;border:0.5px solid rgba(0,0,0,.12);border-radius:8px;font-size:12px;font-weight:500;cursor:pointer;background:#fff;color:#374151;white-space:nowrap}
.fi-btn:hover{background:#f9fafb}
.fi-btn-dark{background:#111827;color:#fff;border-color:#111827}
.fi-btn-dark:hover{background:#1f2937}
.chips-row{display:flex;gap:5px;flex-wrap:wrap;align-items:center;margin-bottom:6px}
.chips-lbl{font-size:10px;font-weight:500;color:#9ca3af;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;min-width:60px}
.fchip{padding:4px 12px;border-radius:999px;font-size:11px;font-weight:500;border:0.5px solid rgba(0,0,0,.1);background:#fff;cursor:pointer;color:#374151;transition:all .1s}
.fchip.on{background:#111827;color:#fff;border-color:#111827}

/* ── KANBAN ── */

.km-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center}
.km-overlay.open{display:flex}
.km-modal{background:#fff;border-radius:16px;width:90%;max-width:900px;max-height:85vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.2)}
.km-modal-header{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #f3f4f6}
.km-modal-title{font-size:14px;font-weight:700;color:#111}
.km-modal-close{background:none;border:none;font-size:20px;cursor:pointer;color:#9ca3af;line-height:1}
.km-modal-body{overflow-y:auto;padding:0}
.km-table{width:100%;border-collapse:collapse;font-size:12px}
.km-table th{padding:10px 14px;text-align:left;font-weight:600;color:#6b7280;background:#f9fafb;border-bottom:1px solid #f3f4f6;white-space:nowrap}
.km-table td{padding:10px 14px;border-bottom:1px solid #f9fafb;color:#374151}
.km-table tr:hover td{background:#f9fafb;cursor:pointer}
.km-ver-btn{font-size:10px;font-weight:600;color:#FC642D;background:none;border:none;cursor:pointer;padding:0;white-space:nowrap}
@keyframes piscar{0%,100%{opacity:1}50%{opacity:.4}}
.lb-ver-pisca{animation:piscar 1.2s ease-in-out infinite;background:#FF385C!important;color:#fff!important;border-color:#FF385C!important}
.km-ver-btn:hover{text-decoration:underline}
.kanban-wrap{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding-bottom:16px;align-items:flex-start;overflow-x:auto}
@media(max-width:768px){.kanban-wrap{grid-template-columns:1fr!important;overflow-x:unset!important}.kanban-col{min-width:unset!important;max-height:unset!important}.kanban-hint-btns{display:none!important}}
.kanban-wrap::-webkit-scrollbar{height:5px}
.kanban-wrap::-webkit-scrollbar-thumb{background:#e5e7eb;border-radius:4px}
.kanban-col{background:#f9fafb;border:0.5px solid rgba(0,0,0,.06);border-radius:14px;padding:14px;min-height:400px;max-height:calc(100vh - 240px);overflow-y:auto;min-width:280px}
.kanban-col-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;padding-bottom:8px;border-bottom:0.5px solid rgba(0,0,0,.06);position:sticky;top:0;background:#f9fafb;z-index:10}
.kanban-col-title{font-size:12px;font-weight:500;color:#374151}
.kanban-col-count{font-size:11px;font-weight:500;color:#9ca3af;background:#fff;border:0.5px solid rgba(0,0,0,.08);border-radius:999px;padding:2px 8px}
.kanban-col-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}

/* ── Cards (reorganizados jul/2026 — mesmos campos, mais clean) ── */
.btn-classificar-flag{background:none!important;color:#c2410c!important;border:none!important;font-size:11px!important;font-weight:600!important;padding:0!important}
.lead-card{background:#fff;border:1px solid #e5e5e3;border-radius:12px;padding:14px 16px;margin-bottom:8px;cursor:pointer;transition:box-shadow .15s;position:relative}
.lead-card:hover{box-shadow:0 2px 12px rgba(0,0,0,.06)}
.lead-card.urg-alta{border-left:2px solid #ef4444}
.lead-card.urg-media{border-left:2px solid #f59e0b}
.lead-card.lc-atendida{background:#fef2f2}

.lc-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:9px}
.acao-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:999px;font-size:10.5px;font-weight:600;border:none}
.lc-vez{font-size:9.5px;font-weight:700;padding:2px 7px;border-radius:20px;background:#f3f4f6;color:#6b7280;margin-left:5px;white-space:nowrap}
.temp-pill{font-size:11px;font-weight:600;display:inline-flex;align-items:center;gap:4px;white-space:nowrap;background:none!important;padding:0!important;border-radius:0!important}

.lead-nome{font-size:14.5px;font-weight:600;color:#111827;text-decoration:none;display:block;margin-bottom:1px}
.lead-nome:hover{color:#FC642D}
.lead-tel{font-size:12px;color:#6b7280;margin-bottom:10px}

.lc-chips{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:10px}
.lc-chip{font-size:10.5px;font-weight:600;padding:3px 9px;border-radius:999px;border:none;text-decoration:none;display:inline-flex;align-items:center;gap:3px}
.lc-chip.origem{background:#f3f4f6;color:#6b7280}
.lc-chip.parceiro{background:#fff1e8;color:#b8460e}
.lc-chip.buscando{background:#e6f7f5;color:#004d47}
.lc-chip.temimovel{background:#f0fdf4;color:#166534}
.lc-chip.ref{background:#f3f4f6;color:#6b7280}

.lc-divider{height:1px;background:#f0f0ee;margin:10px 0}

.score-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.score-mini{display:flex;align-items:center;gap:7px}
.score-bar{width:46px;height:3px;background:#f0f0ee;border-radius:2px;overflow:hidden}
.score-fill{height:3px;border-radius:2px}
.score-num{font-size:11px;color:#6b7280;font-variant-numeric:tabular-nums}
.match-pill{font-size:10.5px;font-weight:600;color:#166534;background:none;border-radius:0;padding:0}

.perfil-row{display:flex;flex-wrap:wrap;font-size:12px;color:#6b7280;margin-bottom:8px}
.perfil-tag{font-size:12px;color:#6b7280;background:none;border:none;padding:0}
.perfil-tag:not(:last-child)::after{content:' · ';color:#d1d5db;margin:0 1px}

.lc-daterow{display:flex;gap:14px;font-size:11px;color:#9ca3af;margin-bottom:2px}

.lead-btns{display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding-top:10px;border-top:1px solid #f0f0ee;margin-top:2px}
.lb{font-size:12px;padding:0;border-radius:0;text-decoration:none;font-weight:600;border:none;color:#6b7280;background:none;cursor:pointer;transition:color .1s;display:inline-flex;align-items:center;gap:5px}
.lb:hover{color:#111827}
.lb.wa{color:#0E7268}
.lb.prim{color:#b8460e}
.lb.dark{background:none;color:#111827;margin-left:auto}
.lb.danger{color:#FF385C}
.confirm-box{display:none;padding:10px 12px;background:#fef2f2;border-radius:10px;border:1px solid #fca5a5;margin-top:8px}

.empty-col{text-align:center;padding:24px 12px;color:#d1d5db;font-size:12px}
</style>

<!-- KPIs -->
<div class="kpi-row">
  <div class="kpi-sm"><div class="kpi-bar" style="background:#FC642D"></div><div class="kpi-label">Total</div><div class="kpi-val"><%= stats.totalLeads %></div></div>
  <div class="kpi-sm"><div class="kpi-bar" style="background:#22c55e"></div><div class="kpi-label">Com match</div><div class="kpi-val" style="color:#15803d"><%= stats.comMatch %></div></div>
  <div class="kpi-sm"><div class="kpi-bar" style="background:#9ca3af"></div><div class="kpi-label">Sem match</div><div class="kpi-val"><%= stats.pendentes %></div></div>
  <div class="kpi-sm"><div class="kpi-bar" style="background:#FC642D"></div><div class="kpi-label">Matches IA</div><div class="kpi-val" style="color:#FC642D"><%= stats.totalMatches %></div></div>
</div>

<!-- Filtros -->
<div class="fi-bar">
  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
    <input class="fi-input" id="filter-search" placeholder="Buscar..." oninput="aplicarFiltros()" style="flex:1;min-width:80px;max-width:200px">
    <button class="fchip on" onclick="setChip('temp','',this)">Todas</button>
    <button class="fchip" onclick="setChip('temp','quente',this)" style="color:#dc2626;border-color:#fca5a5">Quente</button>
    <button class="fchip" onclick="setChip('temp','morno',this)" style="color:#d97706;border-color:#fcd34d">Morno</button>
    <button class="fchip" onclick="setChip('temp','frio',this)" style="color:#00847a;border-color:#99d9d1">Frio</button>
    <button class="fi-btn" onclick="toggleFAdv()">Filtros</button>
    <button class="fi-btn fi-btn-dark" onclick="abrirModalNovaLead()" style="background:#FF385C;border-color:#FF385C">+ Nova Lead</button>
    <button class="fi-btn fi-btn-dark" onclick="abrirModalImportarLeads()">+ Importar</button>
    <button class="fi-btn fi-btn-dark" onclick="rodarMatchBase()" id="btn-match-base" style="display:none">Match IA</button>
  </div>
  <div class="chips-row" style="display:none">
    <span class="chips-lbl">Origem</span>
    <button class="fchip on" onclick="setChip('origem','',this)">Todas</button>
    <button class="fchip" onclick="setChip('origem','whatsapp',this)">WhatsApp</button>
    <button class="fchip" onclick="setChip('origem','pagina_externa_imovel',this)">Página</button>
    <button class="fchip" onclick="setChip('origem','manual',this)">Manual</button>
  </div>
  <div id="fadv" style="display:none;margin-top:10px;padding-top:10px;border-top:0.5px solid rgba(0,0,0,.06)">
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px">
      <div><label style="font-size:11px;color:#6b7280;display:block;margin-bottom:3px">Score mínimo</label><select id="filter-score" onchange="aplicarFiltros()" style="width:100%;padding:7px;border:0.5px solid rgba(0,0,0,.12);border-radius:7px;font-size:12px"><option value="0">Todos</option><option value="20">20+</option><option value="40">40+</option><option value="60">60+</option><option value="80">80+</option></select></div>
      <div><label style="font-size:11px;color:#6b7280;display:block;margin-bottom:3px">Tipo buscado</label><select id="filter-tipo-lead" onchange="aplicarFiltros()" style="width:100%;padding:7px;border:0.5px solid rgba(0,0,0,.12);border-radius:7px;font-size:12px"><option value="">Todos</option><option value="apartamento">Apartamento</option><option value="casa">Casa</option><option value="studio">Studio</option><option value="kitnet">Kitnet</option></select></div>
      <div><label style="font-size:11px;color:#6b7280;display:block;margin-bottom:3px">Intenção</label><select id="filter-intencao" onchange="aplicarFiltros()" style="width:100%;padding:7px;border:0.5px solid rgba(0,0,0,.12);border-radius:7px;font-size:12px"><option value="">Todas</option><option value="comprar">Comprar</option><option value="alugar">Alugar</option></select></div>
    </div>
    <button onclick="limparFiltros()" class="fi-btn" style="margin-top:10px;font-size:12px">Limpar filtros</button>
  </div>
  <div id="filter-counter" style="font-size:11px;color:#9ca3af;margin-top:8px"></div>
</div>

<!-- KANBAN -->
<%
const colunas = [
  { key:'novo',      label:'Novo',           cor:'#9ca3af', dot:'#e5e7eb' },
  { key:'qualificando', label:'Qualificando', cor:'#f59e0b', dot:'#fcd34d' },
  { key:'match',     label:'Com Match',      cor:'#22c55e', dot:'#86efac' },
  { key:'vitrine',   label:'Vitrine Enviada',cor:'#FC642D', dot:'#fff1e8' },


  { key:'proposta',  label:'Proposta',        cor:'#f97316', dot:'#fed7aa' },
  { key:'fechado',   label:'Fechado',         cor:'#16a34a', dot:'#86efac' }
];

function getColuna(item) {
  if(item.faseFunil === 'captacao' || item.origem === 'captacao_link') return null;
  const fase = item.faseFunil || 'novo';
  const mat = (item.matchesAuto||item.matches||[]).length;
  const vitrine = !!item.vitrineEnviada;
  const temVisita = false; // será setado via visitas se necessário
  if (fase === 'decidido') return 'fechado';
  if (item.visitaAgendada || item.visitaSolicitada || item.visitaSolicitadaEm) return null;
  if (vitrine) return 'vitrine';
  if (mat > 0) return 'match';
  const temPerfil = (item.perfilIA && (item.perfilIA.tipo || item.perfilIA.bairro || item.perfilIA.cidade || item.perfilIA.quartos || item.perfilIA.valorMax)) || (item.dados && (item.dados.bairro || item.dados.cidade || item.dados.quartos || item.dados.valorMax));
  if (fase === 'qualificado' || temPerfil) return 'qualificando';
  return 'novo';
}

const leadsPorColuna = {};
colunas.forEach(c => { leadsPorColuna[c.key] = []; });
leads.forEach(item => {
  const col = getColuna(item);
  if (leadsPorColuna[col]) leadsPorColuna[col].push(item);
});
%>

<!-- Hint scroll lateral -->
<div id="kanban-hint" style="display:none">
  <span style="font-size:16px">👆</span>
  <div style="display:flex;gap:4px;margin-left:auto;align-items:center">
    <button onclick="scrollKanban(-1)" style="width:28px;height:28px;border:0.5px solid rgba(0,0,0,.1);border-radius:6px;background:#fff;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center">‹</button>
    <button onclick="scrollKanban(1)" style="width:28px;height:28px;border:0.5px solid rgba(0,0,0,.1);border-radius:6px;background:#fff;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center">›</button>
  </div>
</div>


<style>
@media (max-width: 768px) {
  .kanban-wrap {
    grid-template-columns: 1fr !important;
    overflow-x: unset !important;
    padding-bottom: 12px;
    gap: 8px;
  }
  .kanban-col {
    min-width: unset !important;
    width: 100% !important;
    max-height: unset !important;
  }
  .km-ver-btn { font-size: 9px !important; }
  .lead-card { padding: 10px !important; }
  #kanban-hint { display: none !important; }
}
</style>
<div class="kanban-wrap" id="kanban-board">
<% colunas.forEach(col => { %>
<div class="kanban-col" data-col="<%= col.key %>">
  <div class="kanban-col-header">
    <div style="display:flex;align-items:center;gap:6px">
      <div class="kanban-col-dot" style="background:<%= col.cor %>"></div>
      <span class="kanban-col-title"><%= col.label %></span>
    </div>
    <div style="display:flex;align-items:center;gap:6px">
      <span class="kanban-col-count" id="count-<%= col.key %>"><%= leadsPorColuna[col.key].length %></span>
      <button class="km-ver-btn" onclick="abrirModalKanban('<%= col.key %>', '<%= col.label %>')">Ver todos</button>
    </div>
  </div>

  <% if(leadsPorColuna[col.key].length === 0){ %>
  <div class="empty-col">Nenhuma lead</div>
  <% } %>

  <% leadsPorColuna[col.key].forEach(item => {
    const _mat = (item.matchesAuto||item.matches||[]).length;
    const _perfil = item.perfilIA || {};
    const telefone = String(item.contato||item.telefone||'').replace(/\D/g,'');
    const _sj = item.score || 0;
    const _sjCor = _sj>=70?'#16a34a':_sj>=40?'#d97706':'#9ca3af';
    const _vitrine = !!item.vitrineEnviada;

    let _acao='',_acaoCor='',_urg='';
    if(col.key==='fechado'){_acao='Fechar negócio';_acaoCor='background:#f0fdf4;color:#166534;border-color:#86efac';_urg='alta';}

    else if(col.key==='vitrine'&&!_vitrine){_acao='Enviar vitrine';_acaoCor='background:#fff1e8;color:#b8460e;border-color:#fff1e8';_urg='alta';}
    else if(col.key==='match'){_acao='Ver matches';_acaoCor='background:#f0fdf4;color:#15803d;border-color:#86efac';_urg='media';}
    else if(col.key==='qualificando'){_acao='Qualificar';_acaoCor='background:#fffbeb;color:#92400e;border-color:#fcd34d';_urg='media';}
    else if(col.key==='novo'){_acao='Iniciar contato';_acaoCor='background:#f9fafb;color:#6b7280;border-color:#e5e7eb';_urg='';}
  %>
  <div class="lead-card <%= _urg==='alta'?'urg-alta':_urg==='media'?'urg-media':'' %> <%= item.emAtendimento?'lc-atendida':'' %>"
    title="<%= item.emAtendimento?'Lead em atendimento (já viu detalhes)':'Clique em ver detalhes' %>"
    data-id="<%= item.id %>"
    data-col="<%= col.key %>"
    data-temperatura="<%= item.temperatura||'frio' %>"
    data-origem="<%= item.origem||'' %>"
    data-score="<%= _sj %>"
    data-tipo-lead="<%= (_perfil.tipo||'').toLowerCase() %>"
    data-intencao="<%= (_perfil.intencao||'').toLowerCase() %>"
    data-search="<%= [item.nome,item.contato,item.telefone,item.bairro,_perfil.bairro].filter(Boolean).join(' ').toLowerCase() %>"
    data-tel="<%= item.contato||item.telefone||'' %>">

    <%
      const _origemLabel = {
        'webhook_imovelweb': 'ImovelWeb',
        'webhook_imovelweb_global': 'MatchImóveis',
        'webhook_grupoolx': 'GrupoOLX',
        'webhook_123i': '123i',
        'webhook_chaves': 'Chaves',
        'whatsapp': 'WhatsApp',
        'manual': 'Manual',
        'pagina_externa_imovel': 'Página'
      };
      const _origemEntrada = (item.dados && item.dados.origemEntrada) || item.origemEntrada || item.origem || '';
      const _origemNome = _origemLabel[_origemEntrada] || _origemEntrada || '';
      const _temBusca = item.mapaIntencao && (item.mapaIntencao.tipo_imovel||[]).length > 0;
      const _temVenda = item.tipoLead === 'vendedor' || item.tipoLead === 'cliente_vendedor';
      const _eCorretor = item.tipoLead === 'corretor';
    %>

    <% if(_acao || item.temperatura){ %>
    <div class="lc-head">
      <% if(_acao){ %><span class="acao-badge" style="<%= _acaoCor %>"><%= _acao %></span><% } %>
      <% if(item.temperatura){ %>
      <span class="temp-pill" style="color:<%= item.temperatura==='quente'?'#dc2626':item.temperatura==='morno'?'#b8860b':'#9ca3af' %>"><%= item.temperatura==='quente'?'🔥':item.temperatura==='morno'?'🌡':'❄️' %> <%= item.temperatura %></span>
      <% } %>
    </div>
    <% } %>

    <a href="/app/lead/<%= item.id %>" class="lead-nome"><%= item.nome||telefone||'Lead' %><% if(item._vezesEntrou > 1){ %><span class="lc-vez">↩ <%= item._vezesEntrou %>ª vez</span><% } %></a>
    <div class="lead-tel"><%= telefone||'—' %></div>

    <% if(_origemNome || (!_eCorretor && _temBusca) || _temVenda || _eCorretor || item.idAnuncio){ %>
    <div class="lc-chips">
      <% if(_origemNome){ %><span class="lc-chip origem"><%= _origemNome %></span><% } %>
      <% if(_eCorretor){ %><span class="lc-chip parceiro">🤝 Corretor Parceiro</span><% } %>
      <% if(_temBusca && !_eCorretor){ %><span class="lc-chip buscando">🔍 Buscando imóvel</span><% } %>
      <% if(_temVenda){ %><span class="lc-chip temimovel">🏠 Tem imóvel</span><% } %>
      <% if(item.idAnuncio){ %><a href="/app/imovel/<%= item.idAnuncio %>" target="_blank" class="lc-chip ref">🏠 Imóvel de referência</a><% } %>
    </div>
    <% } %>

    <div class="lc-divider"></div>

    <div class="score-row">
      <div class="score-mini">
        <div class="score-bar"><div class="score-fill" style="width:<%= _sj %>%;background:<%= _sjCor %>"></div></div>
        <span class="score-num"><%= _sj %></span>
      </div>
      <% if(_mat>0){ %><span class="match-pill"><%= _mat %> match<%= _mat>1?'es':'' %></span><% } %>
    </div>

    <% if(_perfil && Object.keys(_perfil).length){ %>
    <div class="perfil-row">
      <% if(_perfil.tipo){%><span class="perfil-tag"><%= _perfil.tipo %></span><%}%>
      <% if(_perfil.quartos){%><span class="perfil-tag"><%= _perfil.quartos %>q</span><%}%>
      <% if(_perfil.bairro){%><span class="perfil-tag"><%= _perfil.bairro %></span><%}%>
      <% if(_perfil.valorMax){%><span class="perfil-tag">R$<%= Math.round(Number(_perfil.valorMax)/1000) %>k</span><%}%>
    </div>
    <% } %>

    <% if(item.criadoEm||item.data_cadastro||item.ultimaMensagemEm){ %>
    <div class="lc-daterow">
      <% if(item.criadoEm||item.data_cadastro){ %><span>📅 <%= new Date(item.criadoEm||item.data_cadastro).toLocaleDateString('pt-BR') %></span><% } %>
      <% if(item.ultimaMensagemEm){ %><span>💬 <%= new Date(item.ultimaMensagemEm).toLocaleDateString('pt-BR') %></span><% } %>
    </div>
    <% } %>

    <div class="lead-btns">
      <% if(telefone){ %>
      <% if(item.vitrineEnviada && item.vitrineLink) { %>
      <% const _linkVitrine = item.vitrineLink || ('/cliente/oferta/'+(item.leadId||item.id)+'?userId='+encodeURIComponent(item.userId||item.usuarioId||item.corretorId||'')); %>
      <% const _msgVitrine = encodeURIComponent('Olá ' + (item.nome||'') + '! Segue sua seleção personalizada de imóveis: ' + _linkVitrine); %>
      <a href="https://wa.me/<%= telefone %>?text=<%= _msgVitrine %>" target="_blank" class="lb wa">🏠 Enviar vitrine manual</a>
      <% } else { %>
      <a href="https://wa.me/<%= telefone %>" target="_blank" class="lb wa">WhatsApp</a>
      <% } %>
      <% } %>
      <% if(_mat>0){ %>
      <% if(item.vitrineEnviada && item.vitrineEnviadaEm){ %>
      <a href="/cliente/oferta/<%= item.leadId||item.id %>?userId=<%= encodeURIComponent(item.userId||item.usuarioId||item.corretorId||'') %>" target="_blank"
         class="lb"
         title="Vitrine enviada pelo sistema — clique para abrir">
        ✓ Vitrine <%= new Date(item.vitrineEnviadaEm).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}) %>
      </a>
      <% } else { %>
      <a href="/cliente/oferta/<%= item.leadId||item.id %>?userId=<%= encodeURIComponent(item.userId||item.usuarioId||item.corretorId||'') %>" class="lb prim" target="_blank">Vitrine</a>
      <% } %>
      <% } %>
      <% if(!item.tipoLead || item.tipoLead==='cliente'){ %>
      <button onclick="abrirClassificar('<%= item.id %>')" class="lb btn-classificar-flag" title="Classificar esta lead">🚩 Classificar</button>
      <% } %>
      <button onclick="confirmarExcluir('<%= item.id %>')" class="lb danger">Excluir</button>
      <a href="/app/lead/<%= item.id %>" class="lb dark">Ver detalhes →</a>
    </div>
    <div class="confirm-box" id="confirm-<%= item.id %>">
      <div style="font-size:11px;color:#991b1b;margin-bottom:6px;font-weight:500">Excluir esta lead?</div>
      <div style="display:flex;gap:5px">
        <button onclick="excluirLead('<%= item.id %>')" class="lb danger" style="font-size:10px">Só excluir</button>
        <button onclick="bloquearLead('<%= item.id %>')" class="lb dark" style="font-size:10px">Excluir e bloquear</button>
        <button onclick="document.getElementById('confirm-<%= item.id %>').style.display='none'" class="lb" style="font-size:10px">Cancelar</button>
      </div>
    </div>
    <div class="confirm-box" id="classificar-<%= item.id %>" style="display:none">
      <div style="font-size:11px;color:#374151;margin-bottom:6px;font-weight:500">Classificar lead:</div>
      <div style="display:flex;gap:5px;flex-wrap:wrap">
        <button onclick="classificarLead('<%= item.id %>','cliente')" class="lb" style="font-size:10px">👤 Buscando</button>
        <button onclick="classificarLead('<%= item.id %>','vendedor')" class="lb" style="font-size:10px">🏠 Tem Imóvel</button>
        <button onclick="classificarLead('<%= item.id %>','corretor')" class="lb" style="font-size:10px">🤝 Corretor</button>
        <button onclick="document.getElementById('classificar-<%= item.id %>').style.display='none'" class="lb" style="font-size:10px">Cancelar</button>
      </div>
    </div>
  </div>
  <% }) %>
</div>
<% }) %>
</div>

