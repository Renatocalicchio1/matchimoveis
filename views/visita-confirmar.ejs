<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Confirmar Presença — MatchImóveis</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',sans-serif;background:#f8f9fa;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
    .card{background:#fff;border-radius:16px;padding:28px;max-width:420px;width:100%;box-shadow:0 4px 24px rgba(0,0,0,.08)}
    .logo{font-size:13px;font-weight:700;color:#FF385C;margin-bottom:20px;text-align:center}
    h2{font-size:18px;font-weight:800;color:#111;margin-bottom:4px}
    .sub{font-size:13px;color:#666;margin-bottom:20px}
    .info-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #f0f0f0;font-size:13px}
    .info-label{color:#888;font-weight:500}
    .info-val{color:#111;font-weight:600;text-align:right}
    .btns{display:flex;flex-direction:column;gap:10px;margin-top:24px}
    .btn{padding:14px;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;width:100%}
    .btn-sim{background:#22c55e;color:#fff}
    .msg{text-align:center;padding:20px;font-size:15px;color:#444;font-weight:500;line-height:1.6}
    .check{font-size:48px;text-align:center;margin-bottom:12px}
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">MatchImóveis</div>
    <% if (respondido) { %>
      <div class="check">✅</div>
      <div class="msg"><%= msg %></div>
    <% } else { %>
      <h2><%= tipo === 'lead' ? 'Confirmar sua presença' : 'Confirmar presença' %></h2>
      <div class="sub"><%= tipo === 'lead' ? 'Você vai comparecer à visita?' : 'Você vai comparecer à visita?' %></div>
      <div class="info-row"><span class="info-label"><%= tipo === 'lead' ? 'Imóvel' : 'Cliente' %></span><span class="info-val"><%= tipo === 'lead' ? (visita.imovel_titulo || visita.imovel_bairro || '—') : (visita.nome || '—') %></span></div>
      <div class="info-row"><span class="info-label">Imóvel</span><span class="info-val"><%= visita.imovel_titulo || visita.imovel_bairro || '—' %></span></div>
      <div class="info-row"><span class="info-label">Data</span><span class="info-val"><%= visita.data_visita || '—' %></span></div>
      <div class="info-row"><span class="info-label">Horário</span><span class="info-val"><%= visita.hora_visita || '—' %></span></div>
      <div class="btns">
        <form method="POST" action="/visita/<%= visita.id %>/confirmar-<%= tipo %>">
          <button class="btn btn-sim">✅ Sim, vou comparecer!</button>
        </form>
      </div>
    <% } %>
  </div>
</body>
</html>
